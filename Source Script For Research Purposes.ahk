    global _fsFreedMain, _fsFreshKeptHidden, _fsHardHidden, _fsHeldBG, _fsHeldMain, _fsHiddenByUs
    global _fsKnownTitle, _fsLoadingLeftLogged, _fsMainBirth, _fsMainCandidate, _fsMainExemptLogged, _fsMainLogged
    global _fsMainPrewarmLogged, _fsMainTitledAt, _fsMainWatchSince, _fsMinLastAttempt, _fsNotifFirstMatch, _fsOWFirstSeen
    global _fsOpCount, _fsOpWarned, _fsOpWindow, _fsOverlayRescued
    global _fsPaintState, _fsParkCycles, _fsParked, _fsParkedRect, _fsPinnedByUs, _fsPopupFirstSeen
    global _fsPopupHeldLogged, _fsPopupKillCount, _fsPopupKilled, _fsPopupLogAt, _fsPostFreeMin
