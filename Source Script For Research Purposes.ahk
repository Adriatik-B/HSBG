_FSNoteDestroyed(hwnd) {
    global _fsKnownTitle, _fsPopupKilled, _fsWasMainTitled, _fsParked
    global _fsMainDiedAt
    global _fsOpCount, _fsOpWindow, _fsOpWarned
    global _fsPostFreeMin
    global _fsHiddenByUs, _fsShielded, _cloakState, _fsBuriedForever
    global _fsTrace

    ; Not a window we ever identified: nothing to SAY about it -- but its
    ; handle can still be recycled into one we will manage, so the per-window
    ; ledgers are purged all the same. See _FSForgetWindow.
    if !_fsKnownTitle.Has(hwnd) {
        _FSForgetWindow(hwnd)
        return
    }

    title := _fsKnownTitle[hwnd]
    weAsked := _fsPopupKilled.Has(hwnd)

    ; The verdict, stated plainly, because the point of this line is that
    ; somebody reading the log should not have to infer it.
    ; ── AND FOR MAIN, SAY WHY, BECAUSE IT IS NOT A FAULT ────────────────────
    ; "Firestone - Main" is CollectionWindow, and Firestone's own manifest
    ; declares it desktop_only. Overwolf closes desktop-only windows while a
    ; game is running. It is a property of the window, not an error, and no
    ; concealment on this side changes it -- six methods were measured against
    ; it, including doing nothing, and all died within 300ms of each other.
    ; Saying so here stops the log implying a bug that was never here.
    gameUp := false
    try gameUp := ProcessExist("Hearthstone.exe") ? true : false
    isMain := _fsWasMainTitled.Has(hwnd)
    verdict := weAsked
        ? "THIS SCRIPT SENT IT A CLOSE -- if this window was Firestone Main,"
        . " the notification closer is the bug and its guards need tightening"
        : (isMain && gameUp)
            ? ("this is CollectionWindow and Hearthstone is running."
            . " Firestone's manifest right now says desktop_only="
            . (_FSDesktopOnlyStateNow())
            . ". Overwolf closes desktop-only windows in-game by design, so if"
            . " that reads true this is expected and nothing here could have"
            . " kept it. If it reads false the flag has been patched out and"
            . " this death needs a different explanation -- do not assume one.")
            : "this script did NOT ask it to close -- Overwolf or the user closed"
            . " it, or it crashed; nothing here is responsible"

    ; ── AND WHAT WE ACTUALLY DID TO IT, IN ORDER ────────────────────────────
    ; The flags above say what state the window was in. They do not say what
    ; happened to it, which is the only thing that helps when a window dies
    ; unexpectedly. This appends the recorded history -- cloak, uncloak, hide,
    ; minimise, close -- with elapsed times, so the line answers "what killed
    ; it" instead of inviting a guess. See _FSTraceNote.
    trace := _FSTraceDump(hwnd)
    _FSLog("FS-DESTROYED hwnd=" . hwnd . " title=`"" . title . "`""
         . " everWasMain=" . (_fsWasMainTitled.Has(hwnd) ? "yes" : "no")
         . " parked="      . (_fsParked.Has(hwnd)        ? "yes" : "no")
         . " hiddenByUs="  . (_fsHiddenByUs.Has(hwnd)    ? "yes" : "no")
         . " shielded="    . (_fsShielded.Has(hwnd)      ? "yes" : "no")
         . " cloaked="     . (_cloakState.Has(hwnd)      ? "yes" : "no")
         . " buried="      . (_fsBuriedForever.Has(hwnd) ? "yes" : "no")
         . " -- " . verdict
         . ((trace != "") ? "  |  WHAT WE DID TO IT: " . trace
                          : "  |  this script performed no traced operation on it"))

    ; STAMP THE DEATH OF A MAIN. The window Overwolf builds to replace this one
    ; appears within a second and is untitled at birth, which makes it look
    ; exactly like a notification to the popup closer. This timestamp is how
    ; that successor is recognised for what it is instead of being held for
    ; twelve seconds. See CFG.fsRebuildGraceMs.
    if _fsWasMainTitled.Has(hwnd) {
        _fsMainDiedAt := A_TickCount

        ; ── DEMAND THE REPLACEMENT NOW, NOT WHEN F3 IS PRESSED ──────────────
        ;
        ; Overwolf has just taken CollectionWindow because a game is running --
        ; that is the documented handoff to CollectionOverlayWindow, and only
        ; Firestone can build that window. Waiting for F3 to ask means the user
        ; presses a key and then waits several seconds while Firestone starts
        ; a window from cold. That is the "eventually works but takes very
        ; long" complaint, and it is entirely avoidable: the moment Main dies
        ; is the moment we know the replacement will be wanted.
        ;
        ; So it is asked for HERE, immediately, and the window is born into a
        ; locked session -- which means the ordinary birth suppression conceals
        ; it exactly as it conceals any other Firestone window. By the time F3
        ; is pressed the window already exists and F3 is a reveal, which is
        ; instant.
        ;
        ; Deferred by a beat rather than run inline: this is a window-destroy
        ; callback, and sending input from inside one is a good way to reenter
        ; the hook. One-shot, so it cannot become a loop.
        if (ProcessExist("Hearthstone.exe") && State.fsMainLocked)
            SetTimer(_FSPreemptInGameWindow, -250)
    }

    ; The HWND is gone and Windows recycles handles aggressively. Every ledger
    ; keyed on it must drop the entry now, or the next window to be handed
    ; this number inherits "we parked this" or "we asked this to close".
    ; EVERYTHING keyed on this handle goes now, not just the six ledgers that
    ; used to be listed here. The log line above has already read what it
    ; needed from them, so this is the correct moment. See _FSForgetWindow for
    ; what inheriting a stale entry actually costs.
    _FSForgetWindow(hwnd)
}

StartOWCreateHook() {
    global _OWCreateHook_Show, _OWCreateHook_Create, _OWCreateCB
    global _OWCreateHook_MinEnd, _OWCreateHook_Uncloak, _OWCreateHook_Name
    global _OWCreateHook_Destroy

    if !_OWCreateCB
        _OWCreateCB := CallbackCreate(OWCreateHookProc, "Fast")

    ; EVENT_OBJECT_CREATE = 0x8000
    if !_OWCreateHook_Create
        _OWCreateHook_Create := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x8000
            , "UInt", 0x8000
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; EVENT_OBJECT_DESTROY = 0x8001 — the only way to learn that a window
    ; we were managing has gone. See _FSNoteDestroyed for why this matters
    ; more than any other event here.
    if !_OWCreateHook_Destroy
        _OWCreateHook_Destroy := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x8001
            , "UInt", 0x8001
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; EVENT_OBJECT_SHOW = 0x8002
    if !_OWCreateHook_Show
        _OWCreateHook_Show := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x8002
            , "UInt", 0x8002
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; EVENT_SYSTEM_MINIMIZEEND = 0x0017 — fires when a window is RESTORED from
    ; minimized. This is how Overwolf raises a suppressed FS‑Main in steady
    ; state, and it produces NO create/show event.
    if !_OWCreateHook_MinEnd
        _OWCreateHook_MinEnd := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x0017
            , "UInt", 0x0017
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; EVENT_OBJECT_UNCLOAKED = 0x8018 — fires when a window's DWM cloak is
    ; cleared. If anything external drops the cloak on a locked FS‑Main, this
    ; tells us the instant it happens so we re‑cloak pre‑frame.
    if !_OWCreateHook_Uncloak
        _OWCreateHook_Uncloak := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x8018
            , "UInt", 0x8018
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; EVENT_OBJECT_NAMECHANGE = 0x800C — fires when a window's TITLE changes.
    ; The title‑settle instant triggers suppression (cloak + alpha shield) at
    ; event speed, and also releases the shield from windows that settled to
    ; non‑suppression titles (e.g. "Firestone - Overlays").
    if !_OWCreateHook_Name
        _OWCreateHook_Name := DllCall(
            "user32\SetWinEventHook"
            , "UInt", 0x800C
            , "UInt", 0x800C
            , "Ptr", 0
            , "Ptr", _OWCreateCB
            , "UInt", 0
            , "UInt", 0
            , "UInt", 0x0000 | 0x0002
            , "Ptr"
        )

    ; ── COUNT WHAT ACTUALLY REGISTERED, AND SAY SO IF ANY DID NOT ───────────
    ;
    ; THE FAILURE THIS EXISTS TO MAKE VISIBLE, BECAUSE IT HAS ALREADY HAPPENED.
    ;
    ; These registrations run one after another with no separation. Anything
    ; that throws partway through -- and reading a global that was never
    ; assigned is enough, which is exactly the bug this guard was written for --
    ; abandons every registration below it. The hooks that DID register keep
    ; working, so the script starts, the tray icon appears, F2 responds, and
    ; nothing anywhere says that four of the six events are missing.
    ;
    ; What that looks like from the outside is "the launch stalls": with no
    ; SHOW and no NAMECHANGE the script is never told that Battle.net's or
    ; Firestone's windows appeared or were renamed, and every piece of
    ; sequencing hanging off those events waits for a signal that is not
    ; coming. It is indistinguishable from a slow machine, and it cost a
    ; release to find.
    ;
    ; One line at start-up removes the whole class. A count that is not 6 is a
    ; bug, stated as such, in the file the user is going to send.
    live := 0
    for h in [_OWCreateHook_Create, _OWCreateHook_Show, _OWCreateHook_Destroy
            , _OWCreateHook_MinEnd, _OWCreateHook_Uncloak, _OWCreateHook_Name]
        if h
            live++
    if (live = 6) {
        _FSLog("HOOK all 6 window events registered (create, show, destroy,"
             . " minimize-end, uncloak, namechange)")
    } else {
        _FSLog("HOOK ONLY " . live . " OF 6 WINDOW EVENTS REGISTERED --"
             . " create=" . (_OWCreateHook_Create  ? 1 : 0)
             . " show="   . (_OWCreateHook_Show    ? 1 : 0)
             . " destroy=" . (_OWCreateHook_Destroy ? 1 : 0)
             . " minend="  . (_OWCreateHook_MinEnd  ? 1 : 0)
             . " uncloak=" . (_OWCreateHook_Uncloak ? 1 : 0)
             . " name="   . (_OWCreateHook_Name    ? 1 : 0)
             . " -- THIS IS A BUG. Window sequencing depends on these; expect"
             . " launches to stall waiting for events that never arrive."
             . " Report this line.")
    }
}

StopOWCreateHook() {
    global _OWCreateHook_Show, _OWCreateHook_Create, _OWCreateCB
    global _OWCreateHook_MinEnd, _OWCreateHook_Uncloak, _OWCreateHook_Name
    global _OWCreateHook_Destroy

    if (_OWCreateHook_Destroy) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_Destroy)
        _OWCreateHook_Destroy := 0
    }
    if (_OWCreateHook_Create) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_Create)
        _OWCreateHook_Create := 0
    }
    if (_OWCreateHook_Show) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_Show)
        _OWCreateHook_Show := 0
    }
    if (_OWCreateHook_MinEnd) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_MinEnd)
        _OWCreateHook_MinEnd := 0
    }
    if (_OWCreateHook_Uncloak) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_Uncloak)
        _OWCreateHook_Uncloak := 0
    }
    if (_OWCreateHook_Name) {
        DllCall("user32\UnhookWinEvent", "Ptr", _OWCreateHook_Name)
        _OWCreateHook_Name := 0
    }
    if (_OWCreateCB) {
        CallbackFree(_OWCreateCB)
        _OWCreateCB := 0
    }
}

; Exact matcher for the Firestone loading popup.
; Close a window WITHOUT waiting for it to go.
;
; AutoHotkey's WinClose sends WM_CLOSE and then BLOCKS until the window is gone
; or its timeout expires. Every call site here targets an Overwolf/Firestone
; window, and the whole point of these closers is that they run when Firestone
; is misbehaving -- so the moment WinClose is called is the moment the target
; is most likely to be hung. AutoHotkey is single-threaded: that block freezes
; the ENTIRE script, hotkeys included, and every watchdog that would recover it
; is a timer, so nothing runs to save it. A user reported exactly this after a
; Firestone crash -- no F-keys at all for the rest of the session.
;
; PostMessage puts WM_CLOSE on the window's queue and returns immediately. A
; healthy window closes exactly as before; a hung one stops being our problem.
; Nothing downstream needed the close to have completed on return -- every
; caller re-checks on its next tick.
_CloseWindowAsync(hwnd) {
    global _fsWasMainTitled
    _FSTraceNote(hwnd, "WM_CLOSE sent")
    ; Never close Firestone Main. Nothing in this file is supposed to, but the
    ; popup-closing paths decide by title and shape and have mis-identified
    ; windows before. Closing Main is unrecoverable without a Firestone restart,
    ; so it is worth one map lookup to make it impossible.
    if _fsWasMainTitled.Has(hwnd) {
        _FSTraceNote(hwnd, "WM_CLOSE REFUSED -- this is Firestone Main")
        return false
    }
    static WM_CLOSE := 0x0010
    try return PostMessage(WM_CLOSE, 0, 0, , "ahk_id " . hwnd)
    return false
}

IsLikelyFirestoneLoadingPopupHwnd(hwnd) {
    try {
        exe := WinGetProcessName("ahk_id " . hwnd)
        if (exe != "Overwolf.exe" && exe != "OverwolfBrowser.exe")
            return false
        title := WinGetTitle("ahk_id " . hwnd)
        if (title = "Firestone - Loading")
            return true

        ; BARE "Firestone" IN THE POPUP SIZE ENVELOPE COUNTS TOO.
        ;
        ; Firestone's start-up window ("Getting ready", with the spinner) is
        ; titled just "Firestone" -- not "Firestone - Loading". Matching only
        ; the hyphenated title meant this dedicated suppressor, the one armed
        ; at 10ms BEFORE the process even exists, never saw the window that is
        ; actually on screen during start-up. It fell through to the general
        ; sweep, which runs later and had more ways to decline.
        ;
        ; Widening it here only ever adds CONCEALMENT -- this path cloaks, it
        ; does not close -- so the cost of a false match is a window that is
        ; hidden a moment earlier than it would have been anyway.
        if (title != "Firestone")
            return false
        if _CoversMostOfItsMonitor(hwnd)      ; the overlay: never
            return false
        ex := 0
        try ex := WinGetExStyle("ahk_id " . hwnd)
        if (ex & 0x20)                        ; WS_EX_TRANSPARENT: click-through
            return false
        w := 0, h := 0
        try WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        return (w >= 300 && h >= 300 && w <= 800 && h <= 800)
    } catch {
    }
    return false
}
; Does this window cover most of the monitor it is sitting on?
;
; THIS REPLACES A FIXED 1600x1000 PIXEL CAP, which was the script's way of
; saying "too big to be a popup, therefore it is the in-game overlay". That
; test is only correct on a monitor bigger than the cap. On a 1366x768 or
; 1600x900 display -- ordinary single-monitor and laptop resolutions -- the
; overlay is SMALLER than the cap, so the check that existed to protect it
; instead waved it through: the overlay could be classified as the loading
; splash and concealed, or judged parkable and moved off screen. Neither can
; happen on the 1440p+ monitor the script was written on, which is exactly why
; it was never seen.
;
; Expressed as a FRACTION of the monitor, the same rule holds at every
; resolution and every DPI: the overlay is game-screen sized by definition, and
; no popup is. The script uses aspect-ratio reasoning elsewhere for the same
; reason -- see _IsProtectedBNetMain, which notes that pixel sizes are not
; DPI-proof.
_CoversMostOfItsMonitor(hwnd, w := 0, h := 0) {
    try {
        if (!w || !h)
            WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        if (w <= 0 || h <= 0)
            return false
        WinGetPos(&x, &y, , , "ahk_id " . hwnd)
        _SafeMonitorRect(GetMonitorIndexForPoint(x + w // 2, y + h // 2)
            , &ml, &mt, &mr, &mb)
        mw := mr - ml, mh := mb - mt
        if (mw <= 0 || mh <= 0)
            return false
        return (w * 100 >= mw * 70) && (h * 100 >= mh * 70)
    }
    return false
}

; Early visual matcher for the Firestone loading popup ONLY.
; Used only by the earliest anti‑flicker paths (create hook + early cloak).
IsLikelyFirestoneLoadingEarlyHwnd(hwnd) {
    try {
        exe := WinGetProcessName("ahk_id " . hwnd)
        if (exe != "Overwolf.exe" && exe != "OverwolfBrowser.exe")
            return false
        title := WinGetTitle("ahk_id " . hwnd)
        if (title = "Firestone - Loading")
            return true
        if (title = "Firestone - Main" || title = "Firestone - Overlays")
            return false
        if (title != "" && title != "Firestone")
            return false
        WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        ; Bounds widened: the pre-title Main is CREATEd tiny (CEF windows are
        ; often born near 0x0 and resized before show) and a remembered size
        ; can exceed the old 1100x900 cap -- either way it escaped this
        ; matcher, showed untitled, and was only minimized once it titled.
        ; The in-game overlay (the reason an upper cap exists at all) is
        ; game-screen sized and still excluded -- by proportion of its monitor
        ; rather than by a pixel count, so the exclusion holds on a small
        ; display too. See _CoversMostOfItsMonitor.
        if (w < 60 || h < 40)
            return false
        if _CoversMostOfItsMonitor(hwnd, w, h)
            return false
        return true
    } catch {
    }
    return false
}

OWCreateHookProc(hWinEventHook, event, hwnd, idObject, idChild, dwEventThread, dwmsEventTime) {
    global _HSCloakActive, _EarlyOWCloakActive, State, _hsGuardActive, _hsRevealed
    global CFG, ChosenMonIdx, _placeCreateSeen, _placeFirstSeen
    global _earlyCloakSawFSMainAt, _bnetFirstMoved, _fsAlphaApplied, _fsHiddenByUs, _fsEverPainted, _fsBirthHidden
    global _bnetPostMinUntil, _bnetPostMinCount, _bnetCloakActive, _bnetHiddenByUs, _fsRevealActive
    global _fsBirthReassert, _fsPaintState, _fsParked, _hdtHiddenByUs, _hdtPreCloaked
    global _hdtPreHidden, _fsShielded, _fsMainEverOpened, _hdtBlanketLogged
    global _hdtMissAt, _hdtStartHiddenAt, _hdtLaunchAt, _hdtLaunchPid
    global _fsEverShown      ; declared explicitly; reads resolve either way
    global _fsBurstUntil     ; "we launched Firestone recently" -- see below
    global _hsFsMarked       ; the window declared fullscreen to the shell
    static EV_CREATE := 0x8000, EV_SHOW := 0x8002
    static EV_MINEND := 0x0017, EV_UNCLOAKED := 0x8018
    static EV_NAMECHANGE := 0x800C
    static EV_DESTROY := 0x8001

    ; ---- HIDDEN-WINDOW VISIBILITY ----
    ; This proc is a CallbackCreate(..., "Fast") callback, so it does not get a
    ; fresh AutoHotkey thread: it inherits the settings of whatever thread it
    ; interrupts, which when the script is idle means DetectHiddenWindows OFF.
    ; Every WinGet* call below addresses a window by "ahk_id", and with that
    ; setting off AutoHotkey will not find a window that is not visible.
    ;
    ; That matters here more than anywhere else in the script, because
    ; EVENT_OBJECT_CREATE always describes an invisible window -- windows are
    ; created hidden and shown afterwards -- and because a window this script has
    ; concealed must remain addressable.
    ;
    ; Fast mode has no thread of its own, so the setting must be restored on every
    ; exit path; hence the finally block at the bottom rather than a plain
    ; assignment.
    ; ── DESTROY IS HANDLED BEFORE ANYTHING ELSE COSTS ANYTHING ──────────────
    ;
    ; ABOVE the DetectHiddenWindows save/set/restore and OUTSIDE the try, and
    ; both of those are deliberate.
    ;
    ; This is a machine-wide hook, so EVERY window destroyed anywhere on the
    ; desktop arrives here -- every menu, tooltip, tab, balloon and transient
    ; that any application creates. That is easily the highest-frequency event
    ; of the six, and it was paying the full callback preamble before it could
    ; discover it had nothing to do. This callback is "Fast" mode: it has no
    ; thread of its own and runs on whatever it interrupted, so work done here
    ; is latency added to the window sequencing that shares the thread -- the
    ; exact starvation the header warns about.
    ;
    ; A destroyed window cannot be queried, so nothing below needs
    ; DetectHiddenWindows and nothing below can help: WinGetProcessName on a
    ; dead HWND fails, so the exe gate would discard the event anyway. The
    ; whole handler is one Map lookup that misses for virtually every window.
    if (event = EV_DESTROY) {
        if (idObject = 0 && idChild = 0 && hwnd) {
            ; Retract the fullscreen declaration when the window it was made
            ; for is destroyed. One integer compare, and the only moment that
            ; cannot flip back and forth. See _HSDeclareFullscreen.
            if (hwnd = _hsFsMarked) {
                _hsFsMarked := 0
                try {
                    tbl := ComObject("{56FDF344-FD6D-11d0-958A-006097C9A090}"
                                   , "{602D4995-B13A-429b-A66E-1935E44F4317}")
                    ComCall(3, tbl)
                    ComCall(8, tbl, "Ptr", hwnd, "Int", 0)
                }
            }
            try _FSNoteDestroyed(hwnd)
        }
        return
    }

    prevDHW := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        if (idObject != 0 || idChild != 0 || !hwnd)
            return

        ; ── RE-ASSERT ALPHA 0 THE INSTANT THE WINDOW IS SHOWN ───────────────
        ; FIRST thing in this hook, before any other work, because the window
        ; is being shown right now and every statement between here and the
        ; SetLayeredWindowAttributes below is a chance for a frame to reach the
        ; screen.
        ;
        ; WHY THIS IS NEEDED AT ALL. Main is concealed at creation -- measured
        ; at 0ms, wasVisible=0, so we genuinely beat the first show. But layered
        ; attributes are initialised when a window is SHOWN, and alpha set on a
        ; window that has never been shown is not reliably in force for that
        ; first frame. Windows paints it once, opaque, and the state check then
        ; re-applies. That single frame is the flicker the owner sees dead
        ; centre of the primary monitor, which is exactly where Main sits
        ; (560,301, 1440x790 on a 2560x1440 screen).
        ;
        ; It also explains why every measurement said we had won: FS-EXPOSURE
        ; reports the conceal at creation, and the watchdog polls at 120ms, so
        ; neither can see a 16ms frame between the show and the re-apply.
        ;
        ; Two DllCalls, only for windows already in _fsAlphaConcealed, so this
        ; costs one map lookup for every other window in the system.
        ; Main birth shield is a CREATE->SHOW bridge only. Resolve it before
        ; the generic alpha reassert so the very first visible state is already
        ; alpha 0, then release the temporary cloak/hide immediately.
        ; ── THE SHIELD IS HELD UNTIL THE FIRST F3, NOT RELEASED ON SHOW ─────
        ;
        ; It used to release here, on the first SHOW, converting the hard hide
        ; into alpha 0. That is a handover, and the handover is where the
        ; flicker lived: Overwolf shows the window, and between the show and
        ; our conversion it draws real frames. Both witnesses caught it --
        ;
        ;   HSBG.log   FS-VISIBLE caught an unconcealed Firestone window ON
        ;              SCREEN, 844ms after creation, wasVisible=1
        ;   watchdog   MAIN hwnd=3147158 vis=True alpha=255   <- 0.6s visible
        ;              MAIN hwnd=3147158 vis=True alpha=0
        ;
        ; -- and they agreed, which is what makes it a finding rather than a
        ; suspicion.
        ;
        ; A window that is SW_HIDDEN cannot draw a frame no matter who calls
        ; ShowWindow on it or what alpha it carries, so the hide is simply kept
        ; until the user actually asks for the window with F3. There is no
        ; handover before that point and therefore nothing to race.
        ;
        ; The concern this used to be written around -- that holding a Chromium
        ; window hidden kills its renderer -- was tested and did not hold: Main
        ; was caught at birth, held hidden for forty-five seconds, and released
        ; to a live window painting normally. This holds it for the same kind
        ; of interval.
        ;
        ; Battlegrounds is untouched by any of this. That window has never
        ; flickered, it is not what the shield admits (the shield only takes
        ; titles "Firestone" and "Firestone - Main"), and a path that works is
        ; not one to go changing.
        if (event = EV_SHOW && _fsMainBirthShielded.Has(hwnd)) {
            static _fsHeldLogged := Map()
            if !_fsHeldLogged.Has(hwnd) {
                _fsHeldLogged[hwnd] := true
                _FSLog("FS-MAIN birth shield HELD through SHOW hwnd=" . hwnd
                     . " -- staying hidden until the first F3. Releasing here"
                     . " is the handover that produced the flicker.")
            }
        }

        if (event = EV_SHOW && _fsAlphaConcealed.Has(hwnd)) {
            static LWA_ALPHA_RS := 0x2
            DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
                  , "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA_RS)
        }

        ; Cheap global gate — only resolve the exe when at least one consumer
        ; below could act on the event. HS conditions (_HSCloakActive,
        ; _hsGuardActive) are intentionally NOT here: HS is owned by its own
        ; dedicated timers, not this hook, so this hook need not wake for an
        ; HS-only phase. Firestone (fsMainLocked / lock), the Overwolf
        ; launcher splash (launcherHideActive), early cloak, and Battle.net
        ; placement (lock) remain.
        ; ── THE TRACKER, HANDLED BEFORE THE FIRESTONE GATE AND RETURNING ────
        ; Placed ABOVE the gate rather than added to it, and the difference is
        ; not stylistic. Adding State.hdtHidden to the gate below would wake
        ; every FIRESTONE branch in this hook for the whole of an HSReplay
        ; session -- including the notification-popup closer, which is gated
        ; only on the Overwolf executables and would then start sending
        ; WM_CLOSE to Firestone's windows in a session whose entire promise is
        ; that the overlay you did not choose is "not launched, not suppressed,
        ; not closed, not moved".
        ;
        ; EV_SHOW ONLY, and never EV_CREATE. _HDTConcealWindow has no
        ; visibility or size test -- every previous path into it came through
        ; GetHDTSurfaces, which has both. At CREATE a window is by definition
        ; not yet visible, so acting there would SW_HIDE and LEDGER every
        ; top-level HWND the tracker builds: WPF dispatcher windows, popup
        ; hosts, 0x0 sinks, panels it never shows. HDTReleaseAll shows the
        ; whole ledger unconditionally, so the first F3 press would dump all of
        ; them onto the screen, pinned above the game -- windows the tracker
        ; itself never displayed. Acting at SHOW costs at most one frame and
        ; keeps the ledger honest: only windows that were genuinely on screen
        ; are ever put back.
        ; PID COMPARE, NOT WinGetProcessName. This sits ABOVE the cheap gate
        ; whose stated job is to resolve the executable only when a consumer
        ; could act -- so it must not itself become a process-name lookup for
        ; every window shown anywhere on the machine, which under
        ; hdtStartHidden is most of an HSReplay session.
        ; GetWindowThreadProcessId is a single non-blocking call with no
        ; OpenProcess behind it; GetHDTPID caches. Two integers compared.
        ; ── THE LAUNCH BLANKET, AHEAD OF THE PID FAST PATH ──────────────────
        ; While a tracker launch we issued is still young, identity comes from
        ; the WINDOW rather than from a process we may not have found yet. See
        ; _HDTLaunchOwnsWindow -- this is the branch with no blind spot in it,
        ; and it is what stops the tracker's splash and the Squirrel stub's
        ; console painting a frame before anything recognises them.
        ;
        ; Bounded to hdtLaunchBlanketMs, and only while F3 has the overlay
        ; hidden, so the per-event process-name lookup it costs is confined to
        ; the seconds either side of a launch.
        ; ── ARMED BY EITHER STAMP, NOT ONLY BY A LAUNCH WE ISSUED ──────────
        ; _hdtLaunchAt is set by LaunchHDTNow -- which returns early, without
        ; setting it, whenever the tracker is ALREADY RUNNING. So on the very
        ; common "F2 with HSReplay already open" path this branch never armed
        ; at all, and every window the tracker created from then on fell back
        ; to the 400 ms watch: up to four hundred milliseconds on screen. That
        ; is not a subtle flicker, it is the tracker appearing and vanishing.
        ;
        ; _hdtStartHiddenAt is stamped whenever the session arms the hidden
        ; state, launch or no launch, which is exactly the interval that needs
        ; covering. Either stamp arms it; both are bounded by the same window.
        if (State.hdtHidden && (event = EV_CREATE || event = EV_SHOW)) {
            if _HDTTryBirthConceal(hwnd, event)
                return
        }

        ; ── FIRESTONE BIRTH CLOAK, ON THE SECOND LINE OF THE HOOK ───────────
        ; THIS IS THE REMAINING BATTLEGROUNDS FLICKER, AND IT IS A LATENCY
        ; PROBLEM RATHER THAN A LOGIC ONE.
        ;
        ; The birth cloak further down is correct, but it sits behind
        ; WinGetProcessName -- an OpenProcess / QueryFullProcessImageNameW /
        ; CloseHandle round-trip -- plus the managed-set lookup. Every one of
        ; those microseconds is time a freshly created CEF window has to
        ; composite its first frame, and the Battlegrounds window is created
        ; lazily at the first match, so it gets exactly one chance to be caught
        ; and no pre-armed cloak from a previous show to fall back on.
        ;
        ; A PID compare needs no handle and no cross-process call, so the cloak
        ; now happens before anything else in this function. It is deliberately
        ; ONLY a cloak: no ledger, no hide, no park, no title read. Everything
        ; that decides what the window actually deserves still happens below,
        ; unchanged -- this only buys the compositor a head start, and a cloak
        ; on a window that turns out not to be ours is undone by its janitor
        ; microseconds later exactly as before.
        ; ── BATTLE.NET INFRASTRUCTURE, HIDDEN ON THE HOOK'S SECOND LINE ─────
        ; Same reasoning as the Firestone birth cloak below: every microsecond
        ; spent resolving an executable name is time the splash and the
        ; auto-login shell have to paint. _HideBlizzWindow keeps all of its own
        ; guards -- the real client is never hidden, LOGIN_WAIT is respected --
        ; this only gets there sooner.
        if (event = EV_CREATE && _HSCloakActive && CFG.bnetFastBirthHide) {
            bzPid := 0
            DllCall("user32\GetWindowThreadProcessId", "Ptr", hwnd, "UInt*", &bzPid)
            bzMap := _BlizzPids()
            if bzMap.Has(bzPid) {
                try {
                    if !_IsBlizzInfrastructureWindow(hwnd)
                        _HideBlizzWindow(hwnd, bzMap[bzPid])
                }
            }
        }

        ; ══════════════════════════════════════════════════════════════════
        ;  BATTLEGROUNDS: HARD HIDE ON BOTH CREATE AND SHOW (DISABLED)
        ; ══════════════════════════════════════════════════════════════════
        ; CREATE catches a window born WITH WS_VISIBLE -- already on screen by
        ; the time the event arrives. SHOW catches the far commoner case, a
        ; window created hidden and displayed a moment later, which is what the
        ; Battlegrounds window actually does and which a CREATE-only shield
        ; could never intercept. One PID compare, then _FSFullBirthSuppress
        ; makes every other decision; see it for what is refused and why.
        ;
        ; This branch is now effectively disabled because CFG.fsBgHardHide is
        ; false. The flicker shield (_FSFlickerShieldOn) provides the brief
        ; SW_HIDE at birth, released as soon as the park lands, which is gentler
        ; and works without holding the hide forever.
        if ((event = EV_CREATE || event = EV_SHOW)
         && State.fsMainLocked && CFG.fsBgHardHide) {
            wpidBg := 0
            DllCall("user32\GetWindowThreadProcessId", "Ptr", hwnd, "UInt*", &wpidBg)
            ; Main and the in-game overlay are excluded from birth-hide by
            ; design and are handled elsewhere; anything else from an Overwolf
            ; PID gets the full suppression. The empty else that used to state
            ; that exclusion is folded into this condition -- a branch whose
            ; whole body is a comment is one a maintainer has to read twice to
            ; discover does nothing.
            if (_IsOverwolfPid(wpidBg, hwnd)
             && !_FSIsMainSurface(hwnd, "")
             && !IsFirestoneInGameOverlay(hwnd, ""))
                _FSFullBirthSuppress(hwnd)
        }

        ; Gated on the OR of the two flags, and each primitive then checks its
        ; own. The clip must not depend on a switch that has nothing to do with
        ; it -- turning the fast cloak off would otherwise silently take the
        ; only concealment that beats the first frame with it.
        ; THE BIRTH CLOAK IS GONE, BY INSTRUCTION.
        ;
        ; This cloaked every newly created Overwolf-process window while the F3
        ; lock was on. Two problems, and neither is fixable from inside a
        ; creation hook:
        ;
        ;   1. It reached Firestone Main. At EV_CREATE the window has no title,
        ;      so no identity test can exclude it -- and Main must never be
        ;      cloaked, because a cloak stops DWM compositing it and takes its
        ;      taskbar button with it.
        ;   2. Every Overwolf app shares these processes, so a MetaTFT window
        ;      born at the wrong moment was cloaked too. Another application's
        ;      window is not this script's to touch.
        ;
        ; The first frame is not a race worth winning here. The answer is to
        ; stop the window being opened visible at all -- Firestone's own
        ; start-up setting -- and to conceal with alpha 0, which keeps the
        ; window composited and on the taskbar. See _FSConcealMain.

        ; Record when this window was created, so the conceal can report how
        ; long it took to reach it and whether the window was visible by then.
        ; One map write, no log: this runs for every newborn Overwolf window.
        if (event = EV_CREATE) {
            wpidSeen := 0
            DllCall("user32\GetWindowThreadProcessId", "Ptr", hwnd, "UInt*", &wpidSeen)
            if (_IsOverwolfPid(wpidSeen, hwnd) && !_fsSeenAt.Has(hwnd))
                _fsSeenAt[hwnd] := A_TickCount
        }


        ; _HSCloakActive and _bnetCloakActive are on this list because the
        ; Battle.net branches BELOW this gate depend on it. They used to be
        ; carried incidentally by State.fsMainLocked, which was armed
        ; unconditionally at start-up whenever Firestone was installed. Now
        ; that the Firestone stack is correctly stood down in an HSReplay or
        ; Tracker=none session, a user on that setup with MonitorLock=0 would
        ; have every disjunct false -- and this hook would return for every
        ; event, leaving Battle.net's boot splash and login shell to the 10 ms
        ; poll alone. Battle.net's concealment is not Firestone's business and
        ; must not be gated on Firestone's state.
        if !(State.launcherHideActive || _EarlyOWCloakActive
          || State.fsMainLocked || CFG.lockWindowsToChosenMonitor
          || _HSCloakActive || _bnetCloakActive)
            return

        exe := ""
        try exe := WinGetProcessName("ahk_id " . hwnd)
        if (exe = "")
            return

        ; ══════════════════════════════════════════════════════════════════
        ; NOTHING OUTSIDE THE MANAGED SET GETS PAST THIS LINE
        ; ══════════════════════════════════════════════════════════════════
        ; Every branch below already tests the executable name before it acts,
        ; and the last of them falls through to a bare return -- so a foreign
        ; window was never touched. But that was a property held up by six
        ; separate conditions agreeing with each other, which is exactly the
        ; kind of property one careless edit removes, and it was not something
        ; a user could be shown.
        ;
        ; This makes it structural and it makes it evidence. A user running a
        ; different tracker, a streaming overlay, a frame counter or anything
        ; else alongside their game can now be told, from their own log, that
        ; this script saw the window and declined it. See _IsScriptManagedExe.
        ;
        ; The HSReplay tracker is deliberately NOT in the managed set. It is
        ; handled by its own branch ABOVE this gate, which returns, so it never
        ; reaches the Firestone machinery here.
        if !_IsScriptManagedExe(exe) {
            _TrackerNoteForeignWindow(exe)
            return
        }

        ; Targeted Firestone Main CREATE shield. Unlike the shared cold shield,
        ; this touches ONLY the small provisional Main host during a locked
        ; Firestone launch. It is one-shot and released on the first SHOW.
        if (event = EV_CREATE && State.fsMainLocked
         && (exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe"))
            try _FSMainBirthShieldOn(hwnd)

        ; ── THE STARTUP SPLASH, BEFORE ANYTHING ELSE IN THIS PROC ───────────
        ;
        ; First, because it is the only branch here whose opportunity expires.
        ; The splash can be dealt with ONLY between its creation and its show,
        ; and everything below this line -- every WinGet round-trip, every
        ; title read -- spends part of that window. It is also the cheapest
        ; test in the proc: two GetWindowLong reads that reject every other
        ; window immediately.
        ;
        ; CREATE **AND** SHOW. Catching it at creation is what prevents the
        ; panel appearing at all, but that depends on the hook being on time,
        ; and under a real F2 -- Battle.net starting, Hearthstone starting,
        ; every window on the desktop generating events -- it is not. The
        ; first live test proved it: the hook was behind, the 10ms sweep saw
        ; the panel first, and it was on screen. Running on SHOW as well means
        ; a late arrival still ends the exposure instead of ignoring the
        ; window for being the wrong shape by then.
        if ((event = EV_CREATE || event = EV_SHOW)
         && (exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe"))
            try _FSSplashBirthCatch(hwnd)
        ; Overwolf's launcher PANEL, same event, same reason: visible on the
        ; primary during our own launch and previously unclassified.
        if ((event = EV_CREATE || event = EV_SHOW)
         && (exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe")) {
            qlTitle := ""
            try qlTitle := WinGetTitle("ahk_id " . hwnd)
            if (qlTitle = "Overwolf Quick Launcher")
                try _FSQuickLauncherCatch(hwnd, qlTitle)
        }
        ; Broad Overwolf birth-cloak removed. It was too wide: Firestone - Overlays
        ; shares the same Overwolf/Browser processes and could be caught before its
        ; own allow-list rescue. Main has the targeted CREATE->SHOW bridge above; all
        ; settled Main concealment remains alpha=0.
        }
        ; ---- BIRTH SUPPRESSION RE-ASSERT ----
        ; Overwolf answers our birth-time concealment by calling SW_SHOW a moment
        ; later. Under the park policy there is nothing to undo -- the window was
        ; never hidden -- so this branch has work to do only under the legacy "hide"
        ; policy.
        ;
        ; The re-assert is COUNTED. Re-asserting once or twice is correct; an
        ; unbounded hide/show duel at event speed is a storm, and a storm on a cold
        ; Chromium window destroys it. Past the cap this stands down and lets the
        ; settled sweep own the window.
        if (event = EV_SHOW && State.fsMainLocked && CFG.fsBirthHide
         && _fsBirthHidden.Has(hwnd)
         && (exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe")) {
            if !IsHelperWindow(hwnd) {
                n := _fsBirthReassert.Get(hwnd, 0)
                if (n < CFG.fsBirthReassertMax) {
                    _fsBirthReassert[hwnd] := n + 1
                    try _FSSuppressSurface(hwnd, "", false)
                    try _FSEventNudge()
                } else if (n = CFG.fsBirthReassertMax) {
                    _fsBirthReassert[hwnd] := n + 1
                    _FSLog("FS-COLD re-assert cap reached hwnd=" . hwnd
                         . " -- standing down at event speed, settled sweep owns it")
                }
            }
        }

        ; ---- Firestone popup: killed the instant it names itself ----------
        ; A CEF window is created without a caption and titled a few
        ; milliseconds later, so this event -- not CREATE -- is the first moment
        ; the popup can be told apart from anything else Overwolf makes. Acting
        ; here is the earliest possible correct kill, and it is why the popup no
        ; longer survives long enough to be seen.
        ;
        ; Not gated on the F3 lock, by design: a notification is never something
        ; the user asked to see, whatever state their overlay is in.
        if (event = EV_NAMECHANGE
         && (exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe")) {
            try {
                t := WinGetTitle("ahk_id " . hwnd)
                if IsFirestoneNotificationPopup(hwnd, t)
                    _FSKillNotificationPopup(hwnd, "namechange")
            }
        }

        ; ---- Battle.net NAMECHANGE enforcement (bidirectional) ----
        ; A title change can flip a window's classification either way, so
        ; both directions are enforced at event speed: a hidden window whose
        ; settled identity is the REAL client is un-hidden immediately; a
        ; live window whose title exposes it as a service surface is hidden.
        if (event = EV_NAMECHANGE && exe = "Battle.net.exe") {
            if _bnetHiddenByUs.Has(hwnd) {
                if _IsProtectedBNetMain(hwnd) {
                    _bnetHiddenByUs.Delete(hwnd)
                    try UncloakWindow(hwnd, false, "OWCreateHookProc")
                    DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
                }
            } else if (_BNetBlanketActive() && CFG.bnetAggressiveHide
                    && !_IsBlizzInfrastructureWindow(hwnd)) {
                try _HideBlizzWindow(hwnd, exe)
            }
            return
        }

        ; ---- Battle.net / Agent placement (no popup suppression) ----
        if ((event = EV_CREATE || event = EV_SHOW)
         && (exe = "Battle.net.exe" || exe = "Agent.exe")) {

            ; Services blanket, event speed: everything except the REAL
            ; client window is cloaked+hidden the instant it appears -- the
            ; auto-login shell included. The real client passes through and
            ; continues into the placement logic below, so its very first
            ; frame already lands on the chosen monitor.
            ; ── SERVICES ARE HIDDEN AND NEVER PLACED ────────────────────────
            ; This used to test _bnetHiddenByUs, which _HideBlizzWindow sets
            ; ONLY when the window was already visible. At EV_CREATE a service
            ; window is not visible yet, so the ledger was empty, this guard did
            ; not fire, and the placement code below MOVED the window -- which
            ; Windows then showed. Appear, jump to the chosen monitor: the
            ; services flicker, caused by the placement, not by the hiding.
            ;
            ; _bnetHideDone is written unconditionally by _HideBlizzWindow, so
            ; it means "we hid this one" regardless of what it was doing at the
            ; time. That is the honest test.
            if (_BNetBlanketActive() && CFG.bnetAggressiveHide) {
                if !_IsBlizzInfrastructureWindow(hwnd)
                    try _HideBlizzWindow(hwnd, exe)
                if (_bnetHideDone.Has(hwnd) || _bnetHiddenByUs.Has(hwnd))
                    return          ; hidden SERVICE surface: nothing to place.
            }

            ; Agent.exe is NEVER placed, hidden or not. It is the Blizzard
            ; update service: the user never looks at it, and the only thing
            ; placement can do to it is move it somewhere visible on its way to
            ; being hidden. Only Hearthstone and the Battle.net LAUNCHER are
            ; positioned, which is the whole of what the monitor lock is for.
            if (exe = "Agent.exe")
                return

            ; And within Battle.net.exe, only the real client window. Every
            ; other surface it owns is a service window by definition -- the
            ; login shell, helpers, popups -- and those are hidden, not moved.
            if (exe = "Battle.net.exe" && !_IsProtectedBNetMain(hwnd))
                return

            ; --- First: placement / minimize for the main launcher ---
            if (CFG.lockWindowsToChosenMonitor) {
                if (DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr") = hwnd) {
                    if (event = EV_CREATE) {
                        _placeCreateSeen[hwnd] := A_TickCount
                        if _placeFirstSeen.Has(hwnd)
                            _placeFirstSeen.Delete(hwnd)

                        ; Layer 1: place it before anyone can see it on the
                        ; wrong monitor.
                        ;
                        ; THIS USED TO REQUIRE THE WINDOW TO BE INVISIBLE, and
                        ; that requirement is why the launcher flickered on the
                        ; primary monitor instead of landing on the locked one.
                        ;
                        ; The window hook is delivered through the message
                        ; queue. During a launch this script is busy, so the
                        ; CREATE notification arrives LATE -- and Battle.net
                        ; restores its own remembered position and paints there
                        ; in the meantime. The window was therefore already
                        ; visible by the time this ran, the whole block was
                        ; skipped, and the only thing left to move it was the
                        ; ready-reveal 94ms later. The user watched it appear
                        ; on primary and jump.
                        ;
                        ; Being late is not a reason to do nothing. It is a
                        ; reason to hide the move instead: an already-visible
                        ; window is cloaked, moved, and uncloaked below, so the
                        ; jump is invisible even when the frame that preceded
                        ; it was not.
                        if (CFG.preShowPlaceBNet && ChosenMonIdx) {
                            try {
                                rc := Buffer(16, 0)
                                if DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc) {
                                    bx := NumGet(rc, 0, "Int"), by := NumGet(rc, 4, "Int")
                                    bw := NumGet(rc,  8, "Int") - bx
                                    bh := NumGet(rc, 12, "Int") - by
                                    if (GetMonitorIndexForPoint(bx + bw // 2, by + bh // 2) != ChosenMonIdx) {
                                        _SafeWorkArea(ChosenMonIdx, &waL, &waT, &waR, &waB)
                                        waW := waR - waL
                                        waH := waB - waT
                                        nx := (bw > 0 && bw <= waW) ? waL + (waW - bw) // 2 : waL
                                        ny := (bh > 0 && bh <= waH) ? waT + (waH - bh) // 2 : waT
                                        ; Cloak across the move ONLY if the
                                        ; window can already be seen. An
                                        ; invisible window needs no cover and
                                        ; cloaking it would be one more state
                                        ; to unwind; a visible one would
                                        ; otherwise be watched sliding between
                                        ; monitors.
                                        global _cloakState
                                        vis1 := DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                                        hid1 := vis1 && !_cloakState.Has(hwnd)
                                        if hid1
                                            CloakWindow(hwnd, false, "OWCreateHookProc")
                                        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
                                            , "Int", nx, "Int", ny, "Int", 0, "Int", 0
                                            , "UInt", 0x0001 | 0x0004 | 0x0010)
                                        if hid1
                                            UncloakWindow(hwnd, false, "OWCreateHookProc")
                                    }
                                }
                            }
                        }
                    } else {
                        if !_placeCreateSeen.Has(hwnd)
                            _placeCreateSeen[hwnd] := A_TickCount
                        ; Layer 2: first‑frame placement at first visibility.
                        _BNetFirstShowPlace(hwnd)

                        ; Event‑speed re‑minimize during the post‑launch window.
                        if (_bnetPostMinUntil > A_TickCount
                         && DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                         && !IsHelperWindow(hwnd)
                         && WinGetMinMax("ahk_id " . hwnd) != -1) {
                            WinGetPos(, , &pbW, &pbH, "ahk_id " . hwnd)
                            if (pbW >= 200 && pbH >= 150
                             && (!_placeCreateSeen.Has(hwnd)
                              || A_TickCount - _placeCreateSeen[hwnd] >= 4000)
                             && _bnetPostMinCount.Get(hwnd, 0) < 3) {
                                _bnetPostMinCount[hwnd] := _bnetPostMinCount.Get(hwnd, 0) + 1
                                _MinimizeWindowNoAnim(hwnd, "window-event hook")
                            }
                        }
                    }
                    ; Layer 3: one‑shot settled pass just past the 400ms margin.
                    SetTimer(_HookedPlacementPass, -460)
                }
            }
            return
        }

        ; ---- Hearthstone: NOT handled here ----
        ; HS placement/cloaking is owned exclusively by StartHSCloaker (launch
        ; phase, 10ms) and HSPlacementGuardTick (post-reveal, 150ms), which
        ; run sequentially (RevealHSAfterLaunch stops the cloaker before
        ; arming the guard). Handling HS in this shared hook too made it a
        ; multi-owner window and coupled its timing to FS/BNet events. It is
        ; now fully independent of this hook -- if the event is for HS, the
        ; per-exe branches below simply don't match it and it falls through
        ; harmlessly. (The dedicated owners see every HS window via their own
        ; WinGetList enumeration, so nothing is missed.)
        if (exe = "Hearthstone.exe")
            return

        ; ---- OverwolfLauncher splash (CREATE/SHOW only) ----
        if ((event = EV_CREATE || event = EV_SHOW)
         && State.launcherHideActive && exe = "OverwolfLauncher.exe") {
            CloakWindow(hwnd, false, "OWCreateHookProc")
            _FSHideWindow(hwnd, "OWCreateHookProc")  ; SW_HIDE
            return
        }

        ; ---- Overwolf / OverwolfBrowser ----
        if (exe != "Overwolf.exe" && exe != "OverwolfBrowser.exe")
            return

        title := ""
        try title := WinGetTitle("ahk_id " . hwnd)

        ; Firestone - Main and Firestone - Battlegrounds while the F3 lock is on.
        ; Routed through the single suppression primitive, which applies the cold
        ; policy until the window has proven it paints and the standard concealment
        ; afterwards. The alpha shield is applied by that primitive, not here: two
        ; owners performing opposite-layer operations on one Chromium window in the
        ; same millisecond is precisely what this design exists to prevent.
        if (IsFirestoneSuppressionTitle(title) && State.fsMainLocked) {
            _ApplyFSAlphaShield(hwnd)     ; ledger-only while fsUseAlphaShield=false
            try _FSSuppressSurface(hwnd, title, false)
            ; Stamp the first sighting for early‑cloak self‑stop.
            if (!_earlyCloakSawFSMainAt && _EarlyOWCloakActive
             && IsFirestoneMainTitle(title))
                _earlyCloakSawFSMainAt := A_TickCount
            return
        }

        ; ---- Unlocked SHOW release ----
        ; While UNLOCKED, a suppression-titled window being shown by
        ; Overwolf must actually appear. Its cloak may deliberately still
        ; be armed from the locked era (kept on hidden windows so the NEXT
        ; locked-era show is born invisible -- the BG match-start flicker
        ; fix); release cloak and shield here at event speed. Worst case
        ; under event lag is a one-frame LATE appearance (invisible ->
        ; visible), imperceptible -- unlike the old wrong-visible frame.
        ; IsFirestoneAppTitle is here for the same reason it is in FSRevealTick:
        ; a Firestone window that is not Main or Battlegrounds -- Settings, most
        ; often -- is concealed by the lock like everything else, so while the
        ; lock is OFF it must be released like everything else. Without it, a
        ; Settings window shown by Overwolf during an unlocked stretch stayed
        ; parked and cloaked from the previous locked era.
        if ((IsFirestoneSuppressionTitle(title) || IsFirestoneAppTitle(title))
         && !State.fsMainLocked) {
            ; ── EXCEPT: a BATTLEGROUNDS window nobody has ever seen ─────────
            ; The Battlegrounds window is created lazily, at the first match,
            ; and this branch is why it used to pop onto the screen when that
            ; happened during an unlocked stretch: born -> Overwolf shows it ->
            ; released and visible, mid-game, unasked. A Battlegrounds window
            ; with no _fsEverShown entry has never been on screen for this
            ; user, so there is no position to respect and no expectation to
            ; honour -- it starts hidden, exactly as it would have if it had
            ; been born under the lock, and the next F3 unlock reveals it.
            ;
            ; MAIN IS DELIBERATELY EXCLUDED, and so is every other Firestone
            ; window. Main is destroyed on close and re-created on a fresh
            ; HWND when the user clicks the tray icon, so "never been shown"
            ; is true of a Main the user is opening RIGHT NOW -- see
            ; CFG.fsFreshBornStartHidden for the log line that proved it and
            ; the three fences applied here.
            ; FENCE 3 IS "IS THE USER IN FIRESTONE RIGHT NOW", NOT "IS THIS THE
            ; FOREGROUND WINDOW". The obvious test -- GetForegroundWindow() !=
            ; hwnd -- cannot work here: this branch runs at SHOW/NAMECHANGE,
            ; and Windows shows a window BEFORE it makes it the foreground, so
            ; a window the user had just clicked open was never the foreground
            ; at the instant it was examined. The fence would have passed every
            ; time and caught the deliberate case it exists to spare.
            ;
            ; What actually separates the two situations is where the user's
            ; attention is. A Battlegrounds window born at the first match of a
            ; game arrives while HEARTHSTONE holds the foreground. One the user
            ; opened from Firestone's own UI arrives while OVERWOLF does --
            ; they just clicked something in it. So: conceal only when the
            ; foreground belongs to something other than the Overwolf family.
            if (CFG.fsFreshBornStartHidden && IsFirestoneBattlegroundsTitle(title)
             && !_fsEverShown.Has(hwnd) && !_fsRevealActive
             && GetHSPID() && !_FSFamilyHasForeground()) {
                _FSConcealFreshUnlocked(hwnd, title)
                return
            }
            if _fsAlphaApplied.Has(hwnd)
                _ClearFSAlphaShield(hwnd)
            _FSReleaseSurface(hwnd)       ; unpark first, then uncloak
            ; The user is looking at this window RIGHT NOW, so from here on its
            ; rectangle is a position they chose. _FSUnparkWindow sets the same
            ; flag, but only for a window it actually un-parks -- and a window
            ; shown for the first time while the lock is OFF was never parked,
            ; so nothing else would record that it has been seen. Without this,
            ; the first F3 lock/unlock cycle after opening it would treat its
            ; rectangle as an unseen birth position and re-centre it on the
            ; primary monitor, throwing away where the user had put it.
            _fsEverShown[hwnd] := true
            return
        }

        ; ---- Overlay janitor (ANY event, incl. NAMECHANGE) ----
        ; The in‑game overlay must be visible. Release cloak, shield AND PARK.
        ; The park matters: the overlay is born untitled like everything else,
        ; so the birth suppression parks it off-screen. Without the unpark here
        ; the in-game overlay would live outside the virtual desktop for the
        ; whole session -- the same class of unrecoverable state the birth-hide
        ; used to create, which is why this janitor exists at all.
        ; Matched by SHAPE as well as by name. Keyed on the exact title alone
        ; this janitor never fired once on the build in the logs, where the
        ; overlay is titled "Firestone" -- so the birth cloak and park applied
        ; to it a few lines earlier were never undone. See
        ; CFG.fsOverlayShapeDetect.
        if IsFirestoneInGameOverlay(hwnd, title) {
            if _fsAlphaApplied.Has(hwnd)
                _RemoveFSAlphaShield(hwnd)
            _FSReleaseSurface(hwnd)
            ; If the birth-hide took it off screen, put it back NOW: the
            ; in-game overlay must be visible.
            if _fsBirthHidden.Has(hwnd) {
                _MapDrop(_fsBirthHidden, hwnd)
                _FSShowIfNotPopup(hwnd)
            }
            return
        }

        ; ---- Title-settle janitor (NAMECHANGE only) ----
        ; A window whose title settles to something we do NOT suppress gets
        ; its shield unwound AND its birth cloak released, the moment it
        ; proves benign. "Firestone - Loading" is deliberately excluded:
        ; its own suppressors keep it cloaked+hidden through the launch.
        if (event = EV_NAMECHANGE) {
            if (title != "" && title != "Firestone") {
                ; ALLOW-LIST. The old test was "not a suppression title and not
                ; Firestone - Loading => benign => uncloak and SHOW it". That
                ; is the event-speed twin of the birth-hide sweep's bug: any
                ; Overwolf window that settled to an unrecognised title -- e.g.
                ; "OverWolf Server" -- was classified benign and deliberately
                ; put on screen. Only titles on CFG.fsVisibleTitles are
                ; released now; everything else stays suppressed while locked.
                ; ── AND NEVER RELEASE THE LOADING / NOTIFICATION WINDOW ──
                ; FSShouldSuppress returns FALSE while unlocked, so on an
                ; unlocked F3 this branch treated every Firestone window as
                ; benign, released it and SHOWED it -- including the
                ; "Your abilities are ready!" popup, which wears the
                ; "Firestone - Loading" title on current builds. That is
                ; precisely "F3 opens the Firestone popup": nothing was
                ; summoning a hidden window, this was releasing one it could
                ; not name.
                ;
                ; The Loading title has its own owner (the loading pipeline and
                ; the notification closer) in every lock state, and this
                ; janitor has no business handing it back in either.
                if (title != "Firestone - Loading"
                 && (!FSShouldSuppress(title) || title = "Firestone - Overlays")) {
                    if _fsAlphaApplied.Has(hwnd)
                        _RemoveFSAlphaShield(hwnd)
                    _FSReleaseSurface(hwnd)     ; unpark, then uncloak
                    if _fsBirthHidden.Has(hwnd) {
                        _MapDrop(_fsBirthHidden, hwnd)
                        _FSShowIfNotPopup(hwnd)
                    }
                } else {
                    ; Suppressed. This branch fires the INSTANT the window
                    ; titles itself "Firestone - Main" -- which for CEF is
                    ; before first paint, not after it. It used to SW_HIDE
                    ; unconditionally right there, which is hide number four
                    ; of five and the one that lands at the worst possible
                    ; moment. Funnelled now: cold policy until proven, the
                    ; Battlegrounds exit afterwards.
                    _MapDrop(_fsBirthHidden, hwnd)
                    try _FSSuppressSurface(hwnd, title, false)
                }
            }
            return
        }

        ; Everything below is CREATE/SHOW policy only.

        ; ---- Firestone - Loading ----
        ; THIS IS FIRESTONE-MAIN'S OWN HWND. The Loading window retitles into
        ; Main in place -- the same-HWND retitle case documented throughout
        ; this script. So every "harmless" suppression aimed at the loading
        ; popup was in fact being applied to the window that becomes Main,
        ; during the coldest seconds of its life. Funnelled.
        if (title = "Firestone - Loading") {
            try _FSSuppressSurface(hwnd, title, false)
            return
        }

        if (title = "" || title = "Firestone") {
            ; Pre-title. Also Main's HWND, earlier still. Same treatment.
            if (_EarlyOWCloakActive || State.fsMainLocked) {
                if !_fsBirthHidden.Has(hwnd)
                    _fsBirthHidden[hwnd] := A_TickCount
                try _FSSuppressSurface(hwnd, title, false)
                return
            }
        }

        ; ── THE LOADING SPLASH IS SUPPRESSED WHETHER OR NOT F2 IS RUNNING ───
        ;
        ; THE FLICKER THIS FIXES. Everything below this point is gated on a
        ; launch being in flight -- _EarlyOWCloakActive, State.f2Active,
        ; State.fsMainLocked. That is right for the broad pre-title matcher,
        ; which is deliberately loose and must not be let near a window the
        ; user asked for. It was also, accidentally, the only thing standing
        ; between the user and a splash that paints, because Firestone starts
        ; its loading window in three situations and only ONE of them is an F2:
        ;
        ;   * F2                       -- gated true, suppressed, no flicker
        ;   * Overwolf self-restarts for an update
        ;   * FirestoneHealthCheck restarts a dead Firestone, or the user
        ;     clicks the tray icon
        ;
        ; In the last two the gates are all false, nothing acts at CREATE, and
        ; the splash is left to the steady-state sweep at fsLoadingIdleMs --
        ; 500 ms, which is thirty frames of a 440x590 splash on screen. The log
        ; named it exactly: "FS-LOADING identified ... untitled=0ms visible=1
        ; cloaked=0" -- visible on the first tick that could see it.
        ;
        ; ── AND WHY THIS IS A BARE CLOAK, NOT A CALL INTO THE FUNNEL ────────
        ;
        ; THIS BRANCH MUST NOT NAME THE WINDOW. It briefly did, passing the
        ; literal "Firestone - Loading" into _FSSuppressSurface so the funnel
        ; would treat it as the splash -- and that was a genuine hazard, for a
        ; reason worth stating so it is not reintroduced.
        ;
        ; The funnel records identity from the title it is HANDED, not from
        ; the window: a "Firestone - Loading" title puts the HWND straight into
        ; _fsMainCandidate. For a real splash that is correct and harmless. But
        ; CEF windows are routinely CREATEd tiny and resized before they are
        ; shown -- the comment in IsLikelyFirestoneLoadingEarlyHwnd says so in
        ; as many words -- so Firestone MAIN, in formation, can be sitting
        ; inside the 300-800px envelope at the instant this branch sees it.
        ; Labelling Main-in-formation as the splash is precisely the mistake
        ; that ends with the notification closer aiming a WM_CLOSE at the
        ; user's Firestone Main: _fsMainCandidate stops protecting a window
        ; once the launch is over, and the closer's structural guard is then
        ; satisfied by the OTHER Main window that already exists.
        ;
        ; A DWM cloak needs no identity to be safe. It is reversible, invisible
        ; to the application, asserts nothing about what the window is, and
        ; every path that later identifies the window -- the funnel, the
        ; EXEMPT release, the reveal -- undoes it in the normal way.
        ; _FSNoteBirthCloak hands it to FSBirthCloakReaper, so a window that
        ; turns out to be something else entirely is uncloaked by a janitor
        ; that already exists rather than by anything new here.
        ;
        ; So: kill the flash, claim nothing, and let the classifiers that RUN
        ; ON A SETTLED WINDOW decide what it actually is.
        if IsLikelyFirestoneLoadingPopupHwnd(hwnd) {
            try {
                _FSEnsureCloaked(hwnd)
                _FSNoteBirthCloak(hwnd)

                ; ── AND SW_HIDE IT, IF IT IS PROVABLY NOT MAIN ──────────────
                ; THIS IS THE LOADING FLICKER, AND THE CLOAK ABOVE CANNOT FIX
                ; IT ON ITS OWN.
                ;
                ; A DWM cloak is a REQUEST. This file says so in three other
                ; places, and it is most often declined for a window whose
                ; process is still starting -- which is precisely when the
                ; splash is born. So the splash gets a frame on screen, cloak
                ; or no cloak. SW_HIDE is not a request: it clears WS_VISIBLE
                ; synchronously and nothing can be composited afterwards.
                ;
                ; SW_HIDE is normally forbidden here because it is what stops
                ; a cold CEF window ever standing up a compositor -- see the
                ; note above _FSConcealMain. That objection does not apply to
                ; THIS window, because this window is going to be CLOSED. A
                ; renderer that never paints is only a problem for a surface
                ; that has to come back, and the splash never does.
                ;
                ; The whole risk is therefore "is this actually the splash, or
                ; is it Main in formation wearing the same bare title inside
                ; the same size envelope?" -- and that has an exact answer
                ; rather than a heuristic one: if a SEPARATE window is already
                ; titled "Firestone - Main", this one cannot be Main. When
                ; that is not yet provable the window keeps the cloak alone,
                ; which is reversible and safe, and the funnel decides later.
                if _FSMainWindowPresent(hwnd)
                    _FSHideWindow(hwnd, "OWCreateHookProc")   ; SW_HIDE
            }
            return
        }

        ; ---- Fallback: early loading‑popup shape matcher (launch phases only) ─
        if !(_EarlyOWCloakActive || State.f2Active)
            return
        if !IsLikelyFirestoneLoadingEarlyHwnd(hwnd)
            return

        ; Concealment is delegated to the single primitive. Note that
        ; ShowWindow(SW_MINIMIZE) on a hidden window RE-SHOWS it, minimised, so a
        ; hide/minimise pair is a visibility flip rather than a concealment -- and a
        ; sustained flip on a cold Chromium window prevents it ever painting.
        try {
            _FSSuppressSurface(hwnd, "", false)
        } catch {
    } finally {
        DetectHiddenWindows prevDHW   ; Fast callback: never leak the setting
    }
}

; ── Firestone loading popup suppression ───────────────────────────────────────
; Handles the startup/loading popup in four stages:
;   • StartOWCreateHook / OWCreateHookProc — at EVENT_OBJECT_CREATE / SHOW,
;     cloaks early popup candidates; SW_HIDEs only the exact‑titled popup.
;   • EarlyOverwolfCloakTick — same policy on a 10ms poll.
;   • SuppressFirestoneLoadingTick — keeps only the exact titled loading popup
;     invisible once it has settled.
;   • KillFirestoneLoading — closes only the exact titled loading popup hwnd.

KillFirestoneLoading() {
    global State, _fsHiddenByUs, _fsPopupKilled, CFG
    global _fsWasMainTitled
    global _fsLoadingLeftLogged
    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(3)   ; exact match only

    popupStillExists := false
    fsMainTitled     := false   ; structural guard for the PS closer (below)

    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    tK := WinGetTitle("ahk_id " . h)
                    if (tK = "Firestone - Main")
                        fsMainTitled := true
                    if (tK != "Firestone - Loading")
                        continue

                    popupStillExists    := true
                    State.fsLoadingSeen := true

                    ; ── CLOSE THIS WINDOW. NOT "THE PROCESS'S MAIN WINDOW". ──
                    ;
                    ; THIS IS "FIRESTONE MAIN KEEPS GETTING CLOSED", AND IT WAS
                    ; A POWERSHELL SWEEP DOING IT.
                    ;
                    ; What used to run here fired a PowerShell command:
                    ;
                    ;   Get-Process | ForEach-Object { $_.Refresh();
                    ;     if ($_.MainWindowTitle -eq 'Firestone - Loading')
                    ;     { $_.CloseMainWindow() } }
                    ;
                    ; MainWindowTitle and CloseMainWindow are PROCESS-level:
                    ; they read and act on whichever window Windows currently
                    ; considers that process's main one. Overwolf.exe hosts
                    ; Firestone Main, Battlegrounds and this popup in ONE
                    ; process, so "close the process's main window" can land on
                    ; Firestone Main -- and the guard that was supposed to make
                    ; it safe only fired the sweep WHEN MAIN EXISTED, which is
                    ; exactly when Main can be that main window.
                    ;
                    ; It also explains why every FS-DESTROYED line insisted
                    ; "this script did NOT ask it to close". That verdict reads
                    ; _fsPopupKilled, an AutoHotkey ledger. A WM_CLOSE sent from
                    ; a separate PowerShell process was never recorded in it, so
                    ; the log gave the closer an alibi it had not earned, and
                    ; the real cause was ruled out for a long time on the
                    ; strength of it.
                    ;
                    ; The window is right here, already matched by an exact
                    ; title, so it is closed by HANDLE. PostMessage cannot go to
                    ; the wrong window, needs no second process, and races
                    ; nothing. The kill is recorded in the same ledger the
                    ; destroy verdict reads, so the log can never again claim
                    ; nobody asked.
                    ; ── AND IT MAY ONLY CLOSE A LOADING WINDOW THAT CANNOT BE
                    ;    MAIN. THIS GUARD WAS DROPPED, AND IT IS THE BUG. ─────
                    ;
                    ; THIS IS "SOMETHING IS STILL CLOSING IT WHEN HS OPENS".
                    ;
                    ; The Firestone start-up splash is titled "Firestone -
                    ; Loading" and it BECOMES Firestone Main IN PLACE, on the
                    ; SAME HWND. This function's own twin says so in as many
                    ; words, twenty lines below:
                    ;
                    ;   "On the same-HWND Loading->Main retitle this close lands
                    ;    on Firestone - Main"
                    ;
                    ; -- and that twin guards its close with `fsMainTitled`,
                    ; which means "a SEPARATE window is already called Main, so
                    ; this one cannot be it".
                    ;
                    ; This copy computed the same flag at the top of the
                    ; function -- the variable is even commented "structural
                    ; guard for the PS closer (below)" -- and then never read
                    ; it. When the PowerShell sweep was replaced with a close by
                    ; handle, the close came across and the guard did not. So
                    ; this posted WM_CLOSE to ANY window wearing the Loading
                    ; title, including the splash that was thirty milliseconds
                    ; from being the user's Firestone Main.
                    ;
                    ; WM_CLOSE IS POSTED, NOT SENT. It sits in the window's
                    ; queue. The retitle happens in that gap, and the close is
                    ; then processed by a window that is now Main. Every
                    ; FS-DESTROYED line called it "asked to close" only if the
                    ; hwnd was in the ledger -- and it was, which is why the
                    ; trace showed a close nobody could account for.
                    ;
                    ; The guard is asked HERE, at the moment of closing, rather
                    ; than accumulated during the loop: the loop visits windows
                    ; in arbitrary order, so a flag set while iterating is true
                    ; or false depending on which window came first.
                    ; _FSMainWindowPresent excludes this hwnd by design, so it
                    ; answers exactly the question that matters -- is there
                    ; ANOTHER window that is already Main?
                    ; ── CLOSED ON SIGHT, BY WINDOW CLASS ────────────────────
                    ; The guard that used to sit here waited for a SEPARATE
                    ; Firestone Main to exist first, on the belief -- written
                    ; into the comment above -- that the splash "BECOMES
                    ; Firestone Main IN PLACE, on the SAME HWND".
                    ;
                    ; THAT IS NOT TRUE, and it is why the popup was unkillable.
                    ; Measured 2026-09-06 with both windows alive at once:
                    ;
                    ;   Firestone - Loading   HwndWrapper[Overwolf.exe;UI;...]
                    ;   Firestone - Main      WindowsForms10.Window.8.app...
                    ;
                    ; Two different handles built on two different toolkits.
                    ; A WPF HwndWrapper window cannot retitle into a WinForms
                    ; one; Overwolf creates and destroys them separately. So
                    ; there is nothing to wait for: a Loading window hosted in
                    ; HwndWrapper is a splash, now and always, and closing it
                    ; can never reach Main.
                    ;
                    ; Class is read by handle, so this cannot land on the wrong
                    ; window, and _fsWasMainTitled is still honoured so a window
                    ; that has ever carried the Main title is never touched.
                    kCls := ""
                    try kCls := WinGetClass("ahk_id " . h)
                    isSplashHost := (SubStr(kCls, 1, 12) = "HwndWrapper[")
                    if (CFG.fsCloseLoadingPopup
                     && !_fsPopupKilled.Has(h)
                     && !_fsWasMainTitled.Has(h)
                     && isSplashHost) {
                        _fsPopupKilled[h] := A_TickCount
                        _FSHideWindow(h, "KillFirestoneLoading")   ; hidden first
                        _CloseWindowAsync(h)                        ; then closed
                        _FSLog("FS-LOADING closed the loading popup hwnd=" . h
                             . " class=" . kCls . " -- hidden, then WM_CLOSE"
                             . " posted to this handle only. It is a WPF"
                             . " HwndWrapper host, and Firestone Main is a"
                             . " WinForms window, so this one can never become"
                             . " Main and there was never anything to wait for.")
                    } else if (CFG.fsCloseLoadingPopup && !_fsPopupKilled.Has(h)
                            && !_fsLoadingLeftLogged.Has(h)) {
                        _fsLoadingLeftLogged[h] := true
                        _FSLog("FS-LOADING left the loading window alone hwnd=" . h
                             . " class=" . kCls . " -- it is NOT a WPF"
                             . " HwndWrapper host, so it is not the splash this"
                             . " path owns. Bounded to one line per window.")
                    }

                    ; SUPPRESSION REMOVED FROM THIS FUNCTION ENTIRELY.
                    ;
                    ; This was one half of the storm. KillFirestoneLoading and
                    ; SuppressFirestoneLoadingTick were TWO IDENTICAL 10 ms
                    ; timers, both doing cloak -> SW_HIDE -> SW_MINIMIZE on the
                    ; same HWND -- and SW_MINIMIZE on a hidden window re-shows
                    ; it. Two hundred visibility flips per second, for up to
                    ; sixty seconds, on the exact HWND that becomes
                    ; Firestone - Main, while Chromium is trying to bring up
                    ; its compositor for the first time.
                    ;
                    ; SuppressFirestoneLoadingTick is now the sole suppressor
                    ; and it funnels through _FSSuppressSurface. This function
                    ; keeps only its bookkeeping and its self-stop, and its
                    ; timer has been dropped from 10 ms to 250 ms to match.
                } catch {
                }
            }
        }

        ; THE POWERSHELL CLOSER THAT USED TO RUN HERE IS GONE.
        ;
        ; It reasoned that firing only while a real "Firestone - Main" existed
        ; made CloseMainWindow structurally safe, because the loading window
        ; could no longer retitle itself into Main. That reasoning inverted the
        ; risk. CloseMainWindow acts on whichever window the PROCESS currently
        ; calls its main one, and Overwolf hosts Main, Battlegrounds and this
        ; popup in a single process -- so requiring Main to exist guaranteed
        ; there was a Main available to be closed by mistake.
        ;
        ; The popup is now closed by handle, in the loop above, at the moment
        ; it is identified. See the comment there for the whole story.

        ; ── THE FAST SWEEP STANDS DOWN ONLY WHEN THE POPUP IS GONE ──────────
        ;
        ; A second condition was added here -- stand down as soon as a real
        ; Main exists, on the grounds that the launch had succeeded and there
        ; was nothing left to race. It caused a visible flicker and has been
        ; taken out.
        ;
        ; Firestone opens its loading/splash window LATER as well, not only
        ; during the launch. Measured, twenty-three seconds after that
        ; stand-down fired:
        ;
        ;   21:26:17 FS-LOADING standing the fast sweep down -- Main is open
        ;   21:26:40 FS-ONSCREEN "Firestone" 440x590 -- VISIBLE
        ;   21:26:40 FS-LOADING identified untitled=0ms visible=1
        ;
        ; visible=1 means the window was already on screen when it was caught.
        ; At the idle cadence the sweep is simply too slow to get there first,
        ; and the user sees the splash -- which is the one thing this sweep
        ; exists to prevent.
        ;
        ; Saving sweep ticks is worth nothing if it costs a frame on screen.
        ; The original condition stays: the sweep stops when a loading window
        ; has been seen and has gone, which is the only moment it is genuinely
        ; finished.
        if (State.fsLoadingSeen && !popupStillExists)
            StopKillFirestoneLoading()
    }
    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}

; Closes any already‑open Firestone - Loading popup immediately.
KillFirestoneLoadingExisting() {
    global CFG
    prevDHW := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        ; Structural guard: a bare "Firestone - Loading" window may only be closed
        ; while a window titled exactly "Firestone - Main" exists simultaneously. Until
        ; then the Loading window could still retitle into the forming Main, so it is
        ; only concealed -- which is all the user could perceive either way.
        fsMainTitled := false
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if (WinGetTitle("ahk_id " . h) == "Firestone - Main")
                        fsMainTitled := true
                }
            }
        }
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if (WinGetTitle("ahk_id " . h) == "Firestone - Loading") {
                        ; Same rule as KillFirestoneLoading: the splash is a WPF
                        ; HwndWrapper host and Main is WinForms, so they are
                        ; never the same window and there is no retitle to fear.
                        ; The "same-HWND Loading->Main retitle" this comment used
                        ; to cite was measured false on 2026-09-06 with both
                        ; windows alive at once.
                        eCls := ""
                        try eCls := WinGetClass("ahk_id " . h)
                        if (CFG.fsCloseLoadingPopup
                         && SubStr(eCls, 1, 12) = "HwndWrapper[") {
                            _FSHideWindow(h, "KillFirestoneLoadingExisting")
                            _CloseWindowAsync(h)
                        }
                    }
                }
            }
        }
    }
    DetectHiddenWindows prevDHW
}


; First sighting of every Overwolf top-level window, used only by the
; diagnostic below. See the FS-LOADING log line for what it answers.
global _fsOWFirstSeen := Map()

; ── "Why is that window still on screen?" ────────────────────────────────────
; Records any Firestone-family window that is VISIBLE while the lock is on and
; nothing has concealed it. That combination should not occur, so a line here
; is always a bug -- and it carries the four facts needed to identify which
; one: the title, the size, the extended styles, and whether the lock was
; actually on at the time.
;
; This exists because the last three reports of "it was not hidden" each had
; several plausible explanations and no way to choose between them. Once per
; window, so a 10ms sweep cannot flood the log.
global _fsVisibleLogged := Map()
_FSLogVisibleSurface(hwnd) {
    global _fsVisibleLogged, State, _fsParked
    try {
        if _fsVisibleLogged.Has(hwnd)
            return

        ; ── WITH THE LOCK OFF, VISIBLE IS THE CORRECT STATE ─────────────────
        ; This whole function asks "why is a Firestone window on screen when it
        ; should be concealed". With F3 unlocked there is no "should" -- the
        ; user asked to see it. Without this the line fired the instant F3
        ; revealed Firestone, reporting the reveal working as if it were a
        ; fault, and saying locked=0 in the same breath:
        ;
        ;   FS-VISIBLE unconcealed Firestone window ... locked=0
        ;   -- this window should have been concealed and was not
        ;
        ; A log that cries wolf is worse than no log, and this one is meant to
        ; be read by strangers sending us their logs.
        if !State.fsMainLocked
            return

        if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            return
        title := WinGetTitle("ahk_id " . hwnd)
        if (title = "" || !InStr(title, "Firestone"))
            return
        if IsFirestoneInGameOverlay(hwnd, title)  ; supposed to be visible
            return
        if IsFSNeverConcealTitle(title)          ; Settings: also allowed
            return                               ; to be visible
        if IsWindowCloakedDWM(hwnd)              ; concealed after all
            return
        ; A PARKED window is off the virtual desktop and cannot be seen, but it
        ; is still WS_VISIBLE and may not be cloaked -- so without this test
        ; every parked window produced a "should have been concealed and was
        ; not" line. That is a false alarm, and a diagnostic that cries wolf is
        ; worse than no diagnostic: the genuine occurrences of this line were
        ; buried among them.
        if _fsParked.Has(hwnd)
            return
        ; ── REPAIR IT, DO NOT JUST COMPLAIN ABOUT IT ────────────────────────
        ; This line existed for a long time as pure diagnostics: it says a
        ; Firestone window is on screen that should not be, and then leaves it
        ; there. Every occurrence of it in the log IS a frame the user saw.
        ;
        ; The reason it only reported was the belief that hiding a window in
        ; this state would kill it. That has now been measured false on the
        ; exact window it was feared for, so the detector can close the hole it
        ; was written to measure.
        ;
        ; It repairs through _FSBlanketHide rather than doing its own hiding,
        ; so an escaped window is classified the same way as every other one --
        ; the in-game overlay is refused here exactly as it is everywhere else.
        ; Only while the lock is armed; with the lock off these windows are
        ; supposed to be visible and this whole function is a no-op anyway.
        if (State.fsMainLocked && _FSBlanketHide(hwnd)) {
            _fsVisibleLogged[hwnd] := true
            _FSLog("FS-VISIBLE caught an unconcealed Firestone window on screen"
                 . " hwnd=" . hwnd . " title=`"" . title . "`" -- concealed it"
                 . " on the spot rather than leaving a frame showing")
            return
        }

        _fsVisibleLogged[hwnd] := true
        w := 0, h := 0, ex := 0, st := 0
        try WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        try ex := WinGetExStyle("ahk_id " . hwnd)
        try st := WinGetStyle("ahk_id " . hwnd)
        _FSLog("FS-VISIBLE unconcealed Firestone window hwnd=" . hwnd
             . " title=`"" . title . "`" size=" . w . "x" . h
             . " ex=" . Format("0x{:X}", ex) . " style=" . Format("0x{:X}", st)
             . " locked=" . (State.fsMainLocked ? 1 : 0)
             . " -- this window should have been concealed and was not")
    }
}

; Is any Overwolf process alive? Cached for a second.
;
; ProcessExist snapshots the entire system process table. The sweeps below run
; at 10-20Hz for the whole session, and on a machine where Overwolf is not
; running -- before the first F2, after F4, or for someone who has Firestone
; installed but not open -- every one of those ticks was enumerating every
; top-level window on the desktop and resolving a process name for each, to
; discover there was nothing to do. One second of staleness costs nothing: the
; launch path arms its own fast instance directly rather than waiting for this.
; Does this process exist? Cached per name for half a second.
;
; Same reasoning as _OverwolfRunningCached, generalised: several sweeps run at
; 10-15 ms for a minute or two either side of a launch, and a WinGetList that
; matches on ahk_exe resolves a process name for every top-level window on the
; desktop. When the process it is looking for does not exist, all of that work
; produces an empty list. One cached ProcessExist answers the same question for
; a fraction of the cost, and half a second of staleness is far shorter than
; anything these sweeps are racing.
; A NEGATIVE ANSWER IS NOT CACHED. That asymmetry is the whole design.
;
; Caching "it is not running" is the dangerous half: the process this guards
; against is started BY this script, moments after the last check, and a cached
; "no" would blind the sweep for the first half-second of the splash's life --
; precisely the window it exists to cover. Caching "it is running" is free,
; because the answer only gets staler in the harmless direction.
;
; So a miss costs one ProcessExist per tick, which is still enormously cheaper
; than the desktop-wide window enumeration it replaces, and a hit costs nothing.
_ProcExistCached(exe) {
    static seen := Map()
    static miss := Map()

    e := seen.Get(exe, 0)
    if (e && A_TickCount - e.at < 500)
        return e.val

    ; ── NEGATIVES ARE CACHED TOO NOW, BRIEFLY, AND THIS IS WHY ──────────────
    ; The original policy was positives-only, deliberately: a process that has
    ; just started should be noticed at once. That reasoning is sound for the
    ; sweeps it was written for, which ask about a process they expect to be
    ; running.
    ;
    ; It became actively harmful when callers started asking about a process
    ; that is ABSENT, at high frequency. ProcessExist is a full
    ; CreateToolhelp32Snapshot walk of every process on the machine, and it
    ; runs on AutoHotkey's single thread -- so with no negative cache,
    ; the old coast-rate logic asking "is Hearthstone up yet?" on every 50 ms sweep tick, and
    ; the window hook asking "is the tracker up yet?" on every window event,
    ; were together taking dozens of kernel-wide process snapshots per second
    ; during the Battle.net launch. That is precisely when HSCloakTick needs a
    ; clean 10 ms cadence to catch the launcher's boot splash and login shell
    ; at birth, and it is why those windows intermittently appeared unhidden
    ; and why the minimize sequence sometimes fired early.
    ;
    ; 120 ms is short enough that nothing waits perceptibly longer to notice a
    ; process appearing -- every consumer of this either polls again within a
    ; frame or two, or is bounded by a much larger timeout -- and long enough
    ; to collapse a storm of identical questions into one answer.
    m := miss.Get(exe, 0)
    if (m && A_TickCount - m < 120)
        return 0

    v := ProcessExist(exe)
    if v {
        seen[exe] := {at: A_TickCount, val: v}
        _MapDrop(miss, exe)
    } else {
        miss[exe] := A_TickCount
        if e
            _MapDrop(seen, exe)
    }
    return v
}

; ── The Overwolf PIDs, cached, for the hook's zero-latency birth cloak ───────
;
; WHY THIS EXISTS: EVERY MICROSECOND BEFORE THE CLOAK IS A CHANCE TO PAINT.
;
; The window event hook is WINEVENT_OUTOFCONTEXT, so an event is queued to this
; process and handled some time after the window actually appeared. Whatever
; that delay is, it is the floor -- but everything the hook does BEFORE it
; cloaks is added on top of it, and the first thing it did was
; WinGetProcessName: an OpenProcess, a QueryFullProcessImageNameW and a
; CloseHandle, on the critical path of every single event.
;
; GetWindowThreadProcessId is a single non-blocking call into win32k with no
; handle to open, and comparing two integers costs nothing. So the birth cloak
; can now happen on the second line of the hook instead of the twentieth.
;
; Refreshed lazily and cheaply. A PID that has just appeared (Overwolf started
; mid-session) is picked up within refreshMs; a stale PID is harmless because
; the worst it can do is fail to match a window that then takes the slower
; original path below.
global _owPidsAt := 0
global _owPids   := Map()
; 400 ms, not 2000. The cache holds raw PIDs and _IsOverwolfPid compares
; integers, so a PID recycled inside the cache window means CloakWindow lands
; on a foreign process's newborn -- possibly Hearthstone's or Battle.net's --
; and the birth-cloak reaper only releases it six seconds later. Windows
; recycles PIDs aggressively, and F2's restart path closes and starts processes
; by design. A shorter window bounds the exposure; the reaper bounds the damage.
_OverwolfPids(refreshMs := 400) {
    global _owPidsAt, _owPids
    ; A cache built while Overwolf was not running holds an EMPTY map, and an
    ; empty map must never be trusted: it would blind the hook for 400ms across
    ; exactly the moment Overwolf starts and Main is created.
    if (_owPidsAt && _owPids.Count && A_TickCount - _owPidsAt < refreshMs)
        return _owPids
    _owPidsAt := A_TickCount
    m := Map()
    for exe in ["Overwolf.exe", "OverwolfBrowser.exe", "OverwolfHelper.exe"] {
        pid := 0
        try pid := ProcessExist(exe)
        if pid
            m[pid] := true
    }
    ; ProcessExist returns ONE pid per name and Overwolf runs several
    ; OverwolfBrowser processes. Missing one only means that window takes the
    ; slower path, never that it is mishandled -- so this stays a fast hint
    ; rather than an enumeration of every process on the machine.
    _owPids := m
    return _owPids
}

; ── The Blizzard family's PIDs, for the same zero-latency reason ─────────────
; pid -> exe name. Battle.net's splash, login shell, maintenance window, Agent
; and Helper are concealed with a plain SW_HIDE (they are never cloaked -- see
; _HideBlizzWindow), and that call is correct. What was slow was REACHING it:
; the hook resolved the window's executable with WinGetProcessName -- an
; OpenProcess round-trip -- before any Battle.net branch could run, on the
; critical path of every event during the noisiest part of a launch.
;
; A PID compare needs no handle. Same trick as _OverwolfPids, and the same
; short TTL for the same reason: these are raw PIDs and Windows recycles them.
global _bzPidsAt := 0
global _bzPids   := Map()
_BlizzPids(refreshMs := 400) {
    global _bzPidsAt, _bzPids
    if (_bzPidsAt && A_TickCount - _bzPidsAt < refreshMs)
        return _bzPids
    _bzPidsAt := A_TickCount
    m := Map()
    for exe in ["Battle.net.exe", "Agent.exe", "Battle.net Helper.exe"] {
        pid := 0
        try pid := ProcessExist(exe)
        if pid
            m[pid] := exe
    }
    _bzPids := m
    return _bzPids
}

_IsOverwolfPid(pid, hwnd := 0) {
    global _owPids, _owPidsAt
    if !pid
        return false
    if _OverwolfPids().Has(pid)
        return true
    ; ── SELF-HEALING MISS PATH ──────────────────────────────────────────────
    ; The cached map is built with ProcessExist, which returns only the FIRST
    ; pid for a name. Overwolf runs SIX OverwolfBrowser.exe processes, so five
    ; of them were never in the map and every window they own was invisible to
    ; this script -- permanently, not just at start-up. The map is also cached
    ; for 400ms, so one built a moment before Overwolf started stayed empty
    ; through exactly the window in which Firestone Main is created.
    ;
    ; Measured 2026-09-06: FS-EXPOSURE reported Main "concealed at an unknown
    ; age (creation not recorded), wasVisible=1" -- EV_CREATE never saw the
    ; window, so the conceal could not run until the sweep found it already on
    ; screen. That is the flicker.
    ;
    ; So on a miss, ask the WINDOW what process owns it. One call, only when
    ; the fast path fails, and the answer is cached so it is asked once per
    ; process rather than once per window.
    if !hwnd
        return false
    exe := ""
    try exe := WinGetProcessName("ahk_id " . hwnd)
    if (exe = "")
        return false
    if !(exe = "Overwolf.exe" || exe = "OverwolfBrowser.exe"
      || exe = "OverwolfHelper.exe")
        return false
    _owPids[pid] := true      ; remember it: this pid is Overwolf's from now on
    return true
}

_OverwolfRunningCached(bust := false) {
    static primed := false, last := 0, val := false
    if bust {
        primed := false
        return val
    }
    if (primed && A_TickCount - last < 1000)
        return val
    primed := true
    last   := A_TickCount
    ; Every executable the sweeps this guards actually enumerate --
    ; CFG.fsFamilyExes plus the launcher's own splash process. A name missing
    ; here would silently switch off suppression for the windows that name owns.
    val := (ProcessExist("Overwolf.exe")       || ProcessExist("OverwolfBrowser.exe")
         || ProcessExist("OverwolfHelper.exe") || ProcessExist("OverwolfLauncher.exe"))
    return val
}

SuppressFirestoneLoadingTick() {
    global State, _fsHiddenByUs, _fsOWFirstSeen
    ; The one gate this sweep gets. It was briefly also stood down once
    ; Firestone Main had opened, on the reasoning that the loading splash only
    ; appears once -- which is wrong twice over: Overwolf restarts itself for
    ; updates, and FirestoneHealthCheck restarts a crashed Firestone, both
    ; outside any launch. This sweep is the ONLY steady-state suppressor for
    ; that splash (it is an owned window, so the main sweep skips it as a
    ; helper), so standing it down means the splash paints. It stays on.
    if !_OverwolfRunningCached()
        return
    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(3)

    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    ; Stamp every Overwolf window the first time this sweep
                    ; sees it, titled or not. Costs one Map lookup per window
                    ; per tick and answers the one question the log could not:
                    ; how long the loading window existed BEFORE it was
                    ; identifiable.
                    if !_fsOWFirstSeen.Has(h)
                        _fsOWFirstSeen[h] := A_TickCount

                    isPopup := IsLikelyFirestoneLoadingPopupHwnd(h)
                    if !isPopup {
                        _FSLogVisibleSurface(h)   ; diagnostic only
                        continue
                    }

                    ; ---- WHY THIS LINE EXISTS ----
                    ; This sweep can only match "Firestone - Loading" by exact
                    ; title, so it is blind to the window for as long as the
                    ; window is untitled. If the splash is ever visible before
                    ; suppression, there are exactly two possible causes and
                    ; they need opposite fixes: either the funnel declined to
                    ; act on it (FS-EXEMPT names that), or it was on screen
                    ; with no title for long enough to be seen (this names
                    ; that). A large untitled= value here is the second.
                    ; Logged once per launch, on the first identification.
                    if !State.fsLoadingSeen
                        _FSLog("FS-LOADING identified hwnd=" . h
                             . " untitled=" . (A_TickCount - _fsOWFirstSeen.Get(h, A_TickCount)) . "ms"
                             . " visible=" . (DllCall("user32\IsWindowVisible", "Ptr", h) ? 1 : 0)
                             . " cloaked=" . (IsWindowCloakedDWM(h) ? 1 : 0))

                    State.fsLoadingSeen := true

                    ; SOLE OWNER of loading-window suppression, and funnelled.
                    ; The old body was cloak -> SW_HIDE -> SW_MINIMIZE every
                    ; tick, unconditionally, with an identical copy of itself
                    ; running in KillFirestoneLoading at the same rate. The
                    ; SW_MINIMIZE re-showed what the SW_HIDE had just hidden,
                    ; so the pair was a visibility flip rather than a hide, and
                    ; this HWND is the one that becomes Firestone - Main.
                    ;
                    ; The funnel is idempotent: the cloak is arbitrated through
                    ; _cloakState, the park is gated on _fsParked, and the warm
                    ; hide is skipped outright when the window is already
                    ; invisible. Running it at 10 ms is now free.
                    _FSSuppressSurface(h, "Firestone - Loading", true)
                } catch {
                }
            }
        }
    }

    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}

; Run the exact‑title popup suppression/close loop at 10ms intervals for up to
; 60s, while simultaneously keeping the popup suppression burst active.
StartKillFirestoneLoading() {
    global State, _fsPopupWatchDone, _fsOWFirstSeen, _fsExemptLogged, _fsVisibleLogged
    State.fsLoadingSeen := false
    ; Fresh measurement per launch. Both maps are diagnostic ledgers scoped to
    ; one Firestone start-up; carrying entries over from a previous F2 would
    ; report an untitled= age measured from the wrong process.
    _fsOWFirstSeen       := Map()
    _fsExemptLogged      := Map()
    _fsVisibleLogged     := Map()
    _fsPopupWatchDone := false   ; popup lifecycle open — early cloak waits on it
    SuppressFirestoneLoadingTick()
    KillFirestoneLoading()
    SetTimer(SuppressFirestoneLoadingTick, 10)
    ; KillFirestoneLoading now runs at 50 ms to close the loading popup faster.
    ; It no longer suppresses anything -- it only does bookkeeping and the
    ; PowerShell close (now enabled by default via fsCloseLoadingPopup=true).
    SetTimer(KillFirestoneLoading, 50)
    SetTimer(StopKillFirestoneLoading, -60000)
}

StopKillFirestoneLoading(*) {
    global State, _fsPopupWatchDone, _EarlyOWCloakActive, CFG
    ; ── CANCEL THE PENDING ONE-SHOT FIRST ──────────────────────────────────
    ; StartKillFirestoneLoading arms this at -60000. It is now also reached
    ; EARLY -- when the loading window resolves, or when Main is up and the
    ; fast sweep has nothing left to race -- so the one-shot can still be in
    ; flight afterwards. If a second Firestone start-up begins in that gap and
    ; raises the sweep back to its fast cadence, the stale timer fires and
    ; drops it to idle again, leaving the new loading window watched at 500ms
    ; instead of 10ms. Whether that matters depends purely on how far apart
    ; the two launches were, which is the definition of inconsistent.
    ;
    ; The same hazard is already handled where the tracker stands Firestone
    ; down; it belongs here too, so every caller gets it rather than the one
    ; that remembered.
    SetTimer(StopKillFirestoneLoading, 0)
    ; ── BACK TO THE STEADY RATE, NOT OFF ────────────────────────────────────
    ; This set the loading sweep to 0. Startup arms it at 100 ms as an
    ; always-on guard (a Firestone the user starts by hand, a loading window
    ; that appears without an F2), and the first F2 raises it to 10 ms for the
    ; launch -- so switching it OFF here meant that after the first F2 of a
    ; session the always-on guard was gone for good, and a later Firestone
    ; restart had nothing watching its loading window.
    SetTimer(SuppressFirestoneLoadingTick, CFG.fsLoadingIdleMs)
    SetTimer(KillFirestoneLoading, 0)
    State.fsLoadingSeen := false
    _fsPopupWatchDone := true
    ; NOTE: early Overwolf cloak is NOT stopped here; it owns its own lifetime.
}

; ══════════════════════════════════════════════════════════════════════════════
;  FIRESTONE'S OWN SHOW/HIDE HOTKEYS
; ══════════════════════════════════════════════════════════════════════════════
;
; WHY THIS EXISTS. Firestone closes its desktop "Firestone - Main" window a few
; seconds after the game starts, and does not bring it back. That was measured
; directly, with this script not running and nothing touching the window:
;
;   untouched            DIED at +7906ms
;   DWM cloak            DIED at +7922ms
;   parked off-desktop   DIED at +7703ms
;   SW_HIDE              DIED at +8000ms
;   minimize             DIED at +7609ms
;   alpha 0 (composited) DIED at +7688ms
;
; Six concealment methods, including doing nothing at all, all dying within
; 300ms of each other. Nothing this script does to that window matters, and a
; follow-up confirmed Firestone does not rebuild it -- it gives up.
;
; That is not a bug to defeat. It is how the app works: in-game it expects you
; to use its OVERLAY, and it ships hotkeys to toggle exactly that. Its own
; manifest declares them:
;
;   "collection"    -> "Show/hide main window"          default Alt+C
;   "battlegrounds" -> "Show/hide battlegrounds window" default Alt+B
;
; So in-game, F3 asks Firestone to show its window instead of this script
; wrestling a window Firestone is about to close. The concealment system is
; unchanged and still does the job it was always good at -- keeping Firestone's
; desktop windows off the screen during the launch.
;
; READ, NOT HARDCODED. The defaults come from the installed manifest, so a
; Firestone update that changes them is picked up automatically. The newest
; installed version wins, matching how Overwolf loads the app.
;
; A REBIND CANNOT BE READ. Overwolf keeps user hotkey overrides in a LevelDB
; store that is open while it runs; there is no supported way to read it and
; certainly no safe way to write it -- editing another application's live
; settings database risks losing every setting the user has. So the binding is
; never assumed to be correct: the caller SENDS it and then CHECKS whether
; anything actually happened.
; ── READ THE USER'S OWN BINDING, IF THEY CHANGED IT ─────────────────────────
;
; Overwolf keeps rebound hotkeys in a LevelDB store at
; %LOCALAPPDATA%\Overwolf\Settings\game_settings.db, as JSON fragments inside
; the table files. A real entry looks like this, read straight out of one:
;
;   "showhide_MetaTFT","title":"Show ... Window","virtualKeycode":68,
;   "modifiers":41,"extension-uid":"aheglebeeekjdnkljmpngplhpedgejncjhojnndh"
;
; So each binding carries the key, its modifiers, and the app it belongs to.
; When nothing has been rebound the array is simply empty -- "hotkeys":[] --
; which is the common case and the one that matters most: finding nothing here
; is a definite answer, not a failure, and the manifest default is then right.
;
; THIS IS DELIBERATELY DISTRUSTFUL OF ITSELF. It is scraping an undocumented
; binary format that Overwolf can change without warning, and a wrong answer
; means sending the wrong keystroke into somebody's game. So it only returns a
; binding when it can see the app id, the hotkey's name and a plausible key
; code together in one fragment. Anything less returns "" and the caller uses
; the published default -- which is then still verified before being trusted.
;
; TWO KNOWN LIMITS, both covered by that verification:
;   * The live .log file is LOCKED while Overwolf runs, so a rebind made in
;     the current Overwolf session may not be visible until it restarts.
;   * The store is log-structured, so an old value can still be present; the
;     LAST match wins, which is the newest.
_FSReadUserHotkey(which) {
    static VKNAME := ""
    try {
        appId := GetFirestoneAppId()
        if (appId = "")
            return ""
        dir := EnvGet("LOCALAPPDATA") . "\Overwolf\Settings\game_settings.db"
        if !DirExist(dir)
            return ""

        blob := ""
        loop files dir . "\*.*" {
            if !(A_LoopFileExt = "ldb" || A_LoopFileExt = "log")
                continue
            try blob .= FileRead(A_LoopFileFullPath, "RAW-CP0")   ; locked files throw; skipped
        }
        if (blob = "")
            return ""

        ; Every binding fragment, newest last.
        best := ""
        pos := 1
        while (pos := RegExMatch(blob, 'i)"virtualKeycode"\s*:\s*(\d+)', &m, pos)) {
            lo  := (pos - 400 < 1) ? 1 : pos - 400
            ctx := SubStr(blob, lo, 800)
            pos += m.Len(0)
            if !InStr(ctx, appId)
                continue
            if !InStr(ctx, which)                 ; "collection" / "battlegrounds"
                continue
            vk := m[1] + 0
            key := _FSVkToName(vk)
            if (key = "")
                continue                          ; unknown key: refuse to guess
            mods := ""
            if RegExMatch(ctx, 'i)"modifiers"\s*:\s*(\d+)', &mm)
                mods := _FSOwModsToSpec(mm[1] + 0)
            best := mods . key
        }
        return best
    }
    return ""
}

; Virtual-key code to the name Overwolf would have written. Letters, digits and
; function keys only -- those cover what anyone binds to a show/hide toggle,
; and refusing everything else is what keeps a misparse from becoming a
; keystroke sent into a game.
_FSVkToName(vk) {
    if (vk >= 65 && vk <= 90)                     ; A-Z
        return Chr(vk)
    if (vk >= 48 && vk <= 57)                     ; 0-9
        return Chr(vk)
    if (vk >= 112 && vk <= 123)                   ; F1-F12
        return "F" . (vk - 111)
    return ""
}

; Overwolf's modifier bitmask into the "Alt+" spelling used everywhere else
; here, so a value read from the store and one read from the manifest arrive in
; the same shape. The bit values are INFERRED from observed data, not
; documented -- which is exactly why the result is verified before it is
; trusted, and why a wrong guess costs a fallback rather than a wrong key.
_FSOwModsToSpec(bits) {
    out := ""
    if (bits & 2)
        out .= "Ctrl+"
    if (bits & 4)
        out .= "Alt+"
    if (bits & 8)
        out .= "Shift+"
    return out
}

_FSReadAppHotkeys() {
    global CFG
    out := {main: "", bg: ""}
    ; An explicit override always wins -- this is the escape hatch for a user
    ; who rebound them in Overwolf.
    if (CFG.fsHotkeyMain != "")
        out.main := CFG.fsHotkeyMain
    if (CFG.fsHotkeyBG != "")
        out.bg := CFG.fsHotkeyBG
    if (out.main != "" && out.bg != "")
        return out
    try {
        appId := GetFirestoneAppId()
        if (appId = "")
            return out
        base := EnvGet("LOCALAPPDATA") . "\Overwolf\Extensions\" . appId
        if !DirExist(base)
            return out
        ; Newest installed version, compared numerically per component so that
        ; 18.17.2 beats 18.9.9 -- a plain string sort gets that backwards.
        best := "", bestKey := ""
        loop files base . "\*", "D" {
            k := ""
            for part in StrSplit(A_LoopFileName, ".")
                k .= Format("{:06}", IsNumber(part) ? part + 0 : 0)
            ; STRING COMPARISON, EXPLICITLY, AND THE FIRST ONE ALWAYS WINS.
            ; "k > bestKey" against an empty starting value does not evaluate
            ; true for a numeric-looking key, so the only installed version was
            ; found, keyed, and then thrown away -- best stayed empty, the
            ; manifest was never read, and no hotkey was ever known. F3 then
            ; had nothing to send and reported "no usable Firestone hotkey",
            ; which read like a missing binding rather than this.
            if (bestKey = "" || StrCompare(k, bestKey) > 0)
                bestKey := k, best := A_LoopFileFullPath
        }
        if (best = "")
            return out
        mf := best . "\manifest.json"
        if !FileExist(mf)
            return out
        txt := FileRead(mf, "UTF-8")
        ; The user's own rebinding beats the published default. Finding
        ; nothing is the normal answer -- almost nobody rebinds these -- and
        ; it means the default below is correct rather than merely assumed.
        if (out.main = "")
            out.main := _FSReadUserHotkey("collection")
        if (out.bg = "")
            out.bg := _FSReadUserHotkey("battlegrounds")
        if (out.main = "")
            out.main := _FSHotkeyDefaultFor(txt, "collection")
        if (out.bg = "")
            out.bg := _FSHotkeyDefaultFor(txt, "battlegrounds")
    }
    return out
}

; Pull one hotkey's "default" out of the manifest text. Deliberately a targeted
; regex rather than a JSON parser: this file has no JSON parser, the shape is
; stable and shallow, and a parser is a large dependency to add for two strings.
; Anchored on the named block so the two hotkeys cannot be confused with each
; other or with any other "default" in the file.
_FSHotkeyDefaultFor(txt, name) {
    try {
        if RegExMatch(txt, 's)"' . name . '"\s*:\s*\{.*?"default"\s*:\s*"([^"]+)"', &m)
            return m[1]
    }
    return ""
}

; "Alt+C" -> "!c"   -- Overwolf's notation into AHK's Send notation.
; Returns "" for anything not understood, and the caller treats that as "this
; route is unavailable" rather than guessing.
_FSHotkeyToSend(spec) {
    if (spec = "")
        return ""
    mods := "", key := ""
    for part in StrSplit(spec, "+") {
        p := Trim(part)
        switch StrLower(p) {
            case "alt":            mods .= "!"
            case "ctrl", "control": mods .= "^"
            case "shift":          mods .= "+"
            case "win", "meta":    mods .= "#"
            default:               key := p
        }
    }
    if (key = "")
        return ""
    ; A single character sends as itself; anything longer is a named key and
    ; needs braces, which is also how Tab, F1 and the like must be written.
    return mods . ((StrLen(key) = 1) ? StrLower(key) : "{" . key . "}")
}

; ── WHEN THE USER PRESSES FIRESTONE'S OWN KEY, FOLLOW IT ────────────────────
;
; THIS IS THE FLICKER ON Alt+C, AND IT WAS THIS SCRIPT DOING IT.
;
; Pressing Firestone's own hotkey makes Firestone show its window. This script
; knew nothing about that, so if the F3 lock happened to be ON, the suppression
; saw a Firestone window become visible while it was supposed to be concealed
; and put it straight back -- which is exactly what a flicker is. The user asked
; Firestone for a window and this script took it away again a frame later.
;
; So the key is registered here as a PASSTHROUGH: the tilde means Firestone
; still receives the keystroke exactly as before -- nothing is swallowed, nothing
; is intercepted, and if this script is not running the key behaves identically.
; All this does is notice the press and move the lock to match, so the two
; systems agree about what the user just asked for.
;
; REGISTERED ONLY WHEN IT IS KNOWABLE. If the binding cannot be read and the
; published default cannot be parsed, no hotkey is registered at all -- the
; script does not guess at a key it might be stealing from something else.
_FSRegisterAppHotkeyMirror() {
    global _fsAppHotkeys, _fsAppMirrorDone
    if _fsAppMirrorDone
        return
    _fsAppMirrorDone := true
    try {
        if !TrackerIsFirestone()
            return
        if !IsObject(_fsAppHotkeys)
            _fsAppHotkeys := _FSReadAppHotkeys()
        for which, spec in Map("main", _fsAppHotkeys.main, "bg", _fsAppHotkeys.bg) {
            send := _FSHotkeyToSend(spec)
            if (send = "")
                continue
            try {
                Hotkey("~" . send, _FSAppHotkeyPressed.Bind(which), "On")
                _FSLog("FS-TOGGLE watching Firestone's own key (" . spec . ") for "
                     . which . " -- pressed directly it will no longer fight this"
                     . " script's concealment. The key still reaches Firestone"
                     . " untouched; this only keeps the F3 lock in step with it.")
            }
        }
    }
}

; The user pressed Firestone's key rather than F3. Firestone is already acting
; on it, so the only job here is to stop the suppression undoing that.
;
; Deliberately does NOT touch any window. Firestone owns them at this point;
; reaching in to help is how the flicker happened in the first place.
_FSAppHotkeyPressed(which, *) {
    global State, _fsUserUnlocked   ; _fsUserUnlocked was NOT declared here: the
                                   ; write below went to a discarded local, so
                                   ; pressing Firestone's own show/hide key released
                                   ; the lock without recording that the USER did
                                   ; it, and _TrackerArmFirestone -- which checks
                                   ; this flag before re-arming -- re-locked the
                                   ; window they had just asked to see.
    try {
        if !State.fsMainLocked
            return                        ; already unlocked: nothing to reconcile
        _FSSetLock(false, "Firestone's own show/hide key was pressed")
        _fsUserUnlocked := true
        SetTimer(FSMainMonitor, 0)
        StopFSBurst()
        try StopEarlyOverwolfCloak()
        _FSLog("FS-TOGGLE the user pressed Firestone's own key while this script"
             . " had its windows locked. The lock is released to match, so the"
             . " window they just asked for stays on screen instead of being"
             . " concealed again a frame later.")
    }
}

; ── Title helpers ─────────────────────────────────────────────────────────────

; Matches the standalone Firestone desktop app window.
IsFirestoneMainTitle(title) {
    if (title = "")
        return false
    return (title = "Firestone - Main")
}

; ══════════════════════════════════════════════════════════════════════════════
;  IS THIS FIRESTONE MAIN? — a pure identity test, and nothing else
; ══════════════════════════════════════════════════════════════════════════════
;
; This answers one question -- "is this window Firestone Main?" -- and has no
; opinion about what should happen to it. That separation is the whole point,
; and it was briefly lost: the function opened with a check on a CONCEALMENT
; POLICY flag and returned false when that flag was off, so every caller asking
; a question about IDENTITY got an answer about policy instead. The guard in
; IsFirestoneNotificationPopup that exists to stop a forming Main being sent
; WM_CLOSE was silently inert for exactly that reason.
;
; THREE WAYS TO BE MAIN, in order of certainty:
;
;   1. It is titled "Firestone - Main" right now.
;   2. It has EVER been titled that. Permanent: Main is destroyed and recreated
;      when you close and reopen it, but within one window's life the title is
;      not something it takes back.
;   3. It is Main IN FORMATION -- created during the launch, wearing one of
;      Firestone's own provisional names, and shaped like Main. This is the
;      case that matters, because the window spends a second or two titled bare
;      "Firestone" before it becomes Main, and the notification popup wears the
;      same provisional names. Size is what separates them: Main is 1440x790,
;      the popup and the splash are 440x590, Settings is 780x620.
;
; Case 3 is latched once decided (_fsMainBirth) because the test's cheap half
; stops being true the moment the launch ends, and because the expensive half
; enumerates two processes -- not something to repeat on a 15 ms sweep.
global _fsMainBirth := Map()
; hwnd -> true once the pre-warm line has been written for it. One line per
; window, not one per sweep tick; pruned with every other per-window ledger.
global _fsMainPrewarmLogged := Map()

_FSIsMainSurface(hwnd, title) {
    global CFG, State, _fsWasMainTitled, _fsMainEverOpened, _EarlyOWCloakActive
    global _fsMainBirth
    static WS_CAPTION := 0x00C00000

    ; 1 and 2: named, or has ever been named.
    if (IsFirestoneMainTitle(title) || _fsWasMainTitled.Has(hwnd))
        return true
    if !CFG.fsMainBirthDetect
        return false
    if _fsMainBirth.Has(hwnd)
        return true

    ; ── CHEAPEST TESTS FIRST. THE ORDER IS THE PERFORMANCE. ────────────────
    ; Reached from the popup closer and the flicker shield, both of which run
    ; on sweeps. Two string compares and two window queries per window per tick
    ; is nothing; the process enumeration at the end would be thousands of
    ; WinGetTitle calls a second, so it must be reached only by a window that
    ; has already passed everything else.

    ; 3: Main-in-formation wears one of Firestone's own provisional names and
    ; nothing else. This alone rejects every Overwolf infrastructure window.
    if !(title = "Firestone" || title = "Firestone - Loading")
        return false

    ; ── NO LAUNCH-TIMING GATE. THIS IS THE BUG THAT WAS HERE. ──────────────
    ; This used to require a launch to be in flight -- the early cloak up, or
    ; F2 running, or no Main yet this session -- on the reasoning that Main is
    ; born during the launch and anything Firestone-shaped born afterwards is
    ; Battlegrounds.
    ;
    ; MAIN IS DESTROYED WHEN YOU CLOSE IT AND CREATED AGAIN WHEN YOU CLICK THE
    ; TRAY ICON. That reopen happens with no launch in flight and with
    ; _fsMainEverOpened long since true, so every one of those conditions was
    ; false and this returned "not Main" about Firestone Main. The window then
    ; fell straight through the flicker shield's exclusions and was SW_HIDDEN
    ; at birth -- the exact regression this project has already had once, by a
    ; different route (fsFreshBornStartHidden applied to Main), and the reason
    ; Main's survival looked random rather than conditional.
    ;
    ; The one-at-a-time guard below is the correct discriminator and it needs
    ; no clock. A Firestone-shaped newborn while NO window is titled
    ; "Firestone - Main" is Main arriving; the same newborn while Main is
    ; already open is Battlegrounds. That is true during a launch and true at
    ; the first match, which is more than the timing test ever was.
    ;
    ; The residual ambiguity is one case: Battlegrounds opening while Main is
    ; closed. That is read as Main, so Battlegrounds keeps its cloak and its
    ; park but loses the birth hide -- a possible flicker, never a wedged
    ; renderer. Wrong in the safe direction, which is the direction this test
    ; must be wrong in.
    try {
        st := WinGetStyle("ahk_id " . hwnd)
        if !(st & WS_CAPTION)           ; the in-game overlay has none
            return false
        w := 0, h := 0
        WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        ; 1440x790 on this build. The floor clears the splash (440x590), the
        ; notification (440x590) and Settings (780x620) with room to spare,
        ; without pinning the test to one Firestone release.
        if (w < 1200 || h < 600)
            return false
        ; ── THE DISCRIMINATOR, AND NOW THE ONLY ONE ────────────────────
        ; Nothing else may already be Main. Two windows are born titled bare
        ; "Firestone" within the same second of every launch and only one of
        ; them becomes Main, so this stops the other inheriting the answer --
        ; and at the first Battlegrounds match, with Main open, it is what
        ; tells Battlegrounds apart from Main by 80 pixels of width that no
        ; size test should ever be asked to notice.
        ;
        ; Costs two process enumerations, and is reached only by a window that
        ; is already titled as Firestone's, captioned, and Main-sized. That is
        ; a handful of windows per session, not a sweep.
        if _FSMainWindowPresent(hwnd)
            return false
        _fsMainBirth[hwnd] := true
        return true
    }
    return false
}

; Matches any Firestone window that should be suppressed at all times.
; "Firestone - Loading" is deliberately NOT included – it is closed,
; not toggled with F3.
IsFirestoneSuppressionTitle(title) {
    return (title = "Firestone - Main" || title = "Firestone - Battlegrounds")
}

; ── Allow-list classification (see CFG.fsVisibleTitles) ──────────────────────
; TRUE only for a title that must be allowed to render while the lock is on.
; Everything else in the Overwolf family is suppressed by default.
IsFSVisibleTitle(title) {
    global CFG
    if (title = "")
        return false
    for t in CFG.fsVisibleTitles {
        if (title = t)
            return true
    }
    return false
}

; ── The in-game overlay, identified structurally ─────────────────────────────
; See CFG.fsOverlayShapeDetect for why this exists and what it fixes. The rule:
; a Firestone-family window with NO CAPTION that is tool-window or click-through
; shaped and covers most of a game window is the in-game overlay, whatever it is
; called. Every other Firestone surface has a caption and is smaller.
;
; Deliberately does NOT require any particular title. The whole point is that
; the title is the thing that turned out not to be dependable. It does require
; the window to be one of Firestone's -- callers only reach this from inside the
; Overwolf-family enumeration, and the shape test alone is not an identity.
IsFirestoneInGameOverlay(hwnd, title := "") {
    global CFG
    static WS_CAPTION        := 0x00C00000
    static WS_EX_TOOLWINDOW  := 0x00000080
    static WS_EX_TRANSPARENT := 0x00000020

    ; The documented name always wins, on any build that actually uses it.
    if (title != "" && IsFSVisibleTitle(title))
        return true
    if !CFG.fsOverlayShapeDetect
        return false
    ; ── AN UNTITLED WINDOW IS NEVER MATCHED BY SHAPE ────────────────────────
    ; Every CEF window is born nameless, and at EVENT_OBJECT_CREATE its styles
    ; are not final either -- a window can be created before its caption bit is
    ; applied. Judging one by shape at that moment risks classifying a
    ; half-built Firestone - Main as the overlay and releasing the birth cloak
    ; that is holding it off the screen, which is a visible flash and exactly
    ; the class of bug this whole subsystem exists to prevent.
    ;
    ; Nothing is lost by waiting: an untitled newborn stays birth-cloaked, and
    ; the moment it names itself the NAMECHANGE janitor and the suppression
    ; funnel both re-ask this question against a settled window. The overlay is
    ; released microseconds later rather than instantly.
    if (title = "")
        return false
    ; A window that names itself as one of the desktop app's surfaces is never
    ; the overlay, whatever its shape. Checked first so a maximised Main can
    ; never be mistaken for it.
    if (IsFirestoneSuppressionTitle(title) || IsFirestoneAppTitle(title)
     || title = "Firestone - Loading")
        return false

    ; ── SHAPE IS NOT AN IDENTITY. THE TITLE STILL HAS TO NAME FIRESTONE. ────
    ; OVERWOLF IS A PLATFORM, NOT AN APP -- it hosts League overlays, TFT
    ; overlays and whatever else the user has installed, all inside the same
    ; two executables this script enumerates. "Chromeless, tool-window-shaped
    ; and big enough to cover the game" is not a description of Firestone's
    ; overlay; it is a description of EVERY in-game overlay, including other
    ; apps' -- and of Overwolf's own 1920x1023 infrastructure windows
    ; ("Overwolf Quick Launcher", "Hidden Window", untitled CEF frames).
    ;
    ; That matters because the callers do not merely leave a match alone: the
    ; settled sweep FORCE-SHOWS anything on the must-stay-visible path, and
    ; OverlayTopmostTick pins it above Hearthstone for the session. Matching on
    ; shape alone would drag another application's window onto the desktop and
    ; nail it over the game -- the exact failure FSShouldSuppress's own comment
    ; says must never be reintroduced.
    ;
    ; So the shape test only ever RUNS on a window that already names itself as
    ; Firestone's. On the build in the logs that name is the bare app name,
    ; "Firestone"; fsVisibleTitles above covers builds that use the documented
    ; "Firestone - Overlays". Another app's overlay carries that app's name and
    ; is never considered here at all.
    named := false
    for t in CFG.fsOverlayShapeTitles {
        if (title = t) {
            named := true
            break
        }
    }
    if !named
        return false
    try {
        st := WinGetStyle("ahk_id " . hwnd)
        if (st & WS_CAPTION)              ; a real window frame: not the overlay
            return false
        ex := WinGetExStyle("ahk_id " . hwnd)
        if !(ex & (WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT))
            return false
        w := 0, h := 0
        WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        if (w < CFG.fsOverlayMinW || h < CFG.fsOverlayMinH)
            return false
        ; ── AND IT MUST ACTUALLY COVER A MONITOR ────────────────────────────
        ; The size floor alone does not separate the overlay from Firestone
        ; Main: Main is 1440x790 on this build, which clears 1000x600. That
        ; left WS_CAPTION and WS_EX_TOOLWINDOW as the only discriminators --
        ; and this file documents elsewhere that Overwolf applies
        ; WS_EX_TOOLWINDOW LATE, after the window is created. So there is a
        ; window in which a bare-titled, not-yet-styled Main satisfies the
        ; shape test, gets its birth cloak released as "the overlay", and
        ; appears.
        ;
        ; The in-game overlay is drawn over the game and covers its monitor;
        ; no desktop window of Firestone's does. That is a property of what the
        ; window IS rather than of styles that are still settling.
        if !_CoversMostOfItsMonitor(hwnd, w, h)
            return false
        return true
    }
    return false
}

; The single question every concealment site should ask before touching an
; Overwolf window: is this one of the surfaces that must remain on screen?
;
; Title-only callers keep using IsFSVisibleTitle. Everything that HAS the hwnd
; should use this instead, because on the build in the logs the title alone
; cannot answer it. See CFG.fsOverlayShapeDetect.
IsFSMustStayVisible(hwnd, title := "") {
    if (title != "" && IsFSVisibleTitle(title))
        return true
    return IsFirestoneInGameOverlay(hwnd, title)
}

; Titles that are exempt from concealment in EVERY lock state, without being
; force-shown the way fsVisibleTitles are. See CFG.fsNeverConcealTitles for
; why the two lists are separate; the short version is that the overlay must
; be actively kept visible and Settings must merely be left alone.
IsFSNeverConcealTitle(title) {
    global CFG
    if (title = "")
        return false
    for t in CFG.fsNeverConcealTitles {
        if (title = t)
            return true
    }
    return false
}

; TRUE when this Overwolf-family window should be kept off the screen right
; now. The single decision point -- every janitor asks this instead of
; open-coding its own "is this one of ours?" test, which is how the three
; reveal paths ended up disagreeing with each other.

FSShouldSuppress(title) {
    global State
    if !State.fsMainLocked
        return false
    ; ALLOW-LIST, NOT DENY-LIST. DO NOT INVERT THIS AGAIN.
    ;
    ; "Should this stay concealed?" is answered by exclusion from a very short
    ; list of titles that are allowed to be seen -- currently just the in-game
    ; overlay. Everything else stays concealed while the lock is on.
    ;
    ; It was briefly changed to "only suppress windows whose title says
    ; Firestone", to stop the script managing other Overwolf apps' windows.
    ; That reasoning was right and the change was in the wrong place: the
    ; CALLER treats "not suppressed" as "actively show it" and calls
    ; ShowWindow. So the inversion did not merely stop concealing Overwolf's
    ; own infrastructure -- "OverWolf Server", untitled CEF frames, windows
    ; Overwolf itself keeps hidden -- it dragged them onto the desktop as blank
    ; white rectangles.
    ;
    ; The problem it was aimed at is solved where it belongs instead: _FSMayPark
    ; refuses to park anything it cannot name as Firestone's, so no other app's
    ; window ever enters the ledger F3 restores from.
    ;
    ; The never-conceal list is folded in here alongside the visible list, and
    ; that placement does real work: the NAMECHANGE janitor in the window hook
    ; treats "not suppressed" as "release it", so the moment a newborn window
    ; titles itself "Firestone - Settings" -- lock on or off -- the birth cloak
    ; it was given as an anonymous CEF window is undone and it appears.
    return !IsFSVisibleTitle(title) && !IsFSNeverConcealTitle(title)
}

; Diagnostic: one log line per distinct Overwolf surface signature per session.
; Purpose is identification, not debugging noise -- if a window still gets
; through, this names its exe, class, title and size so it can be added to a
; list by fact instead of by guess.
global _fsSurfaceLogged := Map()
global _fsSurfaceHwndLogged := Map()
_LogFSSurface(hwnd, title, decision) {
    global CFG, _fsSurfaceLogged, _fsSurfaceHwndLogged
    if !CFG.fsLogUnclassified
        return

    ; Plumbing windows are not "unclassified surfaces" -- they are OS and
    ; COM machinery that is never drawn, and naming them here taught
    ; nobody anything. Seventeen of these landed in the second before the
    ; start-up splash on one launch, each one a synchronous file write on
    ; the single thread that has 16-32ms to catch it. See _FSIsInertHelper.
    if _FSIsInertHelper(hwnd, title)
        return
    ; ── THE DEDUP MUST COME BEFORE THE QUERIES, NOT AFTER THEM ──────────────
    ; The signature below needs the exe, the class and the size, and
    ; WinGetProcessName is an OpenProcess / QueryFullProcessImageName /
    ; CloseHandle per call -- a kernel object opened and closed just to build a
    ; string. The signature dedup then threw that string away on all but the
    ; first sighting.
    ;
    ; This is called from the 10/50/250 ms suppression sweep, once per Overwolf
    ; window per tick. With the ~17 unclassified windows the log shows, at the
    ; 50 ms coast, that is roughly 340 process-handle opens per second spent
    ; entirely on log lines that were already written.
    ;
    ; An hwnd is cheaper to check than a signature is to build, and a window's
    ; exe, class and decision do not change under it. So the per-hwnd gate runs
    ; first and the signature dedup stays as the second line of defence (it
    ; still collapses many hwnds of the same shape into one line). The hwnd map
    ; is pruned with the rest -- see _PrunePlacementMaps.
    ; Keyed on the bare hwnd, not hwnd+decision, so _PrunePlacementMaps can
    ; clear it with the rest -- a composite key is not a window handle and the
    ; pruner's IsWindow test could not read it. One line per window is what
    ; this diagnostic is for anyway.
    if _fsSurfaceHwndLogged.Has(hwnd)
        return
    _fsSurfaceHwndLogged[hwnd] := true
    try {
        exe := "", cls := "", w := 0, h := 0
        try exe := WinGetProcessName("ahk_id " . hwnd)
        try cls := WinGetClass("ahk_id " . hwnd)
        try WinGetPos(, , &w, &h, "ahk_id " . hwnd)

        ; ── COLLAPSE THE PER-WINDOW GUID OUT OF THE CLASS NAME ──────────────
        ; Overwolf's WPF classes look like
        ;   HwndWrapper[Overwolf.exe;UI;7c222d10-2e93-4c4f-9f6a-...]
        ; and the GUID is different for every window it ever creates. This
        ; diagnostic dedups on a signature built from the class, so a fresh
        ; GUID meant a fresh signature and a fresh line -- the dedup never
        ; matched anything and one launch wrote 259 near-identical entries.
        ;
        ; Dropping the GUID keeps everything that identifies the KIND of
        ; window and collapses the family to one line, which is what this
        ; diagnostic was for. Sizes still differ per window; the signature
        ; keeps them apart where that matters.
        clsShort := RegExReplace(cls, "s)^(HwndWrapper\[[^;\]]*;[^;\]]*);.*\]$", "$1]")

        sig := exe . "|" . clsShort . "|" . title . "|" . decision
        if _fsSurfaceLogged.Has(sig)
            return
        _fsSurfaceLogged[sig] := true
        FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss")
            . " FS-SURFACE " . decision
            . " exe=" . exe . " class=" . clsShort
            . " title=`"" . title . "`" size=" . w . "x" . h . "`n"
            , _LogPath())
    }
}

; Matches the Firestone - Battlegrounds window (standalone stats/board view).
IsFirestoneBattlegroundsTitle(title) {
    if (title = "")
        return false
    return (title = "Firestone - Battlegrounds")
}

; ── Any OTHER Firestone desktop window ("Firestone - Settings" and friends) ──
;
; THE BUG THIS EXISTS TO CLOSE: F3 concealed by title and revealed by a
; DIFFERENT, SHORTER list of titles. The lock's allow-list is "everything that
; is not Firestone - Overlays gets concealed"; the reveal's list was the two
; hard-coded names Main and Battlegrounds. Every other Firestone window --
; Settings above all, but equally anything Firestone adds in a later build --
; fell in the gap: concealed by the lock, and then not on the list of things
; the unlock knows how to bring back. Open Settings, press F3 twice, and it is
; gone for the rest of the session with no way to reach it. That is the exact
; failure mode this script's own iron rule is written against -- "nothing is
; ever cloaked, parked or hidden without a janitor guaranteed to run".
;
; Matched by PREFIX rather than by name, deliberately. A fixed list is what
; created the gap, and it would create it again the next time Firestone ships
; a window. "Firestone - " is unambiguous: Overwolf's own surfaces are titled
; "Overwolf ...", "OverWolf Server", "Hidden Window" or nothing at all, and
; another Overwolf app's windows carry that app's name.
;
; Two exclusions, both because the window already has an owner:
;   * Firestone - Overlays is on CFG.fsVisibleTitles and must never be
;     concealed at all, so it must never be parked or revealed by this path.
;   * Firestone - Loading is Main's own HWND before it is renamed, and has a
;     dedicated suppressor that runs through the launch.
IsFirestoneAppTitle(title) {
    if (title = "")
        return false
    if (title = "Firestone - Overlays" || title = "Firestone - Loading")
        return false
    return (SubStr(title, 1, 12) = "Firestone - ")
}

; Matches the "Firestone" notification popup (e.g. "Your abilities are ready!")
; ══════════════════════════════════════════════════════════════════════════════
;  THE NOTIFICATION POPUP IS KILLED, NOT MANAGED
; ══════════════════════════════════════════════════════════════════════════════
; One function, called from every site that can identify the popup, so there is
; exactly one answer to "what happens to it": it is cloaked so it never paints,
; and closed immediately.
;
; NO STABILITY WAIT, and that is the change. The sweeper deliberately waited for
; a window to hold a matching title and size for a stretch before closing it,
; because a sweep sees windows at arbitrary moments and a half-built window can
; briefly resemble anything. That caution is unnecessary here: this is reached
; from the CREATE and NAMECHANGE events, which fire ON the transition, and from
; the funnel, which has already established identity. The window is killed at
; its beginning rather than a second and a half into its life.
;
; INDEPENDENT OF F3. The lock decides whether Firestone's real windows are on
; screen. It has no opinion about a notification, and wiring one to the other
; produced the worst of both: a popup that appeared and disappeared as the user
; toggled their overlay. Nothing here reads State.fsMainLocked.
;
; The identity ledger remains absolute -- a window that has ever carried the
; Main or Loading title is never closed here, whatever it is titled now.
; Is a window titled exactly "Firestone - Main" open RIGHT NOW, other than this
; one? Hidden windows count -- Main is concealed on purpose and is still open.
;
; This is the structural guarantee that the thing being closed is not Firestone
; Main, and it is not a heuristic: if Main exists as its own separate window,
; then whatever else is sitting there titled bare "Firestone" is, by
; definition, not Main.
; ── GIVE A HELD WINDOW BACK, AS MAIN ────────────────────────────────────────
; The counterpart the popup hold never had. Everything the hold did to this
; window is undone in the order that keeps it painting: unpark first so it has
; somewhere real to be, then uncloak, then show, then put its taskbar button
; back so the user has a route to it that does not involve this script.
;
; The ledgers are cleared as well as the state, because leaving the hwnd in
; _fsPopupFirstSeen or _fsPopupKilled means the very next sweep decides it is
; a popup again and takes it straight back.
_FSReleaseHeldAsMain(hwnd) {
    global _fsPopupFirstSeen, _fsPopupHeldLogged, _fsPopupKilled, _fsReleasedAsMain
    global _fsHiddenByUs, _fsParked, _fsMainEverOpened
    try {
        if !DllCall("user32\IsWindow", "Ptr", hwnd)
            return false

        ; ── NEVER PROMOTE AN OVERLAY ────────────────────────────────────────
        ; Everything below unparks, uncloaks, shows and re-taskbars whatever
        ; hwnd it is handed, with no test of its own. Callers reach here when
        ; Main has died and something else appeared -- and in-game that
        ; something is usually Overwolf's OVERLAY counterpart, not a new desktop
        ; Main. CollectionWindow is desktop_only, so Overwolf destroys it when
        ; Hearthstone takes the screen and builds the overlay in its place.
        ;
        ; An overlay is a monitor-sized per-pixel-alpha surface. Force it
        ; visible and then put whole-window alpha on it -- which is what the
        ; conceal and the F3 reveal both do -- and the per-pixel channel is
        ; discarded, so every transparent pixel renders as backing colour: a
        ; full-screen black sheet with no taskbar button.
        ;
        ; The real Main is a native window (native_window + use_os_windowing in
        ; Firestone's manifest). Overwolf's overlays and splash chrome are WPF,
        ; hosted in a HwndWrapper[...] class. Refusing by host class rather than
        ; requiring a WinForms class is deliberate: if Overwolf renames its
        ; native class in an update, a positive test would silently stop
        ; promoting anything at all, and the failure would look like F3 dying.
        ;
        ; GetClassNameW rather than WinGetClass because the window is usually
        ; hidden here and this must not depend on DetectHiddenWindows.
        cls := ""
        try {
            buf := Buffer(512, 0)
            if DllCall("user32\GetClassNameW", "Ptr", hwnd, "Ptr", buf, "Int", 256)
                cls := StrGet(buf, "UTF-16")
        }
        if (SubStr(cls, 1, 12) = "HwndWrapper[") {
            _FSLog("FS-POPUP NOT RELEASED hwnd=" . hwnd . " class=" . cls
                 . " -- this is an Overwolf WPF host (overlay or splash chrome),"
                 . " not the native desktop Main. Promoting it would force a"
                 . " monitor-sized transparent surface on screen, which renders"
                 . " as a black sheet once alpha is applied to it. Left alone.")
            return false
        }
        try {
            if _fsParked.Has(hwnd)
                _FSUnparkWindow(hwnd)
        }
        try UncloakWindow(hwnd, true, "_FSReleaseHeldAsMain")
        try _HDTShieldRestore(hwnd)          ; in case the shield holds it too
        if DllCall("user32\IsIconic", "Ptr", hwnd)
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 9)      ; SW_RESTORE
        else if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)      ; SW_SHOWNA
        try _FSTabOn(hwnd)
        _MapDrop(_fsPopupFirstSeen, hwnd)
        _MapDrop(_fsPopupHeldLogged, hwnd)
        _MapDrop(_fsPopupKilled, hwnd)
        _MapDrop(_fsHiddenByUs, hwnd)
        ; REMEMBER THE VERDICT. Without this the release is amnesiac:
        ; it clears the popup ledgers a few lines above so the window
        ; can be given back, and the very next sweep then meets an
        ; unknown bare-"Firestone" window with no Main beside it,
        ; reaches the same conclusion the hold did, and takes it
        ; again. That is a loop, and it ran for a whole session:
        ;
        ;   17:33:57 FS-POPUP RELEASED hwnd=1835920 as Firestone Main
        ;   17:33:57 FS-POPUP holding  hwnd=1835920   (same second)
        ;   17:34:09 RELEASED ... 17:34:10 holding
        ;   17:34:22 RELEASED ... 17:34:23 holding
        ;
        ; Every cycle cloaked and parked the user's Firestone Main
        ; for twelve seconds, which is indistinguishable from it
        ; having been closed.
        _fsReleasedAsMain[hwnd] := A_TickCount
        _fsMainEverOpened := true
        _FSLog("FS-POPUP RELEASED hwnd=" . hwnd . " as Firestone Main -- it was"
             . " held this long with no Main window anywhere, and a notification"
             . " would have had a real Main beside it. Unparked, uncloaked,"
             . " shown and given its taskbar button back.")
        return true
    }
    return false
}



_FSMainWindowPresent(excludeHwnd := 0) {
    global _fsWasMainTitled
    prev  := A_DetectHiddenWindows
    DetectHiddenWindows true
    found := false
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    ; ── IDENTITY, NOT THE CURRENT TITLE ─────────────────────
                    ; THIS IS WHY F3 ASKED FIRESTONE FOR A NEW MAIN INSTEAD OF
                    ; REVEALING THE ONE ALREADY OPEN.
                    ;
                    ; This tested the exact title "Firestone - Main" only. Main
                    ; wears the plain title "Firestone" for most of its life --
                    ; born that way, retitling about 900ms later, and reverting
                    ; to it on every Overwolf rebuild. So this answered "no Main
                    ; anywhere" about a Main that was sitting right there.
                    ;
                    ; Measured 2026-09-06 14:19:48. Hotkey_F3's unlock branch is:
                    ;
                    ;   if (!_FSMainWindowPresent() && ...) asked := _FSAskFirestoneFor("main")
                    ;   if !asked                           StartFSReveal()
                    ;
                    ; So a false answer here does not merely skip a check -- it
                    ; sends F3 down the "ask Firestone to open one" path and
                    ; StartFSReveal NEVER RUNS. The log showed exactly that:
                    ; freed=0, and a brand new Main hwnd appearing nine seconds
                    ; after the keypress, which the blanket then hid as well.
                    ;
                    ; _fsWasMainTitled records permanently that an HWND HAS
                    ; WORN the Main title. A window that has ever been Main is
                    ; still Main whatever it is called now, and every caller of
                    ; this function is asking the identity question.
                    if (h != excludeHwnd
                     && (IsFirestoneMainTitle(WinGetTitle("ahk_id " . h))
                      || _fsWasMainTitled.Has(h))) {
                        found := true
                        break
                    }
                }
            }
            if found
                break
        }
    }
    DetectHiddenWindows prev
    return found
}

global _fsPopupKilled    := Map()
; hwnd -> how many times we have asked this popup to close. Only used to keep
; the log honest and bounded when a window refuses to go (see close-to-tray).
global _fsPopupKillCount := Map()
; hwnd -> tick of the last "cloaked and moved off-screen" line written for it.
; See CFG.fsPopupLogEveryMs; pruned with every other per-window ledger.
global _fsPopupLogAt := Map()

global _fsPopupFirstSeen := Map()   ; hwnd -> first sighting, for the grace
global _fsReleasedAsMain := Map()  ; hwnd -> tick, we concluded this window IS Main

; Move the notification popup entirely off the virtual desktop.
;
; A DWM-cloaked window is not drawn, but it is still THERE: it still hit-tests,
; so it still swallows every mouse click that lands on it. A popup left cloaked
; in the middle of the screen over Hearthstone is an invisible sheet of glass
; over the board -- the user clicks the game and nothing happens, with nothing
; on screen to explain why.
;
; Deliberately a bare SetWindowPos rather than _FSParkWindow: parking RECORDS
; the window in _fsParked so F3 can restore it, and this window must NEVER be
; restored -- it is waiting to be closed. No ledger entry, nothing to bring it
; back, and no clicks intercepted while it waits.
;
; Its own function because three places now need it: the "cannot yet prove it
; is not Main" branch, the re-assert for a popup that survived its close, and
; the stranded-window repair, which has to be able to recognise this window and
; put it straight back rather than rescuing it onto the desktop.
_FSParkNotificationPopup(hwnd) {
    global _fsHiddenByUs
    ; ── HIDE IT, AND DO NOT LET GO ─────────────────────────────────────────
    ; The park alone is not enough and the log says why:
    ;
    ;   FS-LOADING identified hwnd=13894828 untitled=0ms   visible=1 cloaked=0
    ;   FS-SHIELD  released after 16ms -- parked off-screen
    ;   FS-LOADING identified hwnd=13894828 untitled=516ms visible=1 cloaked=0
    ;   FS-POPUP   killed at funnel                        (3 seconds later)
    ;
    ; cloaked=0 twice: the DWM cloak was asked for and declined, which is
    ; routine on a window whose process is still starting. So for three seconds
    ; the only thing concealing this window was its position -- and a position
    ; is something Overwolf re-asserts on its own windows while they settle.
    ;
    ; SW_HIDE is not a request and cannot be declined. HELD, not released:
    ; every other window in this script gets its hide traded for a park because
    ; a sustained hidden state stops a CEF window building a compositor, and
    ; that trade is what keeps Firestone Main alive. THIS window is about to be
    ; sent WM_CLOSE. It has no future to protect, so it gets the concealment
    ; that actually works.
    ;
    ; Ledgered in _fsHiddenByUs, so if the close is refused (Firestone's
    ; close-to-tray can swallow it) ExitCleanup and the F4 shutdown still owe
    ; it back.
    try {
        if DllCall("user32\IsWindowVisible", "Ptr", hwnd) {
            _fsHiddenByUs[hwnd] := true
            _FSHideWindow(hwnd, "_FSParkNotificationPopup")   ; SW_HIDE
        }
    }
    try {
        vx := SysGet(76), vy := SysGet(77)
        vw := SysGet(78), vh := SysGet(79)
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", vx + vw + 2000, "Int", vy + vh + 2000
            , "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)  ; NOSIZE|NOZORDER|NOACTIVATE
    }
}

; ── CONCEALMENT IS ALWAYS ALLOWED. CLOSING ALMOST NEVER IS. ──────────────────
;
; The whole popup subsystem turns on one asymmetry, which this script states in
; _FSKillNotificationPopup and then does not always act on: "Concealment is
; reversible and costs nothing if the judgement is wrong; closing is neither."
;
; Every guard protecting Firestone Main from being closed is therefore a guard
; about CLOSING. None of them is a reason to leave a window PAINTING. Where a
; guard says "I cannot prove this is safe to close", the correct action is not
; to walk away -- it is to close nothing and make sure the window is invisible
; regardless, and to do that on a timer that has no opinion about F3.
;
; That distinction is the difference between "the popup is still on screen
; because the sweeper declined to act" and "the popup is invisible and will be
; closed if and when it can be proven safe". This function is the second half.
_FSConcealNotificationPopup(hwnd) {
    try {
        CloakWindow(hwnd, false, "_FSConcealNotificationPopup")
        _DisableDWMTransitions(hwnd)
        _FSParkNotificationPopup(hwnd)
    }
}

_FSKillNotificationPopup(hwnd, why) {
    global _fsPopupKilled, _fsPopupFirstSeen, _fsMainCandidate, _fsPopupKillCount
    global _fsReleasedAsMain
    global _fsPopupHeldLogged

    global _fsMainEverOpened, CFG, _fsWasMainTitled, _EarlyOWCloakActive, State
    global _fsPopupLogAt     ; declared explicitly; reads resolve either way
    global _fsMainDiedAt     ; when a Main was last destroyed, for the rebuild test
    try {
        ; ── ABSOLUTE: a window that has WORN the Main title is Main ─────────
        if _fsWasMainTitled.Has(hwnd)
            return false

        ; ── ABSOLUTE: A WINDOW THIS SCRIPT ALREADY CONCLUDED IS MAIN ────────
        ;
        ; The guard above covers windows that WORE the "Firestone - Main"
        ; title. This covers the other way a window becomes Main: the hold
        ; below waits out fsHoldReleaseMs with no Main anywhere, decides this
        ; window must be it, and hands it back. That verdict has to outlive the
        ; sweep that made it.
        ;
        ; Without this, the release is undone immediately. It clears the popup
        ; ledgers so the window can be given back, and the next sweep then sees
        ; exactly what the first one saw -- a bare-"Firestone" window with no
        ; Main beside it -- and holds it again. The measured result was a
        ; twelve-second cycle that ran until Firestone was closed, each turn of
        ; it cloaking and parking the user's Main window.
        if _fsReleasedAsMain.Has(hwnd)
            return false

        ; ── AND "Firestone - Loading" IS MAIN-IN-FORMATION, BUT ONLY THEN ───
        ; _fsMainCandidate records Loading-titled windows too, because the
        ; splash retitles into Main on the same HWND and closing it mid-launch
        ; destroys the user's Firestone. That is correct DURING A LAUNCH.
        ;
        ; It is not correct afterwards, and treating it as absolute is why the
        ; notification could never be closed: this build's notification wears
        ; the Loading title as well, so it landed in _fsMainCandidate on its
        ; first sighting and became permanently untouchable.
        ;
        ; The launch is the discriminator, and it is a fact the script already
        ; tracks. While the early cloak is up, or F2 is running, or Main has
        ; never opened this session, a Loading window may still be becoming
        ; Main -- hands off. Once all three are false, Main exists, nothing is
        ; launching, and a window wearing the splash's name is a notification.
        if _fsMainCandidate.Has(hwnd) {
            launching := _EarlyOWCloakActive || State.f2Active || !_fsMainEverOpened
            if launching
                return false
        }

        ; ── "WE ASKED IT TO CLOSE" IS NOT "IT CLOSED". ─────────────────────
        ;
        ; This guard used to be an unconditional `return false`, and that is
        ; the bug behind "the popup appeared when I pressed F3".
        ;
        ; EnsureFirestoneSettings turns Firestone's close-to-tray ON. That is
        ; deliberate and documented above -- it is what stops a stray WM_CLOSE
        ; destroying Firestone Main. The side effect is that WM_CLOSE is no
        ; longer guaranteed to destroy the NOTIFICATION either: the window can
        ; survive the close it was sent. The moment it did, this early return
        ; made the survivor permanently untouchable -- never re-cloaked, never
        ; moved back off the desktop, never asked to close again. DWM drops a
        ; cloak on various window operations and Overwolf re-shows its own
        ; windows freely, so a survivor eventually uncloaks itself, and from
        ; then on it is simply a visible nag popup that this script has
        ; promised never to look at again.
        ;
        ; So the ledger now throttles the CLOSE only. Concealment is re-asserted
        ; on every sighting for as long as the window exists, which is the same
        ; rule every other concealed window in this script lives by: ask the
        ; window, not the ledger. A window that really did close is gone from
        ; the enumeration and costs nothing.
        killedAt := _fsPopupKilled.Get(hwnd, 0)
        if (killedAt && A_TickCount - killedAt < CFG.fsPopupRekillMs) {
            ; Inside the cooldown: re-assert concealment, do not re-ask.
            _FSConcealNotificationPopup(hwnd)
            return false
        }

        ; ── THE STRUCTURAL GUARD. DO NOT REMOVE IT AGAIN. ──────────────────
        ; A bare-"Firestone" window may only be closed while a SEPARATE window
        ; titled exactly "Firestone - Main" also exists.
        ;
        ; The reason is that the title and size cannot tell the notification
        ; apart from Firestone Main. Main is titled just "Firestone" in some
        ; states -- while it is loading, showing "Getting ready" -- and at a
        ; size squarely inside the envelope the popup matcher accepts. They are
        ; the same window to every static test available.
        ;
        ; This guard was in the original sweeper and the fast kill paths added
        ; later bypassed it. The result was exactly what it sounds like: one F3
        ; press revealed Main, Main's title changed, the NAMECHANGE handler saw
        ; a bare-"Firestone" window of popup size, and closed the user's
        ; Firestone. Speed is worth nothing if it is occasionally aimed at the
        ; wrong window.
        ;
        ; Checked here, in the one function every kill path calls, so no future
        ; caller can route around it.
        ;
        ; TWO WAYS TO SATISFY IT, because requiring (a) alone was too strict: a
        ; notification arriving while Main is closed could then never be closed
        ; at all, which is the "popup was not closed" report.
        ;
        ;   (a) A separate "Firestone - Main" window exists right now, so this
        ;       window is provably not Main. Acted on immediately.
        ;
        ;   (b) Main has opened at some point this session, this HWND has never
        ;       carried a Main or Loading title, and it has sat there titled
        ;       bare "Firestone" for longer than CFG.fsPopupGraceMs. A Main that
        ;       is still forming retitles within a second or so; a notification
        ;       keeps that bare title for its whole life. Waiting out that
        ;       window is the only honest way to separate them when Main is not
        ;       present to compare against.
        ;
        ; EITHER WAY THE WINDOW IS CLOAKED ON FIRST SIGHTING, BEFORE ANY OF THIS.
        ; Concealment is reversible and costs nothing if the judgement is wrong;
        ; closing is neither. So it never paints while its identity is settled.
        CloakWindow(hwnd, false, "_FSKillNotificationPopup")
        _DisableDWMTransitions(hwnd)
        if !_fsPopupFirstSeen.Has(hwnd)
            _fsPopupFirstSeen[hwnd] := A_TickCount

        safeToClose := _FSMainWindowPresent(hwnd)

        ; ══════════════════════════════════════════════════════════════════
        ;  NEVER CLOSE A BARE-"Firestone" WINDOW WHILE NO MAIN EXISTS
        ; ══════════════════════════════════════════════════════════════════
        ;
        ; THIS IS "FIRESTONE MAIN DOES NOT SURVIVE", AND IT IS NOT MAIN DYING.
        ; IT IS THIS SCRIPT KILLING MAIN'S REPLACEMENT.
        ;
        ; The timed fallback below used to promote safeToClose on nothing but
        ; a three-second wait. That is fine while Main is on screen -- a
        ; second bare-"Firestone" window is then plausibly a notification, and
        ; the branch above has already proved Main exists. It is catastrophic
        ; in the one state that follows Main being destroyed, because the log
        ; shows the same three lines in the same order in EVERY session:
        ;
        ;   FS-DESTROYED "Firestone - Main"  -- this script did NOT close it
        ;   FS-POPUP  440x590  "cannot yet prove it is not Firestone Main"
        ;   FS-POPUP killed at sweeper backstop        (3-4 seconds later)
        ;
        ; Overwolf tears Main down for its own reasons and immediately opens a
        ; window to rebuild it. That window is bare-"Firestone", popup-shaped,
        ; and has never worn the Main title -- so it satisfies every condition
        ; the timed fallback tests, waits out the grace, and gets a WM_CLOSE.
        ; Main then never comes back, and from the outside it looks as though
        ; it failed to survive.
        ;
        ; THE TRADE, STATED PLAINLY. Requiring a live Main means a
        ; notification arriving while Main is closed is never closed -- it
        ; stays cloaked and parked, invisible and click-through, until
        ; Overwolf disposes of it. That is a leaked window nobody can see.
        ; The alternative is destroying the user's Firestone. Those costs are
        ; not comparable, and the timer was choosing the wrong one.
        ;
        ; Concealment is unaffected: the window was cloaked on sight above and
        ; stays that way. This governs the irreversible half only.
        if (!safeToClose && CFG.fsRequireMainToClosePopup) {
            ; ── THE REBUILD IS RECOGNISABLE IMMEDIATELY, SO DO NOT HOLD IT ───
            ;
            ; A Main window was destroyed moments ago and there is no Main
            ; anywhere now. This window is the replacement Overwolf is building,
            ; not a notification, and the twelve-second hold below would be
            ; twelve seconds of the user having no Firestone on screen for no
            ; reason. Release it as Main at once.
            ;
            ; Deliberately placed ABOVE the holding log line: when this fires
            ; nothing was ever held, so the log should not claim otherwise.
            if (_fsMainDiedAt
             && (A_TickCount - _fsMainDiedAt) <= CFG.fsRebuildGraceMs
             && !_FSMainWindowPresent(hwnd)) {
                _FSLog("FS-POPUP hwnd=" . hwnd . " appeared "
                     . (A_TickCount - _fsMainDiedAt) . "ms after a Firestone Main"
                     . " was destroyed, with no Main anywhere -- this is Overwolf"
                     . " rebuilding Main, which it does when Hearthstone takes the"
                     . " screen. Released straight away instead of being held for"
                     . " " . CFG.fsHoldReleaseMs . "ms, which is what used to make"
                     . " it look like Firestone had been closed.")
                _fsMainDiedAt := 0        ; one rebuild per death
                _FSReleaseHeldAsMain(hwnd)
                return
            }

            if !_fsPopupHeldLogged.Has(hwnd) {
                _fsPopupHeldLogged[hwnd] := true
                _FSLog("FS-POPUP holding hwnd=" . hwnd . " -- no Firestone Main"
                     . " window exists right now, so this is far more likely to"
                     . " be Main forming or being rebuilt than a notification."
                     . " It stays cloaked and parked; it will not be closed"
                     . " unless a real Main appears alongside it.")
            }

            ; ── AND A HOLD HAS TO BE ABLE TO END ────────────────────────────
            ;
            ; THIS IS "FIRESTONE MAIN CLOSED WHEN BATTLEGROUNDS OPENED", AND
            ; MAIN WAS NEVER CLOSED AT ALL.
            ;
            ; The hold above had exactly two outcomes: close it, or keep
            ; holding it. There was no third one that gives the window back.
            ; So a window that never gains a title -- which is what Main
            ; forming looks like when Overwolf is slow -- was cloaked, parked
            ; off-screen and re-parked every five seconds for the rest of the
            ; session:
            ;
            ;   FS-POPUP holding hwnd=1835868 ... it stays cloaked and parked
            ;   FS-POPUP cloaked and moved off-screen, not yet closed  (x40)
            ;
            ; Alive, invisible, unreachable, and indistinguishable from having
            ; been closed. The reasoning that produced the hold was right --
            ; destroying the user's Firestone is far worse than leaking a
            ; notification -- but "never close it" was implemented as "never
            ; resolve it", which is the same bug the tracker had when a
            ; misidentified window was buried forever.
            ;
            ; So the hold is now bounded in the direction that MATTERS. If it
            ; has been held this long and STILL no Main exists anywhere, then
            ; this window is Main: a notification would have had a real Main
            ; alongside it long ago, because Firestone does not send
            ; notifications when its own main window is not running. Give it
            ; back rather than sit on it.
            if (!_FSMainWindowPresent(hwnd)
             && (A_TickCount - _fsPopupFirstSeen[hwnd]) >= CFG.fsHoldReleaseMs) {
                _FSReleaseHeldAsMain(hwnd)
                return
            }
        } else if (!safeToClose
                && (A_TickCount - _fsPopupFirstSeen[hwnd]) >= CFG.fsPopupGraceMs) {
            safeToClose := true
        }

        ; ── A LOADING-TITLED WINDOW GETS A MUCH LONGER ROPE ─────────────────
        ; READ THIS BEFORE SHORTENING ANY OF IT.
        ;
        ; The grace above is calibrated for a window titled bare "Firestone":
        ; a forming Main wears that name for a second or so, a notification
        ; wears it for life, and three seconds separates them.
        ;
        ; It is NOT sufficient for a window titled "Firestone - Loading",
        ; because that name belongs to BOTH the notification and the startup
        ; splash -- and the splash becomes Firestone Main IN PLACE, on the same
        ; HWND. Closing it destroys the user's Firestone as it is starting.
        ; (The comment above claims this case is excluded by "never carried a
        ; Loading title"; the code never implemented that, and the only thing
        ; standing between a splash and a WM_CLOSE was the _fsMainCandidate
        ; refusal at the top of this function.)
        ;
        ; So for those windows the bar is one of:
        ;
        ;   (a) a SEPARATE window titled "Firestone - Main" exists right now,
        ;       which proves this one is not Main; or
        ;   (b) it has sat there wearing the Loading title for longer than
        ;       CFG.fsLoadingKillAfterMs -- five times the ordinary grace. A
        ;       splash that has not become Main in fifteen seconds is not going
        ;       to; a notification sits there indefinitely.
        ;
        ; and in neither case while a launch is in flight.
        if (_fsMainCandidate.Has(hwnd) && !safeToClose) {
            if ((A_TickCount - _fsPopupFirstSeen[hwnd]) < CFG.fsLoadingKillAfterMs)
                safeToClose := false
        }

        ; The _fsMainEverOpened precondition that used to sit on that second
        ; branch is GONE. It was meant as extra caution and acted as a third
        ; way for the close to be blocked forever -- if the flag never got set,
        ; a popup that appeared while Main was closed could never be closed at
        ; all, which is precisely the recurring complaint.
        ;
        ; Nothing is lost by removing it. The protection that matters is
        ; _fsMainCandidate, checked at the top of this function: an HWND that
        ; has ever carried the Main or Loading title can never be closed here,
        ; whatever it is titled now and whatever any flag says. That is a
        ; property of the window itself rather than of a flag somebody has to
        ; remember to set.

        if !safeToClose {
            ; ── INVISIBLE IS NOT ENOUGH. GET IT OUT OF THE WAY. ─────────────
            ; A DWM-cloaked window is not drawn, but it is still THERE: it
            ; still hit-tests, so it still swallows every mouse click that
            ; lands on it. A popup left cloaked in the middle of the screen
            ; over Hearthstone is an invisible sheet of glass over the board --
            ; the user clicks the game and nothing happens, with nothing on
            ; screen to explain why.
            ;
            ; So it is also moved off the virtual desktop. See
            ; _FSParkNotificationPopup for why that is a bare SetWindowPos and
            ; not _FSParkWindow.
            _FSParkNotificationPopup(hwnd)
            ; ── ONE LINE PER WINDOW PER COOLDOWN, NOT ONE PER SWEEP TICK ───
            ; This is reached from the funnel, which runs at 10-40 ms while a
            ; popup is refusing to close, and it wrote a synchronous line every
            ; single time. The last session's log has sixty of these per second
            ; for three seconds, in the exact window in which the Firestone
            ; windows this script is supposed to catch at birth were being
            ; born. The park above is the work; the line is the diagnostic, and
            ; the diagnostic was costing more than the work.
            if (!_fsPopupLogAt.Has(hwnd)
             || A_TickCount - _fsPopupLogAt[hwnd] >= CFG.fsPopupLogEveryMs) {
                _fsPopupLogAt[hwnd] := A_TickCount
                _FSLog("FS-POPUP cloaked and moved off-screen, not yet closed,"
                     . " hwnd=" . hwnd . " at " . why . " -- cannot yet prove it is"
                     . " not Firestone Main. It is invisible AND cannot intercept"
                     . " clicks; it will be closed the moment it can be told apart.")
            }
            return false
        }

        _fsPopupKilled[hwnd] := A_TickCount
        _CloseWindowAsync(hwnd)

        ; Park it in the same breath as the close request. _CloseWindowAsync is
        ; asynchronous by design, so between the request and the window actually
        ; going away there is a stretch in which it is still on the desktop --
        ; and if close-to-tray swallows the message, that stretch is the rest of
        ; the session. Parking costs one SetWindowPos and makes the difference
        ; invisible either way.
        _FSParkNotificationPopup(hwnd)

        ; Attempt counter, purely so the log stays useful without becoming a
        ; flood. Attempt 1 is the normal case and is what the log has always
        ; recorded. Attempt 2 is the one worth shouting about -- it means
        ; WM_CLOSE did not take, which is the close-to-tray interaction. After
        ; that the retries are silent: they continue on the cooldown, but a line
        ; every couple of seconds for the rest of the session would bury
        ; everything else in the file.
        n := _fsPopupKillCount.Get(hwnd, 0) + 1
        _fsPopupKillCount[hwnd] := n
        w := 0, h := 0
        try WinGetPos(, , &w, &h, "ahk_id " . hwnd)
        if (n = 1)
            _FSLog("FS-POPUP killed at " . why . " hwnd=" . hwnd
                 . " size=" . w . "x" . h . " -- cloaked, parked off-screen"
                 . " and closed on sight")
        else if (n = 2)
            _FSLog("FS-POPUP hwnd=" . hwnd . " SURVIVED its close and is being"
                 . " asked again (attempt " . n . ", at " . why . ")."
                 . " Firestone's close-to-tray setting can turn WM_CLOSE into"
                 . " 'the window stays'. It is cloaked and parked off the"
                 . " desktop throughout, so it is not on screen either way;"
                 . " further attempts are not logged.")
        return true
    }
    return false
}

; hwnd -> tick we first saw this window wearing a title bar. See the sticky
; caption test below; pruned with the other per-window ledgers.
; hwnd -> tick this window was seen wearing a REAL Firestone app name
; ("Firestone - Settings" and friends; not Loading, which the notification also
; wears). Once set it is permanent: a window that has ever named itself as one
; of Firestone's own surfaces is never a notification, whatever it is called
; later or what shape it is.
global _fsAppTitled := Map()

; hwnd -> tick this window was seen titled exactly "Firestone - Main". Distinct
; from _fsMainCandidate, which also records Loading-titled windows -- and the
; distinction is load-bearing, because the notification popup WEARS the Loading
; title on current builds. See _FSKillNotificationPopup.
global _fsWasMainTitled := Map()

; ══════════════════════════════════════════════════════════════════════════════
;  MAIN-TRACE — what actually happened to Firestone Main, in order
; ══════════════════════════════════════════════════════════════════════════════
;
; WHY THIS EXISTS. "Firestone Main keeps closing" was chased for a long time
; with a log that could not answer the only question that mattered: what
; touched the window before it died. A real example, and there is nothing
; wrong with these three lines except that they are all there was:
;
;   00:21:09  FS-HOLD [main] hwnd=5244330 hidden
;   00:21:10  FS-HOLD [main] freed hwnd=5244330 after 1891ms
;   00:21:17  FS-DESTROYED hwnd=5244330
;
; Seven seconds, no record, and a destroy line whose verdict came from a
; ledger that could not see a close sent from another process. That verdict
; read "this script did NOT ask it to close" for months while the script was,
; in fact, asking -- through a PowerShell sweep nothing here recorded.
;
; WHAT IT DOES. Every operation that can plausibly kill or hide a window is
; recorded against that window's handle: cloak, uncloak, hide, show, minimise,
; restore, close, alpha, park, taskbar changes. The entries are kept in a
; short ring per window and printed AS ONE LINE when the window is destroyed,
; so the log shows the window's whole history exactly where somebody reading
; it needs it -- rather than requiring them to reconstruct it from a hundred
; interleaved lines, or discover that it was never written down at all.
;
; COST. One array push per operation on a Firestone window, and a ring capped
; at 24 entries so a long-lived window cannot grow it without bound. Nothing
; is written to disk until a window dies. Windows that are never destroyed
; never produce a line.
;
; SCOPE. Only Firestone-family windows are traced. The point is to answer one
; question, and a trace of every window on the desktop would bury it.
; A NAMING TRAP WORTH RECORDING, BECAUSE IT COST AN HOUR.
; AutoHotkey identifiers are CASE-INSENSITIVE. A function named _FSTrace and a
; variable named _fsTrace are the SAME name, and declaring both is a load
; error -- which AutoHotkey reports by opening a dialog and waiting, so from a
; script it looks like a hang rather than a syntax failure. That is why the
; writer below is _FSTraceNote and not the obvious _FSTrace.
global _fsTrace := Map()          ; hwnd -> array of "t+Nms action" strings
global _fsTraceT0 := 0            ; session start, so offsets read as elapsed

; ── AND IT SHOUTS WHEN A WINDOW IS BEING WORKED TO DEATH ─────────────────────
;
; THREE SEPARATE OSCILLATIONS WERE FOUND IN THIS FILE THE SLOW WAY: by reading
; the trace off a window AFTER it had already been destroyed. Each time the
; pattern was obvious in hindsight and invisible while it was happening --
;
;   a topmost pin re-applied 37 times against a window that kept losing it
;   a hold re-asserted 500 times in eight seconds, then the window was gone
;   a reveal and a conceal taking turns, thirty milliseconds apart
;
; -- and each one cost a session of guessing. Every one of them passed through
; this function, dozens or hundreds of times, while nothing said a word.
;
; So the counter below is the general form of the lesson, rather than a fourth
; specific guard: no single window should receive many operations in a few
; seconds, whatever this script believes it is doing, and if one does then
; something is fighting something. It does not stop the operations -- it has no
; way to know which side is wrong -- it names the window and prints the last few
; things done to it, once, while it is still alive to be looked at.
;
; ONE LINE PER WINDOW PER SESSION. The point is to be noticed, not to become
; the noise it is warning about.
global _fsOpCount   := Map()   ; hwnd -> operations since the window below opened
global _fsOpWindow  := Map()   ; hwnd -> tick that counting window started
global _fsOpWarned  := Map()   ; hwnd -> already warned; never warn twice

_FSTraceNote(hwnd, action) {
    global _fsTrace, _fsTraceT0, _fsKnownTitle, _fsWasMainTitled
    global _fsOpCount, _fsOpWindow, _fsOpWarned, CFG
    if !hwnd
        return
    try {
        ; Only windows this script has already identified as Firestone's. The
        ; known-title ledger is populated by the funnel for every Firestone
        ; window it sees, so this costs one map lookup for everything else.
        if !(_fsKnownTitle.Has(hwnd) || _fsWasMainTitled.Has(hwnd))
            return
        if !_fsTraceT0
            _fsTraceT0 := A_TickCount
        if !_fsTrace.Has(hwnd)
            _fsTrace[hwnd] := []
        arr := _fsTrace[hwnd]
        ; Cap the ring. A window that lives through a whole session would
        ; otherwise accumulate one entry per sweep tick.
        if (arr.Length >= 24)
            arr.RemoveAt(1)
        arr.Push((A_TickCount - _fsTraceT0) . "ms " . action)

        ; ── THE RATE CHECK ──────────────────────────────────────────────────
        ; A rolling window, restarted whenever it expires, so a window that is
        ; touched steadily but slowly over a long session never trips it. Two
        ; map lookups and an add on the common path.
        now := A_TickCount
        if (!_fsOpWindow.Has(hwnd) || (now - _fsOpWindow[hwnd]) > CFG.fsOscillationMs) {
            _fsOpWindow[hwnd] := now
            _fsOpCount[hwnd]  := 0
        }
        _fsOpCount[hwnd] := _fsOpCount[hwnd] + 1

        if (_fsOpCount[hwnd] >= CFG.fsOscillationOps && !_fsOpWarned.Has(hwnd)) {
            _fsOpWarned[hwnd] := true
            ttl := ""
            try ttl := _fsKnownTitle.Has(hwnd) ? _fsKnownTitle[hwnd] : WinGetTitle("ahk_id " . hwnd)
            recent := ""
            start  := (arr.Length > 8) ? arr.Length - 7 : 1
            loop (arr.Length - start + 1)
                recent .= (recent = "" ? "" : " -> ") . arr[start + A_Index - 1]
            _FSLog("FS-OSCILLATION hwnd=" . hwnd . " `"" . ttl . "`" took "
                 . _fsOpCount[hwnd] . " operations in " . (now - _fsOpWindow[hwnd])
                 . "ms -- that is this script fighting something, almost"
                 . " certainly Overwolf, over a window Overwolf owns. Every time"
                 . " this file has done that the window eventually died. Last"
                 . " few: " . recent . " -- read this as a BUG in whichever two"
                 . " subsystems appear alternating above, not as a window that"
                 . " needs holding harder. One line per window per session.")
        }
    }
}

; The history as one line, oldest first. Empty string when nothing was traced,
; so the caller can leave the line out entirely rather than print "(none)".
_FSTraceDump(hwnd) {
    global _fsTrace
    try {
        if !_fsTrace.Has(hwnd)
            return ""
        arr := _fsTrace[hwnd]
        if !arr.Length
            return ""
        out := ""
        for e in arr
            out .= (out = "" ? "" : " -> ") . e
        return out
    }
    return ""
}

; hwnd -> true once the "Firestone Main is exempt" line has been written for it.
; One line per window, not one per sweep tick: the funnel runs at 15 ms during
; the launch and this branch is on its hot path.
global _fsMainExemptLogged := Map()

IsFirestoneNotificationPopup(hwnd, title) {
    global CFG, _fsAppTitled

    ; ── THE TITLES THIS THING ACTUALLY WEARS ────────────────────────────────
    ; It was matched on the bare name "Firestone" alone. On current builds the
    ; "Your abilities are ready!" window RETITLES ITSELF to
    ; "Firestone - Loading" -- the same name the startup splash uses -- and
    ; from that moment nothing recognised it as a notification:
    ;
    ;   * the closer stopped matching it, so it was never closed;
    ;   * FSShouldSuppress returns false while UNLOCKED, so the namechange
    ;     janitor classified it as benign, released it and SHOWED it.
    ;
    ; That pair is the whole of "F3 still opens the Firestone popup". F3 was
    ; not summoning a window it had hidden -- it was releasing one nothing
    ; could name.
    if !(title = "Firestone" || title = "Firestone - Loading")
        return false

    ; Permanent identity beats every heuristic below. A window that has worn a
    ; real Firestone app name is one of Firestone's own and is never closed.
    if _fsAppTitled.Has(hwnd)
        return false

    ; ── GUARD: DO NOT CLOSE FIRESTONE‑MAIN ──────────────────────────────────
    ; Firestone‑Main can briefly wear the bare "Firestone" title before it
    ; becomes "Firestone - Main". If at that moment its size falls inside the
    ; 300‑800px envelope (e.g., a small restored window, or a brief loading
    ; state), the size test below would incorrectly classify it as a popup.
    ; _FSIsMainSurface recognises Main by its size, style, and birth timing,
    ; independent of its current title – if this window is Main, it is not a popup.
    if _FSIsMainSurface(hwnd, title)
        return false

    w := 0, h := 0
    try WinGetPos(, , &w, &h, "ahk_id " . hwnd)
    if (w < 300 || h < 300 || w > 800 || h > 800)
        return false
    exStyle := 0
    try exStyle := WinGetExStyle("ahk_id " . hwnd)
    if (exStyle & 0x20)   ; WS_EX_TRANSPARENT — click‑through overlay, never close
        return false

    ; ── A WINDOW WITH A TITLE BAR IS NOT A NOTIFICATION ─────────────────────
    ; THIS IS THE FIX FOR "THE SCRIPT CLOSED MY SETTINGS WINDOW".
    ;
    ; CFG.fsNeverConcealTitles keeps hands off "Firestone - Settings" -- but
    ; that list matches the SETTLED title, and this function is called from the
    ; NAMECHANGE handler while the window is still called plain "Firestone".
    ; Settings is 780x620. The envelope above is 300..800. So every Settings
    ; window the user opened was matched here and sent a WM_CLOSE before it had
    ; a name the never-conceal list could recognise:
    ;
    ;   FS-POPUP killed at namechange hwnd=1442710 size=780x620
    ;   FS-POPUP killed at namechange hwnd=1967662 size=780x620   (x18 more)
    ;
    ; Eighteen of those in one session, all at exactly Settings' dimensions.
    ;
    ; The discriminator is structural and it is the same one the overlay
    ; detection uses: Overwolf's notification toasts are chromeless CEF popups
    ; with custom-drawn headers and no WS_CAPTION. A window carrying a real
    ; title bar and system menu is a dialog the user opened by clicking
    ; something, and this script does not close those.
    ;
    ; ── THE WS_CAPTION TEST IS GONE, AND THIS NOTE IS WHY IT MUST STAY GONE ─
    ; A previous attempt protected Settings by refusing to treat any window
    ; with a title bar as a notification, on the reasoning that Overwolf's
    ; toasts are chromeless. THE REASONING WAS WRONG: this build's
    ; notification draws a header with a settings gear, a Discord button, a
    ; minimise and a close -- it is chrome-shaped, and the test therefore
    ; protected the exact window it was meant to remove.
    ;
    ; Settings is protected properly instead, by identity rather than by
    ; appearance: _fsAppTitled above records any window that has ever worn a
    ; real Firestone name, permanently, and the settle path below refuses to
    ; close a bare-titled window until it has had time to declare one. A
    ; window's name is a fact about it; its window styles are a guess.
    ; NO WS_EX_TOPMOST EXCLUSION HERE -- and this comment exists so it is not
    ; added back.
    ;
    ; It was, on the theory that Overwolf draws its in-game surfaces topmost so
    ; a pinned comp panel would be excluded by that bit. The theory was wrong in
    ; the way that mattered: the "Your abilities are ready!" notification is
    ; topmost too, so the exclusion did not protect pins, it simply stopped this
    ; function ever identifying anything, and the popup the closer exists to
    ; remove was never removed. It sat on screen being cloaked and un-cloaked by
    ; the F3 lock instead of being closed.
    ;
    ; Pins are protected by the mechanism that was actually broken -- see
    ; UncloakWindow's _MapDrop note, where an exception was aborting the overlay
    ; topmost enforcer on nearly every tick. If a pinned panel is ever closed
    ; anyway, the FS-POPUP log line below names the exact window and size, which
    ; is the evidence needed to write a discriminator that is not a guess.
    return true
}

;  Per-hwnd tick of the first time a window matched the popup shape while
;  titled exactly "Firestone". Retained as evidence that the window's size has
;  settled, and for the log; it no longer gates whether the window is closed.
global _fsNotifFirstMatch := Map()
global _fsDeferredPopupCloak := Map()   ; hwnd -> tick handed over by the
                                        ; blanket's stop-release

; BACKSTOP sweep for the Firestone notification popup.
;
; The popup is normally dead before this ever sees it: the NAMECHANGE handler
; in the window event hook kills it within milliseconds of it being titled, and
; the suppression funnel kills any that reaches it. This sweep exists for the
; cases an event cannot cover -- a popup that already existed when the script
; started, or one created while the hook was being re-armed.
;
; The guards that remain are the ones that protect Firestone's REAL windows,
; and they are structural rather than timing-based:
;   * ABSOLUTE: an HWND that has ever carried the "Firestone - Main" or
;     "Firestone - Loading" title is never closed, whatever it is titled now
;     (_fsMainCandidate). This is the guarantee; everything else is secondary.
;   * ABSOLUTE: never close a window flagged by the pre-title alpha shield
;     (the >=600x400 formation profile of a Main still being built).
;   * Never close a minimized window.
;
; The old ten-second, then 1.2-second, "hold the match before acting" timer is
; gone. It was a proxy for the identity question above, which is now answered
; directly and cannot be fooled by timing -- and every millisecond it bought in
; safety was a millisecond of nag popup on screen, which is the complaint.
_HSIsForeground() {
    try return WinActive("ahk_exe Hearthstone.exe") != 0
    return false
}

; Is the user currently interacting with Overwolf / Firestone itself?
;
; Used as the "did the user ask for this window?" test, because a window the
; user opened by clicking inside Firestone arrives while Firestone holds the
; foreground, whereas one Firestone creates on its own during a match arrives
; while Hearthstone does. Cheap: one GetForegroundWindow and one process-name
; lookup, and only on the narrow path that needs it.
_FSFamilyHasForeground() {
    global CFG
    try {
        fg := DllCall("user32\GetForegroundWindow", "Ptr")
        if !fg
            return false
        exe := WinGetProcessName("ahk_id " . fg)
        for e in CFG.fsFamilyExes {
            if (exe = e)
                return true
        }
    }
    return false
}

CloseFirestoneNotificationPopups() {
    global _EarlyOWCloakActive, State, _fsNotifFirstMatch
    global _fsDeferredPopupCloak, _fsAlphaApplied, _fsMainCandidate

    ; guard 1 -- kept for the early pre-title blanket, where windows genuinely
    ; have no identity yet.
    if _EarlyOWCloakActive
        return

    ; GUARD 1b REMOVED: the popup closer now runs regardless of F3 lock state.
    ; The popup must be terminated on creation, not toggled by F3.

    ; NO "STAND DOWN DURING A MATCH" GUARD HERE, deliberately.
    ;
    ; One was added, suppressing the close whenever the overlay was visible and
    ; Hearthstone had the foreground. That is the state a Battlegrounds player
    ; is in for essentially the whole session -- and it is also exactly when the
    ; "Your abilities are ready!" notification appears. The guard therefore
    ; disabled the closer at the only time it was ever needed.

    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(3)   ; exact match only

    matched := Map()
    try {
        ; ONE ENUMERATION, NOT TWO.
        ;
        ; This walked both Overwolf executables to work out whether a titled
        ; Firestone - Main exists, then walked both again to act. Each walk is a
        ; full EnumWindows over every top-level window on the desktop with a
        ; process-name lookup per window, so the pass that only sets a boolean
        ; cost exactly as much as the pass that does the work. Collect once,
        ; decide, then act on what was collected.
        fsMainPresent := false
        owWnds := []
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    t := WinGetTitle("ahk_id " . h)
                    owWnds.Push({hwnd: h, title: t})
                    if IsFirestoneMainTitle(t)
                        fsMainPresent := true
                } catch {
                }
            }
        }

        {
            for ow in owWnds {
                try {
                    h     := ow.hwnd
                    title := ow.title
                    if !IsFirestoneNotificationPopup(h, title)
                        continue

                    ; ── GUARD 2 IS GONE, AND THIS IS WHY ──────────────────────
                    ; It read `if !fsMainPresent continue`: refuse to act unless
                    ; a SEPARATE window titled exactly "Firestone - Main" exists
                    ; right now.
                    ;
                    ; _FSKillNotificationPopup already makes that exact decision,
                    ; and makes it correctly. Its own header explains why the
                    ; one-way form was wrong and was replaced: "requiring (a)
                    ; alone was too strict: a notification arriving while Main is
                    ; closed could then never be closed at all, which is the
                    ; 'popup was not closed' report." So it now accepts EITHER a
                    ; present Main OR the bare-"Firestone" title held past
                    ; CFG.fsPopupGraceMs.
                    ;
                    ; That fix went into the callee and this caller kept the old,
                    ; stricter copy in front of it -- so on any session where the
                    ; window never carries the literal title "Firestone - Main",
                    ; this backstop never even called the function that knows how
                    ; to handle the case. A full session's log with a nag popup
                    ; visible on screen contains not one "FS-POPUP killed" line
                    ; and dozens of "not yet closed": this guard is the reason.
                    ;
                    ; Nothing is loosened by removing it. The Main check still
                    ; runs, one level down, as the FAST path -- plus the absolute
                    ; _fsMainCandidate identity ledger, the size envelope, the
                    ; minimize guard and the size-stability pass below.
                    ;
                    ; guard 3 -- identity. An HWND that has ever carried the "Firestone - Loading"
                    ; or "Firestone - Main" title can never be closed here, whatever it is titled
                    ; now.
                    ;
                    ; This is the guarantee directly; testing whether the window is currently
                    ; DWM-cloaked is only a proxy for it, and one that collapses as soon as
                    ; concealment cloaks every suppressed surface.
                    if _fsMainCandidate.Has(h)              ; guard 3
                        continue
                    if (WinGetMinMax("ahk_id " . h) = -1)   ; guard 4
                        continue
                    ; guard 3b -- LEFT AT FULL STRENGTH, ON PURPOSE.
                    ;
                    ; This was briefly relaxed to test the map's VALUE rather
                    ; than the presence of the key, on the reasoning that with
                    ; CFG.fsUseAlphaShield off every window the funnel touches
                    ; gets a key written, so the guard fires for everything.
                    ; That reasoning is correct as far as it goes -- and it is
                    ; not worth acting on, because what sits behind this guard
                    ; is a WM_CLOSE, and a WM_CLOSE aimed at the wrong window
                    ; has already cost this user a Firestone session: three
                    ; windows measuring 780x620 and titled "Firestone" were
                    ; closed in two seconds while Firestone Main was open.
                    ;
                    ; Real Firestone UI does appear inside the popup's size
                    ; envelope carrying the popup's title. Until the tray item
                    ; "Log Firestone's windows" says which windows those are,
                    ; every existing brake on closing stays on.
                    ;
                    ; What changes is only what happens when the brake engages.
                    ; Declining to CLOSE is not a reason to let the window
                    ; PAINT: conceal it and move on, so a popup this guard
                    ; protects is invisible rather than on screen.
                    if _fsAlphaApplied.Has(h) {             ; guard 3b
                        _FSConcealNotificationPopup(h)
                        continue
                    }

                    wNow := 0, hNow := 0
                    try WinGetPos(, , &wNow, &hNow, "ahk_id " . h)
                    matched[h] := true
                    if (!_fsNotifFirstMatch.Has(h)
                     || _fsNotifFirstMatch[h].w != wNow
                     || _fsNotifFirstMatch[h].h != hNow) {
                        _fsNotifFirstMatch[h] := {t: A_TickCount, w: wNow, h: hNow}
                        ; Same rule as guard 3b: this pass is not yet willing to
                        ; close the window, which says nothing about whether it
                        ; may be seen. Conceal it now, on this lock-independent
                        ; 750 ms timer, so a popup is invisible from the first
                        ; sweep that recognises it rather than from whenever the
                        ; F3-gated funnel next happens to run.
                        _FSConcealNotificationPopup(h)
                        continue
                    }
                    ; NO STABILITY WAIT. This sweep is now a BACKSTOP: the
                    ; popup is normally killed by the NAMECHANGE handler within
                    ; milliseconds of being titled, and only reaches here if
                    ; that event was missed -- a hook that was not armed yet, a
                    ; window that existed before the script started. Having
                    ; identified it, waiting a further settling period before
                    ; acting would only extend the time it is on screen, which
                    ; is the entire complaint.
                    ;
                    ; The stability ledger is still maintained above, because it
                    ; is what proves the window's size settled -- but it no
                    ; longer gates the kill.
                    _FSKillNotificationPopup(h, "sweeper backstop")
                } catch {
                }
            }
        }

        ; Prune ledger entries that did not match this pass.
        stale := []
        for h in _fsNotifFirstMatch {
            if !matched.Has(h)
                stale.Push(h)
        }
        for h in stale
            _fsNotifFirstMatch.Delete(h)

        ; Deferred‑set hygiene.
        staleDef := []
        for h in _fsDeferredPopupCloak {
            keep := false
            try {
                if DllCall("user32\IsWindow", "Ptr", h) {
                    tD := WinGetTitle("ahk_id " . h)
                    keep := (tD = "Firestone" || tD = "")
                }
            }
            if !keep
                staleDef.Push(h)
        }
        for h in staleDef {
            _fsDeferredPopupCloak.Delete(h)
            try {
                if !DllCall("user32\IsWindow", "Ptr", h)
                    continue
                t := WinGetTitle("ahk_id " . h)
                if (IsFirestoneSuppressionTitle(t) && State.fsMainLocked)
                    continue
                if _fsAlphaApplied.Has(h)
                    _RemoveFSAlphaShield(h)
                _FSReleaseSurface(h)   ; unpark, then uncloak
            }
        }
    }
    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}

; ── Firestone notification‑popup sweeper (F2 launch window) ──────────────────
; The bare‑"Firestone" nag popup is the ONE Firestone window we deliberately
; CLOSE rather than hide. The sweeper runs on a gentle cadence for 90s.
global _fsNotifSweepUntil := 0

StartFSNotifSweeper() {
    global _fsNotifSweepUntil, _fsNotifFirstMatch
    _fsNotifSweepUntil := 0   ; no expiry – runs forever
    _fsNotifFirstMatch := Map()
    SetTimer(FSNotifSweepTick, 750)
    CloseFirestoneNotificationPopups()   ; immediate pass
}

StopFSNotifSweeper() {
    global _fsNotifSweepUntil
    _fsNotifSweepUntil := 0
    SetTimer(FSNotifSweepTick, 0)
    _ReleaseDeferredPopupCloaks()
}

FSNotifSweepTick() {
    ; The sweeper runs indefinitely at a gentle cadence, closing the
    ; notification popup whenever it appears. It is not tied to F3 lock state.
    CloseFirestoneNotificationPopups()
}

; Janitor of last resort for the deferred‑popup set.
_ReleaseDeferredPopupCloaks() {
    global _fsDeferredPopupCloak, _fsAlphaApplied, State, _fsMainCandidate

    fsMainPresent := false
    prevDHW := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for hh in WinGetList("ahk_exe " . exe) {
                try {
                    if IsFirestoneMainTitle(WinGetTitle("ahk_id " . hh))
                        fsMainPresent := true
                }
            }
        }
    }
    DetectHiddenWindows prevDHW

    for h, tickIn in _fsDeferredPopupCloak.Clone() {
        try {
            if !DllCall("user32\IsWindow", "Ptr", h)
                continue
            t := WinGetTitle("ahk_id " . h)
            if (IsFirestoneSuppressionTitle(t) && State.fsMainLocked)
                continue

            ; TOAST PROOF — HARDENED. A member is now closable only when ALL
            ; of these hold:
            ;   • never flagged by the pre‑title alpha shield,
            ;   • its RESTORED size is inside the popup envelope,
            ;   • a titled Firestone - Main exists RIGHT NOW,
            ;   • it has held the bare title for >=45s.
            ; Same rule as the sweeper: never close anything while the lock
            ; is off and the user is looking at Firestone's windows.
            closable := false
            if (State.fsMainLocked
             && t = "Firestone"
             && IsFirestoneNotificationPopup(h, t)
             && !_fsAlphaApplied.Has(h)
             && !_fsMainCandidate.Has(h)      ; same identity guard as the closer
             && fsMainPresent
             && (A_TickCount - tickIn >= 45000)) {
                _GetRestoredSize(h, &dw, &dh)
                if (dw >= 300 && dh >= 300 && dw <= 800 && dh <= 800)
                    closable := true
            }
            if closable {
                try _CloseWindowAsync(h)
                continue
            }

            if _fsAlphaApplied.Has(h)
                _RemoveFSAlphaShield(h)
            _FSReleaseSurface(h)   ; unpark, then uncloak
        }
    }
    _fsDeferredPopupCloak := Map()
}

; ──────────────────────────────────────────────────────────────────────────────
; Firestone‑Main suppression model
; ──────────────────────────────────────────────────────────────────────────────
;
; While the F3 lock is ON (State.fsMainLocked), every FSMainMonitor tick:
;   • DWM‑cloaks FS‑Main (async compositor‑level invisibility),
;   • applies the ALPHA SHIELD (WS_EX_LAYERED, alpha 0) to windows that were
;     not already layered — Overwolf‑layered ones are recorded, never touched,
;   • re‑minimizes it animation‑free (SetWindowPlacement) if it isn't
;     minimized, throttled to one attempt per 250ms per hwnd.
;
; Cadence:
;   Burst (1ms)   → during F2 pipeline and Firestone‑Loading suppression window
;   Coast (200ms) → after CompleteHSLaunchSuccess (safety net only)
;   Off           → F3 unlocked

; ── EVERY CHANGE TO THE F3 LOCK GOES THROUGH HERE, AND SAYS WHO DID IT ───────
;
; The lock is the single most consequential piece of state in this file: it
; decides whether Firestone's windows are concealed or shown, and every
; suppressor and the reveal both read it. It was written directly, from four
; places, with nothing recording the transition.
;
; THAT COST A LOT OF TIME. The log showed a reveal running with locked=1 --
; a state the reveal explicitly refuses to run in -- and the guard that refuses
; it never fired once. Both of those are only possible if the lock is being
; TOGGLED rather than held, and no line in the log could show that, because
; nothing wrote one. So the trail ended at "something changes the lock" with no
; way to name it.
;
; Now the transition is the log line, and only real transitions are written --
; setting it to the value it already has is silent, which keeps the idempotent
; callers (start-up arming, a second F2) from adding noise.
_FSSetLock(v, why) {
    global State
    v := v ? true : false
    if (State.fsMainLocked = v) {
        State.fsMainLocked := v
        return
    }
    State.fsMainLocked := v
    _FSLog("FS-LOCK " . (v ? "ON  (conceal Firestone)" : "OFF (show Firestone)")
         . " <- " . why
         . " -- the lock and the reveal are opposite states; if these lines"
         . " alternate every few seconds then something is toggling it and the"
         . " concealment and the reveal will take turns on the same window"
         . " until Overwolf gives up on it.")
}

LockFirestoneMain() {
    global State, _fsMinLastAttempt, Launch, CFG, _fsPinnedByUs
    StopFSReveal()               ; a re‑lock must cancel any in‑flight F3 reveal
    _FSSetLock(true, "LockFirestoneMain")
    _fsMinLastAttempt := Map()   ; fresh lock ⇒ first minimize fires immediately

    ; ── DROP THE PINS BEFORE CONCEALING, NOT AFTER ──────────────────────────
    ; The reveal pins these windows topmost and the front keeper holds the pin
    ; there; a re-lock is the moment that pin stops being wanted. Doing it
    ; here, before the suppression passes below, matters: a window that is
    ; cloaked or parked while still WS_EX_TOPMOST keeps the bit for as long as
    ; it is concealed, and the next thing to show it -- Overwolf itself, the
    ; stranded-window repair, an exit janitor -- hands the user a window
    ; floating above everything with no reveal to explain it.
    ;
    ; Only pins this script added are dropped. A window Overwolf pinned itself
    ; is left exactly as found; see _FSDropOurPin.
    try {
        for h in _fsPinnedByUs.Clone()
            _FSDropOurPin(h)
    }


    ; ── NO WATCHDOG, NO BURST, NO ENFORCEMENT PASS ──────────────────────────
    ;
    ; This used to arm FSMainMonitor at 50 ms for the life of the lock and run
    ; two synchronous suppression passes on top. That watchdog is the ~62 ms
    ; operation storm visible in every recorded Main death, and concealment of
    ; Main is now a no-op regardless -- see _FSConcealMain. Arming a timer to
    ; call a function that does nothing, sixteen times a second, is the purest
    ; form of the problem this change exists to remove.
    ;
    ; The lock STATE is kept: F3 still toggles, and everything that reads the
    ; lock still gets a truthful answer. What is gone is the WATCHDOG.

    ; ── ONE PASS. NOT NONE, AND NOT TWO. ────────────────────────────────────
    ;
    ; Removing the watchdog also removed the two SuppressFirestoneMainTick
    ; calls that used to sit here, and that left F3 with a working reveal and a
    ; lock that concealed nothing -- the window simply stayed on screen. That
    ; is what "the park and unpark is crude compared to what we had" was.
    ;
    ; The concealment has to happen SYNCHRONOUSLY, in this thread turn, because
    ; there is no longer a timer coming along behind to catch it. A keypress is
    ; the right moment to do work: the user asked, once, and one pass answers.
    ;
    ; The second "stress hardening" pass is NOT restored. It existed because a
    ; re-lock landing microseconds after an unlock could race the burst; with no
    ; burst and no watchdog there is nothing to race, and running the whole
    ; sweep twice per keypress is the habit this file is being cured of.
    SuppressFirestoneMainTick()
    ; The overlay has just been concealed, so the game should own the screen
    ; again. Marking it fullscreen is not enough on its own -- the shell only
    ; hides the taskbar for a covering window that is also FOCUSED. This is
    ; the same call the tracker makes on its own conceal.
    try _HSEnsureFullscreenOwnership(true)
}

; ── Burst controls ────────────────────────────────────────────────────────────
; Ref‑count for timeBeginPeriod(1). Multiple subsystems may all need high‑res
; resolution simultaneously.
global _highResRefCount := 0

_AcquireHighResTimer() {
    global _highResRefCount
    if (_highResRefCount = 0)
        try DllCall("winmm\timeBeginPeriod", "UInt", 1)
    _highResRefCount++
}

_ReleaseHighResTimer() {
    global _highResRefCount
    if (_highResRefCount <= 0) {
        _highResRefCount := 0
        return
    }
    _highResRefCount--
    if (_highResRefCount = 0)
        try DllCall("winmm\timeEndPeriod", "UInt", 1)
}

_ForceReleaseHighResTimer() {
    global _highResRefCount, _fsBurstHasRef, _HSCloakerHasRef, _EarlyOWCloakHasRef, _launcherHideHasRef
    if (_highResRefCount > 0)
        try DllCall("winmm\timeEndPeriod", "UInt", 1)
    _highResRefCount     := 0
    _fsBurstHasRef       := false
    _HSCloakerHasRef     := false
    _EarlyOWCloakHasRef  := false
    _launcherHideHasRef  := false
}

; ── Normal burst (FSMainMonitor at 1ms + timeBeginPeriod) ────────────────────
; Each subsystem owns exactly one boolean tracking whether it currently holds
; a high‑res ref.
global _fsBurstHasRef := false

; How long the current burst is scheduled to last. Lets a short event-driven
; nudge and a long launch burst coexist without the short one cutting the long
; one off -- see _FSEventNudge.
global _fsBurstUntil := 0
; End of the current NUDGE episode (see _FSEventNudge). Separate from
; _fsBurstUntil: a launch burst and an event nudge have different rates,
; different lifetimes, and only one of them takes the high-resolution timer.
global _fsNudgeUntil := 0

; ── HAS THE FAST SWEEP CAUGHT WHAT IT EXISTS TO CATCH? ───────────────────────
;
; The burst's whole purpose is to already be sweeping when Firestone Main is
; created, so the window is concealed before a frame of it reaches the screen.
; This answers whether that has happened.
;
; A CONDITION, NOT A CLOCK -- and that is the point. "Twenty seconds" means a
; different amount of work on every machine: a fast one finishes the launch in
; eight and then sweeps twelve seconds of nothing at the highest cadence in the
; file, while holding the system timer resolution up. A slow one may not be
; finished at twenty. Ending on the thing that actually matters is what makes
; the behaviour the same everywhere, which is the only property worth having.
;
; TRUE when Main has been dealt with and has settled:
;   * held by the birth blanket, and the hold landed at least a settle ago; or
;   * already freed by F3, in which case there is nothing left to catch.
;
; The settle exists because Overwolf creates its windows in a cluster and Main
; is not reliably the last one out. Standing down the instant the hold lands
; would end the burst while its siblings are still being born.
;
; FALSE is always safe: the caller falls through to the fixed ceiling that
; bounded the burst before this existed, so this can only ever shorten it.

StartFSBurst() {
    global State, _fsBurstHasRef, CFG, _fsBurstUntil
    if !State.fsMainLocked
        return

    _fsBurstUntil := A_TickCount + CFG.fsBurstMaxMs
    if !_fsBurstHasRef {
        _AcquireHighResTimer()
        _fsBurstHasRef := true
    }

    ; Re-arm the decay on every call: a burst is a fixed-length window that
    ; restarts whenever something worth bursting for happens (a lock, an F2).
    ; Without this the 1 ms rate ran for the ENTIRE locked period -- and since
    ; the lock is armed at startup and only ever cleared by F3, that meant
    ; permanently, from boot.
    SetTimer(_FSBurstDecay, -CFG.fsBurstMaxMs)
}

; Drop the suppression sweep from the burst rate to the coast rate and give up
; the high-resolution timer period. Suppression itself is unchanged -- only how
; often it re-checks. Safe to call at any time, including twice.
; ── EVENT NUDGE: what makes the settled 250 ms rate safe ─────────────────────
;
; The suppression sweep has three speeds, and the slowest one exists because a
; settled session creates no new windows for minutes at a time. The obvious
; hole in that reasoning is the moment it stops being true -- Firestone opens
; its Battlegrounds window when a match starts, and if the sweep is idling at
; 250 ms that window has a quarter of a second to paint before the backstop
; notices. That is a visible flash across the screen, and it is exactly what
; was reported.
;
; The window event hook sees every creation the instant it happens, so the
; script already knows the moment "nothing is happening" stops being true. This
; is the sweep reacting to that: any newborn Overwolf window snaps the cadence
; straight back to burst speed for a few seconds, then it decays again.
;
; It never SHORTENS an existing burst -- a launch burst is twenty seconds and a
; nudge is three, and a window created during a launch must not cut the launch
; burst down to its own length. _fsBurstUntil is the comparison that prevents
; that.
; ── THIS FUNCTION WAS THE PERFORMANCE BUG. WHAT FOLLOWS IS WHY. ──────────────
;
; The first version pinned the sweep at fsBurstMs (10 ms) for three seconds and
; took a timeBeginPeriod(1) reference to do it, re-arming BOTH on every Overwolf
; window creation, with a throttle of one nudge per 10 ms. Three compounding
; mistakes:
;
;   * SetTimer(fn, -3000) on an already-pending one-shot RESETS the countdown.
;     Every nudge pushed the only release path three seconds further out.
;   * The "a longer burst already covers this" test compares against a horizon
;     that is always three seconds in the future, so it can never be true for
;     one nudge following another. It stops a nudge shortening a LAUNCH burst;
;     it does nothing to stop nudges accumulating.
;   * Nothing anywhere bounded the total.
;
; So one Overwolf window created every three seconds -- which a Chromium app
; hosting a live overlay clears easily during a match -- was enough to hold the
; sweep at 100 Hz and the system timer at 1 ms resolution for the entire
; session. Measured against what the sweep actually does, that is three full
; desktop window enumerations per tick, each resolving the owning process name
; for every top-level window on the machine: on the order of 75,000 OpenProcess
; calls a second, saturating a core, next to the game. That is the reported
; slowdown.
;
; Three changes, and the first is the important one:
;
;   1. THE NUDGE NO LONGER GOES TO BURST SPEED. It goes to the COAST rate. The
;      burst rate exists to win a race against a window's first paint at birth,
;      and the CREATE hook already conceals the window before this is even
;      called -- the sweep is the backstop, and a backstop does not need 100 Hz.
;      Coast is five times cheaper and still five times faster than settled.
;   2. NO HIGH-RESOLUTION TIMER. At a 50 ms cadence the default platform
;      resolution is entirely adequate, so this no longer touches
;      timeBeginPeriod at all -- which is what was raising the system-wide
;      interrupt rate and keeping the CPU out of its deeper idle states while
;      the user was playing.
;   3. A CEILING, AND A REAL THROTTLE. Nudges may extend the elevated cadence
;      for at most fsNudgeCeilingMs from the first one of an episode, and at
;      most one nudge per fsNudgeThrottleMs is considered at all.
;
; It still never shortens a launch burst: that path holds _fsBurstHasRef, and
; this returns immediately when it is set.
_FSEventNudge() {
    global State, _fsBurstHasRef, _fsNudgeUntil, CFG
    static lastNudge := 0, epochStart := 0
    if (!State.fsMainLocked || CFG.fsEventBurstMs <= 0)
        return
    ; A launch burst owns the cadence outright and is already faster than this.
    if _fsBurstHasRef
        return
    ; Chromium creates windows in clusters -- a visible frame plus several
    ; hidden IPC surfaces within a few milliseconds of each other. One nudge
    ; covers the whole cluster.
    if (lastNudge && A_TickCount - lastNudge < CFG.fsNudgeThrottleMs)
        return

    ; An episode is a run of nudges with no gap long enough to let the elevated
    ; cadence decay. Anchored on the first nudge after a quiet period, and
    ; capped, so a steady trickle of window creations can no longer hold the
    ; sweep up indefinitely.
    if (!epochStart || A_TickCount > _fsNudgeUntil)
        epochStart := A_TickCount
    else if (A_TickCount - epochStart > CFG.fsNudgeCeilingMs)
        return

    lastNudge     := A_TickCount
    _fsNudgeUntil := A_TickCount + CFG.fsEventBurstMs
    SetTimer(_FSNudgeDecay, -CFG.fsEventBurstMs)
}

; End a nudge episode: hand the cadence back to FSMainMonitor's own decision.
; Deliberately does NOT touch _fsBurstHasRef or the high-resolution timer --
; a nudge never took either.
_FSNudgeDecay(*) {
    global State, _fsNudgeUntil, _fsBurstHasRef
    _fsNudgeUntil := 0
    if (!State.fsMainLocked || _fsBurstHasRef)
        return
}

_FSBurstDecay(*) {
    global State, _fsBurstHasRef, CFG, _fsBurstUntil
    ; ── CANCEL THE PENDING ONE-SHOT BEFORE DOING ANYTHING ELSE ──────────────
    ; StartFSBurst arms this as a one-shot at fsBurstMaxMs. Now that the burst
    ; can also stand down EARLY, that one-shot can still be in flight when it
    ; does -- and if a new burst starts in the gap (another window appears, a
    ; second F2), the stale timer fires and decays the NEW burst before it has
    ; done its job. A window would then be born into the coast cadence with
    ; nothing sweeping fast enough to catch it, intermittently, depending
    ; entirely on timing -- the exact class of bug this pass exists to remove.
    ;
    ; Cancelling here makes the decay idempotent: it does not matter whether
    ; it was reached early, on time, or twice.
    SetTimer(_FSBurstDecay, 0)
    _fsBurstUntil := 0
    if _fsBurstHasRef {
        _ReleaseHighResTimer()
        _fsBurstHasRef := false
    }
    if !State.fsMainLocked {
        SetTimer(FSMainMonitor, 0)
        return
    }
}

StopFSBurst() {
    global State, _fsBurstHasRef, CFG, _fsBurstUntil

    _fsBurstUntil := 0
    SetTimer(_FSBurstDecay, 0)          ; no decay can fire after an explicit stop

    if _fsBurstHasRef {
        _ReleaseHighResTimer()
        _fsBurstHasRef := false
    }

    if !State.fsMainLocked {
        SetTimer(FSMainMonitor, 0)
        return
    }

    ; Previously this re-armed the 1 ms rate whenever ANY other subsystem still
    ; held a high-res timer ref -- so stopping the burst could leave the sweep
    ; running at full speed indefinitely. Coast unconditionally instead.
}

; Suppression tick. Cloaks FS‑Main / FS‑Loading so DWM refuses to render them.
SuppressFirestoneMainTick() {
    global State, CFG, _fsBirthHidden, _fsHiddenByUs, _fsAlphaApplied, _fsWasMainTitled
    global _cloakState, _fsMainCandidate, _fsExemptReleased
    global _fsParked, _fsTabRemoved, _fsOverlayRescued

    ; ---- birth-hide timeout sweep (safety net) ----
    ; Guarantees no window stays hidden by accident: anything birth-hidden
    ; that never resolved to one of our titles is force-shown once it is
    ; older than CFG.fsBirthHideMaxMs. Usually iterates an empty map.
    if _fsBirthHidden.Count {
        for bhwnd, bat in _fsBirthHidden.Clone() {
            try {
                if !DllCall("user32\IsWindow", "Ptr", bhwnd) {
                    _MapDrop(_fsBirthHidden, bhwnd)
                    continue
                }
                if (A_TickCount - bat < CFG.fsBirthHideMaxMs)
                    continue
                btitle := ""
                try btitle := WinGetTitle("ahk_id " . bhwnd)
                ; _MapDrop: this iterates a Clone, so a hotkey thread can have
                ; removed the key already. A throw here would skip the
                ; reveal/keep-hidden decision below entirely.
                _MapDrop(_fsBirthHidden, bhwnd)
                ; Allow-list, not deny-list. Classifying by exclusion -- suppress a short list
                ; of known titles and reveal everything else -- means any Overwolf window with
                ; an unrecognised title ("OverWolf Server", untitled CEF frames) is treated as
                ; benign and actively shown. Only titles on CFG.fsVisibleTitles are released;
                ; everything else stays concealed while the lock is on.
                if FSShouldSuppress(btitle) {
                    ; ── MAIN IS CONCEALED, NEVER LEFT HIDDEN ────────────────
                    ; fsBirthHide SW_HIDEs EVERY new Overwolf window at CREATE,
                    ; before it has a title to judge, and this tick is where
                    ; that hide is reconsidered fsBirthHideMaxMs later. For
                    ; Firestone Main the answer used to be "yes, suppress",
                    ; which set _fsHiddenByUs and left the window SW_HIDDEN for
                    ; the rest of its life.
                    ;
                    ; Measured 2026-09-06 with an independent watchdog: Main
                    ; lived 24 seconds at vis=False, never painted a frame,
                    ; never appeared on the taskbar, and the user never saw it.
                    ; The log line for that window read "kept-hidden". None of
                    ; the concealment work elsewhere could reach it, because
                    ; this path had already taken the window out of play.
                    ;
                    ; Main is concealed the only way that keeps it alive and
                    ; reachable: alpha 0, still visible, taskbar button intact.
                    ; _FSConcealMain shows it if it is not visible, which is
                    ; exactly the case here.
                    if (IsFirestoneMainTitle(btitle) || _fsWasMainTitled.Has(bhwnd)) {
                        _fsWasMainTitled[bhwnd] := true
                        _MapDrop(_fsHiddenByUs, bhwnd)
                        _FSConcealMain(bhwnd)
                        _LogFSSurface(bhwnd, btitle
                                    , "main -> alpha 0 (was birth-hidden)")
                        continue
                    }
                    _fsHiddenByUs[bhwnd] := true      ; ours: stays hidden
                    _LogFSSurface(bhwnd, btitle, "kept-hidden")
                } else {
                    ; RELEASE, BUT ONLY SHOW WHAT WE HID.
                    ;
                    ; Releasing our own concealment (unpark, uncloak) is always
                    ; correct -- it undoes something this script did. Calling
                    ; ShowWindow is not: a window can be invisible because
                    ; OVERWOLF wants it invisible, and forcing it on screen puts
                    ; a blank internal frame on the user's desktop.
                    ;
                    ; The ledger is the difference. _fsHiddenByUs records the
                    ; windows this script took off the screen, and those are the
                    ; only ones it has any business putting back.
                    _LogFSSurface(bhwnd, btitle, "released")
                    _FSReleaseSurface(bhwnd)    ; unpark, then uncloak
                    if _fsHiddenByUs.Has(bhwnd) {
                        _FSShowIfNotPopup(bhwnd)
                        _MapDrop(_fsHiddenByUs, bhwnd)
                    }
                }
            }
        }
    }

    if !State.fsMainLocked
        return

    ; Nothing to sweep with no Overwolf process alive -- and the enumeration
    ; below is the expensive part of this script's steady state, so it is worth
    ; the one cached process check to skip it entirely.
    if !_OverwolfRunningCached()
        return

    try {
        prev     := A_DetectHiddenWindows
        prevMode := A_TitleMatchMode
        DetectHiddenWindows true
        SetTitleMatchMode(2)

        for exe in CFG.fsFamilyExes {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if !DllCall("IsWindow", "Ptr", h)
                        continue
                    title := WinGetTitle("ahk_id " . h)

                    ; ---- MUST-BE-VISIBLE: actively enforce, every tick ----
                    ; The in-game overlay is the one surface that has to
                    ; render. Nothing in the always-on path used to guarantee
                    ; that: the only un-hide paths were the event hook (which
                    ; was blind to hidden windows) and OverlayTopmostTick
                    ; (which only runs AFTER a successful launch). So an
                    ; overlay that got caught by the birth-hide simply stayed
                    ; hidden for the whole session with nothing to rescue it
                    ; -- the "overlay failed" symptom. Enforcing visibility
                    ; here, on the same 50 ms sweep that does the hiding,
                    ; makes that unrecoverable state impossible.
                    ; Shape as well as name. Keyed on the title alone this
                    ; branch never ran on the build in the logs -- the overlay
                    ; is titled "Firestone" there -- so the rescue it performs
                    ; was never performed. See CFG.fsOverlayShapeDetect.
                    if IsFSMustStayVisible(h, title) {
                        ; Unconditional, NOT gated on a ledger entry: an
                        ; overlay stranded transparent by a previous instance
                        ; has no ledger entry, and it is precisely the case
                        ; that needs rescuing. Same reasoning now covers the
                        ; PARK: an overlay parked off the virtual desktop by
                        ; the birth suppression is just as unrecoverable as one
                        ; stranded transparent, so this sweep un-parks it too.
                        ; ── ONE RESCUE PASS, THEN GUARDED ────────────────
                        ; This pair was unconditional on every tick, against
                        ; the ONE window that is composited on top of the game:
                        ; _RemoveFSAlphaShield plus _FSReleaseSurface is four
                        ; DwmSetWindowAttribute writes, each an LPC round-trip
                        ; to the same dwm.exe that is compositing Hearthstone.
                        ; At the settled rate that is sixteen a second, forever,
                        ; and every one of them asks the compositor to change
                        ; something about the overlay for no reason.
                        ;
                        ; OverlayTopmostTick was rewritten specifically to stop
                        ; doing this -- "pure churn against the one window that
                        ; must stay rock steady while the user has comps pinned
                        ; to it" -- and then this sweep kept doing it anyway,
                        ; sixteen times more often.
                        ;
                        ; The unconditional form exists for a real case: an
                        ; overlay stranded transparent or parked by a PREVIOUS
                        ; instance of this script has no ledger entry, so a
                        ; guarded release would never rescue it. That is a
                        ; once-per-window problem, not a once-per-tick one. So
                        ; it runs unconditionally exactly once per window, and
                        ; every tick after that only when something is actually
                        ; holding the window -- the same guard the topmost
                        ; enforcer already uses.
                        if !_fsOverlayRescued.Has(h) {
                            _fsOverlayRescued[h] := A_TickCount
                            _RemoveFSAlphaShield(h)
                            _FSReleaseSurface(h)      ; unpark, then uncloak
                        } else if (_fsAlphaApplied.Has(h) || _fsParked.Has(h)
                                || _fsTabRemoved.Has(h) || _cloakState.Has(h)
                                || IsWindowCloakedDWM(h)) {
                            _RemoveFSAlphaShield(h)
                            _FSReleaseSurface(h)
                        }
                        if !DllCall("user32\IsWindowVisible", "Ptr", h) {
                            ; _MapDrop, not .Delete: an absent key throws in
                            ; v2, and a throw here would skip the ShowWindow
                            ; below -- leaving the overlay hidden, which is the
                            ; exact failure this branch exists to prevent.
                            _MapDrop(_fsHiddenByUs, h)
                            _MapDrop(_fsBirthHidden, h)
                            DllCall("ShowWindow", "Ptr", h, "Int", 8)  ; SW_SHOWNA
                        }
                        continue
                    }

                    ; ---- NEVER-CONCEAL: hands off, and undo any hold ----
                    ; Settings, by name. Same shape as the overlay branch above
                    ; but WITHOUT the unconditional ShowWindow: this window is
                    ; Firestone's to show and hide, and the sweep's whole duty
                    ; to it is to not be holding it. The guarded release undoes
                    ; anything an earlier pass (or a previous instance) applied
                    ; before the title had settled; a window we are not holding
                    ; costs one DWM cloak query per pass and nothing else. This
                    ; branch is deliberately ABOVE the helper-shaped test --
                    ; Settings gains WS_EX_TOOLWINDOW only after Overwolf
                    ; finishes styling it, and classifying it by that moving
                    ; target is precisely the flap that used to park it. See
                    ; CFG.fsNeverConcealTitles.
                    if IsFSNeverConcealTitle(title) {
                        if (_fsAlphaApplied.Has(h) || _fsParked.Has(h)
                         || _fsTabRemoved.Has(h) || _cloakState.Has(h)
                         || IsWindowCloakedDWM(h)) {
                            _RemoveFSAlphaShield(h)
                            _FSReleaseSurface(h)
                        }
                        if _fsHiddenByUs.Has(h) {
                            _FSShowIfNotPopup(h)
                            _MapDrop(_fsHiddenByUs, h)
                        }
                        _MapDrop(_fsBirthHidden, h)
                        continue
                    }

                    if IsFirestoneSuppressionTitle(title) {
                        _SuppressFSHwnd(h, title)
                        continue
                    }

                    ; ---- EVERYTHING ELSE: suppressed while locked ----
                    ; Previously this only CLOAKED untitled / bare-"Firestone"
                    ; windows and ignored every other title outright, so a
                    ; window that settled to something like "OverWolf Server"
                    ; was never suppressed by this sweep at all -- and a cloak
                    ; alone is fragile: DWM clears it on some window
                    ; operations, and a window that gets uncloaked mid-paint
                    ; is exactly the black-rectangle-with-a-titlebar in the
                    ; screenshot. Cloak AND take it off the screen, ledgered
                    ; so F3 can bring it back.
                    ; ── HELPER-SHAPED: NOT OURS TO MANAGE ────────────────────
                    ; Overwolf builds its internal surfaces owned or
                    ; WS_EX_TOOLWINDOW, so this branch is "we cannot name it and
                    ; it is not a top-level app window" -- leave it alone.
                    if IsHelperWindow(h) {
                        ; ── BUT FIRST: UNDO ANYTHING WE DID TO IT ────────────
                        ;
                        ; THIS IS THE LEAK, AND IT IS A BUG IN THIS SCRIPT ON
                        ; ITS OWN TERMS, whatever the window turns out to be.
                        ;
                        ; The birth cloak in the CREATE hook deliberately has NO
                        ; helper gate -- it fires on every newborn Overwolf
                        ; window, before any of them has a title to judge. This
                        ; branch is where the script later decides such a window
                        ; is not its business. It then `continue`d, leaving the
                        ; window cloaked by us, forever: the release paths above
                        ; only ever fire for the one allow-listed title, so
                        ; nothing else in the sweep could undo it. Invisible
                        ; until F3 or exit.
                        ;
                        ; "Every concealment has a matching cleanup" is a stated
                        ; invariant of this script and it did not hold here. A
                        ; window we conceal and then disown must be released.
                        ;
                        ; Fenced to windows WE are holding (_cloakState), with a
                        ; settled name, and never touching anything still inside
                        ; the Firestone-Main formation lifecycle or the two
                        ; surfaces that are supposed to stay concealed:
                        ;   - a bare "Firestone" is Main still forming, or the
                        ;     notification popup; both are owned elsewhere,
                        ;   - the loading splash has its own suppressor,
                        ;   - _fsMainCandidate is the formation ledger.
                        ; Once per window, so a window Overwolf re-cloaks itself
                        ; is never fought at sweep rate.
                        ; _FSIsInertHelper, not IsHelperWindow. The gate
                        ; warned against above rejects by window SHAPE,
                        ; which is exactly the shape Overwolf gives its
                        ; real surfaces. This rejects by exact NAME --
                        ; "Default IME", "MSCTFIME UI" and the rest --
                        ; which no Firestone surface can ever carry.
                        if (_cloakState.Has(h) && !_fsExemptReleased.Has(h)
                         && !_FSIsInertHelper(h, title)
                         && title != "" && title != "Firestone"
                         && !_fsMainCandidate.Has(h)
                         && !IsFirestoneMainTitle(title)
                         && title != "Firestone - Loading"
                         && !IsLikelyFirestoneLoadingPopupHwnd(h)
                         && !IsFirestoneNotificationPopup(h, title)) {
                            _fsExemptReleased[h] := A_TickCount
                            ; Terse: one line per window, and the reason is
                            ; always the same. "Helper-shaped and unrecognised,
                            ; so not ours to conceal" is the rule, stated in
                            ; full at the funnel that applies it.
                            _FSLog("FS-EXEMPT released `"" . title . "`" hwnd=" . h)
                            _FSReleaseSurface(h)
                        }
                        continue
                    }
                    ; UNTITLED AND UNRECOGNISED SURFACES. Firestone - Main is
                    ; born untitled, so this branch used to be hide number
                    ; three of five on Main's own HWND -- an unconditional
                    ; SW_HIDE at the 1 ms burst rate, before the window had a
                    ; name, let alone a frame. Funnelled, with probing enabled:
                    ; this is the settled sweep, so this is where measurement
                    ; belongs.
                    _LogFSSurface(h, title, "suppressed")
                    _FSSuppressSurface(h, title, true)
                } catch {
                }
            }
        }

        DetectHiddenWindows prev
        SetTitleMatchMode prevMode
    } catch {
        ; Swallow and let the next tick retry.
    }
}

; Per‑hwnd tick of last minimize ATTEMPT (not success) — throttles re‑minimize.
global _fsMinLastAttempt := Map()

; Per-hwnd tick of the FIRST time we saw this window carrying a suppression
; title. Powers the first-paint grace below.
global _fsFirstTitledAt := Map()

_SuppressFSHwnd(h, title := "") {
    global State, CFG, _fsFirstTitledAt

    ; Mid-pass unlock guard: hotkey threads interleave with timer threads,
    ; so an unlock can land between two windows of one suppression sweep.
    ; Without this, the tail of that sweep re-suppresses exactly what the
    ; reveal is about to show -- one avoidable flicker per stress cycle.
    if !State.fsMainLocked
        return

    ; NOT SHORT-CIRCUITED FOR FIRESTONE MAIN, DELIBERATELY, even though the
    ; funnel below refuses Main and undoes everything held on it. Returning
    ; early here would skip _FSSuppressSurface -- and that function is where
    ; the identity ledgers are written: _fsMainCandidate and _fsWasMainTitled,
    ; which are what stop the notification closer ever sending WM_CLOSE to
    ; Firestone Main, and _fsMainEverOpened, which is what arms the
    ; Battlegrounds birth hide. Saving one ledger write per tick is not worth
    ; disarming either of them.
    ;
    ; The shield is ledger-only while CFG.fsUseAlphaShield is false, which it
    ; is. Kept because the notification sweeper's guard 3b reads the ledger.
    _ApplyFSAlphaShield(h)

    if !_fsFirstTitledAt.Has(h)
        _fsFirstTitledAt[h] := A_TickCount

    ; Concealment is delegated to _FSSuppressSurface, which is the single
    ; primitive every suppression site in this script funnels through.
    ;
    ; A per-function paint grace was tried here and cannot work: this function is
    ; the LAST of five owners to touch a Firestone window, so by the time a window
    ; arrives carrying the title Firestone - Main it has already been concealed by
    ; the event hook (at CREATE, at SHOW and at NAMECHANGE) and by the untitled
    ; branch of the settled sweep. A gate here guards a door the others have
    ; already walked through.
    ;
    ; allowProbe is true because this is a settled timer thread, which is the only
    ; context where the PrintWindow capture may run.
    _FSSuppressSurface(h, title, true)
}

; ──────────────────────────────────────────────────────────────────────────────
; Fresh‑launch early Overwolf cloaker
; ──────────────────────────────────────────────────────────────────────────────
; Runs during the startup popup phase. Cloaks only windows that match the
; likely Firestone‑loading popup so the real Overwolf overlay is not suppressed.
; Stopped only after the popup has disappeared and FS‑Main has been titled
; (plus a grace period).
global _EarlyOWCloakActive := false
global _EarlyOWCloakHasRef := false   ; tracks ownership of the high‑res ref
global _earlyCloakSawFSMainAt := 0    ; tick when a suppression‑titled window
                                      ; (FS‑Main / FS‑Battlegrounds) was first
                                      ; observed during THIS cloak session
global _fsPopupWatchDone := true      ; loading‑popup watchdog concluded

; ══════════════════════════════════════════════════════════════════════════════
;  THE 15ms EARLY CLOAK SWEEP IS DELETED
; ══════════════════════════════════════════════════════════════════════════════
;
; EarlyOverwolfCloakTick ran every 15 MILLISECONDS for TWO MINUTES after every
; launch -- sixty-six passes a second -- and each pass enumerated every window
; of Overwolf.exe and OverwolfBrowser.exe and called WinGetTitle on all of them.
;
; It did nothing the window hook does not already do. OWCreateHookProc is
; subscribed to create, show, destroy, minimize-end, uncloak and namechange, and
; routes every one of those windows through _FSSuppressSurface. The sweep was a
; belt-and-braces poll from before the hook covered those events.
;
; WHY IT HAD TO GO: it starved the script's own thread. The log said so in the
; script's own words -- "SWEEP-LATE tick ran 141ms after the last one, not the
; 10ms it is armed for -- the thread was busy" -- and a starved thread does not
; dispatch hotkeys, which is why F1-F4 stopped responding the moment Firestone
; Main appeared. That is the busiest moment for exactly this sweep.
;
; StopEarlyOverwolfCloak is kept: it releases windows and is called from the
; shutdown and stand-down paths.
StartEarlyOverwolfCloak() {
    global _EarlyOWCloakActive
    _EarlyOWCloakActive := true          ; the flag still gates the hook's paths
}

_EarlyCloakFailsafeStop(*) => StopEarlyOverwolfCloak()

StopEarlyOverwolfCloak(*) {
    global _EarlyOWCloakActive, _EarlyOWCloakHasRef, State, _fsAlphaApplied
    global _fsDeferredPopupCloak, _fsNotifSweepUntil
    _EarlyOWCloakActive := false
    SetTimer(_EarlyCloakFailsafeStop, 0)
    if _EarlyOWCloakHasRef {
        _ReleaseHighResTimer()
        _EarlyOWCloakHasRef := false
    }

    ; Release every non‑Firestone‑Main OW window.
    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(2)
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    title := WinGetTitle("ahk_id " . h)

                    ; Leave anything the lock still owns alone. Was
                    ; `IsFirestoneSuppressionTitle(title) && State.fsMainLocked`
                    ; -- the same deny-list mistake, so ending the early cloak
                    ; UNCLOAKED every unrecognised Overwolf surface, which is a
                    ; third independent way the stray windows reached the
                    ; screen. FSShouldSuppress already folds in the lock state.
                    if FSShouldSuppress(title)
                        continue

                    ; A NOTIFICATION POPUP IS KILLED HERE, NEVER RELEASED.
                    ;
                    ; This used to hand the popup to the notification sweeper if
                    ; the sweeper was alive, and otherwise fall through to
                    ; _FSReleaseSurface -- which UNCLOAKS it. That fall-through
                    ; is how F3 painted the popup: the unlock path stopped the
                    ; sweeper one line earlier, so "is the sweeper alive" was
                    ; false and the release ran.
                    ;
                    ; There is no version of this where showing a notification
                    ; is the right outcome, so the sweeper's state no longer has
                    ; a vote. _FSKillNotificationPopup keeps it cloaked and
                    ; closes it, and its own guards still make closing Firestone
                    ; Main impossible.
                    if IsFirestoneNotificationPopup(h, title) {
                        _fsDeferredPopupCloak[h] := A_TickCount
                        _FSKillNotificationPopup(h, "early-cloak stop")
                        continue
                    }

                    if _fsAlphaApplied.Has(h)
                        _RemoveFSAlphaShield(h)
                    _FSReleaseSurface(h)      ; unpark, then uncloak
                } catch {
                }
            }
        }
    }
    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}


; ──────────────────────────────────────────────────────────────────────────────
; Battle.net / Agent launch blanket
; ──────────────────────────────────────────────────────────────────────────────
; Runs from the F2 press through RevealHSAfterLaunch. It no longer touches
; Hearthstone at all -- the game is never concealed; see the note at the top of
; HSHiddenLaunchWatch for why that was removed. What remains is the Battle.net
; side: while _bnetCloakActive is true (armed by StartHSCloaker, cleared by
; StopHSCloaker) each tick blankets every Battle.net.exe / Agent.exe SERVICE
; window, which genuinely does need a 10ms cadence to catch them at birth.
;
; The two flags survive as a pair because the timer's lifetime is still tied to
; the launch, and because Battle.net must be revealable EARLY (login screen)
; independently of when the launch finishes.
global _HSCloakActive   := false
global _bnetCloakActive := false   ; true = HSCloakTick also blankets BNet/Agent
; ── THE BATTLE.NET BLANKET OUTLIVES THE HEARTHSTONE CLOAKER ────────────────
;
; TWO JOBS THAT WERE SHARING ONE FLAG, AND ONLY ONE OF THEM IS FINISHED WHEN
; THE GAME APPEARS.
;
; _bnetCloakActive was armed and cleared by StartHSCloaker/StopHSCloaker,
; which made it the same lifetime as the Hearthstone launch cloak. That is
; right for the HS half: once the game's window exists there is nothing left
; to cloak, and RevealHSAfterLaunch correctly calls StopHSCloaker the moment
; it appears.
;
; It is wrong for the Battle.net half. The service surfaces this blanket
; exists to suppress -- the auto-login shell, update notices, Agent windows,
; the launcher raising itself -- do not all arrive before the game. Several of
; them routinely arrive AFTER it, and from the instant StopHSCloaker ran there
; was nothing hiding any of them. That is "the Battle.net services were shown
; and not hidden": not a classification failure, a lifetime one. The guard was
; torn down at the exact moment the window it covers begins.
;
; So the deadline is separate from the flag. _bnetCloakActive still means
; "a launch is in flight"; the blanket is active while EITHER that is true or
; the grace window is still open. The grace matches
; StartBNetPostLaunchMinimize's ceiling on purpose -- the same two minutes, for
; the same reason, covering the same cold-load period during which Battle.net
; is still doing things of its own accord.
;
; Bounded rather than permanent, because a blanket that never lifts would hide
; a Battle.net the user deliberately opened after the session settled.
global _bnetBlanketUntil := 0

_BNetBlanketActive() {
    global _bnetCloakActive, _bnetBlanketUntil
    if _bnetCloakActive
        return true
    return (_bnetBlanketUntil && A_TickCount < _bnetBlanketUntil)
}
global _HSCloakerHasRef := false

StartHSCloaker() {
    global _HSCloakActive, _HSCloakerHasRef, _hsGuardActive, _hsRevealed
    global _bnetCloakActive, _bnetRevealedAt, _bnetHiddenByUs, _bnetPostMinDone, _bnetLoginAllowed, _bnetLauncherStaged, _bnetLaunchFiredAt, _bnetHideDone, _bnetLauncherHwnd
    global _bnetBlanketUntil
    _hsGuardActive := false
    SetTimer(HSPlacementGuardTick, 0)
    _hsRevealed := Map()
    _HSCloakActive   := true
    _bnetCloakActive  := true   ; arm the Battle.net/Agent launch blanket
    _bnetBlanketUntil := 0      ; a fresh launch re-opens the grace window
    _bnetRevealedAt  := 0      ; fresh launch: launcher-ready not stamped yet
    _bnetHiddenByUs  := Map()  ; fresh ledger of SERVICE windows we SW_HIDE
    _bnetLoginAllowed := false ; the blanket owns Battle.net.exe again
    _bnetLauncherStaged := false ; launcher boots hidden; reveal will stage it
    _bnetHideDone    := Map()  ; fresh hide-once ledger
    _bnetLauncherHwnd := 0     ; no launcher revealed yet this launch
    _bnetLaunchFiredAt := 0    ; launch command not fired yet this launch
    _bnetPostMinDone := false  ; post-launch minimize not performed yet
    StartOWCreateHook()
    if !_HSCloakerHasRef {
        _AcquireHighResTimer()
        _HSCloakerHasRef := true
    }
    SetTimer(HSCloakTick, 10)
    HSCloakTick()
}

StopHSCloaker() {
    global _HSCloakActive, _HSCloakerHasRef, _bnetCloakActive, _bnetLoginAllowed
    global _bnetBlanketUntil, CFG
    _HSCloakActive    := false
    ; The FLAG ends with the tick, as it always did. The BLANKET does not:
    ; see _BNetBlanketActive. Battle.net keeps producing service surfaces
    ; after the game window exists, and this is the moment that used to stop
    ; covering them.
    _bnetCloakActive  := false
    if !_bnetBlanketUntil
        _bnetBlanketUntil := A_TickCount + CFG.bnetBlanketGraceMs
    _bnetLoginAllowed := false
    SetTimer(HSCloakTick, 0)
    if _HSCloakerHasRef {
        _ReleaseHighResTimer()
        _HSCloakerHasRef := false
    }
    ; De-ghost sweep: uncloak every Battle.net-family window (SW_HIDDEN ones
    ; stay hidden, so nothing pops). A cloak leaking past the session would
    ; make any window the client re-shows later invisible-but-"visible".
    try {
        prev := A_DetectHiddenWindows
        DetectHiddenWindows true
        for exe in ["Battle.net.exe", "Agent.exe", "Battle.net Helper.exe"] {
            for hwnd in WinGetList("ahk_exe " . exe) {
                try UncloakWindow(hwnd, false, "StopHSCloaker")
            }
        }
        DetectHiddenWindows prev
    }
}

HSCloakTick() {
    global _HSCloakActive, _bnetCloakActive, CFG, _bnetHiddenByUs, _bnetLauncherStaged, State
    global _bnetHideDone, _bnetLauncherHwnd, _bnetPostMinDone
    ; ── IS THE SWEEP ACTUALLY RUNNING WHEN IT SAYS IT IS? ───────────────
    ;
    ; The splash can only be caught in the 16-32ms between its creation
    ; and its show. This sweep is armed at 10ms, so on paper it gets one
    ; to three chances. On paper.
    ;
    ; AutoHotkey is single-threaded: a timer does not interrupt work, it
    ; waits for it. During a launch this same thread is classifying every
    ; window Overwolf creates and writing a log line for each, so the
    ; interval between ticks is whatever the thread was busy doing, not
    ; the 10ms that was asked for.
    ;
    ; That is the difference between a probe run, which wins the race
    ; almost every time, and a real F2, which wins about three in five.
    ; The two cases differ in nothing except how busy this thread is --
    ; so this measures it directly rather than inferring it. A late tick
    ; is only interesting during a launch, and only the worst few matter,
    ; so it is bounded to eight lines per session.
    static lastTick := 0, lateLogged := 0
    nowT := A_TickCount
    if (lastTick && lateLogged < 8) {
        gap := nowT - lastTick
        if (gap >= 40 && State.fsMainLocked) {
            lateLogged += 1
            _FSLog("SWEEP-LATE tick ran " . gap . "ms after the last one,"
                 . " not the " . (_FSBlanketWantsFast() ? 10 : 100) . "ms it is armed for"
                 . " -- the thread was busy. The start-up splash exists"
                 . " unshown for 16-32ms, so a gap this size is a race"
                 . " this sweep cannot win. Bounded to 8 lines a session.")
        }
    }
    lastTick := nowT
    if !_HSCloakActive {
        SetTimer(HSCloakTick, 0)
        return
    }
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        ; HEARTHSTONE IS NOT TOUCHED HERE ANY MORE.
        ; This tick used to cloak every Hearthstone window the instant it
        ; appeared. That is gone -- the game shows itself, on the user's own
        ; fullscreen and monitor settings. The timer survives because it also
        ; owns the Battle.net services blanket below, which is a separate job
        ; that genuinely does need a 10ms cadence during the launch.
        ;
        ; Battle.net SERVICES blanket -- active for the whole launch (until
        ; StopHSCloaker), maximum aggression: cloak+hide everything in the
        ; family except the REAL client window. The auto-login shell, splash,
        ; maintenance overlays and all Agent / Helper windows never appear.
        ; ── THE SAME BLANKET, FOR FIRESTONE ─────────────────────────────────
        ;
        ; Battle.net's service windows have never flickered and Firestone's
        ; loading window always has, and the difference was never the windows.
        ; It is how the two were written:
        ;
        ;   Battle.net   _HideBlizzWindow: four guards, then CloakWindow and
        ;                SW_HIDE. Driven from THIS 10ms tick, on every window
        ;                of the process, whether or not anything has been told
        ;                the window exists.
        ;   Firestone    _FSSuppressSurface: 340 lines with twelve returns
        ;                before any concealment happens at all, reached only
        ;                through the suppression funnel, and then mostly
        ;                deferring -- because the file believed hiding a
        ;                Chromium window kills it.
        ;
        ; That belief has now been measured false. A one-shot hide from birth,
        ; never repeated, was held on a real Firestone window for 45 seconds
        ; and released to a live, painting window (1824 distinct colours). The
        ; renderer deaths on record came from REPEATED conceal/reveal, which
        ; this does not do -- the per-policy ledgers make it exactly once per
        ; window, and the freed ledgers make it never again after the first F3.
        ;
        ; So Firestone gets the treatment that already works, from the same
        ; 10ms tick, with only the exemptions that genuinely matter.
        if (CFG.fsBirthHoldOnce && State.fsMainLocked) {
            for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
                for hwnd in WinGetList("ahk_exe " . exe) {
                    try _FSBlanketHide(hwnd)
                }
            }
        }

        ; ══════════════════════════════════════════════════════════════════
        ; ══════════════════════════════════════════════════════════════════
        ;  THE BATTLE.NET SERVICES SWEEP IS DELETED. IT WAS THE RACE.
        ; ══════════════════════════════════════════════════════════════════
        ; A 10ms poll that enumerated THREE Battle.net executables on every
        ; tick -- thirty full desktop enumerations a second -- sitting in the
        ; same callback as the Firestone birth catch, immediately after it.
        ;
        ; It was briefly made to STAND DOWN while the Firestone blanket was up.
        ; That was the wrong fix: it tried to WIN the race rather than remove
        ; it, and left the outcome depending on which system got the tick --
        ; which is exactly why runs alternated between perfect and broken with
        ; no change in between.
        ;
        ; NOTHING IS LOST, BECAUSE THIS WAS NEVER THE MECHANISM. Battle.net
        ; surfaces are hidden by _HideBlizzWindow from the WINDOW EVENT HOOK,
        ; at the moment each window is created -- event-driven, once per
        ; window, no polling, and it cannot be late because it runs on the
        ; event that announces the window. This sweep only re-checked what the
        ; hook had already done, and the file own comment admitted as much:
        ; "it would be caught by the window event hook first in any case".
        ;
        ; So the coupling between the two systems is gone by construction.
        ; There is no shared tick left for them to contend for.
    }
    DetectHiddenWindows prev

    ; ── BACK OFF ONCE THE LAUNCHER IS GONE ───────────────────────────────────
    ;
    ; This blanket runs at 10 ms and enumerates three Battle.net executables on
    ; every tick -- thirty full desktop enumerations a second. It needs that
    ; speed for one specific window: the boot splash and auto-login shell,
    ; which appear and start painting within milliseconds of each other. That
    ; is over the moment the launcher has minimised.
    ;
    ; After that, StopHSCloaker is still ten to thirty seconds away -- it waits
    ; for Hearthstone's window -- and those are the seconds the game spends
    ; loading, on the machines where loading is slowest. Holding 100 Hz through
    ; them buys nothing and competes with the game for the CPU. A late stray
    ; service window is still caught, 100 ms later, and it would be caught by
    ; the window event hook first in any case.
    ; ── AND STAY FAST UNTIL FIRESTONE HAS ACTUALLY TURNED UP ───────────────
    ;
    ; THIS IS WHY THE LOADING WINDOW FLICKERED AND BATTLEGROUNDS NEVER DID.
    ;
    ; The downgrade below is keyed on _bnetPostMinDone, which is a fact about
    ; BATTLE.NET and says nothing whatever about Firestone. The log shows what
    ; that costs, identically on every launch:
    ;
    ;   09:00:14  BNET-SEQ minimize confirmed     <- tick drops to 100ms here
    ;   09:00:16  FS-HOLD [main]                  <- Firestone's window is born
    ;   09:00:16  FS-VISIBLE caught ... on screen <- and had already been seen
    ;
    ; Battle.net finishes about two seconds BEFORE Firestone opens, every time.
    ; So the loading window is always born into a 100ms poll -- up to a tenth
    ; of a second on screen before anything takes it.
    ;
    ; Battlegrounds escapes this entirely because it is born mid-match, minutes
    ; later, when the script is idle and the window event hook reaches it at
    ; once. Same code, same window family, opposite outcome, and the only
    ; difference was the cadence at the moment of birth.
    ;
    ; So the fast cadence now also holds while a Firestone launch is still
    ; waiting on its first window. It is bounded twice over -- it ends the
    ; moment Main is held, and it expires on its own timer -- so a Firestone
    ; that never opens cannot pin the timer at 10ms for the session.
    static appliedPeriod := 0
    want := (_bnetPostMinDone && !_FSBlanketWantsFast()) ? 100 : 10
    if (want != appliedPeriod && _HSCloakActive) {
        appliedPeriod := want
        SetTimer(HSCloakTick, want)
    }
}

; ── HS post‑reveal placement guard ────────────────────────────────────────────
; Two jobs, both scoped to 60s after the reveal:
;   1. NEW windows: cloak → place → uncloak on the chosen monitor.
;   2. REVEALED windows: correct drift caused by Unity's display‑mode setup.
global _hsGuardActive := false
global _hsGuardUntil  := 0
global _hsRevealed    := Map()   ; hwnd -> true once placed + uncloaked

; TWO CADENCES, AND THE FAST ONE IS SHORT-LIVED.
;
; The whole reason this runs quickly is Unity's snap-to-primary: for a few
; seconds after the game's window appears it can place itself on the wrong
; monitor, and 50 ms means the correction lands before the user really sees it.
; That window closes. Afterwards the guard is a drift watchdog for something
; that essentially never happens, and it was staying at 50 ms for the entire
; session -- twenty process-table snapshots and twenty full desktop window
; enumerations per second, forever, next to the game. It was the single most
; expensive thing this script did while the user was playing.
;
; durationMs now means what it always looked like it meant: how long the fast
; phase lasts. After it, the same checks continue at hsGuardIdleMs. Nothing is
; given up -- a window that drifts is still corrected, just on the cadence of a
; watchdog instead of a race.
StartHSPlacementGuard(durationMs := 15000) {
    global _hsGuardActive, _hsGuardUntil, CFG
    _hsGuardActive := true
    _hsGuardUntil  := A_TickCount + durationMs
    SetTimer(HSPlacementGuardTick, CFG.hsGuardFastMs)
    HSPlacementGuardTick()
}

StopHSPlacementGuard() {
    global _hsGuardActive, _hsRevealed
    _hsGuardActive := false
    SetTimer(HSPlacementGuardTick, 0)
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in WinGetList("ahk_exe Hearthstone.exe") {
            try {
                if !_hsRevealed.Has(hwnd)
                    UncloakWindow(hwnd, false, "StopHSPlacementGuard")
            }
        }
    }
    DetectHiddenWindows prev
}

HSPlacementGuardTick() {
    global _hsGuardActive, _hsRevealed, CFG, ChosenMonIdx, _hsGuardUntil

    if !_hsGuardActive {
        SetTimer(HSPlacementGuardTick, 0)
        return
    }
    ; Permanent while HS exists: the guard is HS's SOLE monitor-keeper now
    ; (the lock no longer touches HS), so it must not time out and leave HS
    ; unowned. It self-stops only when Hearthstone is gone.
    ;
    ; Cached: this ran an uncached ProcessExist -- a full system process-table
    ; snapshot, taking the global process-list lock -- twenty times a second for
    ; the whole session. The cache never caches a NEGATIVE, so "Hearthstone has
    ; exited" is still noticed on the very next tick.
    if !_ProcExistCached("Hearthstone.exe") {
        StopHSPlacementGuard()
        return
    }

    ; Drop out of the fast phase once Unity has had its chance to misplace the
    ; window. Re-armed at full speed by the next RevealHSAfterLaunch.
    if (_hsGuardUntil && A_TickCount > _hsGuardUntil) {
        _hsGuardUntil := 0
        SetTimer(HSPlacementGuardTick, CFG.hsGuardIdleMs)
    }

    ; Nothing to correct without a monitor to correct to. On a single monitor,
    ; or with the lock off, every check below is arithmetic that can only reach
    ; the same answer -- _PlaceHSOnChosenMonitor returns false at its first two
    ; lines for exactly these cases. Skipping here saves the enumeration too.
    if !(CFG.lockWindowsToChosenMonitor && ChosenMonIdx)
        return

    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in WinGetList("ahk_exe Hearthstone.exe") {
            try {
                if IsIMEWindow(hwnd)
                    continue

                ; ---- Already‑revealed windows: drift correction ────────────
                if _hsRevealed.Has(hwnd) {
                    if !(CFG.lockWindowsToChosenMonitor && ChosenMonIdx)
                        continue
                    if (WinGetTitle("ahk_id " . hwnd) != "Hearthstone")
                        continue
                    if (WinGetMinMax("ahk_id " . hwnd) = -1)
                        continue
                    WinGetPos(&x, &y, &w, &h, "ahk_id " . hwnd)
                    if (w < 600 || h < 400)
                        continue
                    if (GetMonitorIndexForPoint(x + w // 2, y + h // 2) = ChosenMonIdx) {
                        _MoveBudgetReset(hwnd)
                        continue
                    }
                    if !_MoveBudgetAllows(hwnd)
                        continue
                    ; NO CLOAK AROUND THE MOVE.
                    ; This used to cloak, move, sleep 15ms and uncloak, to hide
                    ; the correction. Two problems. The cloak/uncloak pair is
                    ; itself a display-mode event for a borderless DXGI window,
                    ; so it provoked the churn it was hiding; and the
                    ; MonitorGetWorkArea between the two THROWS on a stale
                    ; monitor index -- the catch below swallowed it, and the
                    ; window was left cloaked with no path back. On a machine
                    ; whose monitor count changed, that is a permanently
                    ; invisible game. A bare move cannot strand anything.
                    _MoveBudgetNote(hwnd)
                    _PlaceHSOnChosenMonitor(hwnd)
                    continue
                }

                ; ---- Unreleased windows: place, and mark released ----------
                if (WinGetTitle("ahk_id " . hwnd) != "Hearthstone")
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue
                UncloakWindow(hwnd, false, "HSPlacementGuardTick")      ; repair only (see RevealHSAfterLaunch)
                _PlaceHSOnChosenMonitor(hwnd)
                _hsRevealed[hwnd] := true
            } catch {
            }
        }
    }
    DetectHiddenWindows prev
}

; Timer entry point — delegates to the tick.
; THE 50 ms WATCHDOG IS OVER. It disarms itself the first time it runs.
;
; This is the operation storm. The sweep it called reaches _FSReleaseSurface,
; which is a FORCED uncloak -- it bypasses the "already in that state" guard in
; UncloakWindow by design. Armed at 50 ms and drifting to ~62 ms under load,
; that is a DWM operation against one Chromium window about sixteen times a
; second, for as long as the window lives. It is the exact interval recorded in
; every trace of a dying Firestone Main:
;
;   4547ms uncloak -> 4609ms uncloak -> 4672ms uncloak -> ... -> 6281ms uncloak
;
; The oscillation alarm named this 48 times and was never read.
;
; Nothing is lost by stopping it. The one window that genuinely appears
; uninvited -- the 152x294 Overwolf splash -- is caught at CREATION by
; _FSSplashBirthCatch from OWCreateHookProc, which is a window event and does
; not need a sweep. Measured: of 48 Overwolf windows created by a silent
; launch, exactly 2 ever reach the screen, and Overwolf hides the other 46
; itself.
;
; It disarms rather than being deleted at every call site, because it is armed
; from seven places and one honest stop is safer than seven edits. Those arms
; are now no-ops and should be removed.
FSMainMonitor() {
    SetTimer(FSMainMonitor, 0)
    return
}

; Coast rate, or the slower settled rate once there is nothing left to catch.
; Every read here is a plain variable -- this is called on the sweep itself, so
; it must not cost more than the sweep saves.
; True while the user has deliberately revealed Firestone's windows with F3.
; Distinct from !State.fsMainLocked, which is also false when a stand-down
; cleared the lock -- only one of those is the user's decision. See
; _TrackerArmFirestone.
global _fsUserUnlocked := false

global _fsBgEverSeen  := false  ; has "Firestone - Battlegrounds" existed yet?
global _fsBgWatchUntil := 0     ; and the deadline for waiting on it


; ── DWM cloak helpers (state-arbitrated) ──────────────────────────────────────
; All three attributes are set together so cloaked windows stay invisible
; everywhere: Alt‑Tab thumbnail, Win+Tab view, Aero Peek, and taskbar live
; preview. ARBITRATION (option B): a per-hwnd cloak-state map makes both
; primitives IDEMPOTENT -- the 3 DwmSetWindowAttribute calls fire ONLY when the
; state actually changes. 22 cloak + 27 uncloak sites across Firestone,
; Battle.net and Hearthstone previously hammered DWM with no coordination; a
; window already cloaked by one subsystem was re-cloaked by another every tick,
; and uncloak/re-cloak races between subsystems churned the compositor -- a
; flicker source. With this, redundant calls are no-ops and only genuine
; transitions touch DWM, so the subsystems no longer contend for the primitive.
global _cloakState := Map()   ; hwnd -> true when WE currently have it cloaked

; ── Cloak enforcement: ask DWM, not the ledger ────────────────────────────────
; CloakWindow is arbitrated -- it skips the DWM call when _cloakState already
; records the window as cloaked. That arbitration prevents several subsystems
; hammering DWM every tick, but it has one blind spot: a DWM cloak is
; asynchronous, and some window operations silently reset it.
;
; When that happens the ledger still reads "cloaked", so the arbitration
; returns early and nothing re-applies it. Since those operations are exactly
; the ones an application performs while showing, resizing or restoring a
; window, the concealment can switch itself off at precisely the moment it is
; needed, with no way back on.
;
; DwmGetWindowAttribute answers the question directly for the cost of one
; call, so the suppression path asks it rather than trusting bookkeeping
; another process can invalidate.
_FSEnsureCloaked(hwnd) {
    global _cloakState
    if IsWindowCloakedDWM(hwnd) {
        ; Genuinely cloaked. Keep the ledger honest so the reveal knows it has
        ; something to undo, even when the cloak was applied by an earlier pass
        ; whose bookkeeping has since been pruned.
        if !_cloakState.Has(hwnd)
            _cloakState[hwnd] := true
        return true
    }
    ; DWM says it is NOT cloaked, whatever the ledger believes. Force past the
    ; arbitration -- this is the one caller that has actually checked.
    CloakWindow(hwnd, true, "_FSEnsureCloaked")
    _cloakState[hwnd] := true
    return false
}

; ══════════════════════════════════════════════════════════════════════════════
;  ONE CHOKEPOINT FOR HIDING, SO MAIN CANNOT BE HIDDEN BY ANY PATH
; ══════════════════════════════════════════════════════════════════════════════
;
; There were SEVENTEEN raw SW_HIDE call sites in this file and no single place
; that could say "not this window". _FSFastConceal matches "Firestone - Main" by
; name and hid it, in plain sight, for as long as that function has existed.
;
; Measured 2026-09-06 with an independent watchdog, not with this script's own
; log: Main was born, went vis=False inside 200ms, had its layered style
; stripped, and stayed hidden for its entire 24-second life. It never painted,
; never got a taskbar button, and the user never saw it. HSBG's own log claimed
; "visible=1 alpha=0" one instant earlier -- the two were fighting.
;
; THE RULE: Firestone Main is held at alpha 0 and nothing else. Not hidden, not
; cloaked, not parked. Alpha 0 is the only concealed state that keeps DWM
; compositing the window, so it keeps painting AND keeps its taskbar button.
;
; The single exception is a temporary cloak across creation, taken and released
; inside _FSConcealMain before the window is in _fsAlphaConcealed, so it never
; reaches this test.
;
; The tracker's hides (_HDT*) and Battle.net's (_HideBlizzWindow) deliberately
; do NOT route through here -- different applications, different rules, and
; nothing about this change may alter what happens to them.
; One place every Firestone SW_HIDE goes through, so the death trace can name
; the function that hid a window. That is all it does -- there is no rule here
; and no exception list. Main is not protected from hiding any more: with
; start_minimized set through Overwolf's own manifest switch, Main is never
; shown, so there is nothing to protect it from.
_FSHideWindow(hwnd, why := "") {
    _FSTraceNote(hwnd, "hide (SW_HIDE)" . (why = "" ? "" : " <- " . why))
    DllCall("ShowWindow", "Ptr", hwnd, "Int", 0)
    return true
}

CloakWindow(hwnd, force := false, why := "") {
    _FSTraceNote(hwnd, "cloak" . (why = "" ? "" : " <- " . why))
    global _cloakState, _fsAlphaConcealed, _fsCloakBlocked
    ; ── NEVER CLOAK A WINDOW WE ARE DELIBERATELY HOLDING AT ALPHA 0 ─────────
    ; Alpha 0 and a cloak are not additive, they are opposites. Alpha 0 leaves
    ; the window composited -- still painting, still holding its taskbar button
    ; -- and that is the entire reason Main survives it. A cloak stops DWM
    ; compositing the window and removes the taskbar button.
    ;
    ; 2026-09-06: Main was found with exactly ONE recorded operation across its
    ; 24-second life -- "0ms cloak" -- and never showed a taskbar button. It had
    ; been alpha-concealed while still untitled (the tracer only records windows
    ; it has already identified, so that pass leaves no entry) and then cloaked
    ; by some other path afterwards. The once-guard in _FSHoldApply meant the
    ; conceal never ran again to undo it, so the cloak simply stood.
    ;
    ; _fsAlphaConcealed is written in exactly one place, _FSConcealMain, so it
    ; contains only Firestone Main. The HSReplay tracker keeps its own
    ; _hdtAlphaConcealed and is untouched by this test, as is Battle.net.
    ;
    ; Refused here rather than at each call site: there are 21 of them, which
    ; one fires depends on the order Overwolf assigns titles, and a rule this
    ; load-bearing should not be re-implemented twenty-one times. The refusal is
    ; logged once per window WITH the caller's name, so the offending path is
    ; still identified rather than silently suppressed.
    if _fsAlphaConcealed.Has(hwnd) {
        if !_fsCloakBlocked.Has(hwnd) {
            _fsCloakBlocked[hwnd] := true
            _FSLog("FS-CLOAK REFUSED hwnd=" . hwnd . " caller="
                 . (why = "" ? "unnamed" : why) . " -- this window is held at"
                 . " alpha 0 on purpose. Cloaking it would stop DWM compositing"
                 . " it and take away its taskbar button, which is the state"
                 . " Main was last seen dying in. Alpha conceal left in force.")
        }
        return
    }
    static DWMWA_CLOAK              := 13
    static DWMWA_EXCLUDED_FROM_PEEK := 12
    static DWMWA_DISALLOW_PEEK      := 11
    if (!force && _cloakState.Has(hwnd))   ; already cloaked by us: no DWM churn
        return
    _cloakState[hwnd] := true
    v := 1
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_CLOAK,              "Int*", v, "UInt", 4)
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_EXCLUDED_FROM_PEEK, "Int*", v, "UInt", 4)
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_DISALLOW_PEEK,      "Int*", v, "UInt", 4)
}

UncloakWindow(hwnd, force := false, why := "") {
    _FSTraceNote(hwnd, "uncloak" . (why = "" ? "" : " <- " . why))
    global _cloakState
    static DWMWA_CLOAK              := 13
    static DWMWA_EXCLUDED_FROM_PEEK := 12
    static DWMWA_DISALLOW_PEEK      := 11
    if (!force && !_cloakState.Has(hwnd))  ; not cloaked by us: no DWM churn
        return
    ; Map.Delete THROWS on a key that is not there, and the force path reaches
    ; this line precisely when the key is usually absent -- force exists to
    ; uncloak a window we have no ledger entry for. The throw propagated into
    ; whatever called us, and the biggest victim was OverlayTopmostTick: it
    ; calls _FSReleaseSurface (force uncloak) on the in-game overlay every two
    ; seconds, BEFORE re-asserting the overlay's topmost flag. The exception
    ; aborted the rest of that window's body every single tick, so the topmost
    ; re-assert -- the enforcer's entire job -- almost never ran. An overlay
    ; that loses its z-order and is never put back is an overlay whose pinned
    ; panels appear and disappear at random.
    _MapDrop(_cloakState, hwnd)
    v := 0
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_CLOAK,              "Int*", v, "UInt", 4)
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_EXCLUDED_FROM_PEEK, "Int*", v, "UInt", 4)
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_DISALLOW_PEEK,      "Int*", v, "UInt", 4)
}

; ══════════════════════════════════════════════════════════════════════════════
; FIRESTONE COLD-WINDOW SUBSYSTEM — the Firestone-Main fix
; ══════════════════════════════════════════════════════════════════════════════
;
; Read CFG.fsMainColdPolicy for the full diagnosis. In short:
;
;   COLD  = the window has not yet proven it painted a frame.
;           It is kept 100% invisible WITHOUT ShowWindow(SW_HIDE), because that
;           call is what stops a CEF window ever building its compositor.
;   WARM  = the window has been measured to have painted.
;           From this instant it takes EXACTLY the Battlegrounds exit --
;           cloak + one ledgered SW_HIDE -- and behaves identically to the
;           window that has always worked.
;
; Every suppression site in the script funnels through _FSSuppressSurface()
; so the five owners that used to disagree now cannot. The hook calls it too,
; but the hook never probes (a "Fast" callback must stay cheap); probing is
; owned solely by the settled sweep.
;
global _fsPaintState     := Map()   ; hwnd -> 1 painted, -1 gave up (absent = cold)
; Vestigial: the paint probe that wrote these was removed. They stay only
; because the ledger pruners below still name them; both are always empty.
; ── THIS LEDGER IS NOT FIRESTONE'S ALONE. READ THIS BEFORE ITERATING IT. ────
;
; The _fs prefix is a lie of history. _HDTConcealWindow parks the HSReplay
; tracker's windows through _FSParkWindow, so this Map holds windows from BOTH
; overlays, and any loop over it is being handed windows from a family it may
; know nothing about.
;
; THAT SHARING IS DELIBERATE AND SHOULD NOT BE UNDONE. Parking is the one
; primitive this script cannot afford to have two implementations of -- the
; header states the rule as ONE OWNER PER WINDOW PER PHASE, and a second
; park/unpark pair written for the tracker is exactly the "five sites
; independently deciding what to do with one window" failure that rule exists
; to prevent. The concealment mechanics are genuinely identical; only the
; POLICY around them differs, and policy lives in the callers.
;
; What it does mean is that every wholesale reader of this Map must decide what
; to do about the other family's windows, explicitly. The two that exist:
;
;   _FSUnparkAll             consults BOTH bury ledgers, because unparking a
;                            buried tracker window puts it back on screen.
;   FSRepairStrandedWindows  enumerates CFG.fsAlphaRepairExes, which is
;                            Overwolf-only, so it never sees a tracker window
;                            in the first place.
;
; A third reader must do the same, or filter by executable. Getting this wrong
; is silent: the window belongs to the overlay the user did NOT choose, and the
; promise for that overlay is that it is never moved, hidden or closed.
global _fsPopupHeldLogged := Map()   ; hwnd -> we said why it is not being closed
global _fsSeenAt   := Map()   ; hwnd -> tick the hook first saw it created
global _fsExposureLogged := Map()   ; hwnd -> we already measured its exposure
global _fsAlphaConcealed := Map()   ; hwnd -> true: layered at alpha 0 by us
global _fsCloakBlocked  := Map()   ; hwnd -> true: we refused a cloak on it, logged once
global _fsParked         := Map()   ; hwnd -> true: currently parked off-screen
global _fsParkedRect     := Map()   ; hwnd -> {x,y,w,h} where it was before
; hwnd -> true once this window has been on screen for the user at least once.
; It is what separates "the rectangle Overwolf happened to give this window
; before anyone saw it" from "the position the user chose". See
; _FSUnparkWindow.
global _fsEverShown      := Map()
global _fsParkCycles     := Map()   ; hwnd -> park/unpark cycles performed
; Windows the sweep cloaked at birth and later disowned, released once each.
; Once-per-window so that a window Overwolf chooses to keep cloaked itself is
; never fought at sweep rate -- we undo our own cloak exactly one time and then
; leave the window entirely alone.
global _fsExemptReleased := Map()   ; hwnd -> tick when we let go of it

; Overlay windows that have had their one unconditional rescue pass. After
; that the sweep only touches them when a ledger says it is holding them --
; see the IsFSVisibleTitle branch in SuppressFirestoneMainTick.
global _fsOverlayRescued := Map()

global _fsMainCandidate  := Map()   ; hwnd -> ever carried a Loading/Main title.
                                    ; Identity guard for the popup closer: an
                                    ; HWND that has ever been Loading or Main
                                    ; may NEVER be closed, whatever it is
                                    ; titled now. Replaces the old "never close
                                    ; a cloaked window" proxy, which v8 broke by
                                    ; cloaking everything.
global _fsBirthReassert  := Map()   ; hwnd -> count of event-speed re-asserts
global _fsMainLogged     := Map()   ; hwnd -> lifecycle lines already written

; One-line diagnostic to HSBG.log (next to the script). This is the log that ends the
; guessing: one launch tells you whether Main painted, how long it took, and
; which policy was in force when it did or did not.
; ══════════════════════════════════════════════════════════════════════════════
;  THE LOG WRITE IS ON THE FLICKER'S CRITICAL PATH
; ══════════════════════════════════════════════════════════════════════════════
;
; This looked like pure diagnostics and is not. Every call is a FileAppend --
; CreateFile, WriteFile, CloseHandle -- against a file that on this machine
; lives in a OneDrive folder, so every line also goes through a sync filter
; driver. And it is called from the 10/15/40 ms sweeps and from inside the
; window hook's own callback.
;
; The window hook is SetWinEventHook with WINEVENT_OUTOFCONTEXT: events are
; delivered through this process's MESSAGE QUEUE. Anything that blocks the
; script's thread delays every window event behind it -- and "delayed window
; event" is the definition of the flicker this script exists to remove. The
; last session's log has the proof in it: sixty-odd IDENTICAL "FS-POPUP cloaked
; and moved off-screen" lines per second, each one a synchronous disk write,
; running for three seconds straight while the Firestone windows this script
; was supposed to be catching at birth were being born.
;
; So repeats are collapsed. An identical message inside the dedup window is
; dropped, and when the run ends the count is written once, which keeps the
; evidence without paying for it sixty times. Anything genuinely new is written
; immediately and synchronously, exactly as before -- this is not a buffer and
; nothing is lost to a crash.
; STATICS, NOT GLOBALS. _FSLog is reachable from LoadUserConfig, which runs
; from the auto-execute section long before a top-level `global x := ...` line
; further down the file has executed -- reading an unset global there would
; throw inside the one function that is supposed to be safe to call anywhere.
_FSLog(msg) {
    global CFG
    static lastMsg := "", lastAt := 0, repeats := 0
    if !CFG.f1DebugLog
        return
    try {
        now := A_TickCount
        if (msg = lastMsg && (now - lastAt) < CFG.fsLogDedupMs) {
            repeats++
            lastAt := now
            return
        }
        pre := ""
        if (repeats > 0) {
            pre := FormatTime(, "yyyy-MM-dd HH:mm:ss")
                 . " LOG the previous line repeated " . repeats
                 . " more time(s) and was not written each time -- see _FSLog`n"
            repeats := 0
        }
        lastMsg := msg
        lastAt  := now
        FileAppend(pre . FormatTime(, "yyyy-MM-dd HH:mm:ss") . " " . msg . "`n"
            , _LogPath())
    }
}

; ── Taskbar button suppression (style-free) ───────────────────────────────────
; ITaskbarList::DeleteTab removes a window's taskbar button without touching any
; window style. That matters: the alternative, toggling WS_EX_TOOLWINDOW, needs
; SWP_FRAMECHANGED, which sends WM_NCCALCSIZE to a window that may still be
; forming.
;
; The shell API takes an HWND and is happy to be called cross-process. This
; script runs elevated and Overwolf does not, and a higher integrity level may
; act on a lower one, so the direction is legal.
;
; Falls back to the ex-style toggle only if the COM object cannot be created.
global _fsTbl       := 0
global _fsTblReady  := false
global _fsTblBroken := false

_FSTaskbarInit() {
    global _fsTbl, _fsTblReady, _fsTblBroken
    if (_fsTblReady || _fsTblBroken)
        return
    try {
        _fsTbl := ComObject("{56FDF344-FD6D-11d0-958A-006097C9A090}"   ; CLSID_TaskbarList
                          , "{56FDF342-FD6D-11d0-958A-006097C9A090}")  ; IID_ITaskbarList
        ComCall(3, _fsTbl)                       ; ITaskbarList::HrInit
        _fsTblReady := true
    } catch {
        _fsTbl       := 0
        _fsTblReady  := false
        _fsTblBroken := true
        _FSLog("FS-COLD ITaskbarList unavailable -- falling back to WS_EX_TOOLWINDOW")
    }
}

; Ledgered wrappers. The raw call is fire-and-forget; these remember that WE
; took a button away, so exactly one janitor puts it back and nothing tries to
; restore a button on a window that never had one.
; True only while the F4 full-shutdown path is running. It tells ExitCleanup
; that the Overwolf / Battle.net / Hearthstone processes have just been killed,
; so its restore janitors have nothing left to make reachable and should stay
; out of the way. Cleared again if the kill turns out to have failed.
global _f4Shutdown := false

global _fsTabRemoved := Map()

_FSTabOff(hwnd) {
    global _fsTabRemoved
    if _fsTabRemoved.Has(hwnd)
        return
    _fsTabRemoved[hwnd] := true
    _FSTaskbarTab(hwnd, false)
}

_FSTabOn(hwnd) {
    global _fsTabRemoved
    if !_fsTabRemoved.Has(hwnd)
        return
    _MapDrop(_fsTabRemoved, hwnd)
    _FSTaskbarTab(hwnd, true)
}

_FSTaskbarTab(hwnd, show) {
    global _fsTbl, _fsTblReady, _fsTblBroken
    if (_fsTblReady && !_fsTblBroken) {
        try {
            ComCall(show ? 4 : 5, _fsTbl, "Ptr", hwnd)   ; AddTab / DeleteTab
            return true
        } catch {
            _fsTblBroken := true
            _fsTblReady  := false
            _fsTbl       := 0
            _FSLog("FS-COLD ITaskbarList call failed -- falling back to WS_EX_TOOLWINDOW")
        }
    }
    ; Fallback: ex-style toggle. Deliberately WITHOUT SWP_FRAMECHANGED -- the
    ; taskbar reads the style on the next show/hide transition, and skipping
    ; the frame recalculation keeps this safe on a forming window.
    try {
        static GWL_EXSTYLE := -20, WS_EX_TOOLWINDOW := 0x80, WS_EX_APPWINDOW := 0x40000
        fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
        fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        ex := show ? ((ex & ~WS_EX_TOOLWINDOW) | WS_EX_APPWINDOW)
                   : ((ex | WS_EX_TOOLWINDOW) & ~WS_EX_APPWINDOW)
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr", ex)
        return true
    }
    return false
}

; ── Is this window eligible to be parked? ─────────────────────────────────────
; Deliberately narrow, and the restriction is load-bearing.
;
; Parking moves a window, and moving the wrong one is worse than any flicker:
; the in-game OVERLAY is positioned by Overwolf relative to the Hearthstone
; window and is not necessarily re-placed afterwards. Park the overlay and the
; one surface that must work has been silently broken.
;
; So only windows positively identified as the Firestone desktop application are
; parked, plus -- before a window has ever been shown -- any Overwolf window
; small enough not to be the overlay, since the park records its exact rectangle
; and the unpark restores it. Click-through windows (WS_EX_TRANSPARENT) and
; anything on CFG.fsVisibleTitles are excluded outright.
_FSMayPark(hwnd, title) {
    if IsFSVisibleTitle(title)
        return false
    ; ── THE IN-GAME OVERLAY IS NEVER PARKED, WHATEVER IT IS CALLED ──────────
    ; The title test above is not sufficient on every Firestone build: the
    ; overlay may be titled simply "Firestone", which the allow-list below
    ; accepts as parkable. Parking it moves the one surface the user is
    ; actually playing with off the virtual desktop -- see
    ; CFG.fsOverlayShapeDetect for the log evidence and the symptom (pins and
    ; minion clicks not landing).
    if IsFirestoneInGameOverlay(hwnd, title)
        return false
    if IsFSNeverConcealTitle(title)   ; Settings: never concealed, so never
        return false                  ; parked -- belt and braces under the
                                      ; funnel's own refusal
    try {
        ex := WinGetExStyle("ahk_id " . hwnd)
        if (ex & 0x20)              ; WS_EX_TRANSPARENT: click-through overlay
            return false
    }

    ; Positively-identified Firestone app windows: always parkable.
    ;
    ; IsFirestoneAppTitle covers the rest of the family -- Settings and anything
    ; else titled "Firestone - X". They were previously left to the cloak alone,
    ; which is worse for them in two ways: a cloaked window still HIT-TESTS, so
    ; an invisible Settings window sitting over the board swallows clicks the
    ; user aims at the game; and a cloak has no recorded rectangle, so there was
    ; nothing for the reveal to restore them from. Parking gives them the same
    ; treatment Main and Battlegrounds get: off the desktop entirely, rectangle
    ; remembered, and handed back exactly where they were.
    if (title = "Firestone - Main"
     || title = "Firestone - Battlegrounds" || title = "Firestone"
     || IsFirestoneAppTitle(title))
        return true

    ; ── NOTHING UNNAMED IS EVER PARKED. ────────────────────────────────────
    ; There used to be a "pre-show allowance" here: any not-yet-visible Overwolf
    ; window of reasonable size could be parked off the virtual desktop before
    ; it was ever shown, on the theory that a synchronous move beats a DWM cloak
    ; by up to one frame.
    ;
    ; OVERWOLF IS A PLATFORM, NOT AN APP. It hosts League overlays, TFT
    ; overlays, and whatever else the user has installed, all inside the same
    ; two executables this script enumerates. An untitled newborn is therefore
    ; as likely to belong to somebody else's app as to Firestone -- and parking
    ; RECORDS the window in _fsParked, which F3's unlock sweep restores and
    ; shows. That is exactly how pressing F3 opened a TFT app: the script had
    ; parked a window it could not name, then dutifully handed it back.
    ;
    ; A cloak has no ledger and no restore, so an unnamed newborn is cloaked
    ; instead (see _FSSuppressSurface) and released as soon as its title shows
    ; it belongs to somebody else. The theoretical one frame is worth far less
    ; than reaching into another application's windows.
    return false
}

; ── Off-screen park ───────────────────────────────────────────────────────────
; Moves the window entirely outside the virtual desktop. SetWindowPos does not
; clamp to the desktop, so this is exact. SWP_NOSIZE|SWP_NOZORDER|SWP_NOACTIVATE
; means nothing changes except the origin -- no resize, no z-order churn, no
; focus theft, and above all no ShowWindow.
_FSParkWindow(hwnd) {
    global _fsParked, _fsParkedRect, CFG, _fsEverShown, _fsWasMainTitled, _fsAlphaConcealed
    global _fsMainBirthShielded
    ; Main is never parked. It is held at alpha 0 exactly where Firestone put
    ; it, which is the only concealed state that keeps DWM compositing it and
    ; keeps its taskbar button. A parked window is off the virtual desktop and
    ; _FSConcealMain has to unpark it again before it can do anything, so the
    ; two paths would fight. Six call sites reach this function; this is the one
    ; place that can say no to all of them.
    ; ── THE ONE EXEMPTION: MAIN BEFORE ITS FIRST F3 ─────────────────────────
    ;
    ; The refusal below is the steady-state policy and it stays: once the user
    ; has seen Main, it is held at alpha 0 where it is, and moving it around
    ; underneath them would be wrong.
    ;
    ; But before the first F3 the window has never been wanted on screen, and
    ; leaving it there was the whole flicker. Parking it ONCE at birth was not
    ; enough either -- measured 19:10:59, the park succeeded and a frame still
    ; reached the user 906ms later, because Overwolf positions its own window
    ; after creating it and put it straight back.
    ;
    ; Battlegrounds survives exactly that, and this is why: _FSColdSuppress and
    ; _FSWarmSuppress call _FSParkWindow on every sweep, so anything Overwolf
    ; moves back gets moved out again. Main was refused on every one of those
    ; sweeps, so it had no second chance. Letting the shielded window through
    ; puts it on the same footing as the window that has never once flickered.
    ;
    ; It re-locks itself: the shield is dropped at the first F3, so from then
    ; on this refusal applies again and the alpha-in-place policy resumes.
    if (_fsMainBirthShielded.Has(hwnd)) {
        ; fall through and park -- pre-reveal Main is parked like Battlegrounds
    } else if (_fsWasMainTitled.Has(hwnd) || _fsAlphaConcealed.Has(hwnd)) {
        _FSTraceNote(hwnd, "park REFUSED -- Main is held at alpha 0 in place")
        return false
    }
    try {
        vx := SysGet(76), vy := SysGet(77), vw := SysGet(78), vh := SysGet(79)

        ; Re-assert rather than set and forget. The ledger entry means "this window is
        ; ours", not "this window is done": Overwolf-style applications re-centre their
        ; own windows shortly after showing them. Every call re-reads where the window
        ; actually is and moves it back if it has drifted onto the virtual desktop.
        ; Idempotent when it has not -- the common path is one GetWindowRect.
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return false
        cx := NumGet(rc, 0, "Int"), cy := NumGet(rc, 4, "Int")
        cw := NumGet(rc, 8, "Int") - cx, ch := NumGet(rc, 12, "Int") - cy
        offscreen := !(cx + cw > vx && cx < vx + vw && cy + ch > vy && cy < vy + vh)

        if (_fsParked.Has(hwnd) && offscreen)
            return true                 ; still parked where we put it

        if !_fsParked.Has(hwnd) {
            ; First park: centre on the primary monitor WHILE HIDDEN, then
            ; remember THAT rectangle. F3 then restores a window that was
            ; staged on the primary rather than wherever Overwolf spawned it.
            ; A window that has never been shown has no position worth
            ; keeping, so the restore rect becomes the centred one -- COMPUTED,
            ; not achieved by moving the window there first. See
            ; _FSCenteredRectFor for what that used to cost.
            if !_fsEverShown.Has(hwnd) {
                if _FSCenteredRectFor(hwnd, &ncx, &ncy)
                    cx := ncx, cy := ncy
            }
            if (cw >= 200 && ch >= 200)
                _fsParkedRect[hwnd] := {x: cx, y: cy, w: cw, h: ch}

            ; No cycle cap here. Park and unpark are geometry changes, which a browser
            ; window handles thousands of times without complaint; the expensive operation
            ; was never this one. Capping it would also be unsafe now that parking is the
            ; steady-state concealment mechanism, since refusing to park would simply leave
            ; the window on screen.
        }

        ; Park at the window's existing vertical offset, just past the right edge of the
        ; desktop, so the unpark is a pure horizontal restore -- one less axis for the
        ; compositor to reconcile in the frame the window reappears.
        px := vx + vw + 64
        py := (cy >= vy && cy < vy + vh) ? cy : vy
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", px, "Int", py, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)   ; NOSIZE|NOZORDER|NOACTIVATE
        ; No _FSTabOff. A parked window is still OPEN -- it has only been moved
        ; off the side of the desktop -- so it keeps its taskbar button. That
        ; button is the "Firestone is running" indicator and the only way back
        ; to the window by hand. Removing it from the callers was not enough:
        ; this function stripped it too, which is why the indicator was missing
        ; on every attempt including the good ones.
        _fsParked[hwnd] := true
        return true
    }
    return false
}

; Bring a parked window back. Prefers the remembered position; falls back to
; centring on the chosen monitor when there is none, or when the remembered
; one no longer lands on a monitor (display layout changed while parked).
; Never activates, never resizes.
_FSUnparkWindow(hwnd) {
    global _fsParked, _fsParkedRect, CFG, ChosenMonIdx, _fsEverShown
    if !_fsParked.Has(hwnd)
        return false
    _MapDrop(_fsParked, hwnd)
    try {
        _FSTabOn(hwnd)
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return false
        w := NumGet(rc, 8, "Int") - NumGet(rc, 0, "Int")
        h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")

        nx := "", ny := ""

        ; ── THE FIRST TIME A WINDOW IS SHOWN, IT IS CENTRED ─────────────────
        ; ...on the PRIMARY monitor, and only that first time.
        ;
        ; The rectangle below is recorded by _FSParkWindow at the window's FIRST
        ; park -- which happens at its birth, seconds into the launch, while it
        ; is still being concealed and long before anyone has looked at it. So
        ; on the very first reveal the "remembered position" is not a position
        ; the user chose at all: it is wherever Overwolf dropped a newborn
        ; window, which is arbitrary and routinely lands on the monitor the game
        ; is about to fill.
        ;
        ; Distinguishing the two is the whole job here. Before the window has
        ; ever been on screen there is no user position to preserve, so it is
        ; opened centred on the primary monitor. From the moment it HAS been on
        ; screen the recorded rectangle means what the code below assumes it
        ; means, and it is honoured exactly as before -- move Main to the second
        ; screen, toggle F3, and it comes back where you left it.
        firstOpen := !_fsEverShown.Has(hwnd)
        _fsEverShown[hwnd] := true

        ; ── A window returns to where it was ────────────────────────────────
        ; Firestone's windows are not pinned to the launch monitor. They are the ones
        ; read while playing, so they belong wherever the user put them -- typically a
        ; second screen, beside the game rather than over it. The park records each
        ; window's exact rectangle and the unpark restores it, so moving Main to
        ; another monitor and toggling F3 leaves it exactly where it was.
        ;
        ; CFG.fsFollowMonitorLock := true pins them with everything else.
        ; lockWindowsToChosenMonitor deliberately does not govern this; it still
        ; governs Battle.net, the Agent, Hearthstone and the HUD.
        if (!CFG.fsFollowMonitorLock && !firstOpen) {
            if _fsParkedRect.Has(hwnd) {
                o := _fsParkedRect[hwnd]
                _MapDrop(_fsParkedRect, hwnd)
                vx := SysGet(76), vy := SysGet(77), vw := SysGet(78), vh := SysGet(79)
                ; Only reject it if the layout changed underneath us and the
                ; remembered spot is no longer on any monitor at all.
                if (o.x + o.w > vx && o.x < vx + vw
                 && o.y + o.h > vy && o.y < vy + vh) {
                    nx := o.x, ny := o.y
                }
            }
        } else {
            _MapDrop(_fsParkedRect, hwnd)
        }
        if (nx = "") {
            ; firstOpen forces the PRIMARY monitor. fsFollowMonitorLock is the
            ; opt-in that pins Firestone to the session monitor with everything
            ; else, so it still wins when someone has deliberately set it.
            idx := (CFG.fsFollowMonitorLock && CFG.lockWindowsToChosenMonitor
                 && ChosenMonIdx)
                 ? ChosenMonIdx : MonitorGetPrimary()
            _SafeWorkArea(idx, &waL, &waT, &waR, &waB)
            waW := waR - waL, waH := waB - waT
            nx := (w > 0 && w <= waW) ? waL + (waW - w) // 2 : waL
            ny := (h > 0 && h <= waH) ? waT + (waH - h) // 2 : waT
        }
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", nx, "Int", ny, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)   ; NOSIZE|NOZORDER|NOACTIVATE
        return true
    }
    return false
}

; ── Centre a window on the primary monitor ───────────────────────────────────
;
; The same arithmetic _FSUnparkWindow uses for a window it is bringing back for
; the first time, in a form the REVEAL can call directly.
;
; It needs to exist separately because the unpark is not the only way a
; Firestone window reaches the screen, and "first open is centred" has to be
; true however it got there. A window concealed by the PARK comes back through
; _FSUnparkWindow and is centred there. A window concealed by the SW_HIDE exit
; -- which is what Firestone Main takes whenever _FSMayPark declines it, and
; what the birth-hide ledger produces -- is never un-parked at all: it is simply
; shown again, wherever it happens to sit. Centring only in the unpark therefore
; centred Battlegrounds reliably and Main only sometimes, which is exactly the
; inconsistency being reported.
;
; NOSIZE, so nothing is resized: the two windows are centred independently and
; are free to overlap each other, which is the intended result rather than a
; side effect -- they are separate windows the user drags apart if they want to.
; ── WHERE A WINDOW *WOULD* BE CENTRED, WITHOUT MOVING IT ─────────────────────
;
; The arithmetic half of _FSCenterOnPrimary, split out because the park needed
; the ANSWER and was calling the whole function to get it -- which moved the
; window onto the middle of a monitor first.
;
; THAT WAS A FLICKER, AND A GUARANTEED ONE. _FSParkWindow's job is to get a
; window off the screen before anyone sees it. To record where it should be
; restored to, it called _FSCenterOnPrimary, which performs a real SetWindowPos
; onto the centre of the chosen monitor, and only then parked it outside the
; virtual desktop. So the concealment path deliberately placed the window in
; the most visible position on the display immediately before hiding it, and
; whether the user saw a frame came down to how fast the next call landed.
;
; A restore position is information. It never required touching the window.
_FSCenteredRectFor(hwnd, &nx, &ny) {
    global CFG, ChosenMonIdx
    nx := 0, ny := 0
    try {
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return false
        w := NumGet(rc, 8, "Int") - NumGet(rc, 0, "Int")
        h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")
        if (w < 100 || h < 100)
            return false
        idx := (CFG.fsFollowMonitorLock && CFG.lockWindowsToChosenMonitor
             && ChosenMonIdx)
             ? ChosenMonIdx : MonitorGetPrimary()
        _SafeWorkArea(idx, &waL, &waT, &waR, &waB)
        waW := waR - waL, waH := waB - waT
        nx := (w <= waW) ? waL + (waW - w) // 2 : waL
        ny := (h <= waH) ? waT + (waH - h) // 2 : waT
        return true
    }
    return false
}

_FSCenterOnPrimary(hwnd) {
    global CFG, ChosenMonIdx
    try {
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return false
        w := NumGet(rc, 8, "Int") - NumGet(rc, 0, "Int")
        h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")
        if (w < 100 || h < 100)
            return false

        ; fsFollowMonitorLock is the opt-in that pins Firestone to the session
        ; monitor with everything else; it still wins where someone has set it.
        idx := (CFG.fsFollowMonitorLock && CFG.lockWindowsToChosenMonitor
             && ChosenMonIdx)
             ? ChosenMonIdx : MonitorGetPrimary()
        _SafeWorkArea(idx, &waL, &waT, &waR, &waB)
        waW := waR - waL, waH := waB - waT
        nx := (w <= waW) ? waL + (waW - w) // 2 : waL
        ny := (h <= waH) ? waT + (waH - h) // 2 : waT
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", nx, "Int", ny, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)   ; NOSIZE|NOZORDER|NOACTIVATE
        return true
    }
    return false
}

; Windows that must never paint and must never be handed to F3: Firestone
; Loading, HSReplay Loading, and (via a separate path) Battle.net services.
global _fsBuriedForever := Map()

_FSBuryForever(hwnd) {
    global _fsBuriedForever, _fsParked, _fsParkedRect, _fsHiddenByUs, _fsShielded
    if !hwnd
        return
    _fsBuriedForever[hwnd] := A_TickCount
    try {
        _DisableDWMTransitions(hwnd)
        CloakWindow(hwnd, false, "_FSBuryForever")
        _FSTabOff(hwnd)
        _FSHideWindow(hwnd, "_FSBuryForever")   ; SW_HIDE -- never paint
    }
    ; Detach from F3. Leave geometry alone: unparking would flash it on screen.
    _MapDrop(_fsParked, hwnd)
    _MapDrop(_fsParkedRect, hwnd)
    _MapDrop(_fsHiddenByUs, hwnd)
    _MapDrop(_fsShielded, hwnd)
}

_FSUnburyIfF3Surface(hwnd, title) {
    global _fsBuriedForever
    if !_fsBuriedForever.Has(hwnd)
        return false
    if !(IsFirestoneMainTitle(title) || IsFirestoneBattlegroundsTitle(title)
      || _FSIsMainSurface(hwnd, title))
        return false
    ; Same HWND retitled Loading -> Main. It is now F3's, not a splash.
    _MapDrop(_fsBuriedForever, hwnd)
    _FSLog("FS-UNBURY hwnd=" . hwnd . " title=`"" . title . "`" -- this window"
         . " was buried as Loading and has become an F3 surface")
    return true
}

; Unpark EVERYTHING. Janitor of last resort -- exit, F4, abort. A window left
; parked by a crashed instance is off-screen with no taskbar button, i.e.
; unreachable, so this must run on every teardown path.
_FSUnparkAll() {
    global _fsParked, _fsTabRemoved, _fsBuriedForever
    for h in _fsParked.Clone() {
        try {
            ; ── FIRESTONE'S WINDOWS ONLY. THE TRACKER HAS ITS OWN. ──────────
            ; _fsParked once held both families, because the tracker parked
            ; through _FSParkWindow, and this loop consequently needed to know
            ; about the tracker's bury ledger to avoid dragging a deliberately
            ; buried tracker window back onto the desktop at exit. That
            ; cross-check is gone because the situation that required it is
            ; gone: SECTION 7C gives the tracker _hdtParked and _HDTUnparkAll,
            ; and nothing but Firestone reaches this ledger now.
            if _fsBuriedForever.Has(h)
                continue
            if DllCall("user32\IsWindow", "Ptr", h)
                _FSUnparkWindow(h)
            else
                _MapDrop(_fsParked, h)
        }
    }
    ; And give every window its taskbar button back, including ones that were
    ; never movable and so were never in _fsParked.
    for h in _fsTabRemoved.Clone() {
        try {
            if DllCall("user32\IsWindow", "Ptr", h)
                _FSTabOn(h)
            else
                _MapDrop(_fsTabRemoved, h)
        }
    }
}

; ── Stranded-park repair ──────────────────────────────────────────────────────
; Every concealment in this script has a janitor, and the park needs one that
; works from a COLD LEDGER. If the script is reloaded, killed or crashes while a
; window is parked, the next instance starts with no bookkeeping and would never
; know to bring it back: the window would sit outside the virtual desktop, with
; no taskbar button, unreachable for the rest of the Overwolf session.
;
; A window is judged stranded when its rectangle does not intersect the virtual
; desktop at all. Nothing legitimate lives there.
FSRepairStrandedWindows() {
    global CFG, _fsTabRemoved, _fsParked, _fsParkedRect, ChosenMonIdx, _fsBuriedForever
    static lastRun := 0

    ; THROTTLE. This enumerates four processes and does a GetWindowRect on every
    ; window. StartFSReveal calls it on EVERY F3 unlock, so under a stress test
    ; it was running several times a second for no reason -- a window cannot
    ; become stranded between two key presses.
    if (lastRun && A_TickCount - lastRun < 3000)
        return
    lastRun := A_TickCount

    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        vx := SysGet(76), vy := SysGet(77), vw := SysGet(78), vh := SysGet(79)
        for exe in CFG.fsAlphaRepairExes {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    rc := Buffer(16, 0)
                    if !DllCall("user32\GetWindowRect", "Ptr", h, "Ptr", rc)
                        continue
                    l := NumGet(rc, 0, "Int"), t := NumGet(rc, 4, "Int")
                    r := NumGet(rc, 8, "Int"), b := NumGet(rc, 12, "Int")
                    if (r - l < 100 || b - t < 60)
                        continue
                    if _fsBuriedForever.Has(h)
                        continue
                    ; Intersects the virtual desktop? Then it is not stranded.
                    if (r > vx && l < vx + vw && b > vy && t < vy + vh)
                        continue
                    ; OURS, ON PURPOSE. A window this instance has parked is
                    ; off the virtual desktop BY DESIGN and is not stranded.
                    ; Without this the repair could not tell "abandoned by a
                    ; dead instance" from "deliberately parked one second ago"
                    ; -- and since CompleteHSLaunchSuccess schedules a repair
                    ; 1.5 s out, and the deferred launch starts Firestone right
                    ; around then, it was dragging freshly-parked Firestone
                    ; windows back onto the screen and handing them their
                    ; taskbar buttons. That is the "Getting ready" window in
                    ; the screenshot.
                    if _fsParked.Has(h)
                        continue

                    ; ── THE NOTIFICATION POPUP IS OFF-SCREEN ON PURPOSE ─────
                    ; and it is NOT in _fsParked, deliberately: it has no
                    ; ledger entry precisely so that nothing can restore it.
                    ; This repair was the one thing that did anyway. It walks
                    ; the same processes, sees a window outside the virtual
                    ; desktop, and "rescues" it -- taskbar button and all --
                    ; straight onto the monitor the user is playing on.
                    ;
                    ; StartFSReveal calls this function, so that is exactly
                    ; why a nag popup would appear on an F3 press: the popup
                    ; had never actually closed, it was parked off-screen
                    ; waiting, and F3 fetched it back. The popup was never
                    ; meant to have anything to do with F3.
                    ;
                    ; Hand it to the closer instead and leave it where it is.
                    tPop := ""
                    try tPop := WinGetTitle("ahk_id " . h)
                    if IsFirestoneNotificationPopup(h, tPop) {
                        _FSKillNotificationPopup(h, "stranded sweep")
                        continue
                    }

                    _fsTabRemoved[h] := true      ; force the restore below
                    _FSTabOn(h)

                    ; ── AND UN-HIDE IT, NOT JUST MOVE IT ───────────────────
                    ; A stranded window is one this script (or a previous,
                    ; killed instance of it) put outside the virtual desktop
                    ; and then lost the ledger for. Giving it its position and
                    ; its taskbar button back while leaving WS_VISIBLE clear
                    ; puts it in the exact state the iron rule forbids:
                    ; concealed with nothing anywhere able to show it.
                    ;
                    ; That gap was reachable before this change (the warm
                    ; exit's ledgered SW_HIDE dies with the ledger on a kill)
                    ; and is reachable more often now that the Battlegrounds
                    ; hide is HELD rather than traded for a park. This closes
                    ; it for both. Cheap: the window is off-screen at this
                    ; point, so the show cannot flash, and it is a no-op for
                    ; the far more common already-visible case.
                    ;
                    ; A window still in _fsParked never reaches here -- it is
                    ; ours, on purpose, and was skipped above.
                    try {
                        UncloakWindow(h, true, "FSRepairStrandedWindows")
                        if !DllCall("user32\IsWindowVisible", "Ptr", h)
                            DllCall("ShowWindow", "Ptr", h, "Int", 8)  ; SW_SHOWNA
                    }
                    ; Rescued windows go to the chosen monitor, not the primary. This function
                    ; recovers exactly the windows this script parks -- which is every time the
                    ; park ledger has been lost to a reload -- so depositing them on the primary
                    ; would place them off the session's monitor and they would be revealed there.
                    if _fsParkedRect.Has(h) {
                        _o := _fsParkedRect[h]
                        _MapDrop(_fsParkedRect, h)
                        if (_o.x + _o.w > vx && _o.x < vx + vw
                         && _o.y + _o.h > vy && _o.y < vy + vh) {
                            DllCall("user32\SetWindowPos", "Ptr", h, "Ptr", 0
                                , "Int", _o.x, "Int", _o.y, "Int", 0, "Int", 0
                                , "UInt", 0x0001 | 0x0004 | 0x0010)
                            _MapDrop(_fsParked, h)
                            _FSLog("FS-PARK repaired stranded window exe=" . exe
                                 . " hwnd=" . h . " -- restored to its own last position")
                            continue
                        }
                    }
                    _rIdx := (CFG.lockWindowsToChosenMonitor && ChosenMonIdx)
                           ? ChosenMonIdx : MonitorGetPrimary()
                    _SafeWorkArea(_rIdx, &waL, &waT, &waR, &waB)
                    DllCall("user32\SetWindowPos", "Ptr", h, "Ptr", 0
                        , "Int", waL + 80, "Int", waT + 80, "Int", 0, "Int", 0
                        , "UInt", 0x0001 | 0x0004 | 0x0010)
                    _FSLog("FS-PARK repaired stranded window exe=" . exe
                         . " hwnd=" . h . " -- was outside the virtual desktop")
                }
            }
        }
    }
    DetectHiddenWindows prev
}

; ── PAINT PROOF ───────────────────────────────────────────────────────────────
; Does this window have real composited content?
;
; PrintWindow with PW_RENDERFULLCONTENT (0x2) copies what DWM actually holds for
; the window, including DirectComposition/Chromium surfaces -- without that flag
; a Chromium window prints black, which is why a naive probe would report every
; window as unpainted. The result is sampled on a sparse grid and the number of
; DISTINCT colours is counted: a drawn Firestone dashboard yields hundreds, a
; never-drawn window yields one (usually pure black).
;
; Returns true/false; `distinct` receives the count for the log.
_FSWindowHasPainted(hwnd, &distinct) {
    static PW_RENDERFULLCONTENT := 0x2
    distinct := 0
    hdcScreen := 0, hdcMem := 0, hbm := 0, oldBm := 0
    try {
        ; A window with no WS_VISIBLE prints black no matter what, so do not
        ; waste the capture -- and never report a hidden window as painted.
        if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            return false
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return false
        w := NumGet(rc, 8, "Int") - NumGet(rc, 0, "Int")
        h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")
        if (w < 200 || h < 200)
            return false
        if (w > 1024)
            w := 1024                 ; cap the capture; PrintWindow just clips
        if (h > 1024)
            h := 1024

        hdcScreen := DllCall("user32\GetDC", "Ptr", 0, "Ptr")
        if !hdcScreen
            return false
        hdcMem := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
        if !hdcMem
            return false

        bi := Buffer(40, 0)
        NumPut("UInt",   40, bi,  0)          ; biSize
        NumPut("Int",     w, bi,  4)          ; biWidth
        NumPut("Int",    -h, bi,  8)          ; biHeight, negative = top-down
        NumPut("UShort",  1, bi, 12)          ; biPlanes
        NumPut("UShort", 32, bi, 14)          ; biBitCount
        NumPut("UInt",    0, bi, 16)          ; BI_RGB

        pBits := 0
        hbm := DllCall("gdi32\CreateDIBSection", "Ptr", hdcMem, "Ptr", bi
             , "UInt", 0, "Ptr*", &pBits, "Ptr", 0, "UInt", 0, "Ptr")
        if (!hbm || !pBits)
            return false
        oldBm := DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")

        if !DllCall("user32\PrintWindow", "Ptr", hwnd, "Ptr", hdcMem
                  , "UInt", PW_RENDERFULLCONTENT)
            return false

        seen := Map()
        step := 17                    ; prime-ish stride: never aligns with a
                                      ; repeating UI grid and misses variation
        y := 3
        while (y < h) {
            x := 3
            while (x < w) {
                px := NumGet(pBits + 0, (y * w + x) * 4, "UInt") & 0x00FFFFFF
                seen[px] := true
                x += step
            }
            y += step
        }
        distinct := seen.Count
        return true
    } catch {
        return false
    } finally {
        try {
            if (hdcMem && oldBm)
                DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", oldBm, "Ptr")
            if hbm
                DllCall("gdi32\DeleteObject", "Ptr", hbm)
            if hdcMem
                DllCall("gdi32\DeleteDC", "Ptr", hdcMem)
            if hdcScreen
                DllCall("user32\ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
        }
    }
}

; ══════════════════════════════════════════════════════════════════════════════
;  BIRTH-CLOAK REAPER — nothing is left invisible AND clickable
; ══════════════════════════════════════════════════════════════════════════════
;
; THIS IS THE FIX FOR "IT WOULDN'T LET ME OUT OF A WINDOW" AND, PROBABLY, FOR
; CLICKS LANDING ON THE WRONG MINION.
;
; This script's own comment states the hazard and then does not defend against
; it: "a cloaked window is not drawn but is still HIT-TESTED, so one left
; sitting over Hearthstone silently swallows every click that lands on it. An
; invisible window in the middle of the screen is worse than a visible one."
;
; Two paths cloak a window WITHOUT parking it, and therefore leave exactly
; that:
;   * the helper-window branch of _FSSuppressSurface, for any newborn with no
;     title yet -- which is every CEF window, because they are all born
;     nameless;
;   * _FSColdSuppress, whenever _FSMayPark refuses the window -- which it does
;     for every title this script cannot name.
;
; Both are correct as far as they go: cloaking an unidentified newborn is the
; safe direction to be wrong in, and refusing to MOVE another app's window is
; the right call. The gap is what happens next. The release janitor is gated on
; `title != ""`, so a window that never acquires a title is never released, and
; the log is full of windows that never do: "Hidden Window" at 1920x1023,
; untitled Chrome_WidgetWin_0 at 1920x1023, "Overwolf Quick Launcher" at
; 1920x1023 and 1480x460. Any one of those left cloaked over the game is a
; full-monitor invisible sheet that eats every click aimed at anything beneath
; it -- the close button of a window included -- with nothing on screen to
; explain why.
;
; This script's iron rule is that nothing is ever cloaked, parked or hidden
; without a janitor guaranteed to run. This is that janitor for the one case
; that did not have one.
;
; WHAT IT WILL NOT DO. It never releases a window the normal machinery owns: a
; parked window is off the virtual desktop and cannot be clicked, a ledgered
; hidden window is not in the hit-test chain at all, and a window that has
; settled into a name this script recognises belongs to the suppression funnel
; and the reveal. It only ever undoes a cloak on a window that is STILL
; anonymous, still on screen, and still swallowing clicks after the grace
; period -- which is the definition of a window that was never ours.
; ── ONE DECISION PER WINDOW, NOT ONE PER SIX SECONDS ─────────────────────────
; The reaper's release has to be REMEMBERED, or it is not a decision, it is an
; oscillation. _FSColdSuppress calls _FSNoteBirthCloak on every sweep tick for
; every window it cloaks, and the sweep runs at 10-250 ms -- so an uncloak that
; left no record would simply be undone by the next tick and repeated six
; seconds later, giving a full-monitor blank window a visible flash every six
; seconds for the whole session. Exactly the symptom this janitor exists to
; remove, at a slower tempo.
;
; So a reaped window is DISOWNED: the suppression funnel stops touching it
; entirely. That is the honest conclusion anyway -- six seconds on screen
; without ever naming itself as Firestone's means it is not Firestone's -- and
; it is reversible: the funnel drops the disown the moment the window does name
; itself, so a slow-titling Firestone surface is picked straight back up.
global _fsBirthCloaked  := Map()   ; hwnd -> tick we cloaked it, unidentified
global _fsMainBirthShielded := Map() ; hwnd -> tick; temporary CREATE->SHOW shield for Firestone Main
global _fsBirthReaped   := Map()   ; hwnd -> tick, once-per-window log gate
global _fsDisowned      := Map()   ; hwnd -> tick the reaper released it

; ── ONE PREDICATE, ASKED BY BOTH SIDES ───────────────────────────────────────
; The reaper decides a window is not ours; the funnel decides a window IS ours
; again. If those two lists ever differ by a single title, the pair becomes an
; oscillator: the reaper releases, the funnel immediately re-adopts, the reaper
; releases again six seconds later, forever.
;
; That is not hypothetical -- it happened. The reaper's list omitted the bare
; "Firestone" title while the funnel's included it, and the loop was
; self-driving: UncloakWindow raises EVENT_OBJECT_UNCLOAKED, which this hook
; subscribes to, which calls the funnel, which re-adopted and re-cloaked the
; window without needing the sweep at all. So there is now exactly one list and
; both sides read it.
_FSTitleIsOurs(title) {
    return (IsFirestoneSuppressionTitle(title) || IsFirestoneAppTitle(title)
         || title = "Firestone - Loading" || title = "Firestone")
}

_FSNoteBirthCloak(hwnd) {
    global _fsBirthCloaked, _fsDisowned
    if _fsDisowned.Has(hwnd)
        return
    if !_fsBirthCloaked.Has(hwnd)
        _fsBirthCloaked[hwnd] := A_TickCount
}

FSBirthCloakReaper() {
    global _fsBirthCloaked, _fsBirthReaped, _fsParked, _fsHiddenByUs, CFG
    global _fsDisowned, _fsFreshKeptHidden, State, _fsRevealActive

    ; ── FIRST: re-assert the fresh-born park, which nothing else will ───────
    ; _FSConcealFreshUnlocked parks the Battlegrounds window while the F3 lock
    ; is OFF, and the settled sweep -- the janitor that re-asserts parks
    ; against Overwolf's habit of re-centring its own windows -- returns
    ; immediately while unlocked. This hook is not subscribed to
    ; EVENT_OBJECT_LOCATIONCHANGE either, so nothing at all was watching. When
    ; Overwolf moved the window back onto the desktop the result was a cloaked,
    ; still-visible, full-size window over the board swallowing clicks: the
    ; very hazard the rest of this function exists to prevent, arriving through
    ; the one path it skips (a parked window is dropped below).
    ;
    ; _FSParkWindow re-reads the window's real position and only moves it if it
    ; has drifted, so the common case is one GetWindowRect on one window.
    ;
    ; !_fsRevealActive for the same reason the call site in the hook carries it:
    ; a reveal in flight is the user explicitly asking to SEE these windows, and
    ; re-parking one mid-reveal is the tug-of-war this script exists to prevent.
    if (_fsFreshKeptHidden.Count && !State.fsMainLocked && !_fsRevealActive) {
        for h, at in _fsFreshKeptHidden.Clone() {
            try {
                if (!DllCall("user32\IsWindow", "Ptr", h) || !_fsParked.Has(h)) {
                    _MapDrop(_fsFreshKeptHidden, h)   ; gone, or revealed
                    continue
                }
                _FSEnsureCloaked(h)
                _FSParkWindow(h)
            }
        }
    }

    if !_fsBirthCloaked.Count
        return

    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd, at in _fsBirthCloaked.Clone() {
            try {
                ; Gone: nothing to release, and a stale entry on a recycled
                ; handle is a wrong answer waiting to happen.
                if !DllCall("user32\IsWindow", "Ptr", hwnd) {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }
                ; Properly concealed by the normal machinery: off the desktop,
                ; or hidden with a ledger entry to restore it. Not a sink.
                if (_fsParked.Has(hwnd) || _fsHiddenByUs.Has(hwnd)) {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }
                title := ""
                try title := WinGetTitle("ahk_id " . hwnd)
                ; Named itself as one of ours: the funnel and the reveal own it
                ; from here, and both know how to hand it back. THE SAME
                ; PREDICATE THE FUNNEL USES -- see _FSTitleIsOurs for why the
                ; two lists must not be written out separately.
                if (_FSTitleIsOurs(title) || IsFSNeverConcealTitle(title)
                 || IsFirestoneInGameOverlay(hwnd, title)) {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }
                ; A click-through window swallows nothing, so it was never this
                ; janitor's business. WS_EX_TRANSPARENT is also what _FSMayPark
                ; refuses on, which is how such a window reached the ledger in
                ; the first place -- releasing it here only to have the funnel
                ; re-cloak it is the oscillation described above.
                isClickThrough := false
                try isClickThrough := (WinGetExStyle("ahk_id " . hwnd) & 0x20) != 0
                if isClickThrough {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }
                ; Still inside the grace period: it may yet name itself.
                if (A_TickCount - at < CFG.fsBirthCloakMaxMs)
                    continue
                ; Not cloaked any more -- somebody else released it.
                if !IsWindowCloakedDWM(hwnd) {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }
                ; A cloaked window that is not visible is not swallowing
                ; anything. Leave it exactly as it is; Overwolf keeps plenty of
                ; windows hidden on purpose and un-hiding them is not our job.
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd) {
                    _MapDrop(_fsBirthCloaked, hwnd)
                    continue
                }

                UncloakWindow(hwnd, true, "FSBirthCloakReaper")
                _MapDrop(_fsBirthCloaked, hwnd)
                ; Remembered, so the next sweep tick does not simply re-cloak
                ; it and start the six-second cycle again. See _fsDisowned.
                _fsDisowned[hwnd] := A_TickCount
                if !_fsBirthReaped.Has(hwnd) {
                    _fsBirthReaped[hwnd] := A_TickCount
                    w := 0, h := 0
                    try WinGetPos(, , &w, &h, "ahk_id " . hwnd)
                    _FSLog("FS-REAP released a birth cloak on an unidentified"
                         . " window after " . (A_TickCount - at) . "ms hwnd=" . hwnd
                         . " title=`"" . title . "`" size=" . w . "x" . h
                         . " -- it never named itself as Firestone's, and a"
                         . " cloaked window still swallows clicks")
                }
            }
        }
    }
    DetectHiddenWindows prev
}

; Cheap read: has this hwnd been proven (or given up on)? Safe in the hook.
_FSIsWarm(hwnd) {
    global _fsPaintState
    return _fsPaintState.Has(hwnd)
}

; Throttled probe. Called ONLY from the settled suppression sweep -- never from
; the event hook. Promotes the window to WARM on two consecutive passes, or
; gives up (and says so, loudly) at the ceiling.
; ══════════════════════════════════════════════════════════════════════════════
;  MAIN'S READY SIGNAL — its own title, and nothing else
; ══════════════════════════════════════════════════════════════════════════════
;
; Main is left completely untouched until it is ready. The only question is how
; "ready" is decided, and the previous answer was wrong in a way that defeated
; the whole point.
;
; IT USED TO MEASURE WITH PrintWindow. _FSWindowHasPainted calls PrintWindow
; with PW_RENDERFULLCONTENT, which is not a read -- it is a command that makes
; the TARGET's UI thread and dwm.exe perform a full synchronous render. Doing
; that every 250 ms for fifteen seconds to a window whose compositor is still
; being built is the same class of interference as concealing it, and this
; file's own comments say so in two other places. "Do not touch Main while it
; is forming" and "force Overwolf to render Main sixty times while it is
; forming" cannot both be the plan.
;
; FIRESTONE ALREADY ANNOUNCES IT. The window is created titled bare "Firestone"
; (or "Firestone - Loading") and RENAMES ITSELF to "Firestone - Main" when the
; app behind it has finished loading. That rename is a fact published by
; Firestone at exactly the right moment, it is delivered to this script for
; free by the NAMECHANGE hook, and observing it costs nothing at all -- no
; capture, no DC, no DIB section, no cross-process render.
;
; So: watch for the name, wait a short settle after it, then conceal. Between
; creation and that point NOTHING touches the window.
;
; The ceiling remains, for a Main that never renames itself. It is marked ready
; anyway, because an F3 with nothing to toggle is worse than a Main that was
; concealed a little early.
global _fsMainWatchSince := Map()   ; hwnd -> first sighting
global _fsMainTitledAt   := Map()   ; hwnd -> when it first wore the Main title

_FSMainReadyWatch(hwnd, title) {
    global CFG, _fsPaintState, _fsMainWatchSince, _fsMainTitledAt

    if !_fsMainWatchSince.Has(hwnd)
        _fsMainWatchSince[hwnd] := A_TickCount
    age := A_TickCount - _fsMainWatchSince[hwnd]

    ; The rename: Firestone saying the window is finished.
    if IsFirestoneMainTitle(title) {
        if !_fsMainTitledAt.Has(hwnd) {
            _fsMainTitledAt[hwnd] := A_TickCount
            _FSLog("FS-MAIN titled after " . age . "ms hwnd=" . hwnd
                 . " -- Firestone has finished loading it. Settling for "
                 . CFG.fsMainSettleMs . "ms, then it is concealed normally"
                 . " and F3 owns it. Nothing has touched it until now.")
            return
        }
        if (A_TickCount - _fsMainTitledAt[hwnd] >= CFG.fsMainSettleMs) {
            _fsPaintState[hwnd] := 1
            _FSLog("FS-MAIN ready hwnd=" . hwnd . " -- settled, concealing from"
                 . " here (cloak, no taskbar button, parked). F3 toggles it.")
        }
        return
    }

    ; Never renamed. Conceal it anyway rather than leave F3 inert forever.
    if (age > CFG.fsMainPaintCeilingMs) {
        _fsPaintState[hwnd] := 1
        _FSLog("FS-MAIN never took the `"Firestone - Main`" title after " . age
             . "ms hwnd=" . hwnd . " -- concealing it anyway so F3 has"
             . " something to toggle. It was left untouched until now.")
    }
}

; ── _FSProbePaint: REMOVED ──────────────────────────────────────────────────
;
; It answered "has this window painted yet" by calling PrintWindow across
; process boundaries -- a synchronous, full-window render request. Its own
; notes described the cost: seventeen windows per launch, each probed every
; 250ms for twenty seconds, roughly twenty-five full captures a second against
; the same Chromium window while it was still bringing its compositor up.
;
; It is gone because the answer never mattered for the window it was hurting.
; Both _FSWarmSuppress and _FSColdSuppress route a Main surface to
; _FSConcealMain -- "one policy, one function, both temperatures" -- so the
; warm/cold verdict changed nothing for Firestone Main, while producing the
; heaviest sustained load in the file against exactly that window.
;
; Windows now take the cold path unless something else has already marked them
; warm. Nothing in this script calls PrintWindow any more.

; ── The single suppression primitive ──────────────────────────────────────────
; COLD path. Keeps the window 100% invisible without ever clearing WS_VISIBLE.
; ══════════════════════════════════════════════════════════════════════════════
;  THE FLICKER SHIELD — a hard SW_HIDE that lets go of itself
; ══════════════════════════════════════════════════════════════════════════════
;
; A DWM cloak is a request. On a window whose process is still starting the
; compositor declines it often enough that the logs are full of newborn
; Firestone windows sitting there visible with IsWindowCloakedDWM false. The
; park that follows is a MOVE, and a move lands on the next frame. Between the
; declined cloak and the completed move there is one frame at the window's real
; position, and that frame is the flicker.
;
; SW_HIDE is not a request. WS_VISIBLE is cleared synchronously and the window
; cannot be composited at all. So the shield is a hard hide applied at birth --
; and then, crucially, TAKEN OFF AGAIN once the window is provably parked off
; the virtual desktop, which is where it is invisible for free.
;
; ── WHY IT IS TEMPORARY, AND WHY THAT IS THE ENTIRE POINT ────────────────────
; A SUSTAINED hidden state is what stops CEF ever building a compositor for a
; window. That is not a theory: it is how Firestone Main has been killed
; repeatedly, and "Firestone Main did not survive" is what it looks like from
; the outside. So the hide exists only for the handful of frames the park needs
; to land, and a janitor takes it off. The window spends its life parked and
; VISIBLE, which is the state every other part of this script already expects.
;
; ── WHO IS ELIGIBLE, AND WHY IT IS DECIDED BY TIMING ─────────────────────────
; Firestone Main is NEVER eligible. It is born during the launch, under the
; early-cloak blanket and the 10 ms burst, and it does not flicker -- it has
; nothing to gain and everything to lose.
;
; But at birth a window has no title yet, so "is this Main?" cannot be asked
; directly. What can be asked is WHEN it was born, and that separates them
; completely: Main arrives during the launch; the Battlegrounds window is
; created lazily, at the first match, long after Main has opened and the launch
; machinery has stood down. So a Firestone window born while a launch is in
; flight is Main's family and is left alone, and one born after everything has
; settled is the Battlegrounds window and gets the shield.
global _fsShielded := Map()    ; hwnd -> tick we hard-hid it

; ══════════════════════════════════════════════════════════════════════════════
;  THE SHIELD IS A ONE-SHOT. THIS IS THE LEDGER THAT MAKES IT ONE.
; ══════════════════════════════════════════════════════════════════════════════
;
; _fsShielded is the ACTIVE set -- what is hidden right now -- and the release
; empties it. Eligibility was tested against that same set, so the moment the
; janitor let a window go the very next sweep tick found it eligible again and
; hid it a second time. Then a third. Then forever.
;
; That is not a theory. The log records it, at the shield's own janitor rate:
;
;   FS-SHIELD hard-hid "Firestone" at birth ...
;   FS-SHIELD released after 31ms hwnd=1313132 ...
;   FS-SHIELD hard-hid "Firestone" at birth ...
;   FS-SHIELD released after 31ms hwnd=1313132 ...        ... x34
;
; Twenty hide/show pairs a second on a live CEF window, each one a synchronous
; log write on the thread the window hook is delivered on. TWO THINGS FOLLOW,
; and they are the two complaints this fixes:
;
;   * The window strobes. A hide that is undone 31 ms later and re-applied 9 ms
;     after that is not concealment, it is a flashing window -- which is
;     indistinguishable from "the SW_HIDE was removed".
;
;   * Firestone Main's survival becomes a coin toss. A visibility transition
;     makes Chromium tear down and rebuild the compositor's frame sink; this
;     script's own comments say so in four places. Forty of them per second,
;     next to a Main that is still standing its renderer up, is exactly the
;     documented way to wedge it -- and it explains why Main survived some
;     launches and not others with no other variable changing.
;
; The hold (CFG.fsBgHardHideHold) masked this by never releasing. Turning the
; hold off did not introduce the bug, it uncovered it.
;
; So the shield fires ONCE per window, ever. After its release the window is
; parked off the virtual desktop and cloaked, which is the steady state the
; rest of the script is built around and is concealment enough on its own.
global _fsShieldOnce := Map()  ; hwnd -> tick. Permanent for the window's life.
; hwnd -> true once the "holding the hide" line has been written for it. The
; janitor runs every CFG.fsShieldTickMs for as long as the hold lasts, which is
; the rest of the session; one line per window, not forty a second.
global _fsShieldHeldLogged := Map()

; ------------------------------------------------------------------------------
; Aggressive birth suppression – no paint, no click, no trace
; ------------------------------------------------------------------------------
_FSFullBirthSuppress(hwnd) {
    try {
        ; 1. DWM cloak – asks the compositor not to draw (idempotent)
        CloakWindow(hwnd, false, "_FSFullBirthSuppress")
        ; 2. Disable minimise/restore animations
        _DisableDWMTransitions(hwnd)
        ; 3. Move off the virtual desktop (park)
        _FSParkWindow(hwnd)
        ; 4. If it's not already hidden, hide it
        if DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            _FSHideWindow(hwnd, "_FSFullBirthSuppress")   ; SW_HIDE
        ; 5. Make it fully transparent (alpha=0) and layered
        static WS_EX_LAYERED := 0x80000
        static LWA_ALPHA := 0x2
        exStyle := DllCall("user32\GetWindowLongW", "Ptr", hwnd, "Int", -20, "UInt")
        if !(exStyle & WS_EX_LAYERED) {
            DllCall("user32\SetWindowLongW", "Ptr", hwnd, "Int", -20, "UInt", exStyle | WS_EX_LAYERED)
        }
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd, "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA)
        ; 6. Remove from taskbar (optional, but clean)
        _FSTabOff(hwnd)
        return true
    }
    return false
}

; ── Is this window eligible for the flicker shield? ─────────────────────────
; The shield is a hard SW_HIDE applied at birth, released as soon as the
; window is parked off‑screen. It is meant **only** for Firestone Battlegrounds,
; which is created lazily at the first match after the launch has settled.
; Main, Loading, the in‑game overlay and Settings are never eligible.
;
; Conditions:
;   * fsFlickerShield must be true.
;   * The window must not already be shielded.
;   * It must not be Firestone Main (by name or by birth‑time test),
;     not "Firestone - Loading", not the in‑game overlay, and not a
;     never‑conceal title (Settings).
;   * The launch must have finished: _fsMainEverOpened is true and
;     State.f2Active is false. This guarantees that only windows born
;     after the initial storm (i.e. Battlegrounds) are ever hidden.
; ── WHAT MAY BE HIDDEN AT BIRTH, AND WHY MAIN IS NOT ON THE LIST ────────────
;
; THIS PREDICATE AND THE RELEASE TEST IN FSFlickerShieldTick MUST NOT AGREE
; ABOUT ANY WINDOW. That is the whole invariant, and breaking it is what the
; visible flicker was.
;
; Main used to be listed here, on the reasoning quoted in the old comment --
; "leaving it visible until it painted WAS the Main flicker". Meanwhile the
; janitor's first branch releases, immediately and unconditionally, anything
; that answers to _FSIsMainSurface. So every Firestone Main window was hidden
; on the hook's first line and shown again on the very next shield tick, with
; nothing in between: an SW_HIDE and an SW_SHOWNA one frame apart on a window
; that was never going to be concealed. That is not a shield against a
; flicker, it IS the flicker, and it fired on every launch and on every
; reopen from the tray icon. The log names it in two adjacent lines every
; time -- "hard-hid at birth" followed by "released immediately ... this
; window must never be concealed".
;
; The two tests are now disjoint by construction:
;
;   shielded here          Battlegrounds, and Firestone-shaped newborns that
;                          are not Main. Born warm, into an Overwolf that has
;                          been running for minutes, and genuinely parked --
;                          the log shows these released after 0-50 ms with
;                          the park confirmed, which is the healthy path.
;
;   released there         the in-game overlay, Main, never-conceal titles.
;                          Reached only when the hook's cheap PID-and-exstyle
;                          test hid something before anyone could identify it.
;
; Main is now excluded before anything else can claim it, and CFG.fsMainNeverConceal
; is a real setting rather than a comment describing an intention that was
; never implemented.
_FSFlickerShieldEligible(hwnd, title) {
    global CFG, _fsShielded, _fsShieldOnce, _fsBuriedForever
    if !CFG.fsFlickerShield
        return false
    if _fsShielded.Has(hwnd)
        return false
    if _fsShieldOnce.Has(hwnd)
        return false
    if _fsBuriedForever.Has(hwnd)
        return false
    if (title = "Firestone - Loading")
        return false
    if IsFirestoneInGameOverlay(hwnd, title)
        return false
    if IsFSNeverConcealTitle(title)
        return false

    ; ── MAIN IS NEVER HIDDEN AT BIRTH ──────────────────────────────────────
    ; Checked before the accept test below, because _FSIsMainSurface and
    ; IsFirestoneBattlegroundsTitle can both answer yes about the same
    ; newborn while it is still wearing the provisional bare "Firestone"
    ; title. Whichever way that race lands, Main must lose it.
    if (CFG.fsMainNeverConceal && _FSIsMainSurface(hwnd, title))
        return false

    ; F3 surfaces only: hide until the park lands, then the janitor un-hides
    ; off-desktop so CEF keeps a compositor.
    if (IsFirestoneBattlegroundsTitle(title))
        return true
    if (!CFG.fsMainNeverConceal
     && (IsFirestoneMainTitle(title) || _FSIsMainSurface(hwnd, title)))
        return true
    return false
}

_FSFlickerShieldOn(hwnd, title) {
    global _fsShielded, _fsHiddenByUs, _fsShieldOnce
    if (_fsShielded.Has(hwnd) || _fsShieldOnce.Has(hwnd))
        return
    _fsShielded[hwnd]   := A_TickCount
    _fsShieldOnce[hwnd] := A_TickCount    ; this window's one and only shot
    ; ── AND RECORDED AS OURS TO GIVE BACK ──────────────────────────────────
    ; _fsHiddenByUs means "this script took this window off the screen and owes
    ; it back", and every restore path in the file reads it: the F3 reveal,
    ; ExitCleanup, the F4 shutdown, the stranded-window repair. A shielded
    ; window is hidden by definition, so if the script were killed while the
    ; shield was on and this were not recorded, the window would stay hidden
    ; with nothing anywhere able to show it -- which is the one outcome this
    ; script's iron rule forbids. The shield's own release drops the entry
    ; again a fraction of a second later.
    _fsHiddenByUs[hwnd] := true
    try _FSHideWindow(hwnd, "_FSFlickerShieldOn")      ; SW_HIDE
    _FSLog("FS-SHIELD hard-hid `"" . title . "`" at birth so nothing can be"
         . " painted before the park lands -- released as soon as it is"
         . " provably off the virtual desktop")
}

; Take the shield off every window that no longer needs it. Runs on the same
; one-second janitor as the birth-cloak reaper.
;
; RELEASE IS CONDITIONAL ON THE PARK HAVING LANDED, not on a timer alone. The
; whole reason the shield exists is that the park takes a frame; showing the
; window again before the move has actually happened would hand back the exact
; frame it was preventing. So the window's real rectangle is read, and it is
; only shown once it is outside the virtual desktop.
;
; The ceiling is the safety net rather than the mechanism: a window that never
; parks is released anyway, because a window left hidden by this script with
; nothing to un-hide it is the one outcome that is worse than a flicker.
FSFlickerShieldTick() {
    global _fsShielded, _fsParked, CFG, State, _fsHiddenByUs, _fsShieldHeldLogged

    if !_fsShielded.Count
        return

    ; ── HIDDEN WINDOWS MUST BE ADDRESSABLE ─────────────────────────────────
    ; Every window in this ledger has had WS_VISIBLE cleared by this script, and
    ; a timer thread starts with DetectHiddenWindows OFF -- so WinGetTitle,
    ; WinGetStyle and WinGetPos would all throw on exactly the windows this
    ; janitor exists to make decisions about. The identity tests below would
    ; then silently see an empty title and hold a window they should have
    ; released, which is the in-game overlay left hidden mid-match.
    ;
    ; Restored on the way out rather than left set: a timer thread's settings
    ; persist for the rest of that thread, and this one is not the only thing
    ; that runs in it.
    prevDHW := A_DetectHiddenWindows
    DetectHiddenWindows true

    vx := SysGet(76), vy := SysGet(77), vw := SysGet(78), vh := SysGet(79)

    for hwnd, at in _fsShielded.Clone() {
        try {
            if !DllCall("user32\IsWindow", "Ptr", hwnd) {
                _MapDrop(_fsShielded, hwnd)
                _MapDrop(_fsShieldHeldLogged, hwnd)
                continue
            }
            age := A_TickCount - at

            ; ── ALREADY SETTLED: NOTHING LEFT TO DECIDE ────────────────────
            ; Under the hold this loop runs for the rest of the session, and
            ; every test below it is an identity question that was answered the
            ; first time. Re-asking a window whether it is the overlay,
            ; twenty-five times a second, for an hour, is pure waste next to a
            ; window that is not going to change its mind. The ledger entry is
            ; dropped by the reveal, by the death check above and by the
            ; pruner, so this cannot outlive the hold it is short-circuiting.
            if _fsShieldHeldLogged.Has(hwnd)
                continue

            ; ── THE TWO WINDOWS THAT MUST COME BACK IMMEDIATELY ────────────
            ; The hard hide is applied on the hook's first line from a PID
            ; compare and an ex-style test, which is deliberately as little
            ; work as possible -- so this is where a window that turns out to
            ; be the in-game overlay, Firestone Main or Settings is given back,
            ; at once and without waiting for a park that is never coming.
            ;
            ; This is the janitor the iron rule asks for. Nothing reaches
            ; _fsShielded without a guaranteed way out of it.
            shTitle := ""
            try shTitle := WinGetTitle("ahk_id " . hwnd)
            if (IsFirestoneInGameOverlay(hwnd, shTitle)
             || _FSIsMainSurface(hwnd, shTitle)
             || IsFSNeverConcealTitle(shTitle)) {
                DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
                _MapDrop(_fsShielded, hwnd)
                _MapDrop(_fsHiddenByUs, hwnd)
                try _FSReleaseSurface(hwnd)
                _FSLog("FS-SHIELD released immediately hwnd=" . hwnd
                     . " title=`"" . shTitle . "`" -- this window must never be"
                     . " concealed; the birth hide caught it and has been undone")
                continue
            }

            ; Is it actually off the virtual desktop yet?
            parked := false
            rc := Buffer(16, 0)
            if DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc) {
                cx := NumGet(rc, 0, "Int"), cy := NumGet(rc, 4, "Int")
                cw := NumGet(rc, 8, "Int") - cx, ch := NumGet(rc, 12, "Int") - cy
                parked := !(cx + cw > vx && cx < vx + vw
                         && cy + ch > vy && cy < vy + vh)
            }

            ; ══════════════════════════════════════════════════════════════
            ;  HOLD THE HIDE. DO NOT TRADE IT FOR A PARK.
            ; ══════════════════════════════════════════════════════════════
            ; The shield used to hand visibility back as soon as the park had
            ; landed, on the reasoning that a parked window is invisible for
            ; free and a shown window is what the rest of the script expects.
            ; Both of those are true and neither is the point: a window that is
            ; SHOWN, even off the virtual desktop, can still be composited, and
            ; the moment anything moves it -- a reveal, a monitor-lock
            ; correction, Overwolf re-centring its own window -- it has a frame
            ; to paint. Holding the hide removes that last chance entirely.
            ;
            ; The park stays underneath it, so the eventual release is still
            ; invisible: the window is shown off-screen first and moved back
            ; second, exactly as the reveal has always done it.
            ;
            ; SAFE HERE AND NOT ON MAIN, and the difference is renderer
            ; temperature rather than opinion. This branch is only ever reached
            ; by a window born after the launch finished -- Battlegrounds, from
            ; an Overwolf that has been running for minutes with Main already
            ; painted. Main is born cold, is excluded above, and is now never
            ; concealed at all (CFG.fsMainNeverConceal).
            ;
            ; The release paths are unchanged and all of them read
            ; _fsHiddenByUs: the F3 reveal, FSRepairStrandedWindows, the F4
            ; shutdown and ExitCleanup. The entry stays in that ledger for as
            ; long as the hide is held, which is what makes the hold safe.
            if (parked && CFG.fsBgHardHideHold) {
                if !_fsShieldHeldLogged.Has(hwnd) {
                    _fsShieldHeldLogged[hwnd] := true
                    _FSLog("FS-SHIELD holding the hide on hwnd=" . hwnd
                         . " title=`"" . shTitle . "`" after " . age . "ms --"
                         . " parked AND hidden, so it cannot paint at all."
                         . " Released by the reveal, F4 or exit"
                         . " (fsBgHardHideHold).")
                }
                continue
            }

            if (!parked && age < CFG.fsFlickerShieldMaxMs)
                continue                 ; the move has not landed; hold on

            ; Off-screen (or out of patience). Give the window back its
            ; visibility -- it is parked, so nothing appears, and CEF gets a
            ; shown window again rather than a permanently hidden one.
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)      ; SW_SHOWNA
            _MapDrop(_fsShielded, hwnd)
            _MapDrop(_fsHiddenByUs, hwnd)    ; no longer owed: it is shown
            _FSLog("FS-SHIELD released after " . age . "ms hwnd=" . hwnd
                 . (parked ? " -- parked off-screen, so it is invisible without"
                           . " the hide and takes the normal path from here"
                           : " -- WITHOUT confirming the park; a window left"
                           . " hidden is worse than a window that flickered"))
        }
    }
    DetectHiddenWindows prevDHW
}

; hwnd -> tick. Retained: the old once-per-window gate name is still pruned.
global _fsHardHidden := Map()

; ══════════════════════════════════════════════════════════════════════════════
;  WHY SW_HIDE WORKS FOR BATTLE.NET AND FAILS FOR EVERYTHING ELSE
; ══════════════════════════════════════════════════════════════════════════════
;
; This is the question the whole concealment design turns on, and the file has
; never answered it in one place. It is answered here because every policy
; below follows from it.
;
; BATTLE.NET'S SERVICE SURFACES ARE WIN32/WPF WINDOWS. To such a window
; SW_HIDE is an ordinary, fully-supported state: the application keeps its
; window object, Windows keeps the HWND, and a later SW_SHOW puts it back
; exactly as it was. Nothing has to be rebuilt because nothing was torn down.
; They also never need to paint again -- HSBG hides them once and they stay
; hidden for the session. There is no failure mode available.
;
; FIRESTONE'S AND THE TRACKER'S WINDOWS ARE CHROMIUM (CEF). Chromium ties its
; renderer's frame sink to the window actually being COMPOSITED BY DWM. It
; also runs occlusion tracking, and a window it decides is permanently
; invisible is a window whose compositing resources it is entitled to discard.
; Three states produce no compositing at all:
;
;     SW_HIDE            WS_VISIBLE cleared. The strongest possible signal.
;     parked off-desktop bounds intersect no display, so DWM composites
;                        nothing. This is the one the file thought was safe.
;     DWM cloak          rendered nowhere.
;
; The old comment on fsMainColdPolicy asserted that parking was safe because
; "WS_VISIBLE is never cleared, so the renderer keeps a live widget and paints
; normally". That is the claim this machine's log disproves, and the disproof
; is worth keeping because the claim is seductive:
;
;   13:09:18  FS-COLD born "Firestone" policy=park
;   13:09:20  FS-PAINT PROVEN AT REVEAL distinct=482      <- painted once shown
;   13:09:21  FS-REVEAL "Firestone - Main" painted=yes    <- working
;   13:09:27  FS-DESTROYED parked=yes hiddenByUs=yes cloaked=yes
;             -- this script did NOT ask it to close
;
; Main painted only while it was VISIBLE, and it was destroyed six seconds
; after being re-concealed with all three no-compositing states stacked on it.
; Not a WM_CLOSE from here: the destroy watcher says so explicitly.
;
; SO WHAT IS LEFT? Minimise. It is the one concealed state a desktop
; application is BUILT to survive, because its own users do it constantly:
; Chromium has a well-trodden path for iconic windows, restores from them, and
; does not treat them as destruction. It composites nothing either -- but it
; is the state the renderer expects, rather than one it has to infer meaning
; from.
;
; This is not a new discovery. v6.0.0 shipped exactly this fix and its release
; notes say so: "concealed by minimizing it rather than moving it off the
; desktop ... That is the failure behind every 'Firestone Main did not
; survive'." A later change reverted it to park and the symptom returned
; unchanged. It is written down here, with the evidence, so the next person to
; think parking looks tidier has to argue with the log rather than with a
; preference.
;
; ONE POLICY, BOTH TEMPERATURES. Main used to take the cold path at birth and
; the warm path after its first reveal, and those two paths disagreed: the
; cold one was changed to minimise and the warm one kept parking, so every F3
; re-lock re-applied the concealment that kills it. A window does not become a
; different kind of window once it has painted. There is now one answer.
; ══════════════════════════════════════════════════════════════════════════════
;  CONCEALING A WINDOW THAT MUST KEEP PAINTING
; ══════════════════════════════════════════════════════════════════════════════
;  ALPHA CONCEALMENT — Firestone only now, and no longer the primary mechanism
;
;  SUPERSEDED IN PART. READ _RgnConceal FIRST.
;
;  Everything below about compositing is still true and still the reason this
;  exists. What changed is the conclusion. Alpha 0 keeps a window composited,
;  which is what a Chromium renderer needs -- but it lives in the extended
;  style, and an application can rewrite its own extended style. The tracker
;  was caught doing exactly that, stripping WS_EX_LAYERED back off fifty times
;  in four seconds (logged as HDT-ALPHA), which is a race nothing on this side
;  can win.
;
;  An empty WINDOW REGION achieves the same concealment without being a style
;  bit, and was measured to survive SW_HIDE+SW_SHOW, a move, a resize and an
;  ex-style rewrite -- on a real tracker window AND on a live Firestone Main.
;  So the tracker no longer uses alpha at all (hdtAlphaConceal is false) and
;  Firestone applies the region first, keeping alpha alongside it only because
;  it is free and WS_EX_TRANSPARENT is still what stops an invisible window
;  swallowing clicks.
; ══════════════════════════════════════════════════════════════════════════════
;
; Two properties matter, and the second is the one that fixes rapid F3.
;
; IT KEEPS THE WINDOW COMPOSITED. A layered window at alpha 0 is still drawn
; by DWM every frame -- just transparently -- so a Chromium renderer never
; sees its window go away and never reclaims the surface. Every other
; concealment (SW_HIDE, park off-desktop, DWM cloak, minimise) produces no
; composited frame and eventually kills a cold CEF window.
;
; IT IS IDEMPOTENT AND HAS NO GEOMETRY. This is what makes it survive being
; hammered. The park-based path had to remember where a window was, move it
; off the desktop, move it back, and keep a ledger of which windows were
; where -- a state machine with two moving parts per window, driven by a key
; the user can press twenty times in ten seconds. The log shows exactly what
; that costs:
;
;   HDT-SHOW backstop released hwnd=657010 parked=yes cloaked=no
;            -- it was concealed but absent from the ledger
;   HDT-SHUTDOWN the tracker did not close when asked -- forcing it
;
; Setting alpha to 0 twice is the same as setting it once. There is no
; remembered rectangle to lose, no unpark that can be skipped, and no order
; the two halves can get into that leaves the window stranded. Spamming the
; key just writes the same byte repeatedly.
;
; STATELESS ON PURPOSE. The caller supplies its own ledger, so Firestone and
; the tracker keep entirely separate bookkeeping -- the shared thing here is
; mechanism, not policy. That is the same split as _FSTaskbarTab.
; Is a window we alpha-concealed STILL transparent?
;
; The one question the hide watchdog has to ask now that concealed windows are
; deliberately left visible. A window whose opacity has been restored by
; something else really has been re-shown and should be treated as such; one
; still sitting at alpha 0 is exactly as we left it and must not be counted as
; a fight. Reading the attribute is the only honest test -- the ledger says
; what we intended, not what is true now.
_AlphaStillConcealed(hwnd) {
    a := 0
    try {
        if !DllCall("user32\GetLayeredWindowAttributes", "Ptr", hwnd
                  , "Ptr", 0, "UChar*", &a, "Ptr", 0)
            return false          ; no longer layered at all
        return (a = 0)
    }
    return false
}

; WHY a window stopped being concealed, in words, for the log. There are three
; distinct ways to lose the race and they call for different answers -- a
; cleared style bit means the owner rewrote its ex-style, a per-pixel switch
; means it started compositing itself, and a non-zero alpha means it kept the
; layering and simply set its own opacity. The counter alone cannot tell them
; apart, so the standdown that used to fire here was guessing.
_AlphaLossReason(hwnd) {
    static GWL_EXSTYLE := -20, WS_EX_LAYERED := 0x00080000
    try {
        fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        if !(ex & WS_EX_LAYERED)
            return "the tracker cleared WS_EX_LAYERED"
        a := 0
        if !DllCall("user32\GetLayeredWindowAttributes", "Ptr", hwnd
                  , "Ptr", 0, "UChar*", &a, "Ptr", 0)
            return "the tracker switched it to per-pixel alpha"
        if (a != 0)
            return "the tracker reset alpha to " . a
        return "it is still concealed"
    }
    return "its state could not be read"
}

_AlphaConceal(hwnd, ledger) {
    static GWL_EXSTYLE       := -20
    static WS_EX_LAYERED     := 0x00080000
    static WS_EX_TRANSPARENT := 0x00000020
    static LWA_ALPHA         := 0x2
    fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
    try {
        if !DllCall("user32\IsWindow", "Ptr", hwnd)
            return false

        ; ── PURE WIN32 ONLY. NO AHK WINDOW RESOLUTION IN HERE. ──────────────
        ; This used WinGetMinMax, which resolves "ahk_id N" through AutoHotkey
        ; -- and that THROWS on a window without WS_VISIBLE unless the calling
        ; thread has DetectHiddenWindows on. HDTHideWatch does not set it, and
        ; the birth path SW_HIDEs the window before this ever runs, so the
        ; very first conceal attempt threw, the whole try block aborted, and
        ; the caller fell through to the park path instead.
        ;
        ; The result was the two concealment strategies running against the
        ; same window: park hiding it, alpha showing it, the hook firing on
        ; every transition, and the re-hide counter climbing to its cap of 50
        ; in a few seconds. That is the "it fights itself".
        ;
        ; IsIconic is the same question asked of the OS directly. It cannot
        ; throw and does not care whether the window is visible.
        ; ── REFUSE PER-PIXEL LAYERED WINDOWS ────────────────────────────────
        ; A window can already be layered before this script touches it, and
        ; there are two kinds. One was given a uniform alpha with
        ; SetLayeredWindowAttributes and can be given another. The other draws
        ; itself with UpdateLayeredWindow, supplying its own per-pixel alpha
        ; for every frame -- which is what a WPF window with AllowsTransparency
        ; does, and the tracker has those.
        ;
        ; Calling SetLayeredWindowAttributes on the second kind does not make
        ; it transparent. It switches the window to uniform-alpha mode while
        ; its renderer carries on supplying per-pixel content, and the result
        ; on screen is an undefined rectangle -- in practice a white block
        ; sitting in the corner.
        ;
        ; _FSLayeredAlphaState returns 0 for exactly that case. Those windows
        ; are refused here and fall back to the caller's other path, which is
        ; correct for them anyway: they are WPF, not Chromium, so SW_HIDE is a
        ; state they survive without complaint.
        probeAlpha := 255
        if (_FSLayeredAlphaState(hwnd, &probeAlpha) = 0)
            return false

        if DllCall("user32\IsIconic", "Ptr", hwnd)
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 9)      ; SW_RESTORE
        try UncloakWindow(hwnd, true, "_AlphaConceal")
        if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)      ; SW_SHOWNA

        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE
              , "Ptr", ex | WS_EX_LAYERED | WS_EX_TRANSPARENT)
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
              , "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA)
        ledger[hwnd] := true
        return true
    }
    return false
}

_AlphaReveal(hwnd, ledger) {
    static GWL_EXSTYLE       := -20
    static WS_EX_TRANSPARENT := 0x00000020
    static LWA_ALPHA         := 0x2
    fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
    try {
        if !DllCall("user32\IsWindow", "Ptr", hwnd) {
            _MapDrop(ledger, hwnd)
            return false
        }
        ; Opaque first, click-through cleared second. The other order leaves a
        ; fully transparent window briefly able to swallow clicks.
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
              , "UInt", 0, "UChar", 255, "UInt", LWA_ALPHA)
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE
              , "Ptr", ex & ~WS_EX_TRANSPARENT)
        _MapDrop(ledger, hwnd)
        return true
    }
    return false
}

; ══════════════════════════════════════════════════════════════════════════════
;
; THE RULE THIS FILE TOOK FOUR ATTEMPTS TO FIND, WRITTEN ONCE, PROPERLY:
;
;   A Chromium window survives concealment only if DWM STILL COMPOSITES IT.
;
; Chromium ties its renderer's frame sink to the window actually being drawn
; by the compositor, and it runs occlusion tracking that reclaims resources
; from a window it decides is permanently invisible. Every concealment that
; produces no composited frame therefore kills a cold window -- not instantly,
; but reliably, and always in the seconds after the user finally asks for it:
;
;   SW_HIDE              WS_VISIBLE cleared. The strongest possible signal.
;   park off-desktop     bounds intersect no display -> nothing to composite.
;   DWM cloak            drawn nowhere, by definition.
;   MINIMISE             also nothing to composite. This one looked safe and
;                        is not; the log below is the proof.
;
; Each of those was tried in turn and each failed the same way. The minimise
; attempt is worth recording because it was the most plausible of them -- a
; state every application handles because its own users trigger it constantly:
;
;   FS-PAINT no reading after 20047ms  title="Firestone - Main"
;   FS-REVEAL painted=NOT PROVEN visible=1
;   FS-DESTROYED parked=no hiddenByUs=yes -- this script did NOT ask it to close
;
; Twenty seconds concealed, not one frame, destroyed one second after being
; shown. Nothing here closed it; the renderer had already given up.
;
; WHAT IS LEFT, AND WHY IT WORKS. A LAYERED WINDOW AT ALPHA 0 keeps
; compositing. The window stays WS_VISIBLE, stays on screen geometrically, and
; DWM keeps drawing it every frame -- it simply draws it fully transparent.
; The renderer sees a normal, visible, painting window and has no reason to
; reclaim anything. The user sees nothing.
;
; This used to say alpha was THE ONLY such state. It is not: AN EMPTY WINDOW
; REGION has the same property and is not a style bit, so an application
; cannot strip it off the way the tracker strips WS_EX_LAYERED. See
; _RgnConceal, which is now the primary concealment for both overlays.
;
; The two things transparency alone does not solve are handled alongside it:
;
;   clicks     an invisible window still hit-tests, so it would swallow
;              clicks aimed at the game underneath. WS_EX_TRANSPARENT makes
;              it click-through.
;   taskbar    still listed, so ITaskbarList::DeleteTab removes the button.
;
; Revealing is the exact inverse and is instant: alpha back to opaque, the
; click-through bit cleared, the taskbar button restored. No geometry moves,
; nothing is shown or hidden, so there is no transition for the compositor to
; get wrong -- which is also why this does not flicker.
; CONCEALMENT OF FIRESTONE MAIN IS OVER. This is deliberately a no-op.
;
; MEASURED, not assumed. A silent Firestone launch with NOTHING hidden,
; cloaked, parked or closed by this script was observed end to end:
;
;   total Overwolf-family windows created: 48
;   windows that ever reached the screen:   2
;
;     +2.7s   152x294  untitled  HwndWrapper[Overwolf.exe;UI;<guid>]  <- splash
;     +7.7s  1440x790  "Firestone" -> retitles to "Firestone - Main"
;
; Overwolf already hides 46 of its own 48 windows. Only the splash appears
; uninvited, and that is caught at birth by its ex-style signature elsewhere
; in this file. Main is the one window a user actually asked for.
;
; WHY CONCEALING IT WAS ACTIVELY HARMFUL. Of 89 recorded Main deaths, 85 were
; hiddenByUs=yes, and the oscillation alarm fired 48 times naming the window
; and the operation storm that preceded each death -- a 50 ms watchdog issuing
; DWM operations against one Chromium window ~16 times a second for its whole
; life. A Main left untouched while Hearthstone starts survives; that was
; tested with this script not running at all.
;
; The earlier "it dies at 7.8s whatever we do" measurement did NOT apply: that
; harness opened Main INTO an already-running game, which is a different
; scenario from a Main that is already open when the game starts.
;
; Silence is now achieved by not opening Main, rather than by hiding it after
; it opens. F3 opens it on demand through the hotkey mirror.
; CONCEALED ONLY WHEN SOMETHING ASKS, NEVER BY A CLOCK.
;
; This body was briefly a no-op while the 50 ms watchdog was removed, which
; left F3 with a working reveal and a lock that did nothing -- the log said so
; in as many words: "FS-VISIBLE ... locked=1 -- this window should have been
; concealed and was not". So the concealment is back; what is NOT back is
; anything that re-applies it on a timer.
;
; The only routes here are SuppressFirestoneMainTick's two suppress paths, and
; that sweep is now reached from exactly two places: Hotkey_F3 and
; _BNetDwellMinimize. Both are events. One keypress, one operation.
;
; What was removed was FSMainMonitor at 50 ms, which drifted to ~62 ms and
; drove a forced uncloak against this window sixteen times a second for its
; whole life -- the interval in every recorded Main death, and the thing the
; oscillation alarm named 48 times without anyone reading it.
; Does Main actually need concealing right now? STATE, not a ledger.
;
; The ledger records what we ASKED for. Overwolf rewrites its own window's
; extended style, and the ask silently stops being true. Measured 2026-09-06:
; Main was set to alpha 0 at 19:14:52 and read "not layered at all" 200ms
; later, then sat fully visible for TWENTY-SIX SECONDS -- because the guard
; asked the ledger, the ledger said "already concealed", and nothing ever
; re-applied it. The user's screenshot is that window, wide open.
;
; This is not an oscillation risk. It returns false the instant the window IS
; at alpha 0, so a conceal that holds is never repeated. A conceal that keeps
; being undone is the application fighting us, and _FSTraceNote's rate check
; exists to report exactly that.

_FSMainNeedsConceal(hwnd) {
    global _fsAlphaConcealed
    if !_fsAlphaConcealed.Has(hwnd)
        return true
    a := 255
    return !(_FSLayeredAlphaState(hwnd, &a) = 1 && a = 0)
}

_FSConcealMain(hwnd) {
    global CFG, _fsHiddenByUs, _fsParked, _fsAlphaConcealed
    static GWL_EXSTYLE     := -20
    static WS_EX_LAYERED   := 0x00080000
    static WS_EX_TRANSPARENT := 0x00000020
    static LWA_ALPHA       := 0x2
    fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"

    try {
        ; Undo whatever an earlier policy did to it. A window left parked or
        ; minimised cannot composite no matter how transparent it is, so these
        ; are not optional tidying -- they are part of the fix.
        if _fsParked.Has(hwnd)
            _FSUnparkWindow(hwnd)

        ; The documented fallback, kept so the failure is reproducible rather
        ; than merely described. A minimised window composites nothing, so
        ; this is expected to lose Main eventually -- it exists to be switched
        ; on if the alpha path ever misbehaves on a different build.
        if (CFG.fsMainConceal = "minimize") {
            _FSTabOff(hwnd)
            if (!DllCall("user32\IsIconic", "Ptr", hwnd))
                _MinimizeWindowNoAnim(hwnd, "Main conceal policy")
            _fsHiddenByUs[hwnd] := true
            return true
        }

        ; ── ALPHA 0, AND NOTHING ELSE ───────────────────────────────────────
        ; THE RULE FOR MAIN: alpha 0 and nothing else. Not hidden, not parked,
        ; not left cloaked. Alpha 0 is a concealed state that DWM still
        ; composites, so the window keeps painting and KEEPS ITS TASKBAR BUTTON.
        ; Every other concealment takes one or both of those away, and the
        ; taskbar button is how the user knows Firestone is alive.
        ;
        ; THE ONE EXCEPTION is a temporary cloak, below, and only when the
        ; window is ALREADY ON SCREEN when we reach it. That is the only case
        ; with a frame to lose: the window is visible and opaque, and writing
        ; alpha takes effect on the next frame, so the compositor can present
        ; one opaque frame first. A cloak freezes it for the length of two
        ; DllCalls and is released immediately.
        ;
        ; A window that is NOT yet on screen needs no cloak at all -- nothing
        ; can paint what was never shown. It gets alpha first and is shown
        ; afterwards, already transparent, which is also what gives it its
        ; taskbar button.
        ; ── NEVER PUT WHOLE-WINDOW ALPHA ON A PER-PIXEL SURFACE ─────────────
        ; SetLayeredWindowAttributes replaces a window's per-pixel alpha
        ; channel with a single value for the whole window. On an Overwolf
        ; overlay -- which is transparent per pixel -- that discards the
        ; transparency and every transparent pixel paints as backing colour:
        ; a solid rectangle the size of the window.
        ;
        ; 2026-09-06: _FSPolicyFor classified "Firestone - Overlays"
        ; (2560x1440) as Main, this concealed it, and F3 restored it to alpha
        ; 255 -- producing the full-screen BLACK SHEET. The policy is fixed,
        ; but this is the backstop, because getting it wrong is very visible
        ; and the test costs one GetWindowLong plus one GetLayeredWindowAttributes.
        aChk := 255
        static ppRefused := Map()   ; log once per window: _FSLog is a FileAppend
        if (_FSLayeredAlphaState(hwnd, &aChk) = 0) {
            if !ppRefused.Has(hwnd) {
                ppRefused[hwnd] := true
            _FSLog("FS-CONCEAL REFUSED hwnd=" . hwnd . " -- this window uses"
                 . " PER-PIXEL alpha. Whole-window alpha would discard that"
                 . " channel and paint it as a solid rectangle. This is an"
                     . " Overwolf overlay, not Firestone Main. Left alone.")
            }
            return false
        }
        ; ── ALPHA 0 AND NOTHING ELSE. NO CLOAK, NO SW_HIDE, EVER ────────────
        ; Main is concealed by one mechanism: WS_EX_LAYERED at alpha 0. It stays
        ; WS_VISIBLE, DWM keeps compositing it, it keeps painting, and it keeps
        ; its taskbar button. Every other concealment takes one of those away.
        ;
        ; A first-paint cloak used to sit here. It is gone by instruction: it
        ; only ever half-worked, and the real answer to the first frame is to
        ; stop the window being opened visible in the first place -- Firestone's
        ; own start-up setting -- not to race it after the fact.
        ;
        ; The chokepoints enforce the rest: CloakWindow, _FSHideWindow,
        ; _FSParkWindow, _MinimizeWindowNoAnim and _CloseWindowAsync all refuse
        ; a window held here. This function must not be the one that breaks it.
        ; ── NO SW_HIDE. ALPHA 0 AND NOTHING ELSE. ───────────────────────────
        ; A brief SW_HIDE sat here, taken when the window was already visible
        ; and released the moment alpha landed. It is gone because the
        ; measurement showed it never did anything: FS-EXPOSURE reports Main
        ; concealed 0ms after creation with wasVisible=0, so on the normal path
        ; wasOnScreen is false and the hide never fired at all. Keeping code
        ; that looks like it is solving the problem while provably never
        ; running is worse than not having it.
        ;
        ; The real first frame is not here. Layered attributes are initialised
        ; when a window is SHOWN, so alpha set on a never-shown window is not
        ; reliably in force for that first paint -- which is why the re-assert
        ; lives in OWCreateHookProc on EV_SHOW, at the instant the window
        ; becomes visible, and not in this function.
        ;
        ; wasOnScreen is kept: FS-EXPOSURE below reports it, and it is the one
        ; measurement that says whether a frame reached the user.
        wasOnScreen := DllCall("user32\IsWindowVisible", "Ptr", hwnd) ? true : false
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE
              , "Ptr", ex | WS_EX_LAYERED | WS_EX_TRANSPARENT)
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
              , "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA)     ; alpha 0
        ; ── shield over: from here the window is visible and transparent ─────

        if (DllCall("user32\IsIconic", "Ptr", hwnd))
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 9)      ; SW_RESTORE

        ; Defensive, for the window that was never shown in the first place:
        ; undo a cloak any other path applied, and make sure it ends visible so
        ; the shell grants it a taskbar button.

        ; ── MEASURE THE EXPOSURE, ONCE PER WINDOW ───────────────────────────
        ; The one number that matters and has never been recorded: how long
        ; after this window was created did the conceal land, and had the window
        ; been shown by then. wasOnScreen=1 means a frame reached the screen --
        ; that IS the flicker, and the age says how much room there was to beat
        ; it. The external watchdog cannot answer this: it polls at 120ms and a
        ; frame is 16ms, so it can only say "concealed within 120ms".
        if !_fsExposureLogged.Has(hwnd) {
            _fsExposureLogged[hwnd] := true
            bornAt := _fsSeenAt.Has(hwnd) ? _fsSeenAt[hwnd] : 0
            age := bornAt ? (A_TickCount - bornAt) : -1
            _FSLog("FS-EXPOSURE hwnd=" . hwnd . " concealed "
                 . (age < 0 ? "at an unknown age (creation not recorded)"
                            : age . "ms after it was created")
                 . ", wasVisible=" . (wasOnScreen ? 1 : 0)
                 . (wasOnScreen
                    ? " <- IT WAS ALREADY ON SCREEN. A frame reached the user"
                    . " before this landed; that is the flicker, and it means we"
                    . " arrived late rather than that the conceal failed."
                    : " <- caught before it was ever shown, so nothing was"
                    . " visible at any point.")
                 . " One frame is about 16ms, so any age above that is room the"
                 . " window had to paint in.")
        }
        try UncloakWindow(hwnd, true, "_FSConcealMain release")
        if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)      ; SW_SHOWNA

        ; ── RECORD IT BEFORE THE LAST RISKY CALL, NOT AFTER ─────────────────
        ; These two writes used to sit BELOW _FSTabOff, and that ordering breaks
        ; F3. _fsAlphaConcealed is the ledger F3 reveals FROM -- see
        ; _FSRevealAllAlpha, which iterates it -- so anything thrown above this
        ; point left the ledger empty and F3 had nothing to reveal, silently.
        ;
        ; The alpha is already applied by the time we get here, so the ledger is
        ; simply telling the truth. Losing a taskbar button is nothing beside
        ; losing the ability to show Main again, so TabOff runs after the record.
        _fsAlphaConcealed[hwnd] := true
        _fsHiddenByUs[hwnd]     := true

        ; ── AND MAIN KEEPS ITS TASKBAR BUTTON. ──────────────────────────────
        ; _FSTabOff used to run here, and this is the path Main now takes, so it
        ; was still stripping the button after I removed it from the blanket and
        ; the park path. That is why the "open" indicator was missing on EVERY
        ; attempt, good runs included -- unlike the rest of the symptoms, this
        ; one was never intermittent, which is what marked it as a plain missed
        ; call site rather than part of the race.
        ;
        ; An alpha-concealed Main is not hidden, not parked and not cloaked: it
        ; is a live, composited window sitting on its monitor drawing nothing.
        ; A live window belongs in the taskbar. That button is the only signal
        ; Firestone is running and the only way back to it by hand if anything
        ; else fails -- which is exactly the state the baseline had and this
        ; script lost.
        return true
    } catch as e {
        ; This try had no catch, so a throw returned false with no trace and the
        ; two writes above never ran -- concealment and F3 both failing silently.
        try _FSLog("FS-CONCEAL-FAILED hwnd=" . hwnd . " -- " . Type(e) . ": "
            . e.Message . " (line " . e.Line . ")  |  Main was NOT recorded in"
            . " _fsAlphaConcealed/_fsHiddenByUs, so F3 has nothing to reveal.")
    }
    return false
}

; The inverse. Called by the reveal, by the F4 shutdown and by ExitCleanup --
; anything this script made transparent must be given back, or the user is
; left with a window that is running, listed nowhere, and invisible.
_FSRevealMain(hwnd) {
    global _fsAlphaConcealed, _fsHiddenByUs
    static GWL_EXSTYLE       := -20
    static WS_EX_TRANSPARENT := 0x00000020
    static LWA_ALPHA         := 0x2
    fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"

    ; The region comes back FIRST, and regardless of whether alpha was ever
    ; applied. The two are independent: a window concealed under a policy that
    ; does not use alpha -- or one whose layered bit the application stripped
    ; back off -- would otherwise keep an empty region for the rest of its
    ; life, which is a window that is running, on screen and painting nothing.
    if !_fsAlphaConcealed.Has(hwnd)
        return false
    try {
        ; Opaque first, click-through cleared second. The other order would
        ; leave a fully transparent window briefly accepting clicks.
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
              , "UInt", 0, "UChar", 255, "UInt", LWA_ALPHA)
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE
              , "Ptr", ex & ~WS_EX_TRANSPARENT)
        _FSTabOn(hwnd)
        _MapDrop(_fsAlphaConcealed, hwnd)
        _MapDrop(_fsHiddenByUs, hwnd)
        return true
    }
    return false
}

; Give every alpha-concealed window back. The janitor the iron rule demands:
; a window left at alpha 0 by a crashed or reloaded instance is running,
; invisible and has no taskbar button, which is unreachable by any means the
; user has.
_FSRevealAllAlpha() {
    global _fsAlphaConcealed
    for h in _fsAlphaConcealed.Clone() {
        try {
            if DllCall("user32\IsWindow", "Ptr", h)
                _FSRevealMain(h)
            else
                _MapDrop(_fsAlphaConcealed, h)
        }
    }
}

; ── WINDOWS THAT CANNOT EVER BE A FIRESTONE SURFACE ─────────────────────────
;
; THIS IS A LOAD FIX, AND THE LOAD WAS COSTING A VISIBLE FLICKER.
;
; Overwolf's processes create a crowd of OS and COM plumbing windows during
; start-up -- input-method windows, Cicero windows, OLE marshalling windows,
; crash-handler watchers. None of them is ever drawn, none can ever be a
; Firestone surface, and every one of them was being run through the whole
; funnel and then written to the log.
;
; Measured on one launch: 89 log lines in the launch window, 31 of them for
; these windows -- 34 per cent of the traffic -- with 26 lines landing in the
; single second before the start-up splash appeared.
;
; That matters because the splash can only be caught in the 16-32ms between
; its creation and its show, and this script is single-threaded: window work
; and a synchronous FileAppend for each of these windows is spent out of the
; same budget. The result is in the log, in the splash's own words:
;
;   18:06:15 FS-SPLASH ... IT HAD ALREADY BEEN SHOWN at 1947,387
;
; while quieter launches either side of it caught the same window before it
; was ever shown. So this is not cosmetic tidying of the log; it is giving the
; catch back the milliseconds it needs.
;
; SAFE BY CONSTRUCTION. These are names Windows and COM give their own
; plumbing, not names an application chooses. A Firestone window cannot be
; called "Default IME", and if Overwolf ever ships one that is, it would still
; have to be drawn to matter -- and a window that is drawn is caught by the
; visibility-driven paths regardless of what this says.
_FSIsInertHelper(hwnd, title := "") {
    static NAMES := Map(
        "Default IME",                    true,
        "MSCTFIME UI",                    true,
        "CiceroUIWndFrame",               true,
        "CicMarshalWnd",                  true,
        "OLEChannelWnd",                  true,
        "OleMainThreadWndName",           true,
        "MediaContextNotificationWindow", true,
        "SystemResourceNotifyWindow",     true)
    static CLASSES := Map(
        "crashpad_SessionEndWatcher", true,
        "Base_PowerMessageWindow",    true)
    try {
        if (title = "") {
            try title := WinGetTitle("ahk_id " . hwnd)
        }
        if (title != "") {
            if NAMES.Has(title)
                return true
            ; Two carry a suffix that changes per process or per runtime
            ; version, so they are matched by their stable prefix.
            if (SubStr(title, 1, 11) = "GDI+ Window")
                return true
            if (SubStr(title, 1, 25) = ".NET-BroadcastEventWindow")
                return true
        }
        ; The class lookup is reached ONLY for untitled windows. Both
        ; class-matched entries are untitled, and asking every titled
        ; window for its class as well would add a round trip per
        ; window per sweep -- spending exactly what this exists to save.
        if (title != "")
            return false
        cls := ""
        try cls := WinGetClass("ahk_id " . hwnd)
        if (cls != "" && CLASSES.Has(cls))
            return true
    }
    return false
}

_FSColdSuppress(hwnd, title) {
    global CFG, _fsHiddenByUs, _fsMainLogged
    global _fsHardHidden, _fsParked

    ; Plumbing windows leave before anything is spent on them -- see
    ; _FSIsInertHelper. They are never drawn, so there is nothing to
    ; conceal, and both the work and the log write come out of the
    ; same budget the start-up splash catch needs.
    if _FSIsInertHelper(hwnd, title)
        return

    if (!_fsMainLogged.Has(hwnd) && title != "") {
        _fsMainLogged[hwnd] := true
        ; Terse on purpose: this fires for every Overwolf window born during a
        ; launch. The name is the configured cold policy, not a record of what
        ; was done -- Main takes fsMainConceal and returns before the cold
        ; policy is consulted at all, so a log full of "policy=park" never
        ; meant a window was parked. The concealment that actually runs logs
        ; itself; this line is only the birth record.
        _FSLog("FS-COLD born `"" . title . "`" (cold-policy="
             . CFG.fsMainColdPolicy . ")")
    }

    ; ── SHIELD FIRST, WHATEVER THE POLICY BELOW TURNS OUT TO BE ─────────────
    ;
    ; THIS IS THE FIRESTONE LOADING FLICKER, and it is the same treatment the
    ; Battle.net service windows already get: refuse to let it paint at all,
    ; rather than conceal it after it already has.
    ;
    ; Every other concealment on this path depends on something going right.
    ; The cloak below is a REQUEST, and this file already documents that DWM
    ; routinely declines it for a process that is still starting -- which is
    ; precisely when the loading window is born. The park only takes effect
    ; after a SetWindowPos, and the window can paint before that lands; the
    ; hard-hide flicker shield exists to paper over that gap, and the log
    ; still carries FS-VISIBLE lines for a window titled "Firestone" at full
    ; size, so it is not covering it.
    ;
    ; An empty region cannot be declined and takes effect on the call. The
    ; window keeps its position, so the park below still works if it runs, and
    ; the reveal undoes both. The loading window is also the one Firestone
    ; surface that must not be hidden or moved carelessly, because it becomes
    ; Main IN PLACE on the same HWND -- and the region is the only option here
    ; that neither hides it nor moves it.

    ; FIRESTONE MAIN NEVER ENTERS THE SHARED COLD CLOAK/PARK PATH.
    ;
    ; Main is the one Chromium surface for which we have measured that
    ; compositor-disrupting states can make the window die. Hand it directly
    ; to the alpha-only owner before the generic cloak/park logic gets a chance
    ; to touch it. Alpha 0 keeps WS_VISIBLE and the real desktop coordinates,
    ; so the renderer remains alive and F3 can always reverse the same state.
    if (CFG.fsMainConceal != "park" && _FSIsMainSurface(hwnd, title)) {
        _FSConcealMain(hwnd)
        return
    }

    ; Cloak in every policy: it is the one operation that removes the window
    ; from Alt-Tab, Win+Tab, Aero Peek and taskbar thumbnails, and it does not
    ; clear WS_VISIBLE. VERIFIED against DWM rather than assumed -- see
    ; _FSEnsureCloaked for why the ledger alone is not enough.
    _FSEnsureCloaked(hwnd)
    _DisableDWMTransitions(hwnd)

    if (CFG.fsMainColdPolicy = "park") {
        ; ── A PARKED WINDOW KEEPS ITS TASKBAR BUTTON ────────────────────────
        ; This used to call _FSTabOff here, on the reasoning that "100%
        ; invisible has to include the taskbar". That reasoning is wrong for a
        ; PARKED window, and it is what made Firestone Main unreachable.
        ;
        ; Parking and hiding are not the same state. A hidden window is gone --
        ; nothing can see it and it has no business in the taskbar. A PARKED
        ; window is still open, still composited, still perfectly alive; it has
        ; merely been moved off the side of the desktop. Stripping its button as
        ; well leaves it alive, invisible AND unreachable: no way to see that it
        ; exists, and no way to click it back if anything else goes wrong.
        ;
        ; Measured over several runs: Main sat parked and alive while F3 failed,
        ; and with no taskbar button there was no way to tell it was there or to
        ; recover it by hand. In the builds where the button survived it was
        ; obvious at a glance that Main was up.
        ;
        ; So the button stays for parked windows. It is the last way in, and the
        ; window is off-screen anyway -- the button costs nothing and is the only
        ; honest signal that Firestone is running.
        ;
        ; The genuinely hidden paths still remove it, which is correct: a window
        ; nothing can show has no button to offer.
        ; Only positively-identified Firestone app windows are ever MOVED --
        ; see _FSMayPark. Everything else (untitled frames in particular) is
        ; left exactly where it is and carried by the cloak alone, which is
        ; invisible and touches no geometry. This is what keeps the in-game
        ; overlay safe: it is never relocated, only ever cloaked.
        if _FSMayPark(hwnd, title) {
            ; ── THE FLICKER SHIELD, AND WHO IS ELIGIBLE FOR IT ──────────────
            ; A hard SW_HIDE is the only concealment that cannot be declined:
            ; it clears WS_VISIBLE synchronously, so nothing can be composited
            ; between it and the park. A DWM cloak is a REQUEST, and on a
            ; window whose process is still starting the compositor routinely
            ; declines it -- which is the one frame the Battlegrounds window
            ; paints at its real position.
            ;
            ; FIRESTONE MAIN IS NOT ELIGIBLE AND MUST NEVER BE. A sustained
            ; hidden state is what stops CEF ever standing up a compositor for
            ; a window, and Main is the window this script has repeatedly
            ; killed that way -- "Firestone Main did not survive" is what that
            ; looks like from the outside. Main is born during the launch,
            ; under the early-cloak blanket and the 10 ms burst, and it does
            ; not flicker. It keeps the gentle path it has always had.
            ;
            ; _FSFlickerShieldEligible decides, and it separates the two by
            ; WHEN the window is born rather than by a title that has not
            ; settled yet. See it for why that is the only test available at
            ; birth.
            if _FSFlickerShieldEligible(hwnd, title)
                _FSFlickerShieldOn(hwnd, title)
            ; No _FSTabOff here either -- same reasoning as above. The window is
            ; about to be PARKED, which leaves it open and alive, so it keeps
            ; its taskbar button. That button is the only way to see Firestone
            ; is running and the only way back to it by hand.
            _FSParkWindow(hwnd)
        } else {
            _FSNoteBirthCloak(hwnd)      ; cloak-only: it is invisible but it
                                         ; still hit-tests. See the reaper.
        }
        return
    }
    if (CFG.fsMainColdPolicy = "cloak") {
        _FSNoteBirthCloak(hwnd)
        return
    }

    ; "hide" -- the OLD behaviour, kept only so the whole fix can be A/B'd with
    ; one config word. This is the setting that produces the blank window.
    if DllCall("user32\IsWindowVisible", "Ptr", hwnd) {
        _fsHiddenByUs[hwnd] := true
        _FSHideWindow(hwnd, "_FSColdSuppress")   ; SW_HIDE
    }
}

; WARM path. Byte-for-byte the exit Firestone - Battlegrounds has always taken
; and which has always worked: cloak, then ONE ledgered SW_HIDE, and never
; touch it again while it stays hidden.
_FSWarmSuppress(hwnd, title) {
    global _fsHiddenByUs, _fsRevealActive, State, CFG, _fsMinLastAttempt

    ; Yield to an active reveal (an unlock in flight): never hide while the
    ; reveal is showing it -- that is the taskbar-strobe war.
    if (_fsRevealActive || !State.fsMainLocked)
        return

    ; ── MAIN LEAVES HERE BEFORE ANYTHING TOUCHES IT ─────────────────────────
    ; THIS IS THE LINE THAT WAS MISSING, AND IT IS WHY MAIN DIED AFTER EVERY
    ; F3 CYCLE RATHER THAN AT BIRTH.
    ;
    ; The cold path was given a minimise policy for Main; this one was not, so
    ; the two disagreed about the same window. Birth concealed Main safely,
    ; the first reveal showed it, and then the very next re-lock came through
    ; here and applied the cloak-and-park that the cold path had just been
    ; changed to avoid. The log shows the window destroyed six seconds after a
    ; successful reveal with parked=yes hiddenByUs=yes cloaked=yes -- all three
    ; no-compositing states, re-applied to a window that had finally painted.
    ;
    ; A window does not become a different kind of window once it is warm.
    ; One policy, one function, both temperatures. See _FSConcealMain.
    if (CFG.fsMainConceal != "park" && _FSIsMainSurface(hwnd, title)) {
        _FSConcealMain(hwnd)
        return
    }

    _FSEnsureCloaked(hwnd)            ; verified against DWM, not assumed
    _DisableDWMTransitions(hwnd)

    ; ══════════════════════════════════════════════════════════════════════
    ; CONCEALMENT WITHOUT A VISIBILITY TRANSITION
    ; ══════════════════════════════════════════════════════════════════════
    ; To Chromium a visibility transition is not a cheap flag: WM_SHOWWINDOW
    ; drives the widget's visibility, which tears down and rebuilds the
    ; compositor's frame sink. A hide/show pair per F3 press accumulates, and a
    ; renderer subjected to enough of them stops coming back.
    ;
    ; The cold path already solved this by keeping the window WS_VISIBLE and
    ; moving it out of sight instead, and there is no reason the warm path should
    ; not do the same. A SetWindowPos is a geometry change, which a browser window
    ; handles thousands of times without complaint. So the lock becomes:
    ;
    ;     lock   -> move off the virtual desktop + cloak
    ;     unlock -> move back + uncloak
    ;
    ; No ShowWindow in either direction. The renderer is never told the window
    ; went away, so there is nothing to rebuild. Concealment is unchanged: off
    ; every monitor, out of Alt-Tab and Peek, and no taskbar button.
    ;
    ; CFG.fsWarmPolicy := "hide" selects the SW_HIDE exit instead.
    ; ── SHIELD BEFORE PARK ──────────────────────────────────────────────────
    ; THIS IS WHY BATTLEGROUNDS STILL FLICKERED. The shield was added to the
    ; bottom of this function, and the park branch below returns before ever
    ; reaching it -- so Battlegrounds carried on taking cloak, park, and the
    ; SW_HIDE exit exactly as before, and the log said so on every match:
    ;
    ;   FS-PAINT PROVEN ... policy=park -- switching to the Battlegrounds exit
    ;
    ; The shield is the better mechanism for this window on every axis that
    ; matters. It does not move it, so there is no remembered rectangle to
    ; lose and no window sliding across the screen when it comes back. It does
    ; not hide it, so the renderer keeps compositing and the window does not go
    ; cold. And it cannot be undone by the application rewriting its own style.
    if (CFG.fsWarmPolicy = "park" && _FSMayPark(hwnd, title)) {
        ; Drop the F3 topmost pin before parking. The reveal pins the window
        ; HWND_TOPMOST so it sits above a borderless fullscreen Hearthstone; that pin
        ; must be released symmetrically or the window stays always-on-top for the rest
        ; of the session, above every other application, the next time anything shows it.
        ;
        ; ── ONLY ON AN ACTUAL TRANSITION ────────────────────────────────────
        ; This ran unconditionally, on every sweep tick, for every Firestone
        ; window -- and SWP_NOZORDER is deliberately absent from the flags, so
        ; each call is a real z-order change. A cross-process SetWindowPos is
        ; synchronous: it sends WM_WINDOWPOSCHANGING / WM_NCCALCSIZE /
        ; WM_WINDOWPOSCHANGED to Overwolf's UI thread and blocks until they are
        ; handled, and every z-order change also makes DWM re-evaluate ordering
        ; -- the same DWM presenting Hearthstone. At the 50 ms coast with Main
        ; and Battlegrounds both up that is forty blocking z-order operations a
        ; second, indefinitely, to remove a topmost bit that was already
        ; removed thirty-nine times.
        ;
        ; Reading the bit first is one cheap non-blocking GetWindowLong, and it
        ; is the same pattern OverlayTopmostTick already uses before its own
        ; SetWindowPos. The clear still happens exactly when it is needed: the
        ; first tick after a reveal set the pin.
        try {
            fnGetLongW := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW"
                                          : "user32\GetWindowLongW"
            exNow := DllCall(fnGetLongW, "Ptr", hwnd, "Int", -20, "Ptr")
            if (exNow & 0x00000008)          ; WS_EX_TOPMOST is actually set
                DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -2   ; HWND_NOTOPMOST
                    , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                    , "UInt", 0x0001 | 0x0002 | 0x0010)
        }
        _FSTabOff(hwnd)
        _FSParkWindow(hwnd)
        return
    }

    if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
        return                        ; already off screen: NOTHING to do.
                                      ; Re-issuing a hide here is the storm.

    ; Legacy path, preserved: with CFG.fsMainUseHide := false, FS-Main takes
    ; the classic cloak+minimize exit rather than SW_HIDE. Battlegrounds always
    ; hides. Throttled exactly as before so a minimize can never be hammered.
    if (!CFG.fsMainUseHide && IsFirestoneMainTitle(title)) {
        if (WinGetMinMax("ahk_id " . hwnd) = -1)
            return
        now := A_TickCount
        if (now - _fsMinLastAttempt.Get(hwnd, 0) < 250)
            return
        _fsMinLastAttempt[hwnd] := now
        _MinimizeWindowNoAnim(hwnd, "warm suppress")
        return
    }

    _fsHiddenByUs[hwnd] := true
    ; Drop any F3 topmost pin before hiding.
    try DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -2   ; HWND_NOTOPMOST
        , "Int", 0, "Int", 0, "Int", 0, "Int", 0
        , "UInt", 0x0001 | 0x0002 | 0x0010)

    ; ── SHIELD RATHER THAN SW_HIDE ──────────────────────────────────────────
    ; This is the Battlegrounds exit, and SW_HIDE is the single most reliable
    ; way to kill a Chromium window: it clears WS_VISIBLE, DWM then composites
    ; nothing, and the renderer reclaims the surface. That is the cause behind
    ; the FS-DESTROYED obituaries -- the window was not closed by anything, it
    ; had already given up while concealed.
    ;
    ; An empty region gives the user the same outcome -- nothing painted --
    ; while the window stays visible and composited. Measured against a live
    ; Firestone window: thirty seconds shielded, alive at every check, still
    ; painting afterwards. SW_HIDE stays as the fallback for the case where the
    ; region could not be applied at all, because a window left visible when it
    ; was meant to be concealed is the worse of the two failures.
    ; SW_HIDE, and no longer apologetically. Measured on the real Battlegrounds
    ; window: held ten seconds and survived eight rapid hide/show cycles, coming
    ; back painting MORE than its own baseline (1179 and 1184 against 1004).
    ; The region shield that used to sit here was silently refused by that
    ; window -- it reported success and left rgn=none -- so it was concealing
    ; nothing while looking like it worked.
    _FSHideWindow(hwnd, "_FSWarmSuppress")      ; SW_HIDE -- exactly once
}

; Diagnostic: record a window the funnel declined to touch because it is
; helper-shaped and carries no title we recognise.
;
; ONCE PER HWND, and only for titled windows. The funnel runs at 10 ms and the
; window event hook calls it with an empty title for every newborn Overwolf
; window, so an ungated log line here would be both a flood and a hot-path
; FileAppend from a "Fast" callback. What it buys: if a Firestone surface is
; ever visible when it should not be, this line names the window that was
; skipped and why -- instead of leaving a silent early return to be found by
; reading the source.
global _fsExemptLogged := Map()
_FSLogExemptOnce(hwnd, title) {
    global _fsExemptLogged
    ; Same reason as the cold path: these are never drawn, so naming
    ; them costs a file write during the busiest moment of a launch
    ; and tells nobody anything.
    if _FSIsInertHelper(hwnd, title)
        return
    if (title = "" || _fsExemptLogged.Has(hwnd))
        return
    _fsExemptLogged[hwnd] := true
    ex := 0
    try ex := WinGetExStyle("ahk_id " . hwnd)
    _FSLog("FS-EXEMPT declined (helper-shaped, unrecognised title) hwnd=" . hwnd
         . " title=`"" . title . "`" exstyle=" . Format("0x{:X}", ex))
}

; The single suppression primitive. Every concealment site in this script calls
; this and nothing else, so the owners that act on one window cannot disagree
; about it.
;
; allowProbe is false for the window event hook: that is a CallbackCreate
; "Fast" callback with no thread of its own, so a PrintWindow capture there
; would run on whatever thread it interrupted. The hook reads the already
; decided state; the settled sweep owns the measurement.
_FSSuppressSurface(hwnd, title, allowProbe := false) {
    global State, CFG, _fsMainCandidate, _fsMainEverOpened, _fsDisowned
    global _fsWasMainTitled, _fsAppTitled, _fsBgEverSeen
    global _fsPaintState, _fsMainPrewarmLogged, _fsBuriedForever
    global _fsKnownTitle
    ; Declared for the reader, not to fix anything. AutoHotkey v2 resolves an
    ; undeclared READ to the global, and `map[key] := value` is a method call
    ; on that global object rather than a rebinding, so these ledgers were
    ; always being consulted correctly. Only a bare `name := value` would have
    ; created a local and quietly diverged. Listing them makes the set of
    ; ledgers this function touches visible at the top, where the others are.
    global _fsParked, _fsTabRemoved, _fsAlphaApplied, _fsHiddenByUs
    global _fsShielded, _fsShieldHeldLogged, _fsBirthHidden
    global _fsFreedMain, _fsFreedBG, _fsHeldMain, _fsHeldBG
    global _fsRevealActive, _fsAlphaConcealed
    if !State.fsMainLocked
        return

    ; ══════════════════════════════════════════════════════════════════════
    ;  FIRESTONE MAIN: ALPHA IN PLACE, ONCE, AND NEVER HIDDEN OR PARKED
    ; ══════════════════════════════════════════════════════════════════════
    ;
    ; This is the baseline's rule, and it is the only thing that separated the
    ; harness that worked from every version of this script that did not:
    ;
    ;   every other Firestone window  cloak + no-fade + taskbar-off + park
    ;   Firestone MAIN               uncloak, UNPARK, alpha-0, left exactly
    ;                                where Firestone put it
    ;
    ; Measured by the harness: Main cloaked AND parked, with no other operation
    ; performed on it, was destroyed 12s after Hearthstone started. Uncloaked +
    ; alpha-0 but still PARKED died at +16s. What both dead runs shared was
    ; being moved off the virtual desktop. Alpha-0 is the one concealed state
    ; where DWM keeps compositing the window -- it stays on a monitor, simply
    ; transparent -- and _FSConcealMain already does exactly that.
    ;
    ; _FSConcealMain was never the problem. The problem was everything that
    ; reached Main FIRST: the birth hide, the "park" cold policy and the 10ms
    ; blanket all act before a window has named itself, so Main was hidden and
    ; parked seconds before the alpha policy saw it. This funnel is the single
    ; point they all pass through, so the rule is enforced here once.
    ;
    ; THREE THINGS THAT LOOK OPTIONAL AND ARE NOT:
    ;
    ;   identity FIRST. The ledgers below this guard are what remember a window
    ;   IS Main. Returning above them meant the one window this protects was the
    ;   one whose identity was never recorded -- FS-DESTROYED reported
    ;   everWasMain=no on a window the log had already shown titled
    ;   "Firestone - Main". Main then wears the plain title "Firestone" for most
    ;   of its life, the test missed, and it fell through to the blanket.
    ;
    ;   yield to a reveal. _FSRevealMain clears _fsAlphaConcealed when it shows
    ;   the window. Without this check the guard saw Main unconcealed and hid it
    ;   again instantly -- F3 revealed, this re-hid, and F3 appeared to do
    ;   nothing. _FSWarmSuppress has always had the same check for the same
    ;   reason: "never hide while the reveal is showing it".
    ;
    ;   ONCE, not per event. Calling _FSConcealMain on every event uncloaks
    ;   (alpha needs compositing) while the blanket re-cloaks, and the two
    ;   alternate at event speed -- 40 operations in 406ms, and the window died.
    ; ── CATCH MAIN AT ITS PRE-TITLE, BEFORE IT IS EVER SHOWN ────────────────
    ; This used to require the FINAL title, "Firestone - Main". By the time that
    ; arrives Overwolf has usually shown the window, so the conceal was always
    ; chasing a frame that had already been painted.
    ;
    ; It does not have to. Firestone Main is a WindowsForms host and it is born
    ; carrying the bare title "Firestone" -- the watchdog caught it at
    ; 1440x790 with vis=False, i.e. correctly sized, named, and NOT YET SHOWN.
    ; Concealing at that moment sets alpha 0 on a window that has never been
    ; visible, so there is no first frame to lose and nothing to hide.
    ;
    ; This is what replaces the birth hide. CFG.fsBirthHide only ever recorded
    ; an hwnd in a ledger -- it never called ShowWindow at all -- because an
    ; unconditional SW_HIDE at CREATE was measured to damage the window before
    ; Chromium had stood up a compositor for it. Setting a style bit on an
    ; unshown window has no such cost.
    ;
    ; _FSPolicyFor decides, not a size test written here: it already separates
    ; Main from a notification by size, and now rejects any per-pixel-alpha
    ; surface, so the in-game overlay cannot reach this branch.
    if (_fsWasMainTitled.Has(hwnd) || IsFirestoneMainTitle(title)
     || (title = "Firestone" && _FSPolicyFor(hwnd, title) = "main")) {
        _fsMainCandidate[hwnd] := true
        _fsWasMainTitled[hwnd] := true

        ; ── AND THE FLAG F3 ITSELF IS GATED ON. ─────────────────────────────
        ; THIS IS WHY F3 DID NOTHING.
        ;
        ; Hotkey_F3 opens with `if !FSMainHasOpened() return`, and that reads
        ; _fsMainEverOpened -- which is set further down THIS function, below
        ; the return above. So the guard that exists to protect Main was also
        ; the thing preventing F3 from ever believing Main had opened: the key
        ; returned on its second line and did nothing at all.
        ;
        ; Same mistake as the identity ledgers, one step further down the
        ; function: an early return skips whatever lives below it, and what
        ; lives below it is what the rest of the script runs on. Everything
        ; this branch skips is now written here first -- these three lines are
        ; the complete set, checked against the tail of this function.
        if IsFirestoneMainTitle(title)
            _fsMainEverOpened := true

        if _fsRevealActive
            return
        if _FSMainNeedsConceal(hwnd)
            _FSConcealMain(hwnd)
        return
    }

    ; ── RELEASE ONLY WHEN THE TITLE PROVES IT IS NOT MAIN ───────────────────
    ; This used to release on any non-empty title, which threw the pre-arm away
    ; on the very window it exists for. Firestone Main is titled bare
    ; "Firestone" for a moment BEFORE it becomes "Firestone - Main", and the
    ; Main branch above only matches the final title -- so the pre-armed
    ; transparency was stripped a moment before the window became Main, and it
    ; came up fully visible. Confirmed live 2026-09-06: "Firestone - Main",
    ; 1440x790, vis=True, WS_EX_LAYERED absent, ex=0x50100.
    ;
    ; Bare "Firestone" is therefore NOT proof of anything and must never
    ; release. Neither is a window already held at alpha 0, or one that has
    ; ever been Main. Everything else is a genuine other surface and gets its
    ; style back immediately.
    _FSUnburyIfF3Surface(hwnd, title)

    if _fsBuriedForever.Has(hwnd) {
        _FSBuryForever(hwnd)
        return
    }
    if (title = "Firestone - Loading") {
        _FSBuryForever(hwnd)
        return
    }

    ; Identity ledger, FIRST. Once an HWND has carried the Loading or Main title
    ; it is permanently off-limits to the notification-popup closer, whatever it is
    ; titled later. A title-and-size heuristic cannot safely distinguish a settled
    ; notification from a Firestone window that happens to match, and the
    ; consequence of getting it wrong is a WM_CLOSE.
    ;
    ; This runs BEFORE the helper-window branch below, which returns early. A
    ; Loading window that took that early return was never recorded here, so the
    ; one window guaranteed to become Firestone - Main was also the one window
    ; the closer considered fair game. Recording identity is free and must not
    ; be conditional on whether we go on to act.
    if (title = "Firestone - Loading" || title = "Firestone - Main")
        _fsMainCandidate[hwnd] := true

    ; ── REMEMBER WHAT WE CALLED IT, FOR THE OBITUARY ────────────────────────
    ; A DESTROY event arrives with nothing but an HWND, and the window is
    ; already gone -- WinGetTitle on it fails. Without a name recorded while
    ; the window was alive, _FSNoteDestroyed could only report a number, which
    ; is exactly as useful as the silence it replaces. Recorded for named
    ; Firestone surfaces only, so this stays a handful of entries rather than
    ; one per window on the desktop.
    if (title != "" && (IsFirestoneAppTitle(title)
                     || IsFirestoneSuppressionTitle(title)
                     || title = "Firestone"))
        _fsKnownTitle[hwnd] := title
    ; The narrower fact, recorded separately. _fsMainCandidate also holds
    ; Loading-titled windows -- and the notification popup wears that title --
    ; so it cannot be used as "this window is Main". Having actually WORN the
    ; Main title can. See _FSKillNotificationPopup.
    if IsFirestoneMainTitle(title)
        _fsWasMainTitled[hwnd] := true
    ; And any window that names itself as one of Firestone's own surfaces is
    ; permanently off-limits to the notification closer, whatever it is called
    ; later. This is how Settings is protected -- by its name, not by a guess
    ; at its window styles.
    if (IsFirestoneAppTitle(title) || IsFirestoneSuppressionTitle(title))
        _fsAppTitled[hwnd] := A_TickCount
    ; Once the Battlegrounds window has existed, its birth is behind us and the
    ; faster watch kept for it can be stood down. See fsBgBirthWatch.
    if IsFirestoneBattlegroundsTitle(title)
        _fsBgEverSeen := true

    ; Latch "Main has existed this session" HERE, where Main is actually seen.
    ;
    ; It used to be set only inside FSMainHasOpened(), which is called only from
    ; Hotkey_F3 -- so a user who never pressed F3 never set it, and every rule
    ; depending on it was silently inert for the whole session. A fact about the
    ; world belongs where the world is observed, not where somebody asks.
    if IsFirestoneMainTitle(title)
        _fsMainEverOpened := true

    ; ── THE IN-GAME OVERLAY: REFUSE, AND UNDO ANY HOLD ──────────────────────
    ; Placed at the very top of the funnel, above every other test, because
    ; this is the one window in the Overwolf family that must never be
    ; concealed by anything, in any lock state, for any reason. Identified by
    ; SHAPE and not only by title -- on the build in the logs it is called
    ; "Firestone", which the tests further down accept as a parkable desktop
    ; surface. See CFG.fsOverlayShapeDetect.
    ;
    ; It also RELEASES, for the same reason the never-conceal branch below
    ; does: the overlay is born nameless and chromeless like every other CEF
    ; window and is cloaked on sight by the birth machinery, and the janitor
    ; that used to undo that matched a title this build never produces. So the
    ; undo happens here, at the first suppression attempt made against the
    ; window once it is recognisable -- at event speed, and guarded on our own
    ; ledgers so an overlay nobody has touched costs one DWM query.
    if IsFirestoneInGameOverlay(hwnd, title) {
        if (_fsParked.Has(hwnd) || _fsTabRemoved.Has(hwnd)
         || _cloakState.Has(hwnd) || _fsAlphaApplied.Has(hwnd)
         || IsWindowCloakedDWM(hwnd)) {
            _RemoveFSAlphaShield(hwnd)
            _FSReleaseSurface(hwnd)       ; unpark, then uncloak
        }
        if _fsHiddenByUs.Has(hwnd) {
            _FSShowIfNotPopup(hwnd)
            _MapDrop(_fsHiddenByUs, hwnd)
        }
        _MapDrop(_fsShielded, hwnd)
        _MapDrop(_fsShieldHeldLogged, hwnd)
        _MapDrop(_fsBirthHidden, hwnd)
        return
    }

    ; ── DISOWNED: THE REAPER ALREADY CONCLUDED THIS IS NOT OURS ─────────────
    ; A window that spent CFG.fsBirthCloakMaxMs on screen without ever naming
    ; itself as Firestone's was released by FSBirthCloakReaper. Re-cloaking it
    ; here would undo that release on the very next sweep tick and hand it back
    ; to the reaper six seconds later -- a permanent flash cycle rather than a
    ; decision. So the funnel keeps its hands off it.
    ;
    ; Reversible on purpose: the instant the window DOES carry a Firestone
    ; name, the disown is dropped and normal suppression resumes. A surface
    ; that titles itself unusually late is picked straight back up, and nothing
    ; is permanently exempt on the strength of one slow start.
    if _fsDisowned.Has(hwnd) {
        if !_FSTitleIsOurs(title)        ; the same list the reaper reads
            return
        _MapDrop(_fsDisowned, hwnd)
    }

    ; ── NEVER-CONCEAL TITLES: THE FUNNEL REFUSES, AND UNDOES ────────────────
    ; This is the single primitive every suppression site goes through, which
    ; makes it the one place a title-level exemption is airtight rather than
    ; scattered. A window on CFG.fsNeverConcealTitles (Settings) is never
    ; suppressed here, whatever the lock state and whoever asked.
    ;
    ; It also RELEASES, because the exemption can only be judged once the
    ; window has a title, and by then the birth machinery has already acted:
    ; every CEF window is born nameless and cloaked/parked on sight, this one
    ; included. Undoing that here -- instead of only in the sweep's branch --
    ; means the very first suppression attempt made against the window under
    ; its settled name is the moment it comes back, at event speed. Guarded on
    ; our own ledgers so a Settings window nobody has touched costs nothing.
    if IsFSNeverConcealTitle(title) {
        if (_fsParked.Has(hwnd) || _fsTabRemoved.Has(hwnd)
         || _cloakState.Has(hwnd) || _fsAlphaApplied.Has(hwnd)
         || IsWindowCloakedDWM(hwnd)) {
            ; _Remove, not _Clear: the full unwind drops the shield ledger
            ; entry too, so this guard stops matching once the undo has run --
            ; _Clear keeps the entry and would re-fire this release on every
            ; later call, which is churn against a window Firestone owns.
            _RemoveFSAlphaShield(hwnd)
            _FSReleaseSurface(hwnd)       ; unpark, then uncloak
        }
        if _fsHiddenByUs.Has(hwnd) {
            _FSShowIfNotPopup(hwnd)
            _MapDrop(_fsHiddenByUs, hwnd)
        }
        _MapDrop(_fsBirthHidden, hwnd)
        return
    }

    ; HELPER-WINDOW EXEMPTION, NARROWED.
    ; IsHelperWindow returns true for anything OWNED by another window or
    ; carrying WS_EX_TOOLWINDOW. Overwolf builds most of its chrome-less
    ; surfaces that way -- the notification popup ("Your abilities are ready!")
    ; AND the "Firestone - Loading" splash -- so this early return skipped the
    ; loading window entirely. Nothing else hides it: the 10 ms sweep funnels
    ; through here, so it declined too, and the window simply sat on screen in
    ; full view until KillFirestoneLoading's 250 ms timer WM_CLOSEd it. That is
    ; the "flickered for a second and wasn't completely hidden before it
    ; disappeared" report -- it was never hidden at all, it was closed.
    ;
    ; The exemption exists to protect INFRASTRUCTURE (Qt tray helper,
    ; message-only sinks) from being managed at all. A titled Firestone surface
    ; is not that, whatever its window styles say. Any surface we can name is
    ; suppressed -- CLOAK ONLY, never moved, since a tool window's position is
    ; Overwolf's business and a park would fight its owner.
    ;
    ; Titles are matched EXACTLY (IsFirestoneMainTitle and friends), so the
    ; in-game overlay ("Firestone - Overlays") does not match any of them and
    ; keeps its complete immunity. That is deliberate and load-bearing: the
    ; overlay is the one Firestone surface that must never be touched.
    ; ── NOTIFICATION POPUP: CLOAK, NEVER PARK, AND KILL IT ──────────────────
    ; Handled before everything below, and deliberately never parked.
    ;
    ; Parking moves a window off the virtual desktop and RECORDS ITS RECTANGLE
    ; so it can be put back. That bookkeeping is what ties a window to F3: the
    ; unlock sweep restores everything it finds parked. A popup that is going
    ; to be closed must never enter that ledger, or F3 becomes a way to summon
    ; a window whose whole purpose is to not exist. Cloaking has no such
    ; bookkeeping -- it is a property of the window, cleared when the window
    ; dies, which for this window is imminent.
    if IsFirestoneNotificationPopup(hwnd, title) {
        ; The kill is ASKED FOR, not assumed. _FSKillNotificationPopup applies
        ; the structural guard and refuses when this window might be Firestone
        ; Main -- and if it refuses, this window is not a popup after all, so
        ; it must fall through to normal suppression rather than being cloaked
        ; here and abandoned. Cloaking first and asking afterwards left a
        ; declined window cloaked, outside the ledgers, and reachable only by
        ; the reveal path.
        if _FSKillNotificationPopup(hwnd, "funnel") {
            _DisableDWMTransitions(hwnd)
            return
        }
        ; Declined: treat it as the real Firestone window it may well be.
    }

    if IsHelperWindow(hwnd) {
        ; AN UNNAMED NEWBORN IS CLOAKED, NOT WAVED THROUGH.
        ;
        ; This is the birth gap. The window event hook calls this funnel at
        ; CREATE with an EMPTY title -- a CEF window has no caption yet -- and
        ; every test below matches on a TITLE, so at CREATE none of them could
        ; match and this branch returned having done nothing at all. By the
        ; time the window had a name to recognise, it had already painted.
        ;
        ; Cloaking an unidentified newborn is the safe direction to be wrong
        ; in. A cloak is reversible, costs nothing, and works on a window that
        ; has never been shown; if it turns out to be the in-game overlay,
        ; OverlayTopmostTick uncloaks it on its next pass -- the same contract
        ; this hook already relies on for every non-helper Overwolf window.
        ; Being invisible for one tick is recoverable. Being painted is not.
        if (title = "") {
            CloakWindow(hwnd, false, "_FSSuppressSurface")
            _DisableDWMTransitions(hwnd)
            _FSNoteBirthCloak(hwnd)      ; so the reaper can undo it if this
            return                       ; window never turns out to be ours
        }
        if !(IsFirestoneMainTitle(title)
          || IsFirestoneBattlegroundsTitle(title)
          || title = "Firestone - Loading"
          || title = "Firestone") {
            _FSLogExemptOnce(hwnd, title)
            return
        }
        ; A NAMED FIRESTONE SURFACE FALLS THROUGH to the normal policy below,
        ; which MOVES it off the virtual desktop rather than only cloaking it.
        ;
        ; This branch used to stop here with a cloak and nothing else, on the
        ; reasoning that a tool window's position is Overwolf's business. That
        ; is true while the window is visible and false while we are concealing
        ; it: a cloaked window is not drawn but is still HIT-TESTED, so one left
        ; sitting over Hearthstone silently swallows every click that lands on
        ; it. An invisible window in the middle of the screen is worse than a
        ; visible one, because nothing on screen explains why the game stopped
        ; responding.
        ;
        ; The park records the exact rectangle and the reveal restores it, so
        ; the window still returns precisely where Overwolf put it.
    }

    ; ══════════════════════════════════════════════════════════════════════
    ;  FIRESTONE MAIN IS NOT TOUCHED AT ALL UNTIL IT HAS PAINTED
    ; ══════════════════════════════════════════════════════════════════════
    ; THIS IS THE FIX FOR "MAIN DOES NOT SURVIVE", AND THE LOG NAMES THE BUG:
    ;
    ;   07:32:02  FS-MAIN  hwnd=4981776  title="Firestone"  size=1440x790
    ;   07:32:04  CEF children appear for it (CollectionWindow, D3D, ...)
    ;             ... hwnd 4981776 is never mentioned again ...
    ;   07:32:54  Main appears as hwnd=5047312, fifty-two seconds later
    ;
    ; Main was concealed at birth and destroyed. The window that eventually
    ; carried the Main title was a different one, created much later -- which
    ; from the outside is exactly "Main did not open, and I had to open it from
    ; the tray to get F3 working".
    ;
    ; The cold/warm split already encodes the right rule and this is the first
    ; place that actually obeys it. COLD MEANS "HAS NEVER PAINTED". A window
    ; that has never painted is a window whose compositor is still being built,
    ; and the correct thing to do to it is NOTHING -- not a cloak, not a park,
    ; not a hide. Both exits parked it, which is why every previous attempt
    ; here failed: the choice was between two ways of touching a window that
    ; must not be touched yet.
    ;
    ; A previous revision forced Main WARM on sight to keep it away from the
    ; flicker shield. That reached the shield's goal and made the real problem
    ; worse, because warm parks immediately with no probe at all.
    ;
    ; WHAT THIS COSTS: Main is visible for the second or two it takes to draw
    ; its first frame. That is the behaviour asked for anyway -- Main opens
    ; ahead of Hearthstone, and the fullscreen game then covers it. The moment
    ; it has painted it becomes warm and F3 owns it exactly as before.
    ;
    ; _FSMainReadyWatch waits for Firestone's own rename and touches nothing
    ; at all -- no cloak, no park, no ShowWindow, and no PrintWindow either.
    ; ── SHIELD ON SIGHT, WHICH MAKES EVERYTHING BELOW UNNECESSARY ───────────
    ;
    ; THIS IS THE FIRESTONE FLICKER -- BOTH KINDS -- AND THEY HAVE ONE CAUSE.
    ;
    ; Every mechanism below is arranged around a single constraint: HIDING OR
    ; MOVING A COLD CEF WINDOW KILLS IT. Two accommodations follow from it, and
    ; those two accommodations ARE the two flickers:
    ;
    ;   Main            is left visible until it has drawn its first frame.
    ;                   The comment immediately below states the cost in as
    ;                   many words -- "Main is visible for the second or two
    ;                   it takes to draw its first frame".
    ;   Battlegrounds   is parked, then unparked, to PROVE it has painted
    ;                   before it is allowed to be hidden:
    ;                     FS-SHIELD released after 47ms -- parked off-screen
    ;                     FS-PAINT PROVEN after 1328ms ... policy=park
    ;                   That proof is a visible round trip on a live window.
    ;
    ; An empty region neither hides nor moves the window, and requires nothing
    ; to be proven about it beforehand. It is exactly as safe on a window that
    ; has never painted as on one that has, so the warm/cold distinction it
    ; exists to serve stops applying the moment it takes. Measured on a live
    ; Firestone window: thirty seconds concealed, alive at every check, still
    ; painting afterwards.
    ;
    ; Every exemption has already run above, so anything reaching this line is
    ; a Firestone surface this script is meant to conceal -- the in-game
    ; overlay, the never-conceal titles, the notification popups and the
    ; helper windows have all returned before now.
    ; ── TWO PHASES, AND NOTHING ELSE ────────────────────────────────────────
    ; Before the first F3 the window has never been shown, so it is held hidden
    ; -- once, and only once. After the first F3 it is warm and visible, and
    ; concealing it means minimising it. Both are measured safe; see
    ; _FSHoldApply for the numbers. Neither repeats an operation on a window
    ; that is already in the state it wants, which is the property the old
    ; park-and-prove machinery below never had.
    ; The blanket owns this. It classifies the window, refuses the overlay
    ; outright, and holds Main or Battlegrounds exactly once each.
    if _FSBlanketHide(hwnd)
        return
    ; Already freed by an earlier F3: minimise is the concealment from here.
    if _FSPostFreeConceal(hwnd)
        return

    if (CFG.fsMainDeferConceal && !_FSIsWarm(hwnd) && _FSIsMainSurface(hwnd, title)) {
        _FSMainReadyWatch(hwnd, title)
        return
    }

    ; ── THE PAINT PROBE IS NOT RUN. IT COST MORE THAN IT ANSWERED. ──────────
    ;
    ; _FSProbePaint decides "has this window painted yet" by calling
    ; PrintWindow across process boundaries -- a synchronous, full-window
    ; render request. Its own notes describe the load: seventeen windows per
    ; launch, each probed every 250ms for twenty seconds, about twenty-five
    ; full captures a second against the same Chromium window while it is
    ; still bringing its compositor up.
    ;
    ; And for Firestone Main the answer changes nothing. Both branches below
    ; call _FSConcealMain for a Main surface -- "one policy, one function,
    ; both temperatures", as _FSWarmSuppress puts it. So the probe was forcing
    ; renders out of the exact window that keeps dying, to decide something
    ; that has no effect on it.
    ;
    ; Windows now take the cold path unless something else has already marked
    ; them warm, which is the same route Main took anyway. Nothing calls
    ; PrintWindow any more.
    warm := _FSIsWarm(hwnd)

    if warm
        _FSWarmSuppress(hwnd, title)
    else
        _FSColdSuppress(hwnd, title)
}

; Reveal-side counterpart: undo everything the cold path did, in the order that
; keeps it invisible until the last step.
; Show a Firestone window -- unless it is the notification popup, which is
; killed instead.
;
; The companion to the guard inside _FSReleaseSurface. Release and show are the
; two ways a concealed window gets back on screen, and both now refuse the one
; window that must never return. Every ShowWindow on a Firestone surface goes
; through here; the Battle.net paths have their own rules and are untouched.
_FSShowIfNotPopup(hwnd) {
    global _fsBuriedForever
    try {
        if _fsBuriedForever.Has(hwnd)
            return false
        t := WinGetTitle("ahk_id " . hwnd)
        if IsFirestoneNotificationPopup(hwnd, t) {
            _FSKillNotificationPopup(hwnd, "show attempt")
            return false
        }
        ; Belt and braces for the same window under a title the matcher above
        ; declined -- during a launch the Loading window IS Main-in-formation
        ; and the closer rightly refuses it, but "do not close it" has never
        ; meant "put it on screen". Nothing in this script ever wants a
        ; Loading-titled window shown; its own pipeline owns its visibility.
        if (t = "Firestone - Loading")
            return false
    }
    ; The region first: a shielded window is already visible, so ShowWindow
    ; alone would report success while it carried on painting nothing.
    try DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
    return true
}

_FSReleaseSurface(hwnd) {
    global _fsParked, _fsBuriedForever

    if _fsBuriedForever.Has(hwnd)
        return

    ; ── A NOTIFICATION POPUP IS NEVER RELEASED. IT IS KILLED. ───────────────
    ; This is the single choke point for "make a Firestone window visible
    ; again" -- the F3 reveal, the early-cloak teardown, the overlay enforcer
    ; and the stranded-window repairs all end up here. Putting this rule at
    ; each of those sites means getting it right five times and keeping it
    ; right forever; putting it here means it cannot be got wrong at all.
    ;
    ; The popup reached the screen through this function twice already, via two
    ; different callers, which is the definition of a rule that belongs one
    ; level down. Firestone Main cannot match: this tests for the bare
    ; "Firestone" title, and Main's is "Firestone - Main".
    try {
        t := WinGetTitle("ahk_id " . hwnd)
        if IsFirestoneNotificationPopup(hwnd, t) {
            _FSKillNotificationPopup(hwnd, "release attempt")
            return
        }
    }

    _FSUnparkWindow(hwnd)             ; back on the chosen monitor, still cloaked
    _FSFreeHeld(hwnd)                 ; one hold -> minimise, once and for good
    _FSTabOn(hwnd)                    ; taskbar button back (no-op if never taken)
    ; Force the uncloak. The arbitration in UncloakWindow skips the DWM call when
    ; the ledger says we are not holding the cloak -- correct for avoiding churn,
    ; wrong here. A window cloaked by a previous instance, or one whose ledger entry
    ; was pruned, would be left cloaked: shown, positioned, focusable and completely
    ; invisible. The reveal must ask the window, not the ledger.
    UncloakWindow(hwnd, true, "_FSReleaseSurface")
}

; ── Fresh-born keep-hidden (the "Battlegrounds popped up mid-match" fix) ─────
; Conceals a suppression-titled window at its FIRST appearance while the F3
; lock is OFF. See CFG.fsFreshBornStartHidden for the policy and the asymmetry
; it closes; this is only the mechanism.
;
; NOT routed through _FSSuppressSurface, deliberately: the funnel's first line
; is "do nothing while unlocked", and that gate is load-bearing for its dozen
; other callers -- widening it for this one case would put every unlocked-era
; event back inside the suppression machinery. This does the cold exit by hand
; instead: cloak (anti-flash), transitions off, taskbar button off, park. No
; ShowWindow in any direction, so a renderer that has never painted is never
; told it stopped existing -- the same rule the cold path lives by.
;
; The park records the window in _fsParked, which is the reveal's own ledger,
; so the next F3 unlock hands the window back through exactly the machinery
; that hands back everything else. ExitCleanup restores it on every exit path.
global _fsFreshKeptHidden := Map()   ; hwnd -> tick; once-per-window log gate
_FSConcealFreshUnlocked(hwnd, title) {
    global _fsFreshKeptHidden
    _FSEnsureCloaked(hwnd)
    _DisableDWMTransitions(hwnd)
    _FSTabOff(hwnd)
    if _FSMayPark(hwnd, title) {
        ; ── THE BIRTH HIDE BELONGS HERE TOO ────────────────────────────────
        ; This path had a cloak and a park and nothing in between, and that is
        ; a gap with a frame in it. A DWM cloak is a REQUEST the compositor
        ; declines often on a window whose process is still starting -- the log
        ; is full of newborn Firestone windows reading cloaked=0 immediately
        ; after we asked -- and a park is a MOVE, which lands on the next
        ; frame. Between a declined cloak and a completed move the window is on
        ; screen at its real position. That is the flicker.
        ;
        ; The cold path solved this with _FSFlickerShieldOn: an SW_HIDE that
        ; cannot be declined, released the moment the park is provably landed.
        ; This path is the OTHER way a Battlegrounds window is concealed -- the
        ; one taken when it is born mid-match while F3 has the overlay
        ; unlocked, which is precisely when nobody is watching for it -- and it
        ; never got the shield.
        ;
        ; Routed through _FSFlickerShieldEligible rather than calling the
        ; shield directly, so this site inherits every exclusion the cold path
        ; has (Main, the in-game overlay, Settings) and the one-shot latch.
        ; The call site above this function is Battlegrounds-only anyway; this
        ; is belt and braces on a window that must never be hard-hidden.
        if _FSFlickerShieldEligible(hwnd, title)
            _FSFlickerShieldOn(hwnd, title)
        _FSParkWindow(hwnd)
    }
    if !_fsFreshKeptHidden.Has(hwnd) {
        _fsFreshKeptHidden[hwnd] := A_TickCount
        _FSLog("FS-FRESH `"" . title . "`" born while the lock is OFF --"
             . " concealed at first appearance (fsFreshBornStartHidden);"
             . " the next F3 unlock reveals it")
    }
}

; True only for the REAL Battle.net client window: launcher-titled AND
; resizable (WS_THICKFRAME) or currently maximized. That is the fingerprint
; separating it from the fixed-size auto-login shell ("Logging in" +
; Maintenance Alert panel), which keeps the SAME "Battle.net" title but has
; no resize frame and no maximize box. Styles are DPI-proof; pixel sizes are
; not, so no size thresholds are used here.
_IsProtectedBNetMain(hwnd) {
    try {
        t := WinGetTitle("ahk_id " . hwnd)
        if !(t = "Battle.net" || t = "Blizzard Battle.net")
            return false

        ; ---- OWNED WINDOWS ARE NEVER THE CLIENT ----------------------------
        ; The real Battle.net client is an unowned top-level window. Its alert
        ; panels -- maintenance notices, service outages, update prompts --
        ; are OWNED dialogs that inherit the owner's caption, so they too are
        ; titled "Battle.net" and they are laid out landscape at a size the
        ; SHAPE FALLBACK below happily accepts. That made an alert pass as the
        ; client: protected from the services blanket, and worse, latched into
        ; _bnetLauncherHwnd as the launcher's identity.
        ;
        ; This test runs before the style and shape tests because it is the
        ; only one of the three that cannot be fooled -- ownership is fixed at
        ; creation and never changes, whereas styles settle late (the reason
        ; the shape fallback exists at all) and shape is just a guess.
        if DllCall("user32\GetWindow", "Ptr", hwnd, "UInt", 4, "Ptr")   ; GW_OWNER
            return false

        style := WinGetStyle("ahk_id " . hwnd)
        if (style & 0x00040000)          ; WS_THICKFRAME: resizable = the client
            return true
        if (style & 0x01000000)          ; WS_MAXIMIZE: surely the client
            return true
        ; ---- SHAPE FALLBACK (birth-race fix) --------------------------------
        ; On several client builds WS_THICKFRAME is applied a few frames AFTER
        ; the window is created and titled. During that gap both style tests
        ; above fail, the services blanket classifies the REAL launcher as a
        ; service surface and SW_HIDEs it, and whether it is ever un-hidden
        ; depends on the exact ordering of (title set) / (style set) / (event
        ; delivery) -- the launcher inconsistency. This third test identifies
        ; the client by SHAPE while its styles are still settling.
        ;
        ; Discriminator is ASPECT, not absolute size: the client is markedly
        ; LANDSCAPE (~1.6:1), while the fixed-size auto-login shell ("Logging
        ; in" + Maintenance Alert) is portrait/square. Aspect holds at every
        ; DPI. The pixel floors only exclude small landscape dialogs; they are
        ; low enough to pass the client at 100% scaling and are never the
        ; deciding factor on a high-DPI display (where every dimension grows).
        rc := Buffer(16, 0)
        if DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc) {
            w := NumGet(rc,  8, "Int") - NumGet(rc, 0, "Int")
            h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")
            if (w >= 700 && h >= 400 && w > h * 1.15)
                return true
        }
    }
    return false
}

; -- Battle.net SERVICES blanket (aggressive) ---------------------------------
; Only the REAL client window (_IsProtectedBNetMain) is untouchable. EVERYTHING
; else in the Battle.net family is taken off the screen at maximum aggression
; while the blanket is armed: DWM-cloaked the instant it exists (cloak works on
; still-invisible windows, so the first shown frame is already invisible) and
; SW_HIDDEN + ledgered the moment it is visible. That includes the fixed-size
; auto-login shell ("Logging in" + Maintenance Alert), the boot splash,
; update/maintenance overlays, stray dialogs, and every Agent / Battle.net
; Helper window. Login and auth screens are hidden too: if a HUMAN actually
; has to type, the pipeline's title-based detector (which sees hidden windows)
; notices, LOGIN_WAIT flips _bnetLoginAllowed, and UnhideBNetLoginWindows
; brings back exactly those windows. Recovery paths for everything hidden
; here: NAMECHANGE janitor + 10ms tick enforcement (turns out to be the real
; client), LOGIN_WAIT (login windows), abort/exit janitors (everything).
_HideBlizzWindow(hwnd, exe := "Battle.net.exe") {
    global _bnetHiddenByUs, _bnetLoginAllowed, _bnetHideDone, _bnetLauncherHwnd
    try {
        ; IDENTITY PROTECTION: the real Battle.net client (resizable) is
        ; never hidden. This guarantees the launcher stays visible from the
        ; moment it appears, as requested. All other surfaces (splash,
        ; login shell, maintenance, Agent, Helper) are still hidden.
        if (exe = "Battle.net.exe" && _IsProtectedBNetMain(hwnd))
            return

        ; Once the reveal has shown the launcher, that exact hwnd is off-limits
        ; forever. (This is now redundant but kept for safety.)
        if (hwnd = _bnetLauncherHwnd)
            return
        ; Already hidden by us and still hidden: nothing to do.
        if (_bnetHideDone.Has(hwnd)
         && !DllCall("user32\IsWindowVisible", "Ptr", hwnd))
            return
        ; LOGIN_WAIT: hands off entirely so the user can see and type.
        if (exe = "Battle.net.exe" && _bnetLoginAllowed)
            return
        if DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            _bnetHiddenByUs[hwnd] := true   ; was visible: janitors may restore

        ; ── PLACE IT ON THE LOCKED MONITOR *BEFORE* HIDING IT ───────────────
        ; This is what made the monitor lock half-broken for Battle.net.
        ;
        ; Two systems were disagreeing. This one hides a service window the
        ; instant it appears. The lock -- _LockProcWindowsToChosenMonitor --
        ; only moves VISIBLE windows ("if !IsWindowVisible continue"), because
        ; moving something nobody can see looked pointless. So a window hidden
        ; here at birth was never placed at all: it sat hidden wherever
        ; Battle.net created it, usually the primary monitor, and the lock could
        ; not reach it afterwards because it was no longer visible.
        ;
        ; That is why Battle.net surfaces kept turning up on the primary. The
        ; lock was not failing to move them; it was never allowed to see them.
        ;
        ; Placing first fixes it properly rather than papering over it: the
        ; window is put on the chosen monitor while it is still reachable, and
        ; only then hidden. It is now hidden ON the locked monitor, so if it is
        ; ever revealed -- LOGIN_WAIT, the janitors, a crash recovery -- it
        CloakWindow(hwnd, false, "_HideBlizzWindow")
        DllCall("ShowWindow", "Ptr", hwnd, "Int", 0)       ; SW_HIDE
        _bnetHideDone[hwnd] := true
    }
}

; Move a Blizzard top-level window onto the chosen monitor WITHOUT requiring it
; to be visible (the normal placement assists skip invisible windows). Used at
; reveal time, before the window is shown, so its first visible frame lands on
; the right screen. No-op unless monitor locking is on and a monitor is chosen.
_PlaceBlizzWindowNow(hwnd) {
    global CFG, ChosenMonIdx
    if (!CFG.lockWindowsToChosenMonitor || !ChosenMonIdx)
        return
    try {
        if (DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr") != hwnd)
            return
        if (IsHelperWindow(hwnd) || IsIMEWindow(hwnd))
            return
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return
        bx := NumGet(rc, 0, "Int"), by := NumGet(rc, 4, "Int")
        bw := NumGet(rc,  8, "Int") - bx
        bh := NumGet(rc, 12, "Int") - by
        if (bw < 100 || bh < 60)
            return
        if (GetMonitorIndexForPoint(bx + bw // 2, by + bh // 2) = ChosenMonIdx)
            return
        _SafeWorkArea(ChosenMonIdx, &waL, &waT, &waR, &waB)
        waW := waR - waL, waH := waB - waT
        if (waW <= 0 || waH <= 0)
            return
        nx := (bw <= waW) ? waL + (waW - bw) // 2 : waL
        ny := (bh <= waH) ? waT + (waH - bh) // 2 : waT
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", nx, "Int", ny, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)
    }
}

; ── DWM transition kill‑switch ───────────────────────────────────────────────
; DWMWA_TRANSITIONS_FORCEDISABLED (3): while TRUE, DWM draws NO minimize /
; restore / open transition animation for the window. This removes the black‑
; rectangle flicker during restore↔minimize fights.
; Arbitrated, like CloakWindow and UncloakWindow beside it -- and for the same
; reason. Every one of these is an LPC round-trip to dwm.exe, the process that
; is also compositing the game, and this pair had no idempotency guard at all:
; the suppression path called it unconditionally for every concealed Firestone
; window on every sweep tick, to set a value that was already set.
global _fsTransitionsOff := Map()   ; hwnd -> true while WE have transitions off

_DisableDWMTransitions(hwnd) {
    global _fsTransitionsOff
    static DWMWA_TRANSITIONS_FORCEDISABLED := 3
    if _fsTransitionsOff.Has(hwnd)
        return
    _fsTransitionsOff[hwnd] := true
    v := 1
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_TRANSITIONS_FORCEDISABLED, "Int*", v, "UInt", 4)
}

_EnableDWMTransitions(hwnd) {
    global _fsTransitionsOff
    static DWMWA_TRANSITIONS_FORCEDISABLED := 3
    ; Unlike the disable, this is NOT skipped when the ledger is empty: it is a
    ; repair path as well as an undo, and a window left with transitions
    ; disabled by a previous instance has no ledger entry here.
    _MapDrop(_fsTransitionsOff, hwnd)
    v := 0
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_TRANSITIONS_FORCEDISABLED, "Int*", v, "UInt", 4)
}

; True if DWM currently reports the window as cloaked.
IsWindowCloakedDWM(hwnd) {
    static DWMWA_CLOAKED := 14
    v := 0
    if DllCall("dwmapi\DwmGetWindowAttribute", "Ptr", hwnd, "UInt", DWMWA_CLOAKED, "UInt*", &v, "UInt", 4) = 0
        return v != 0
    return false
}

; ── FS‑Main alpha shield ──────────────────────────────────────────────────────
; Makes the window's pixels fully transparent (WS_EX_LAYERED, alpha 0).
; Applied only to suppression‑titled windows while the F3 lock is ON.
; Removed by F3 unlock, stop‑release, and ExitCleanup.
global _fsAlphaApplied := Map()   ; hwnd -> window was ALREADY layered before us
global _fsShieldDown   := Map()   ; hwnd -> OUR alpha-0 shield is currently
                                  ; armed on this kept-layered window. Lets
                                  ; every lock/unlock re-arm or clear the
                                  ; shield with pure VALUE writes -- never a
                                  ; style flip, never a FRAMECHANGED
global _fsBirthHidden   := Map()  ; hwnd -> tick we SW_HID it at CREATE,
                                  ; before it could paint. Released by the
                                  ; overlay / title-settle janitors, or by the
                                  ; timeout sweep, so nothing stays hidden by
                                  ; accident.
global _fsRevealFg      := Map()  ; hwnd -> already foregrounded during THIS
                                  ; reveal. Caps the topmost+activate at one
                                  ; per window per F3 press (it used to run on
                                  ; every 30ms tick -- the stress-test killer).
global _fsEverPainted  := Map()   ; kept for reveal tracking (set when revealed)
global _fsHiddenByUs   := Map()   ; hwnd -> a Firestone-Loading suppressor
                                  ; SW_HID this window while it was VISIBLE.
                                  ; The F3 reveal may force-show ONLY these
                                  ; (the Loading->Main same-HWND retitle
                                  ; case). Windows Overwolf itself keeps
                                  ; hidden are NEVER force-shown -- doing so
                                  ; desynced Overwolf's own visibility state
                                  ; and made rapid F3 toggling kill the Main.
; The following maps are removed because they were only used for the
; first-paint safety logic, which is no longer enforced:
; _fsFirstTitledAt and _fsPaintedTitles.

; ── Layered-window mechanism probe ────────────────────────────────────────────
; A window can be layered in two mutually exclusive ways, and the difference
; decides whether it is safe to touch:
;
;   * UpdateLayeredWindow -- per-pixel alpha, which Chromium uses for its own
;     compositing. Calling SetLayeredWindowAttributes on such a window pulls it
;     out of that mode and can wedge one that is still forming. Never touch.
;   * SetLayeredWindowAttributes -- a single whole-window alpha value. Safe to
;     read and rewrite.
;
; GetLayeredWindowAttributes distinguishes them for free: it succeeds only for
; the attribute form. That is a direct question to the OS about the window's
; actual state, rather than an inference from whether it happened to look
; layered the first time this process saw it.
;
; Returns  1 = attribute-layered (alpha readable and writable)
;          0 = per-pixel layered (hands off)
;         -1 = not layered
_MapDrop(m, k) {
    try m.Delete(k)
}

_FSLayeredAlphaState(hwnd, &alpha) {
    alpha := 255
    static GWL_EXSTYLE := -20, WS_EX_LAYERED := 0x80000
    try {
        fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        if !(ex & WS_EX_LAYERED)
            return -1
        key := 0, bAlpha := 0, flags := 0
        if !DllCall("user32\GetLayeredWindowAttributes", "Ptr", hwnd
            , "UInt*", &key, "UChar*", &bAlpha, "UInt*", &flags)
            return 0
        alpha := bAlpha
        return 1
    }
    return -1
}

; ── Stuck-transparency repair ────────────────────────────────────────────────
; THE F3-REVEALS-AN-EMPTY-FRAME FIX.
;
; The shield deliberately keeps WS_EX_LAYERED across an unlock, so a window it
; has ever touched stays layered for life. If the script is then reloaded or
; restarted while Firestone is running -- which happens constantly during
; testing, and is exactly what Ctrl+Alt+R does -- the new instance starts with
; empty ledgers, sees a layered window, and (under the old logic) filed it as
; "Overwolf's own, never touch". From that moment both release paths refused to
; restore its alpha, so the window was stranded at alpha 0: shown, sized,
; focusable, and completely invisible. Pressing F3 dutifully un-hid and
; un-cloaked it, and you saw an empty outline.
;
; This walks the Overwolf family and restores full opacity on anything left
; attribute-layered at less than full alpha. Per-pixel windows are skipped by
; the probe above, so Overwolf's own compositing is never disturbed. Run at
; startup (repairs whatever a previous instance stranded) and on every F3
; unlock (guarantees the reveal cannot produce an invisible window).
FSRepairStuckAlpha() {
    global CFG, _fsAlphaApplied, _fsShieldDown, _fsAlphaConcealed
    static LWA_ALPHA := 0x2
    static lastRun := 0
    ; Throttled for the same reason as FSRepairStrandedWindows: StartFSReveal
    ; calls this on every F3 unlock, and a window cannot become stranded
    ; transparent between two key presses.
    if (lastRun && A_TickCount - lastRun < 3000)
        return
    lastRun := A_TickCount
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for exe in CFG.fsAlphaRepairExes {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    ; ── DELIBERATE CONCEALMENT IS NOT DAMAGE ────────────────
                    ; This janitor exists for windows a CRASHED or previous
                    ; instance left transparent with nothing running to restore
                    ; them. _FSConcealMain holds Firestone Main at alpha 0 on
                    ; purpose and records it in _fsAlphaConcealed, and without
                    ; this test the two fight: CompleteHSLaunchSuccess schedules
                    ; this 1500ms after the F2 launch tail, which forces Main
                    ; opaque just after it was concealed -- the flicker -- and
                    ; Hotkey_F4 calls StopLauncherHide, which calls this, which
                    ; is why F4 stopped keeping a hidden Main hidden on the way
                    ; out.
                    ;
                    ; F3 is unaffected. StartFSReveal calls _FSRevealAllAlpha
                    ; immediately before calling this, and that empties the
                    ; ledger, so during a reveal there is nothing here to skip.
                    if _fsAlphaConcealed.Has(h)
                        continue
                    a := 255
                    if (_FSLayeredAlphaState(h, &a) = 1 && a < 255) {
                        DllCall("user32\SetLayeredWindowAttributes", "Ptr", h
                            , "UInt", 0, "UChar", 255, "UInt", LWA_ALPHA)
                        _MapDrop(_fsShieldDown, h)
                        _MapDrop(_fsAlphaApplied, h)
                    }
                }
            }
        }
    }
    DetectHiddenWindows prev
}

_ApplyFSAlphaShield(hwnd) {
    global _fsAlphaApplied, _fsShieldDown, CFG
    try {
        static LWA_ALPHA := 0x2
        static GWL_EXSTYLE := -20, WS_EX_LAYERED := 0x80000
        fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
        fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"

        a := 255
        st := _FSLayeredAlphaState(hwnd, &a)

        ; Per-pixel layered (Overwolf's own compositing): record and leave it
        ; alone. The record still powers the notification sweeper's guard 3b,
        ; so downstream behaviour is unchanged. Invisibility for this window is
        ; carried by the cloak + minimize + hide, which is ample.
        if (st = 0) {
            _fsAlphaApplied[hwnd] := true
            return
        }

        ; Shield disabled (the default): record ownership so the guards that
        ; read _fsAlphaApplied behave exactly as before, but write no alpha.
        ; Nothing can be stranded transparent if nothing is ever made
        ; transparent.
        if !CFG.fsUseAlphaShield {
            if !_fsAlphaApplied.Has(hwnd)
                _fsAlphaApplied[hwnd] := false
            return
        }

        if (st = 1) {
            ; Attribute-layered -- ours, or a previous instance's. Either way
            ; the alpha is safely writable, so claim it rather than guessing.
            _fsAlphaApplied[hwnd] := false
            if !_fsShieldDown.Has(hwnd) {
                _fsShieldDown[hwnd] := true
                DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
                    , "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA)
            }
            return
        }

        ; Not layered: first-ever shield on this hwnd.
        ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
        DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr", ex | WS_EX_LAYERED)
        DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
            , "UInt", 0, "UChar", 0, "UInt", LWA_ALPHA)
        _fsAlphaApplied[hwnd] := false
        _fsShieldDown[hwnd]  := true
    }
}

; F3-cycle shield release: alpha back to 255, WS_EX_LAYERED DELIBERATELY KEPT.
; The old full unwind (strip the style + the FRAMECHANGED a style change
; requires) ran once per unlock -- N F3 cycles = N layered-mode round-trips
; on the live CEF window, exactly the repeated-mode-switch hazard the apply
; side documents. A layered window at alpha 255 renders fully normally, so
; keeping the style turns every later lock/unlock into a pure value write.
; The full unwind (_RemoveFSAlphaShield below) remains for the ONE-SHOT
; janitors (early-cloak release, popup closer, overlay sweep, exit), where a
; true style restore is the right thing and happens at most once per launch.
_ClearFSAlphaShield(hwnd) {
    global _fsAlphaApplied, _fsShieldDown
    _EnableDWMTransitions(hwnd)
    ; State, not ledger. Ask the window what its alpha actually is rather than
    ; consulting bookkeeping: a window stranded transparent by an earlier instance
    ; has no ledger entry, and it is exactly the case that needs repairing.
    ; Per-pixel layered windows still return 0 from the probe and are still never
    ; touched, so Chromium's own compositing is safe.
    try {
        a := 255
        if (_FSLayeredAlphaState(hwnd, &a) = 1 && a < 255) {
            DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
                , "UInt", 0, "UChar", 255, "UInt", 0x2)
        }
    }
    _MapDrop(_fsShieldDown, hwnd)
}

; Full unwind, for the one-shot janitors (early-cloak release, overlay sweep,
; popup closer, exit). Safe to call on ANY window, ledger entry or not.
;
; Was ledger-driven and bailed on `!_fsAlphaApplied.Has(hwnd)` -- so the exact
; window that most needs rescuing (one stranded transparent by a previous
; instance, whose ledger entry does not exist) was the one it refused to touch.
; The overlay-visibility enforcement depends on this working from a cold
; ledger, so it is now driven by the window's real state.
_RemoveFSAlphaShield(hwnd) {
    global _fsAlphaApplied, _fsShieldDown, _fsAlphaConcealed
    ; ── DELIBERATE CONCEALMENT IS NOT A LEFTOVER SHIELD ─────────────────────
    ; This function strips WS_EX_LAYERED and restores full opacity. It reads
    ; _fsAlphaApplied and _fsShieldDown -- the flicker-shield ledgers -- and
    ; knows nothing about _fsAlphaConcealed, which is the hold that keeps
    ; Firestone Main invisible-but-composited. Twelve callers reach it,
    ; including two inside _FSSuppressSurface itself.
    ;
    ; Measured 2026-09-06: Main was alpha 0 at birth and read alpha=- (not
    ; layered at all) 400ms later, then stayed that way until it died. This is
    ; what removed it. The conceal never re-ran to repair it, so Main spent its
    ; whole life hidden with no taskbar button.
    ;
    ; F3 is unaffected: the reveal calls _FSRevealAllAlpha first, which restores
    ; opacity and empties this ledger, so by the time anything reaches here on a
    ; reveal there is nothing left to protect.
    if _fsAlphaConcealed.Has(hwnd)
        return
    _MapDrop(_fsShieldDown, hwnd)
    ownedByUs := (_fsAlphaApplied.Has(hwnd) && !_fsAlphaApplied[hwnd])
    _MapDrop(_fsAlphaApplied, hwnd)
    _EnableDWMTransitions(hwnd)
    try {
        static GWL_EXSTYLE := -20, WS_EX_LAYERED := 0x80000, LWA_ALPHA := 0x2
        fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
        fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"

        a := 255
        st := _FSLayeredAlphaState(hwnd, &a)
        if (st = 0)
            return          ; per-pixel (Overwolf's own): never touch

        ; ALWAYS restore opacity first if it is dimmed -- this is the part that
        ; must work even with no ledger entry.
        if (st = 1 && a < 255) {
            DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd
                , "UInt", 0, "UChar", 255, "UInt", LWA_ALPHA)
        }

        ; Only strip the STYLE for a window we know we made layered. Removing
        ; it from someone else's window is the mode-switch hazard the apply
        ; side is careful to avoid; a layered window at alpha 255 renders
        ; completely normally, so leaving the style on costs nothing.
        if (ownedByUs && st = 1) {
            ex := DllCall(fnGet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr")
            DllCall(fnSet, "Ptr", hwnd, "Int", GWL_EXSTYLE, "Ptr", ex & ~WS_EX_LAYERED)
            DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
                , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                , "UInt", 0x0001 | 0x0002 | 0x0004 | 0x0010 | 0x0020)
        }
    }
}

; ── IME / TSF filter ──────────────────────────────────────────────────────────
; Centralized filter for Windows IME/TSF helper windows that must never be
; touched by any window‑management API.
IsIMEWindow(hwnd) {
    try {
        ; Renamed from `class`: that is a language keyword in AutoHotkey v2 and
        ; using it as a variable is asking the parser for trouble for no gain.
        cls := WinGetClass("ahk_id " . hwnd)
        if (cls = "")
            return false

        if (cls = "IME"
         || cls = "MSCTFIME UI"
         || cls = "Default IME"
         || cls = "CicMarshalWnd"
         || cls = "CicMarshalWndClass"
         || cls = "CicLoaderWndClass"
         || cls = "CiceroUIWndFrame"
         || cls = "CUAS_MainWnd"
         || cls = "CUASMainWnd"
         || cls = "TSF_DimmItemWindow"
         || cls = "MSUIM.Win.Context"
         || cls = "MSUIM.Win.Client"
         || cls = "MSUIM.Win.TipConfig"
         || cls = "MSUIM.Win.TipBand"
         || cls = "UIAWnd")
            return true

        if (InStr(cls, "IME")
         || InStr(cls, "MSCTF")
         || InStr(cls, "Cicero")
         || InStr(cls, "CUAS")
         || SubStr(cls, 1, 10) = "MSUIM.Win.")
            return true
    } catch {
    }
    return false
}

; ── Battle.net window policy ──────────────────────────────────────────────────
; During an F2 launch the Battle.net LAUNCHER is never hidden: it appears
; normally (placed on the chosen monitor by the hook / first-show assists),
; renders unfocused for the render dwell, launches Hearthstone, and is
; minimized animation-free the instant Play fires (re-asserted at HS-PID)
; so the client's game-page navigation renders off-screen. Only SERVICE surfaces (boot splash / loading / maintenance /
; Agent) are SW_HIDDEN, by _HideBlizzWindow, for the blanket's lifetime
; (StartHSCloaker -> StopHSCloaker), the auto-login shell and login screens
; included -- LOGIN_WAIT un-hides the login windows when a human must type.
; Abort/exit restore what was hidden.
global _bnetPostMinUntil := 0
global _bnetPostMinCount := Map()   ; hwnd -> corrective minimizes performed

; ── Helper‑window immunity ───────────────────────────────────────────────────
; Infrastructure windows (Qt tray helper, tool windows) must NEVER be managed.
IsHelperWindow(hwnd) {
    try {
        ; GA_ROOTOWNER = 3, NOT GA_ROOT = 2.
        ;
        ; This test is documented in two places as "exempt anything OWNED by
        ; another window", and with GA_ROOT it never fired once: GA_ROOT walks
        ; the PARENT chain, and WinGetList only ever returns top-level windows,
        ; for which GetAncestor(h, GA_ROOT) is always h. GA_ROOTOWNER is the one
        ; that follows the OWNER chain and actually answers the question.
        ;
        ; The effect of the fix is uniformly to be GENTLER with owned Overwolf
        ; windows -- cloak-only instead of the cold park in _FSSuppressSurface,
        ; skipped instead of suppressed by the settled sweep, not moved by the
        ; monitor lock, not re-asserted at EV_SHOW. That is what the surrounding
        ; policy was written assuming, and an owned overlay panel is precisely
        ; the kind of window it was meant to keep hands off.
        if (DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 3, "Ptr") != hwnd)
            return true
        ex := 0
        try ex := WinGetExStyle("ahk_id " . hwnd)
        if (ex & 0x80)                             ; WS_EX_TOOLWINDOW
            return true
        t := ""
        try t := WinGetTitle("ahk_id " . hwnd)
        if (t = "QTrayIconMessageWindow" || t = "QEventDispatcherWin32_Internal_Widget"
         || t = "SystemTray_Main" || t = "MSCTFIME UI" || t = "Default IME")
            return true
    } catch {
        return true
    }
    return false
}

; ── Blizzard-family helper immunity, NARROWED ────────────────────────────────
; IsHelperWindow is deliberately broad: it exempts anything OWNED by another
; window and anything carrying WS_EX_TOOLWINDOW. For Overwolf that is right --
; those really are infrastructure. For the Battle.net family it is exactly
; wrong, because the surfaces the services blanket exists to suppress ARE owned
; dialogs: the maintenance alert, service-outage notices, update prompts. Every
; Blizzard sweep called IsHelperWindow and hit `continue` on them, so the one
; class of window most worth hiding was the one class guaranteed to be skipped.
; That is the same shape as the Firestone notification-popup exemption bug --
; a broad immunity rule swallowing the thing it was supposed to catch.
;
; This is the narrowed version used by the Blizzard sweeps. It exempts only
; windows with no visible surface to suppress in the first place:
;   * IME / TSF windows            -- managing them breaks text input
;   * known Qt infrastructure      -- tray sink, event dispatcher
;   * message-only windows         -- parented to HWND_MESSAGE, never composited
;   * degenerate rectangles        -- 1x1 and smaller sinks
; Anything with real pixels on a real monitor is the blanket's business,
; ownership and tool-window style notwithstanding.
_IsBlizzInfrastructureWindow(hwnd) {
    try {
        if IsIMEWindow(hwnd)
            return true

        t := ""
        try t := WinGetTitle("ahk_id " . hwnd)
        if (t = "QTrayIconMessageWindow" || t = "QEventDispatcherWin32_Internal_Widget"
         || t = "SystemTray_Main" || t = "MSCTFIME UI" || t = "Default IME")
            return true

        ; Message-only windows are parented to HWND_MESSAGE rather than to the
        ; desktop. They are never composited, so there is nothing to conceal --
        ; and SW_HIDE on one is a pointless poke at another process's plumbing.
        par  := DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 1, "Ptr")   ; GA_PARENT
        desk := DllCall("user32\GetDesktopWindow", "Ptr")
        if (par && desk && par != desk)
            return true

        rc := Buffer(16, 0)
        if DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc) {
            w := NumGet(rc,  8, "Int") - NumGet(rc, 0, "Int")
            h := NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")
            if (w <= 1 || h <= 1)
                return true
        }
    } catch {
        return true            ; unreadable window: leave it alone
    }
    return false
}

; Janitor: if a "QTrayIconMessageWindow" is ever VISIBLE, hide it again and log.
global _qtHelperLogged := Map()
QtHelperJanitor() {
    global _qtHelperLogged, CFG
    prevMode := A_TitleMatchMode
    SetTitleMatchMode(3)
    try {
        for h in WinGetList("QTrayIconMessageWindow") {
            try {
                if !DllCall("user32\IsWindowVisible", "Ptr", h)
                    continue
                exe := ""
                try exe := WinGetProcessName("ahk_id " . h)
                n := _qtHelperLogged.Get(h, 0)
                if (n = 0 && CFG.f1DebugLog)
                    try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss")
                        . " QT-HELPER visible owner=" . exe
                        . " hwnd=" . h . " -> re-hidden`n"
                        , _LogPath())
                if (n >= 3)
                    continue
                _qtHelperLogged[h] := n + 1
                WinHide("ahk_id " . h)
            }
        }
    }
    SetTitleMatchMode prevMode
}

; Minimize the way a human does: SC_MINIMIZE, with the shell's animation.
;
; _MinimizeWindowNoAnim below exists for a specific reason -- an animated
; minimize of a CLOAKED window composites as a solid black rectangle
; collapsing into the taskbar, which is why every Firestone and Hearthstone
; minimize in this script is animation-free.
;
; The Battle.net launcher is NOT cloaked when it minimizes; it was uncloaked
; seconds earlier, at the end of the navigation. So the reason does not apply
; to it, and suppressing the animation just made the window vanish -- "almost
; like its hidden and just put into minimization". This sends the same
; WM_SYSCOMMAND the minimize button sends, so the launcher animates into the
; taskbar exactly as if it had been clicked.
;
; DWM transitions are re-enabled first: they are force-disabled during the
; navigation cloak (so the uncloak does not fade in) and, while that attribute
; is set, DWM draws no minimize animation either. The scheduled restore
; normally beats this by several seconds; calling it here as well makes the
; animation independent of that timing.
_MinimizeWindowAnimated(hwnd) {
    static WM_SYSCOMMAND := 0x0112, SC_MINIMIZE := 0xF020
    try _EnableDWMTransitions(hwnd)
    try {
        PostMessage(WM_SYSCOMMAND, SC_MINIMIZE, 0, , "ahk_id " . hwnd)
        return true
    }
    ; Fallback for a client that ignores SC_MINIMIZE: SW_MINIMIZE still
    ; animates, it just also activates the next window in the z-order.
    try return DllCall("ShowWindow", "Ptr", hwnd, "Int", 6) != 0
    return false
}

; Minimize with no animation and no activation. Preserves the restore rect.
; ── EVERY MINIMISE NAMES ITS CALLER ──────────────────────────────────────────
; "minimise" on its own in a window trace says an operation happened and not
; who asked for it, which is the difference between knowing a window was
; minimised twice in five seconds and knowing WHICH TWO pieces of this file did
; it. Seven call sites reach here; the reason costs a string literal at each.
_MinimizeWindowNoAnim(hwnd, why := "unlabelled") {
    global _fsAlphaConcealed
    _FSTraceNote(hwnd, "minimise <- " . why)
    ; Refused ONLY while Main is held at alpha 0. A minimised window composites
    ; nothing and the renderer eventually discards it, which is the documented
    ; failure of the "minimize" conceal policy.
    ;
    ; NOT a blanket ban: once F3 has freed Main, _fsAlphaConcealed no longer
    ; holds it and _FSPostFreeConceal minimises it deliberately -- "from here it
    ; is minimise and restore, never hidden again". That path must keep working.
    if _fsAlphaConcealed.Has(hwnd) {
        _FSTraceNote(hwnd, "minimise REFUSED -- held at alpha 0, not freed yet")
        return false
    }
    wp := Buffer(44, 0)
    NumPut("UInt", 44, wp, 0)
    if !DllCall("user32\GetWindowPlacement", "Ptr", hwnd, "Ptr", wp)
        return false
    NumPut("UInt", 7, wp, 8)                        ; showCmd = SW_SHOWMINNOACTIVE
    return DllCall("user32\SetWindowPlacement", "Ptr", hwnd, "Ptr", wp) != 0
}

; ── Battle.net reveal / minimize lifecycle ────────────────────────────────────
; The launcher is NEVER hidden. The lifecycle is now:
;
;   RevealBNetForRender()    "LAUNCHER READY" (first call only): stamps
;                            _bnetRevealedAt -- the render dwell AND the
;                            launch gate (TryLaunchWTCG) both measure from
;                            it -- un-hides anything the blanket caught
;                            that is really the client, and puts a
;                            minimized client on screen WITHOUT taking
;                            focus (no activation, no active-window
;                            highlight). Later calls are no-ops, so it is
;                            safe as a janitor.
;   RevealBNetWindows(min)   Public entry used by every call site; if min is
;                            true it hands off to the dwell-aware minimize.
;   MinimizeBNetAfterDwell() Waits out whatever remains of
;                            CFG.bnetRevealDwellMs so the launcher is fully
;                            painted, then minimizes it animation-free and
;                            starts the post-launch minimize watchdog.
;                            Called at Play-fire (primary; the linger knob
;                            can delay it) and again the moment HS's
;                            PROCESS exists (backstop).
;   RestoreHiddenBNetServices()  Abort/exit janitor: re-shows every service
;                            window the blanket took off the screen (a
;                            stalled launch may be stalled BECAUSE of a
;                            maintenance surface the user needs to see).
;   UnhideBNetLoginWindows() LOGIN_WAIT janitor: un-hides ONLY the login /
;                            auth windows the blanket hid. Auto-login stays
;                            invisible; a human who must type gets the
;                            screen back, placed and focused.
global _bnetRevealedAt := 0        ; TickCount of Battle.net's first revealed frame (0 = still hidden)
global _bnetLaunchFiredAt := 0     ; TickCount the WTCG launch command was
                                   ; fired (0 = not yet this launch). The
                                   ; launch fires only AFTER the launcher is
                                   ; revealed and dwelled, so HS can never
                                   ; open before the launcher is on screen.
global _bnetHiddenByUs := Map()    ; hwnd -> true: the blanket SW_HIDE'd this
                                   ; window while it was VISIBLE — the only
                                   ; windows the reveal / cleanup may WinShow
global _bnetLauncherHwnd := 0      ; the EXACT launcher hwnd the reveal has
                                   ; shown. Identity beats predicates: once
                                   ; set, nothing may hide this window again.
global _bnetHideDone := Map()      ; hwnd -> we have already hidden (and, for
                                   ; the launcher, minimized) this window.
                                   ; Stops the blanket from re-issuing
                                   ; SetWindowPlacement every 10ms tick --
                                   ; the "launcher fighting itself" storm.
global _bnetLauncherStaged := false ; true once the ready-reveal has restored
                                   ; the launcher on screen -- from then on
                                   ; the hide path leaves it alone so it can
                                   ; render, launch HS, and minimize
global _bnetLoginAllowed := false  ; true while the pipeline is in LOGIN_WAIT:
                                   ; the Battle.net.exe half of the services
                                   ; blanket stands down COMPLETELY so a human
                                   ; can see and type into the login screen
                                   ; (and any authenticator popup it spawns)
global _smLastTick := 0            ; heartbeat: TickCount of the last
                                   ; LaunchStateMachine_Tick run. Lets F2
                                   ; detect a DEAD (vs busy) pipeline and
                                   ; self-heal instead of blocking forever.
global _bnetPostMinDone := false   ; one-shot: the post-launch minimize already
                                   ; ran for this F2 (HAMMERING sets it the
                                   ; moment HS's process exists)

; ── Launcher foreground pin ──────────────────────────────────────────────────
; The launcher's whole job is to be looked at: it comes up, navigates to the
; Hearthstone page, presses Play, and goes away. Opening it into whatever slot
; the z-order happens to offer means that on a desktop with anything already
; open it launches the game from behind a browser window. This gives it the
; same treatment F3 gives Firestone Main and Battlegrounds -- HWND_TOPMOST plus
; an activate -- so it is unambiguously in front for the few seconds it exists.
;
; TOPMOST rather than a plain raise, for the same reason F3 uses it: a plain
; SetForegroundWindow is subject to Windows' foreground-lock rules and loses to
; a fullscreen window, which is precisely the situation this runs in.
;
; ONE-SHOT per hwnd. RevealBNetForRender doubles as a janitor and is called
; repeatedly; repeating the activate on every call is the "hundreds of z-order
; changes and activations" pattern that killed Firestone Main under F3 spam.
;
; NEVER while Hearthstone exists. A borderless Unity window that loses the
; foreground re-runs its display-mode setup and snaps to its remembered
; monitor -- the "HS flickered to primary monitor" regression. Once the game is
; up, the foreground is its property and this stays out of it.
global _bnetFgPinned := Map()
_BNetPinForeground(hwnd) {
    global CFG, _bnetFgPinned
    if (!CFG.bnetRevealForeground || _bnetFgPinned.Has(hwnd))
        return
    if GetHSPID()
        return
    _bnetFgPinned[hwnd] := true
    try {
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -1      ; HWND_TOPMOST
            , "Int", 0, "Int", 0, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0002 | 0x0010)                    ; NOSIZE|NOMOVE|NOACTIVATE
        WinActivate("ahk_id " . hwnd)
        _FSLog("BNET-FG launcher pinned topmost and activated hwnd=" . hwnd)
    }
}

; Release the pin. Called from the minimize path and from the Hearthstone
; reveal, whichever happens first.
;
; A topmost window that minimizes keeps the flag, so a launcher the user later
; restores by hand would sit over the game forever. And if the minimize is late
; -- a slow client, a retry -- the pin would otherwise put the launcher over a
; game that has already been revealed. Both are one SetWindowPos to prevent.
_BNetDropTopmost(hwnd := 0) {
    global _bnetFgPinned
    if hwnd {
        targets := [hwnd]
    } else {
        targets := []
        for h in _bnetFgPinned
            targets.Push(h)
    }
    for h in targets {
        try {
            if DllCall("user32\IsWindow", "Ptr", h)
                DllCall("user32\SetWindowPos", "Ptr", h, "Ptr", -2  ; HWND_NOTOPMOST
                    , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                    , "UInt", 0x0001 | 0x0002 | 0x0010)
        }
        ; The ledger records the pin we are CURRENTLY holding, not one we once
        ; held. Releasing has to clear it, or an F2 restart that reuses the
        ; running launcher finds a stale entry, treats the window as already
        ; pinned, and brings it back behind everything -- the exact bug this
        ; whole block exists to prevent. Entry removed even when the window is
        ; already dead, so the map cannot grow across restarts.
        try _bnetFgPinned.Delete(h)
    }
}

RevealBNetForRender() {
    global _bnetRevealedAt, _bnetLauncherStaged, ChosenMonIdx, _bnetLauncherHwnd
    global _bnetHiddenByUs, _bnetHideDone, CFG
    ; Since the launcher is never hidden, this function now only positions
    ; the real client window on the chosen monitor (if not already there).
    ; The un‑hide / rescue sweep is removed because it is no longer needed.

    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        _bnetLauncherStaged := true
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if IsHelperWindow(hwnd)
                    continue
                if !_IsProtectedBNetMain(hwnd)
                    continue

                ; --- UN-HIDE BACKSTOP -------------------------------------
                ; This function was rewritten under the assumption that the
                ; launcher is never hidden, and its rescue sweep was deleted.
                ; That assumption does not hold on builds where the client is
                ; unidentifiable at birth: the blanket hides it before anyone
                ; can tell what it is. The reveal is the stage whose entire
                ; job is to put the launcher on screen, so it must be able to
                ; undo that. Layer 3 of 3 (identify at birth -> reclaim at
                ; 10ms -> guarantee here).
                if (_bnetHiddenByUs.Has(hwnd) || _bnetHideDone.Has(hwnd)
                 || !DllCall("user32\IsWindowVisible", "Ptr", hwnd)) {
                    ; _MapDrop, NOT .Delete. The third disjunct above enters
                    ; this block for a window that is merely INVISIBLE and in
                    ; neither ledger -- Battle.net closed to the tray, started
                    ; minimized, or left hidden by a killed instance -- and
                    ; Map.Delete on an absent key throws in v2. The enclosing
                    ; try has no catch, so the throw silently abandoned the
                    ; rest of this window's body: no uncloak, no ShowWindow, no
                    ; placement, and _bnetLauncherHwnd never assigned. This is
                    ; the reveal's own "Layer 3 of 3 -- guarantee here", and it
                    ; was dead in exactly the configuration it names.
                    _MapDrop(_bnetHiddenByUs, hwnd)
                    _MapDrop(_bnetHideDone, hwnd)
                    try UncloakWindow(hwnd, false, "RevealBNetForRender")
                    if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                        DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
                }

                ; --- CENTER IT (if not already on the chosen monitor) ---
                ; The window is visible, but we move it only once and while
                ; it is already visible; to avoid a visible jump we use the
                ; same cloak‑wrap that _PlaceBlizzWindowNow uses.
                if ChosenMonIdx {
                    try {
                        rc := Buffer(16, 0)
                        if DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc) {
                            bx := NumGet(rc, 0, "Int"), by := NumGet(rc, 4, "Int")
                            bw := NumGet(rc,  8, "Int") - bx
                            bh := NumGet(rc, 12, "Int") - by
                            ; Only move if not already on chosen monitor
                            if (GetMonitorIndexForPoint(bx + bw // 2, by + bh // 2) != ChosenMonIdx) {
                                _SafeWorkArea(ChosenMonIdx, &rL, &rT, &rR, &rB)
                                rW := rR - rL, rH := rB - rT
                                if (bw < 200 || bw > rW)
                                    bw := Min(rW, 1200)
                                if (bh < 150 || bh > rH)
                                    bh := Min(rH, 800)
                                px := rL + (rW - bw) // 2
                                py := rT + (rH - bh) // 2
                                ; Cloak to hide the move, then move, then uncloak
                                global _cloakState
                                wasCloaked := _cloakState.Has(hwnd)
                                if !wasCloaked
                                    CloakWindow(hwnd, false, "RevealBNetForRender")
                                DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
                                    , "Int", px, "Int", py, "Int", bw, "Int", bh
                                    , "UInt", 0x0004 | 0x0010)   ; NOZORDER|NOACTIVATE
                                if !wasCloaked {
                                    Sleep(15)
                                    UncloakWindow(hwnd, false, "RevealBNetForRender")
                                }
                            }
                        }
                    }
                }

                ; IDENTITY: from here on, this exact hwnd is the launcher and
                ; nothing may hide it again (see _HideBlizzWindow).
                _bnetLauncherHwnd := hwnd

                ; Last step, and it depends on the mode.
                ;
                ; "visible": put it in front. Done last so the pin lands on a
                ; window that is already un-hidden and already on the chosen
                ; monitor -- pinning first would raise a window about to move.
                ;
                ; "minimized": put it away instead, animation-free and without
                ; activation, before it has drawn a frame anyone will see. The
                ; launch command does not care whether the client is visible,
                ; so nothing else in the sequence changes.
                if (CFG.bnetLauncherMode = "minimized") {
                    _MinimizeWindowNoAnim(hwnd, "Battle.net render reveal")
                    _FSLog("BNET-SEQ launcher mode=minimized -- tucked away"
                         . " without being shown")
                } else {
                    _BNetPinForeground(hwnd)
                }
            }
        }
    }
    DetectHiddenWindows prev
}

; Has the launcher finished arriving, as opposed to merely existing?
;
; Deliberately shape-based rather than timed. "Visible, not minimised, and
; bigger than the placeholder rect a CEF window starts with" is evidence; a
; stopwatch is a guess, and it is wrong on exactly the machines that most need
; it to be right.
_BNetLauncherLooksReady() {
    prev  := A_DetectHiddenWindows
    DetectHiddenWindows true
    ready := false
    try {
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if _IsBlizzInfrastructureWindow(hwnd)
                    continue
                if !_IsProtectedBNetMain(hwnd)
                    continue
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue
                w := 0, h := 0
                WinGetPos(, , &w, &h, "ahk_id " . hwnd)
                if (w >= 700 && h >= 400) {
                    ready := true
                    break
                }
            }
        }
    }
    DetectHiddenWindows prev
    return ready
}

; Public entry (unchanged signature). See the lifecycle note above.
RevealBNetWindows(minimizeMain := false) {
    RevealBNetForRender()
    if minimizeMain
        MinimizeBNetAfterDwell()
}

; Abort/exit janitor: bring back every Battle.net-family window the services
; blanket took off the screen. A stalled launch may be stalled BECAUSE of a
; maintenance/update surface the user needs to see.
RestoreHiddenBNetServices() {
    global _bnetHiddenByUs
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    for hwnd in _bnetHiddenByUs.Clone() {
        try {
            _bnetHiddenByUs.Delete(hwnd)
            if DllCall("user32\IsWindow", "Ptr", hwnd) {
                try UncloakWindow(hwnd, false, "RestoreHiddenBNetServices")
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
            }
        }
    }
    DetectHiddenWindows prev
}

; LOGIN_WAIT janitor: bring back ONLY the login/auth windows the blanket hid,
; place them, and put focus on the first so the user can type at once.
; _bnetLoginAllowed must already be true, or the 10ms blanket re-hides them.
UnhideBNetLoginWindows() {
    global _bnetHiddenByUs, _bnetHideDone
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    focused := false
    ; Scan EVERY Battle.net window (hidden included), not just our ledger: the
    ; blanket now hides unconditionally, so a login window born hidden would
    ; never appear in the ledger and could never be restored -> unable to log
    ; in. Enumerating the process guarantees we find it however it was hidden.
    for hwnd in WinGetList("ahk_exe Battle.net.exe") {
        try {
            if IsHelperWindow(hwnd)
                continue
            t := StrLower(WinGetTitle("ahk_id " . hwnd))
            if (InStr(t, "log in") || InStr(t, "sign in") || InStr(t, "battle.net login")) {
                if _bnetHiddenByUs.Has(hwnd)
                    _bnetHiddenByUs.Delete(hwnd)
                if _bnetHideDone.Has(hwnd)
                    _bnetHideDone.Delete(hwnd)
                try UncloakWindow(hwnd, false, "UnhideBNetLoginWindows")
                _PlaceBlizzWindowNow(hwnd)
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    DllCall("ShowWindow", "Ptr", hwnd, "Int", 9)   ; SW_RESTORE
                else
                    DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)   ; SW_SHOWNA
                if !focused {
                    try WinActivate("ahk_id " . hwnd)
                    focused := true
                }
            }
        }
    }
    DetectHiddenWindows prev
}

; ══════════════════════════════════════════════════════════════════════════════
; LAUNCHER MINIMISE -- anchored to Hearthstone, not to a stopwatch
; ══════════════════════════════════════════════════════════════════════════════
; The rule, stated plainly:
;
;     open -> launch Hearthstone -> once Hearthstone has launched,
;     wait a beat -> minimise.
;
; The middle clause is the important one. Guessing how long Battle.net takes
; to spawn the game makes the sequence depend on disk speed, pending patches
; and login latency; waiting for the event does not.
;
; One timer owns the decision, armed the instant the launcher becomes
; visible:
;
;   * the launcher must have been visible for bnetRevealDwellMs (never
;     flashes away),
;   * Hearthstone.exe must exist (it has launched),
;   * bnetPostPlayLingerMs must have elapsed since then (the beat),
;   * or bnetMinimizeCeilingMs, if Hearthstone never arrives (never stuck).
;
; Other code may request a minimise -- the request is idempotent -- but
; nothing else sets the timing.
; The Play command's timestamp, kept SEPARATE from _bnetLaunchFiredAt.
;
; Both are stamped at the same instant, but _bnetLaunchFiredAt is cleared by
; CancelLaunchTimers -- which runs on six paths including the SUCCESS ones --
; and the minimize and the stall watch both measure from this moment. Reusing a
; value someone else resets would make the launcher's exit depend on which
; teardown happened to run first. This one belongs to the minimize sequence and
; nothing else writes it.
global _bnetPlayFiredAt := 0

; The moment the launcher became USABLE, as opposed to merely existing.
;
; Every visible interval in the sequence is measured from here, which is what
; makes the sequence take the same time on a cold start as on a warm one. Reset
; per launch by StartBNetMinimizeSequence.
global _bnetReadyAt := 0
                               ; AFTER the launcher became visible
global _bnetMinSeqUntil := 0   ; ceiling for the sequence (0 = not running)

StartBNetMinimizeSequence() {
    global _bnetMinSeqUntil, _bnetPlayFiredAt, _bnetReadyAt, CFG
    ; Clear the anchor for THIS sequence. The predecessor this replaced was
    ; reset here; without the same reset, a second F2 in one session starts a
    ; sequence still holding the PREVIOUS launch's timestamp -- already older
    ; than the linger -- and the tick would minimize a launcher that has not
    ; pressed Play yet. Stage 3 of TryLaunchWTCG re-stamps it for real.
    _bnetPlayFiredAt := 0
    _bnetReadyAt     := 0
    _bnetMinSeqUntil := A_TickCount + CFG.bnetMinimizeCeilingMs
    SetTimer(BNetMinimizeSequenceTick, 200)
}

StopBNetMinimizeSequence() {
    global _bnetMinSeqUntil
    _bnetMinSeqUntil := 0
    SetTimer(BNetMinimizeSequenceTick, 0)
}

BNetMinimizeSequenceTick() {
    global CFG, _bnetRevealedAt, _bnetPostMinDone, _bnetPlayFiredAt, _bnetMinSeqUntil
    global _bnetReadyAt

    if (_bnetPostMinDone || !_bnetRevealedAt || !_bnetMinSeqUntil) {
        StopBNetMinimizeSequence()
        return
    }
    ; The launcher must actually have been looked at before it goes away --
    ; unless it was never shown, in which case there is nothing to look at and
    ; the floor is zero. That is the whole difference the "minimized" mode
    ; makes to this timer.
    ; Same anchor as the scheduled minimize, so the backstop can never
    ; disagree with it about when the launcher is due to go.
    dwell := (CFG.bnetLauncherMode = "minimized") ? 0 : CFG.bnetRevealDwellMs
    if (_bnetReadyAt && (A_TickCount - _bnetReadyAt) < dwell)
        return

    ; Ceiling: the launch command never fired at all. Minimize anyway rather
    ; than leaving the launcher sitting on screen forever, and say so.
    if (A_TickCount >= _bnetMinSeqUntil) {
        _FSLog("BNET-SEQ ceiling reached after "
             . (A_TickCount - _bnetRevealedAt) . "ms -- minimizing the launcher"
             . " anyway")
        _BNetSequenceMinimizeNow()
        return
    }

    ; ══════════════════════════════════════════════════════════════════════
    ; THE ANCHOR IS THE PLAY COMMAND, NOT HEARTHSTONE'S PROCESS
    ; ══════════════════════════════════════════════════════════════════════
    ; This used to wait for Hearthstone to exist and then linger. That put the
    ; launcher on screen for the whole of Hearthstone's start-up, and produced
    ; the sequence the user did not want: launcher, then game, then the
    ; launcher tidying itself away over the top of the game.
    ;
    ; Anchoring on the launch command instead means the launcher is already
    ; gone by the time the game's window appears, so the game arrives to an
    ; empty screen and takes the foreground uncontested. The launcher's job
    ; ended when it fired the command; nothing about the minimize needs to know
    ; whether the game has started yet.
    ;
    ; What the game's absence DOES matter for is a stalled launch -- a pending
    ; update or a sign-in. That is a separate question with its own owner, the
    ; stall watch armed after the minimize. See BNetStallWatchTick.
    if !_bnetPlayFiredAt
        return
    if (A_TickCount - _bnetPlayFiredAt < CFG.bnetPostPlayLingerMs)
        return

    _FSLog("BNET-SEQ Play fired " . (A_TickCount - _bnetPlayFiredAt)
         . "ms ago -- minimizing the launcher now, ahead of the game window")
    _BNetSequenceMinimizeNow()
}

; ══════════════════════════════════════════════════════════════════════════════
;  F1 GUARD — keep the launcher down while the connection is blocked
; ══════════════════════════════════════════════════════════════════════════════
; Scoping the firewall rule to Hearthstone.exe (see _HSProgramScope) removes the
; CAUSE of the launcher surfacing during F1. This is the second line: Battle.net
; restores itself for its own reasons too -- a finished background download, a
; friend request, a notification -- and mid-combat is the worst possible moment
; for a window to appear over the game.
;
; Two hard rules, so this can never become the thing that fights the user:
;   * It only ever re-minimizes a launcher THIS SCRIPT already minimized
;     (_bnetPostMinDone). A launcher the user opened themselves is not ours.
;   * It stands down completely while the stall watch has deliberately put the
;     launcher on screen for an update or a sign-in.
; And it minimizes WITHOUT animation or activation, because F1 runs while the
; user is in combat: no shrink-to-taskbar animation, no focus change.
global _f1BNetGuardUntil := 0
global _f1BNetWasMinimized := Map()   ; hwnd -> was minimized when F1 started

; Snapshot which launcher windows are minimized RIGHT NOW, then watch only
; those. _bnetPostMinDone alone was too coarse a test: it stays true for the
; rest of the session after the first launch, so the guard would also
; re-minimize a launcher the user had opened themselves and was reading during
; the F1 window. Restoring a window this script minimized is what we undo;
; a window the user chose to have open is theirs.
StartF1BNetGuard(durationMs) {
    global _f1BNetGuardUntil, _f1BNetWasMinimized
    _f1BNetWasMinimized := Map()
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if _IsBlizzInfrastructureWindow(hwnd)
                    continue
                if !_IsProtectedBNetMain(hwnd)
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    _f1BNetWasMinimized[hwnd] := true
            }
        }
    }
    DetectHiddenWindows prev

    if !_f1BNetWasMinimized.Count
        return                    ; nothing was tucked away: nothing to protect
    _f1BNetGuardUntil := A_TickCount + durationMs
    SetTimer(F1BNetGuardTick, 250)
}

StopF1BNetGuard() {
    global _f1BNetGuardUntil, _f1BNetWasMinimized
    _f1BNetGuardUntil   := 0
    _f1BNetWasMinimized := Map()
    SetTimer(F1BNetGuardTick, 0)
}

F1BNetGuardTick() {
    global _f1BNetGuardUntil, _f1BNetWasMinimized, _bnetStallRevealed
    if (!_f1BNetGuardUntil || A_TickCount >= _f1BNetGuardUntil) {
        StopF1BNetGuard()
        return
    }
    if _bnetStallRevealed
        return                    ; the stall watch put it up on purpose
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in _f1BNetWasMinimized {
            try {
                if !DllCall("user32\IsWindow", "Ptr", hwnd)
                    continue
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue
                _FSLog("F1-GUARD the launcher restored itself during an F1"
                     . " block -- putting it back, silently")
                _MinimizeWindowNoAnim(hwnd, "F1 Battle.net guard")
            }
        }
    }
    DetectHiddenWindows prev
}

; ══════════════════════════════════════════════════════════════════════════════
;  STALLED-LAUNCH WATCH — update pending, or a sign-in the detector missed
; ══════════════════════════════════════════════════════════════════════════════
; The launcher now minimizes as soon as Play fires, without waiting to see
; whether the game actually starts. That is right in the normal case and wrong
; in exactly one: when Play could not start the game, because Battle.net is
; downloading a patch, or wants credentials, or is showing something that needs
; a human. Left alone the user would be staring at an empty desktop with a
; minimized launcher and no idea why nothing happened.
;
; So the launcher goes away optimistically and comes BACK if it turns out to
; have been needed. The test is the outcome, not the UI: no Hearthstone process
; within CFG.bnetStallRevealMs of the Play command means Play did not work.
; Reading Battle.net's own interface to find out why would mean matching
; localised text in a CEF surface, which breaks on every client update and in
; every language; the absence of a process does not.
;
; While waiting, the launch command is re-fired periodically. A download that
; finishes leaves a client where Play now works, and nothing else would ever
; press it -- TryLaunchWTCG fires exactly once per launch by design.
global _bnetStallWatchUntil := 0
global _bnetStallRevealed   := false
global _bnetStallLastRetry  := 0

StartBNetStallWatch() {
    global _bnetStallWatchUntil, _bnetStallRevealed, _bnetStallLastRetry, CFG
    _bnetStallWatchUntil := A_TickCount + CFG.bnetStallWatchMaxMs
    _bnetStallRevealed   := false
    _bnetStallLastRetry  := A_TickCount
    SetTimer(BNetStallWatchTick, 1000)
}

StopBNetStallWatch() {
    global _bnetStallWatchUntil
    _bnetStallWatchUntil := 0
    SetTimer(BNetStallWatchTick, 0)
}

BNetStallWatchTick() {
    global CFG, _bnetStallWatchUntil, _bnetStallRevealed, _bnetStallLastRetry
    global _bnetPlayFiredAt, _bnetLauncherHwnd

    if !_bnetStallWatchUntil {
        SetTimer(BNetStallWatchTick, 0)
        return
    }

    ; The game arrived. Whether it took two seconds or twenty minutes, the
    ; watch is done -- and if the launcher was brought back, put it away again.
    if GetHSPID() {
        if _bnetStallRevealed {
            _FSLog("BNET-STALL Hearthstone launched -- re-minimizing the launcher")
            try _BNetDropTopmost()
            try _BNetDwellMinimize()
        }
        StopBNetStallWatch()
        return
    }

    ; Battle.net itself is gone: nothing left to wait for.
    if !ProcessExist("Battle.net.exe") {
        StopBNetStallWatch()
        return
    }

    if (A_TickCount >= _bnetStallWatchUntil) {
        _FSLog("BNET-STALL giving up after " . CFG.bnetStallWatchMaxMs . "ms")
        StopBNetStallWatch()
        return
    }

    waited := _bnetPlayFiredAt ? (A_TickCount - _bnetPlayFiredAt) : 0
    if (waited < CFG.bnetStallRevealMs)
        return

    ; ---- Bring the launcher back, once ----
    if !_bnetStallRevealed {
        _bnetStallRevealed := true
        _FSLog("BNET-STALL no Hearthstone " . waited . "ms after Play"
             . " -- restoring the launcher so the user can see what it wants"
             . " (update or sign-in)")
        try RestoreHiddenBNetServices()   ; the reason may BE a hidden surface
        try {
            prev := A_DetectHiddenWindows
            DetectHiddenWindows true
            for hwnd in WinGetList("ahk_exe Battle.net.exe") {
                try {
                    if _IsBlizzInfrastructureWindow(hwnd)
                        continue
                    if !_IsProtectedBNetMain(hwnd)
                        continue
                    if (WinGetMinMax("ahk_id " . hwnd) = -1)
                        DllCall("ShowWindow", "Ptr", hwnd, "Int", 9)  ; SW_RESTORE
                    _bnetLauncherHwnd := hwnd
                    _BNetPinForeground(hwnd)
                }
            }
            DetectHiddenWindows prev
        }
        BgHUD.Show("Battle.net needs attention — update or sign-in", 6000)
        return
    }

    ; ---- Keep nudging Play while we wait ----
    if (A_TickCount - _bnetStallLastRetry >= CFG.bnetRelaunchEveryMs) {
        _bnetStallLastRetry := A_TickCount
        _FSLog("BNET-STALL re-firing the launch command")
        try LaunchWTCG()
    }
}

_BNetSequenceMinimizeNow() {
    ; Deliberately does NOT set _bnetPostMinDone itself. MinimizeBNetAfterDwell
    ; owns that flag and returns early if it is already set, so setting it here
    ; would make the call a no-op and the launcher would never minimize at all.
    ; One owner for the decision, one owner for the flag.
    ;
    ; The sequence timer is NOT stopped here either -- it is stopped by
    ; MinimizeBNetAfterDwell once the flag is set, and leaving it running until
    ; then means the verification below gets a second chance if the first
    ; attempt does not take.
    MinimizeBNetAfterDwell()
    SetTimer(_BNetVerifyMinimized, -400)
}

; Confirm the launcher actually ended up minimised, rather than assuming it.
;
; A SetWindowPlacement that does not take -- or a launcher that restores itself
; immediately afterwards, which this client does when a download finishes or a
; notification arrives -- is otherwise indistinguishable from success. Retries a
; few times and records the outcome either way.
_BNetVerifyMinimized() {
    static tries := 0
    ok := false, seen := false
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if IsHelperWindow(hwnd)
                    continue
                t := WinGetTitle("ahk_id " . hwnd)
                if !(t = "Battle.net" || t = "Blizzard Battle.net")
                    continue
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    continue
                seen := true
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    ok := true
                else
                    _MinimizeWindowAnimated(hwnd)
            }
        }
    }
    DetectHiddenWindows prev

    if (ok || !seen) {
        tries := 0
        _FSLog("BNET-SEQ minimize confirmed")
        return
    }
    tries++
    if (tries < 4) {
        SetTimer(_BNetVerifyMinimized, -500)
        return
    }
    tries := 0
    _FSLog("BNET-SEQ minimize did NOT take after 4 attempts"
         . " -- the launcher is refusing SetWindowPlacement or restoring itself")
}

; Minimise the launcher now. Idempotent.
;
; All timing lives in BNetMinimizeSequenceTick, the single owner of the
; question "when should the launcher go away". This function does not
; re-derive it: a second opinion on the same question is what makes the
; sequence unpredictable, since whichever caller arrives first would set the
; timing. _bnetPostMinDone makes a duplicate call a no-op.
MinimizeBNetAfterDwell() {
    global _bnetRevealedAt, _bnetLaunchFiredAt, CFG, _bnetPostMinDone
    ; NO TIMING LIVES HERE ANY MORE.
    ;
    ; This function used to re-derive "is it too early?" from wall-clock deltas,
    ; and its own header explained that four different call sites could reach it
    ; and whichever arrived first won. That is precisely the problem
    ; BNetMinimizeSequenceTick now owns, so re-deriving it here would just
    ; reintroduce a second opinion.
    ;
    ; It is now a plain, idempotent "minimize the launcher, now". The sequence
    ; calls it when its conditions are met; the abort and late-recovery paths
    ; call it because at that point the launcher genuinely should be tucked
    ; away. _bnetPostMinDone makes a duplicate call a no-op.
    if _bnetPostMinDone
        return
    _bnetPostMinDone := true
    StopBNetMinimizeSequence()
    _BNetDwellMinimize()
    ; The launcher went away without waiting to see whether the game starts.
    ; This is what notices if it should not have. Armed here because this
    ; function is the once-only owner of the minimize; _BNetDwellMinimize is
    ; also called BY the stall watch, and arming it there would re-arm itself.
    StartBNetStallWatch()
}

_BNetDwellMinimize() {
    global ChosenMonIdx
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if IsHelperWindow(hwnd)
                    continue
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    continue    ; hidden (e.g. the ledgered auto-login shell):
                                ; already off-screen; minimizing it would pop
                                ; a ghost taskbar button
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue
                title := WinGetTitle("ahk_id " . hwnd)
                if (title = "Battle.net" || title = "Blizzard Battle.net") {
                    ; Park the foreground before minimising, but only while Hearthstone does not
                    ; yet exist.
                    ;
                    ; Minimising the foreground launcher lets Windows hand the foreground to the
                    ; next eligible window, which before Hearthstone is running is the topmost
                    ; Firestone - Overlays -- and Overwolf answers that by restoring
                    ; Firestone - Main. Handing the foreground to the desktop shell first makes
                    ; the hand-off deterministic.
                    ;
                    ; Once Hearthstone exists the foreground belongs to it, and taking it away is
                    ; harmful: a borderless Unity window that loses the foreground re-runs its
                    ; display-mode setup and snaps to its remembered monitor.
                    if (!GetHSPID()
                     && DllCall("user32\GetForegroundWindow", "Ptr") = hwnd) {
                        shell := DllCall("user32\GetShellWindow", "Ptr")
                        if shell
                            try WinActivate("ahk_id " . shell)
                    }
                    ; MOVE-ONTO-CHOSEN-MONITOR, THEN MINIMIZE. Windows restores
                    ; a window to the monitor it was minimized FROM (the
                    ; minimize origin), NOT to rcNormalPosition -- so the only
                    ; reliable way to make it restore on the chosen monitor is
                    ; to have it PHYSICALLY THERE at minimize time. The launcher
                    ; is borderless, so moving it while visible is a silent
                    ; reposition. Move, confirm it landed, then minimize.
                    if (ChosenMonIdx) {
                        try {
                            WinGetPos(&mx, &my, &mw, &mh, "ahk_id " . hwnd)
                            if (mw > 0 && GetMonitorIndexForPoint(mx + mw // 2, my + mh // 2) != ChosenMonIdx) {
                                _SafeWorkArea(ChosenMonIdx, &mwaL, &mwaT, &mwaR, &mwaB)
                                mwW := mwaR - mwaL, mwH := mwaB - mwaT
                                nmx := (mw <= mwW) ? mwaL + (mwW - mw) // 2 : mwaL
                                nmy := (mh <= mwH) ? mwaT + (mwH - mh) // 2 : mwaT
                                WinMove(nmx, nmy, , , "ahk_id " . hwnd)
                                ; Confirm the move before minimizing -- see
                                ; _WaitWindowOnMonitor. Returns immediately once
                                ; the window is where it was asked to be.
                                _WaitWindowOnMonitor(hwnd, ChosenMonIdx, 150)
                            }
                        }
                    }
                    ; Release the foreground pin BEFORE minimizing. A topmost
                    ; window keeps the flag across a minimize, so a launcher
                    ; the user restores by hand later would come back floating
                    ; over the game.
                    _BNetDropTopmost(hwnd)
                    _MinimizeWindowAnimated(hwnd)   ; the launcher is not cloaked: let it animate
                }
            }
        }
    }
    DetectHiddenWindows prev
    ; Close any residual gap in the SAME thread turn as the minimize: one
    ; synchronous suppression pass re‑asserts FS‑Main's cloak and (verified)
    ; alpha shield before any Overwolf reaction can composite a frame.
    try SuppressFirestoneMainTick()
    StartBNetPostLaunchMinimize()
}

; Wait, briefly, for a window to actually BE on a monitor after being moved to it.
;
; A move is a request, not a fact. A Chromium-based launcher can reposition
; itself asynchronously after our SetWindowPos, and the caller's next action --
; a minimize -- is what records the restore origin. Windows restores a window to
; the monitor it was minimized FROM, so moving and minimizing in the same breath
; is exactly how the launcher comes back on the wrong screen.
;
; This replaces a flat Sleep(20) that only ever worked because AutoHotkey's
; default SetWinDelay was silently adding 100 ms on top of it. That default is
; off script-wide now -- it was costing far more elsewhere than it bought here
; -- so the wait that actually matters is written down and measured instead of
; inherited. It returns the instant the move is visible, so the normal case
; still costs nothing.
_WaitWindowOnMonitor(hwnd, monIdx, timeoutMs := 150) {
    if !monIdx
        return true
    deadline := A_TickCount + timeoutMs
    Loop {
        try {
            WinGetPos(&wmx, &wmy, &wmw, &wmh, "ahk_id " . hwnd)
            if (wmw > 0 && GetMonitorIndexForPoint(wmx + wmw // 2, wmy + wmh // 2) = monIdx)
                return true
        }
        if (A_TickCount >= deadline)
            return false
        Sleep(10)
    }
}

; ── HOW LONG THE LAUNCHER IS HELD DOWN AFTER THE GAME APPEARS ───────────────
;
; WAS 20 SECONDS, AND "BATTLE.NET PULLED ITSELF UP AGAIN" IS WHAT THAT BUYS.
;
; The window this guard exists for is not the launch -- the launch is already
; handled by the minimise sequence, which confirms its own result. This guard
; is for the launcher deciding, on its own, to restore itself AFTER the game
; is up: an update notice, a friends-list toast, a shop banner, or simply
; Battle.net's habit of raising itself when the game it launched finishes
; loading. On a cold start Hearthstone can still be loading twenty seconds
; after its window appears, so the old ceiling routinely expired BEFORE the
; moment it was written to cover.
;
; 120 seconds spans the whole of a cold load with room to spare. It is not
; unbounded, and it does not need to be, because the real protection against
; fighting a user who WANTS the launcher up is the per-window cap of three
; re-minimises in BNetPostLaunchMinimizeTick -- not the clock. After three the
; launcher stays wherever the user puts it, whether that is at second five or
; second ninety.
;
; The tick itself already exits early when Hearthstone is gone, so a session
; that ends before the ceiling costs nothing.
StartBNetPostLaunchMinimize(durationMs := 120000) {
    global _bnetPostMinUntil, _bnetPostMinCount
    _bnetPostMinUntil := A_TickCount + durationMs
    _bnetPostMinCount := Map()
    SetTimer(BNetPostLaunchMinimizeTick, 500)
    BNetPostLaunchMinimizeTick()
}

StopBNetPostLaunchMinimize() {
    global _bnetPostMinUntil
    _bnetPostMinUntil := 0
    SetTimer(BNetPostLaunchMinimizeTick, 0)
}

BNetPostLaunchMinimizeTick() {
    global _bnetPostMinUntil, _bnetPostMinCount, _placeCreateSeen, ChosenMonIdx

    if (!ProcessExist("Hearthstone.exe") || A_TickCount >= _bnetPostMinUntil) {
        StopBNetPostLaunchMinimize()
        return
    }

    try {
        for hwnd in WinGetList("ahk_exe Battle.net.exe") {
            try {
                if IsHelperWindow(hwnd)
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue
                WinGetPos(, , &w, &h, "ahk_id " . hwnd)
                if (w < 200 || h < 150)
                    continue
                if (_placeCreateSeen.Has(hwnd)
                 && (A_TickCount - _placeCreateSeen[hwnd] < 4000))
                    continue
                if (_bnetPostMinCount.Get(hwnd, 0) >= 3)
                    continue
                _bnetPostMinCount[hwnd] := _bnetPostMinCount.Get(hwnd, 0) + 1
                ; Move onto the chosen monitor (if the launcher got restored
                ; off it between ticks), then minimize -- so it restores THERE.
                ; The watchdog only fires when the launcher is un-minimized, so
                ; a visible borderless move is a silent reposition.
                if (ChosenMonIdx) {
                    try {
                        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
                        if (ww > 0 && GetMonitorIndexForPoint(wx + ww // 2, wy + wh // 2) != ChosenMonIdx) {
                            _SafeWorkArea(ChosenMonIdx, &wwaL, &wwaT, &wwaR, &wwaB)
                            wwW := wwaR - wwaL, wwH := wwaB - wwaT
                            nwx := (ww <= wwW) ? wwaL + (wwW - ww) // 2 : wwaL
                            nwy := (wh <= wwH) ? wwaT + (wwH - wh) // 2 : wwaT
                            WinMove(nwx, nwy, , , "ahk_id " . hwnd)
                            _WaitWindowOnMonitor(hwnd, ChosenMonIdx, 150)
                        }
                    }
                }
                _MinimizeWindowAnimated(hwnd)
            } catch {
            }
        }
    }
}

; ==============================================================================
; SECTION 11b: FIRESTONE OVERLAY TOPMOST ENFORCER
; ------------------------------------------------------------------------------
; Overwolf sometimes fails to promote "Firestone - Overlays" to TOPMOST.
; This watchdog forces it via SetWindowPos(HWND_TOPMOST) after launch completes.
; ==============================================================================

StartOverlayTopmostEnforcer() {
    SetTimer(OverlayTopmostTick, 2000)
    OverlayTopmostTick()
}

StopOverlayTopmostEnforcer() {
    SetTimer(OverlayTopmostTick, 0)
}

OverlayTopmostTick() {
    ; _fsAlphaApplied must be declared global here. In AutoHotkey v2 an
    ; undeclared name inside a function is a LOCAL, and reading an unset local
    ; throws -- inside the try below, which would swallow it and skip the rest of
    ; the per-window body, silently disabling this entire enforcer.
    global _fsAlphaApplied, _fsParked, _fsTabRemoved, _cloakState
    static HWND_TOPMOST   := -1
    static SWP_NOSIZE     := 0x0001
    static SWP_NOMOVE     := 0x0002
    static SWP_NOACTIVATE := 0x0010

    if !GetHSPID() {
        StopOverlayTopmostEnforcer()
        return
    }

    hsForeground := false
    hsForeground := _HSIsForeground()

    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(2)

    try {
        ; Scan OverwolfBrowser.exe as well: recent Overwolf builds host the in-game
        ; overlay in the browser process, so an Overwolf.exe-only scan finds nothing
        ; and this enforcer becomes a no-op on those installations.
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    title := WinGetTitle("ahk_id " . h)
                    ; Shape OR name. On the build in the logs the overlay is
                    ; titled "Firestone", so the exact-title test made this
                    ; entire enforcer a no-op for the whole session -- the
                    ; overlay was neither kept topmost nor released from the
                    ; birth cloak. See CFG.fsOverlayShapeDetect.
                    if !IsFirestoneInGameOverlay(h, title)
                        continue

                    if _fsAlphaApplied.Has(h)
                        _RemoveFSAlphaShield(h)

                    ; Release ONLY if something is actually holding this
                    ; window. _FSReleaseSurface unparks, restores the taskbar
                    ; button and force-uncloaks; running all three on the
                    ; overlay every two seconds -- when the overlay is almost
                    ; never parked, tab-stripped or cloaked -- was pure churn
                    ; against the one window that must stay rock steady while
                    ; the user has comps pinned to it.
                    if (_fsParked.Has(h) || _fsTabRemoved.Has(h)
                     || _cloakState.Has(h) || IsWindowCloakedDWM(h))
                        _FSReleaseSurface(h)

                    if !hsForeground
                        continue

                    ; "GetWindowLongPtr" is not an exported symbol -- the real exports are
                    ; GetWindowLongPtrW (64-bit) and GetWindowLongW (32-bit). Use the same
                    ; A_PtrSize branch as the rest of the script rather than relying on DllCall's
                    ; implicit "W" retry, which would fail outright on a 32-bit host.
                    fnGetLong := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
                    exStyle := DllCall(fnGetLong, "Ptr", h, "Int", -20, "Ptr")
                    if (exStyle & 0x00000008)   ; WS_EX_TOPMOST already set
                        continue

                    if !DllCall("user32\IsWindowVisible", "Ptr", h)
                        continue

                    ; ── AND THE PIN ITSELF IS OFF BY DEFAULT. HERE IS WHY. ──
                    ; THIS IS THE FIX FOR "HEARTHSTONE SOMETIMES DOES NOT GO
                    ; FULLSCREEN AND THE TASKBAR STAYS VISIBLE."
                    ;
                    ; This enforcer matched on the exact title
                    ; "Firestone - Overlays", which the current Firestone build
                    ; never uses -- so for this user it had NEVER ONCE FIRED.
                    ; Teaching it to recognise the overlay by shape fixed the
                    ; release half (which is what stopped comps un-pinning) and
                    ; simultaneously switched on a SetWindowPos that had been
                    ; dormant for the script's entire life.
                    ;
                    ; What it now does, every two seconds, is pin a 2560x1440
                    ; WS_EX_LAYERED window HWND_TOPMOST on the game's monitor.
                    ; A topmost layered window covering the display disqualifies
                    ; the game from the shell's fullscreen detection and from
                    ; DWM's independent-flip path -- so the taskbar stops
                    ; auto-hiding and sits on top of the game. Worse, the first
                    ; tick runs SYNCHRONOUSLY from CompleteHSLaunchSuccess, at
                    ; the exact moment Unity is standing up its swap chain.
                    ;
                    ; The RELEASE half above is the valuable half and it stays
                    ; unconditional. The pin was written for a failure nobody
                    ; here has observed -- Overwolf not promoting its own
                    ; overlay -- and it is not worth breaking fullscreen for.
                    ; Set fsOverlayEnforceTopmost := true to restore it.
                    if !CFG.fsOverlayEnforceTopmost
                        continue

                    DllCall("user32\SetWindowPos",
                        "Ptr",  h,
                        "Ptr",  HWND_TOPMOST,
                        "Int",  0,
                        "Int",  0,
                        "Int",  0,
                        "Int",  0,
                        "UInt", SWP_NOSIZE | SWP_NOMOVE | SWP_NOACTIVATE)
                } catch {
                }
            }
        }
    }

    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}

; ==============================================================================
; SECTION 11d: FIRESTONE‑MAIN REVEAL (F3 unlock) — stability‑hardened
; ------------------------------------------------------------------------------
; Reveals the Firestone main window when unlocked. Uses a watchdog tick to
; wait for the window to settle and avoid touching a half‑initialised Chromium
; surface.
global _fsRevealActive    := false
global _fsRevealUntil     := 0
global _fsRevealedMainAt  := 0
global _fsRevealSettleReq := 0
global _fsRevealFirstSeen := Map()
global _fsRevealDone      := Map()   ; hwnd -> one-shot reveal work done
global _fsRevealSettled   := Map()   ; hwnd -> its move has had a frame to
                                     ; itself; z-order work may proceed
global _fsRevealNudged    := Map()
; ── HOW LONG THE REVEAL WAITS BEFORE SHOWING A WINDOW DURING A LAUNCH ───────
;
; WAS 1000 MS, AND THAT IS "IT TAKES TOO LONG FOR FIRESTONE MAIN TO OPEN".
;
; The second existed to avoid "touching a half-initialised Chromium surface"
; -- a real hazard back when the reveal's job was to un-park and un-cloak a
; window that had been kept off the virtual desktop since birth and had
; therefore never composited. Restoring such a window really is delicate:
; there is no compositor yet, and prodding it is how it dies.
;
; That is no longer the situation for Main. It is concealed by minimising now
; (see _FSConcealMain), so the reveal is restoring a window that has a live
; compositor and a well-defined iconic state -- the same operation the user
; performs from the taskbar, which needs no settling period at all. The delay
; is now protecting against a condition that has been designed out, while
; being the single most visible cost of pressing F3 during a launch.
;
; Not zero: the reveal still moves windows and changes z-order, and giving the
; first move a frame of its own genuinely does stop the window appearing to
; jump into place. One or two frames is what that costs -- not sixty.
global _fsRevealSettleMs  := 120

; Gentle, crash‑safe repaint nudge for an Overwolf/Chromium surface.
; Atomic FS show: re-checks the lock the instant before showing. A re-lock
; (LockFirestoneMain -> StopFSReveal) can land AFTER the reveal loop's top
; guard but BEFORE this call; without the re-check the reveal would show a
; window the burst is simultaneously hiding -- the taskbar-ping war that
; ends with Firestone exiting. cmd is the SW_ verb (4/8/9). Returns whether
; it showed.
_GuardedFSShow(hwnd, cmd) {
    global State
    if State.fsMainLocked
        return false            ; lock won the race: leave it hidden
    DllCall("ShowWindow", "Ptr", hwnd, "Int", cmd)
    return true
}

_ForceFSRepaint(hwnd) {
    ; InvalidateRect on the TOP-LEVEL window is close to useless for Chromium:
    ; the page is painted by a child HWND (Chrome_RenderWidgetHostHWND) into a
    ; compositor surface, so invalidating the parent asks the one window that
    ; draws nothing to redraw nothing. RedrawWindow with RDW_ALLCHILDREN
    ; actually reaches the surface that holds the content.
    static RDW_INVALIDATE := 0x1, RDW_ERASE := 0x4
    static RDW_ALLCHILDREN := 0x80, RDW_UPDATENOW := 0x100
    try DllCall("user32\RedrawWindow", "Ptr", hwnd, "Ptr", 0, "Ptr", 0
        , "UInt", RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN | RDW_UPDATENOW)
}

; Stronger kick: force a real geometry change so the window receives
; WM_WINDOWPOSCHANGED / WM_SIZE. That is a signal Chromium acts on -- it
; re-lays-out and produces a frame -- whereas a bare SW_SHOWNA is not. Used on
; reveal for a window that comes back idle rather than destroyed. Size is
; nudged by one pixel and put straight back, so nothing moves perceptibly.
_FSForceRender(hwnd) {
    static SWP_NOZORDER := 0x0004, SWP_NOACTIVATE := 0x0010, SWP_NOMOVE := 0x0002
    try {
        UncloakWindow(hwnd, true, "_FSForceRender")      ; a cloaked window reads as occluded
        _ForceFSRepaint(hwnd)
        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return
        x := NumGet(rc, 0, "Int"), y := NumGet(rc, 4, "Int")
        w := NumGet(rc, 8, "Int") - x, h := NumGet(rc, 12, "Int") - y
        if (w < 50 || h < 50)
            return
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", x, "Int", y, "Int", w - 1, "Int", h
            , "UInt", SWP_NOZORDER | SWP_NOACTIVATE)
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", x, "Int", y, "Int", w, "Int", h
            , "UInt", SWP_NOZORDER | SWP_NOACTIVATE)
        _ForceFSRepaint(hwnd)
    }
}

; Bring the just‑revealed Firestone window to the TRUE foreground (above other
; apps such as Chrome), but ONLY when Hearthstone is not itself the active window.
; ══════════════════════════════════════════════════════════════════════════════
;  BATTLEGROUNDS SITS ABOVE MAIN
; ══════════════════════════════════════════════════════════════════════════════
;
; The reveal pins every Firestone window HWND_TOPMOST so it clears a borderless
; fullscreen Hearthstone. That settles the game, and settles nothing between the
; windows themselves: they all land in the same topmost band, in whatever order
; WinGetList happened to hand them over, and the last one pinned is the one on
; top. With both Main and Battlegrounds open that is a coin toss on every F3.
;
; Battlegrounds is the one being read during a match, so it wins. This states
; that explicitly rather than leaving it to enumeration order.
;
; SetWindowPos(main, bg, ...) inserts MAIN DIRECTLY BEHIND BG, which is the
; exact relationship wanted and is one call. The alternative -- re-pinning BG
; topmost to float it to the top of the band -- also works but says less, and
; it touches the window that is currently correct instead of the one that is
; not.
;
; SWP_NOACTIVATE throughout: this is a z-order statement, not a focus one.
; Hearthstone must never lose the foreground to it -- a borderless Unity window
; that does re-runs its display setup and snaps to its remembered monitor.
;
; Runs once per reveal, and only when both windows are actually up. Everything
; here is a no-op with one window open, which is the common case.
global _fsBgOverMainDone := false
; Separate from _fsBgOverMainDone ON PURPOSE. That one is cleared on every F3
; so the pair's Z-ORDER is re-decided each reveal, which is right for ordering
; and wrong for geometry: moving and resizing someone's windows every time they
; press F3 undoes whatever they dragged them to. This is cleared per GAME.
global _fsTiledThisGame := false

_FSOrderBattlegroundsOverMain() {
    global _fsBgOverMainDone
    if _fsBgOverMainDone
        return false
    mainH := 0, bgH := 0
    prev  := A_DetectHiddenWindows
    DetectHiddenWindows false          ; only windows actually on screen count
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    t := WinGetTitle("ahk_id " . h)
                    if (!mainH && IsFirestoneMainTitle(t))
                        mainH := h
                    else if (!bgH && IsFirestoneBattlegroundsTitle(t))
                        bgH := h
                }
            }
        }
    }
    DetectHiddenWindows prev

    if !(mainH && bgH)
        return false                   ; one of them is not open: nothing to order

    _fsBgOverMainDone := true

    ; ── RAISED ON EVERY F3, NOT ONLY THE FIRST ──────────────────────────────
    ;
    ; The topmost pin and the focus used to live inside _FSTileBgAndMain, and
    ; that runs ONCE PER GAME. So the first F3 put Battlegrounds in front and
    ; every F3 after it did nothing -- which is exactly the report: fine the
    ; first time, Main in front from the second on, and clicking Battlegrounds
    ; yourself did not stick because the next reveal put it back.
    ;
    ; Layout is still once per game (moving windows the user has since dragged
    ; would be wrong). Ordering is not layout, and belongs on every reveal.
    _FSBgOverMainNow(bgH, mainH)
    _FSFocusWindow(bgH)
    SetTimer(() => (_FSBgOverMainNow(bgH, mainH), _FSFocusWindow(bgH)), -200)
    SetTimer(() => (_FSBgOverMainNow(bgH, mainH), _FSFocusWindow(bgH)), -600)
    SetTimer(() => (_FSBgOverMainNow(bgH, mainH), _FSFocusWindow(bgH)), -1200)
    _FSLog("FS-ORDER Battlegrounds pinned above Main (bg=" . bgH
         . " main=" . mainH . ") -- re-asserted on this reveal and for the"
         . " next 1.2s, because the reveal keeps re-ordering underneath it")

    _FSTileBgAndMain(bgH, mainH)
    return true
}

; ── SIDE BY SIDE, NOT STACKED ───────────────────────────────────────────────
;
; Z-order alone left both windows at whatever position Overwolf last used,
; which is the same rectangle for both -- so revealing them put one exactly on
; top of the other and only the front one could be read. Ordering answered
; "which is in front" when the question was "how do I see both".
;
; They are tiled across the monitor the session is locked to: Battlegrounds on
; the left because that is the one being read during a match, Main on the
; right. Each gets half the width, less a small gutter.
;
; RESIZING IS DELIBERATE AND IS THE RISKY PART. At their natural sizes the two
; come to about 2800px wide together, which does not fit a 2560px monitor, so
; leaving sizes alone would push Main off the edge on any normal display.
; Overwolf owns these windows and may move or re-size them back at any time --
; this does not fight it and does not re-apply on a timer; it is applied once
; per reveal, at the moment the user asked to see them. If Firestone moves them
; afterwards, that is Firestone's window and the user can drag it.
; ── FORCE A WINDOW TO THE FOREGROUND ────────────────────────────────────────
; SetForegroundWindow is refused unless the caller already owns the foreground
; -- it returns false and does nothing, which is exactly what "Battlegrounds
; isn't winning the foreground" looked like. Attaching to the current
; foreground thread's input queue makes the request legal; the attach is
; released immediately, because leaving two threads sharing an input queue
; couples their focus and keyboard state for as long as it lasts.
; Battlegrounds sits above Main, always. Inserting Main AFTER Battlegrounds in
; the z-order is what puts Main underneath -- the pair is ordered by moving the
; one that should be BEHIND, not the one that should be in front.
_FSBgOverMainNow(bgH, mainH) {
    if !bgH
        return false
    static HWND_TOPMOST := -1, HWND_NOTOPMOST := -2
    static SWP_NOSIZE := 0x0001, SWP_NOMOVE := 0x0002, SWP_NOACTIVATE := 0x0010
    try {
        ; ── BATTLEGROUNDS IS PINNED ABOVE EVERYTHING ────────────────────────
        ; Re-ordering it relative to Main was not enough: the reveal, Overwolf
        ; and Firestone itself all re-order these windows afterwards, and
        ; whichever ran last decided what you saw. TOPMOST takes it out of that
        ; argument entirely -- it sits above every non-topmost window, so
        ; nothing that re-orders the normal band can put it behind Main again.
        DllCall("user32\SetWindowPos", "Ptr", bgH, "Ptr", HWND_TOPMOST
              , "Int", 0, "Int", 0, "Int", 0, "Int", 0
              , "UInt", SWP_NOSIZE | SWP_NOMOVE | SWP_NOACTIVATE)
        ; And Main is explicitly NOT topmost, so it cannot join it up there.
        if mainH
            DllCall("user32\SetWindowPos", "Ptr", mainH, "Ptr", HWND_NOTOPMOST
                  , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                  , "UInt", SWP_NOSIZE | SWP_NOMOVE | SWP_NOACTIVATE)
        return true
    }
    return false
}

_FSFocusWindow(hwnd) {
    if !hwnd
        return false
    try {
        if !DllCall("user32\IsWindow", "Ptr", hwnd)
            return false
        fg := DllCall("user32\GetForegroundWindow", "Ptr")
        if (fg = hwnd)
            return true
        me    := DllCall("kernel32\GetCurrentThreadId", "UInt")
        other := DllCall("user32\GetWindowThreadProcessId", "Ptr", fg, "Ptr", 0, "UInt")
        attached := false
        if (other && other != me)
            attached := DllCall("user32\AttachThreadInput", "UInt", me, "UInt", other, "Int", true)
        DllCall("user32\BringWindowToTop", "Ptr", hwnd)
        DllCall("user32\SetForegroundWindow", "Ptr", hwnd)
        if attached
            DllCall("user32\AttachThreadInput", "UInt", me, "UInt", other, "Int", false)
        return (DllCall("user32\GetForegroundWindow", "Ptr") = hwnd)
    }
    return false
}

; ── CLICK FIRESTONE'S "HERO SELECTION" TAB ──────────────────────────────────
; The tab strip is a web view inside Overwolf, so there is no control to
; address and no message to send -- a click at the right place is the only
; way in. The offset is measured from the WINDOW's top-left, not the screen,
; so it survives the window being moved or tiled.
;
; It is deliberately timid: it does nothing unless the window is where we just
; put it and big enough for the strip to be at that offset, and it never
; retries. A stray click into someone's tracker is worse than a tab that
; stayed on Opponent.
_FSClickHeroSelection(hwnd) {
    if !hwnd
        return false
    try {
        if !DllCall("user32\IsWindow", "Ptr", hwnd)
            return false
        x := 0, y := 0, w := 0, h := 0
        WinGetPos(&x, &y, &w, &h, "ahk_id " . hwnd)
        if (w < 400 || h < 300)
            return false
        ; Measured from a real window: the strip sits ~36px below the top edge
        ; and "Hero selection" starts ~120px in from the left.
        cx := x + 175
        cy := y + 36
        prev := A_CoordModeMouse
        CoordMode("Mouse", "Screen")
        try Click(cx, cy)
        CoordMode("Mouse", prev)
        _FSLog("FS-TAB clicked Firestone's Hero selection tab at " . cx . "," . cy
             . " (window " . w . "x" . h . " at " . x . "," . y . "). Firestone"
             . " reopens on whatever tab it was last on, which is usually"
             . " Opponent; this is the only way to change that from outside.")
        return true
    }
    return false
}

; One line per window per step of the layout: whether it is composited
; (cloak=0 means DWM is still drawing it), whether it is visible, and exactly
; where it is. Read-only.
_FSTileStep(mainH, bgH, when) {
    out := "FS-TILESTEP " . when
    for pair in [{n: "Main", h: mainH}, {n: "BG", h: bgH}] {
        if !pair.h
            continue
        try {
            x := 0, y := 0, w := 0, h := 0
            WinGetPos(&x, &y, &w, &h, "ahk_id " . pair.h)
            ck := 0
            DllCall("dwmapi\DwmGetWindowAttribute", "Ptr", pair.h, "UInt", 14
                  , "Int*", &ck, "Int", 4)
            vis := DllCall("user32\IsWindowVisible", "Ptr", pair.h)
            out .= "  |  " . pair.n . " " . w . "x" . h . " at " . x . "," . y
                 . " vis=" . (vis ? 1 : 0) . " cloaked=" . (ck ? 1 : 0)
        }
    }
    _FSLog(out . "  -- a window with vis=1 and cloaked=0 is on screen right"
         . " now; that is the step the flicker is in.")
}

; Puts the pair back where the layout put them, once, after Firestone has had
; its chance to restore its own saved position. Only acts on a window that has
; actually drifted, so it costs nothing when Firestone leaves them alone.
_FSTileReapply(mainH, bgH, mainX, bgX, top) {
    static SWP_NOSIZE := 0x0001, SWP_NOZORDER := 0x0004, SWP_NOACTIVATE := 0x0010
    moved := 0
    for pane in [{h: mainH, x: mainX, n: "Main"}, {h: bgH, x: bgX, n: "BG"}] {
        if !pane.h
            continue
        try {
            cx := 0, cy := 0
            WinGetPos(&cx, &cy, , , "ahk_id " . pane.h)
            if (Abs(cx - pane.x) <= 4 && Abs(cy - top) <= 4)
                continue                       ; still where we put it
            DllCall("user32\SetWindowPos", "Ptr", pane.h, "Ptr", 0
                  , "Int", pane.x, "Int", top, "Int", 0, "Int", 0
                  , "UInt", SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE)
            moved += 1
            _FSLog("FS-TILE " . pane.n . " had drifted to " . cx . "," . cy
                 . " -- Firestone restored its own saved position after the"
                 . " reveal; put back to " . pane.x . "," . top)
        }
    }
    return moved
}

; ── PUT THEM WHERE THEY BELONG WHILE NOBODY CAN SEE THEM ────────────────────
;
; Runs at the top of a reveal, before anything is shown. Finds both Firestone
; windows -- including parked ones, which is why hidden windows are detected --
; and writes the final layout straight into _fsParkedRect, so the unpark that
; follows restores them into position rather than to wherever Firestone had
; them. It also moves them directly, for the case where a window is not parked
; at all and is merely concealed.
;
; Same geometry as the visible layout: nothing is resized, Battlegrounds
; overlaps Main's advertising column, and the pair is centred on the monitor
; they are already on. Once per game.
_FSPrePositionFirestone() {
    global State, _fsTiledThisGame, _fsParkedRect
    if _fsTiledThisGame
        return false
    if !State.bgInBG
        return false

    mainH := 0, bgH := 0
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true            ; parked windows are still hidden here
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    t := WinGetTitle("ahk_id " . h)
                    if (!mainH && IsFirestoneMainTitle(t))
                        mainH := h
                    else if (!bgH && IsFirestoneBattlegroundsTitle(t))
                        bgH := h
                }
            }
        }
    }
    DetectHiddenWindows prev
    if !(mainH && bgH)
        return false                    ; both have to exist to arrange them

    mw := 0, mh := 0, bw := 0, bh := 0
    try WinGetPos(, , &mw, &mh, "ahk_id " . mainH)
    try WinGetPos(, , &bw, &bh, "ahk_id " . bgH)
    if (mw < 200 || bw < 200)
        return false

    ; The monitor they belong to. A parked window sits off the desktop, so its
    ; own centre is useless -- the chosen monitor is the sane answer, falling
    ; back to primary.
    ml := 0, mt := 0, mr := 0, mb := 0
    try MonitorGetWorkArea(MonitorGetPrimary(), &ml, &mt, &mr, &mb)
    monW := mr - ml, monH := mb - mt
    if (monW <= 0 || monH <= 0)
        return false

    overlap := Min(300, mw // 3)
    total   := mw + bw - overlap
    x0      := ml + ((monW - total) // 2)
    if (x0 < ml)
        x0 := ml
    top := mt + ((monH - Max(mh, bh)) // 2)
    if (top < mt)
        top := mt
    bgX := x0 + mw - overlap

    static SWP_NOSIZE := 0x0001, SWP_NOZORDER := 0x0004, SWP_NOACTIVATE := 0x0010
    for pane in [{h: mainH, x: x0, w: mw, ht: mh}
               , {h: bgH,   x: bgX, w: bw, ht: bh}] {
        ; The parked rectangle is what unpark restores to, so this is the part
        ; that actually decides where the window appears.
        _fsParkedRect[pane.h] := {x: pane.x, y: top, w: pane.w, h: pane.ht}
        try DllCall("user32\SetWindowPos", "Ptr", pane.h, "Ptr", 0
                  , "Int", pane.x, "Int", top, "Int", 0, "Int", 0
                  , "UInt", SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE)
    }
    _fsTiledThisGame := true
    _FSLog("FS-TILE pre-positioned before the reveal: Main " . mw . " wide at "
         . x0 . "," . top . " and Battlegrounds " . bw . " wide at " . bgX
         . "," . top . ", overlapping " . overlap . "px. Both were still"
         . " concealed, so there is no move for the user to see -- the reveal"
         . " shows them in place on the first frame.")
    return true
}

_FSTileBgAndMain(bgH, mainH) {
    global State, _fsTiledThisGame
    if !(bgH && mainH)
        return false
    ; Once per GAME, on the first F3 that finds both windows up during a
    ; Battlegrounds match -- not once per F3. Re-tiling on every press threw
    ; away whatever the user had dragged them to.
    if _fsTiledThisGame
        return false
    if !State.bgInBG
        return false          ; not in a match: leave their windows alone

    ; ── THE MONITOR THEY ARE ALREADY ON ─────────────────────────────────────
    ;
    ; This used the session's CHOSEN monitor and that was wrong twice over.
    ; Firestone Main and Battlegrounds are deliberately EXCLUDED from the
    ; window-locking system -- they are not ours to relocate onto the locked
    ; screen -- so honouring the lock here contradicted the rule the rest of
    ; the file follows. Measured: the pair was thrown onto the second monitor
    ; at x=3844, away from where they already were.
    ;
    ; Arranging windows is not the same as owning where they live. The monitor
    ; is read from the Battlegrounds window itself, so the pair is tidied where
    ; the user already had it -- normally the primary, but not by assumption.
    ; Primary is only the fallback for a window whose centre lands on no
    ; monitor at all (one that was parked off-screen).
    ml := 0, mt := 0, mr := 0, mb := 0
    bx := 0, by := 0, bw := 0, bh := 0
    try WinGetPos(&bx, &by, &bw, &bh, "ahk_id " . bgH)
    cx := bx + (bw // 2)
    cy := by + (bh // 2)
    found := false
    try {
        loop MonitorGetCount() {
            MonitorGet(A_Index, &tl, &tt, &tr, &tbm)
            if (cx >= tl && cx < tr && cy >= tt && cy < tbm) {
                MonitorGetWorkArea(A_Index, &ml, &mt, &mr, &mb)
                found := true
                break
            }
        }
    }
    if !found
        MonitorGetWorkArea(MonitorGetPrimary(), &ml, &mt, &mr, &mb)
    monW := mr - ml
    monH := mb - mt
    if (monW <= 0 || monH <= 0)
        return false

    ; ── SIZED TO FIT SIDE BY SIDE, NOT TO FILL THE SCREEN ───────────────────
    ;
    ; Half the monitor each came out at 1440x1210 -- enormous, and taller than
    ; the screen it was centred on. The point of the arrangement is to see both
    ; at once, which wants them SMALL and adjacent, not maximised.
    ;
    ; Firestone may refuse to go this small; it owns its own minimum size. The
    ; request is made anyway and the result is logged, because a window that
    ; clamps itself is information, not a failure.
    ; ── POSITION ONLY. NOTHING IS RESIZED. ──────────────────────────────────
    ;
    ; This used to size both windows as well as move them, and the resize is
    ; what stopped Firestone Battlegrounds loading at all -- Firestone lays its
    ; own content out to the size it chose, and being resized underneath that
    ; left it with a window it never finished drawing into.
    ;
    ; So the pair is arranged at WHATEVER SIZE FIRESTONE MADE THEM. Their real
    ; widths are read here, not assumed, and the only thing written back is an
    ; x and a y. Main on the left, Battlegrounds overlapping the advertising
    ; strip down Main's right-hand side so the two read as one panel with hero
    ; statistics where the ad was.
    mw := 0, mh := 0, bw := 0, bh := 0
    try WinGetPos(, , &mw, &mh, "ahk_id " . mainH)
    try WinGetPos(, , &bw, &bh, "ahk_id " . bgH)
    if (mw < 200 || bw < 200)
        return false

    overlap := Min(300, mw // 3)         ; Main's ad column, never more than a third
    total   := mw + bw - overlap
    x0  := ml + ((monW - total) // 2)
    if (x0 < ml)
        x0 := ml                          ; wider than the monitor: start at its edge
    top := mt + ((monH - Max(mh, bh)) // 2)
    if (top < mt)
        top := mt

    ; ── CLOAKED ACROSS THE MOVE ─────────────────────────────────────────────
    ; The reveal shows both windows wherever Firestone last had them -- top
    ; right -- and only then does this run, so what the user sees is the pair
    ; appearing in the wrong place and jumping. Cloaking takes them out of the
    ; compositor for the length of the move, so the first frame anyone sees is
    ; the final position. NOREDRAW alone could not fix that: it stops the move
    ; painting, it does nothing about the frame already on screen.
    ; ── THE MOVE, STEP BY STEP ──────────────────────────────────────────────
    ; The flicker survived cloaking, so the assumption that cloaking hides the
    ; window through the move is wrong somewhere. This records each window's
    ; ACTUAL state at every step, so the next report says which step it is
    ; visible in rather than leaving it to be guessed:
    ;
    ;   cloak reported success but the window is still composited  -> the cloak
    ;       is not being honoured (Overwolf owns it and may re-show it)
    ;   visible=1 between cloak and move                           -> the cloak
    ;       did not take effect before the move started
    ;   visible=1 only after uncloak, at the OLD position          -> the move
    ;       did not stick and Firestone put it back
    ; ── MOVED AT ALPHA 0, NOT CLOAKED ───────────────────────────────────────
    ;
    ; Cloaking these two is IMPOSSIBLE and the attempt was silently refused.
    ; CloakWindow declines any window in _fsAlphaConcealed on purpose -- a
    ; cloak stops DWM compositing and takes the taskbar button with it, which
    ; is the whole reason Main is held at alpha 0 instead. The measurement said
    ; so plainly: cloaked=0 at every step including "after cloak", so both
    ; windows were fully visible for the entire move. That is the flicker.
    ;
    ; Alpha is the lever that is already allowed on these windows. Taking them
    ; to 0 for the length of the move makes it invisible without touching
    ; compositing or the taskbar button, and the previous alpha is restored
    ; afterwards rather than assumed to be 255.
    static GWL_EXSTYLE := -20, WS_EX_LAYERED := 0x80000, LWA_ALPHA := 0x2
    fnGet := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    fnSet := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
    prevA := Map()
    _FSTileStep(mainH, bgH, "BEFORE hiding")
    for h in [mainH, bgH] {
        try {
            ex := DllCall(fnGet, "Ptr", h, "Int", GWL_EXSTYLE, "Ptr")
            a := 255, key := 0, fl := 0
            if (ex & WS_EX_LAYERED)
                DllCall("user32\GetLayeredWindowAttributes", "Ptr", h
                      , "UInt*", &key, "UChar*", &a, "UInt*", &fl)
            else
                DllCall(fnSet, "Ptr", h, "Int", GWL_EXSTYLE, "Ptr", ex | WS_EX_LAYERED)
            prevA[h] := a
            DllCall("user32\SetLayeredWindowAttributes", "Ptr", h, "UInt", 0
                  , "UChar", 0, "UInt", LWA_ALPHA)
        }
    }
    _FSTileStep(mainH, bgH, "at alpha 0, before move")

    static SWP_NOACTIVATE := 0x0010, SWP_NOZORDER := 0x0004
    static SWP_NOREDRAW   := 0x0008, SWP_NOSIZE   := 0x0001
    ok := 0
    ; Main first, Battlegrounds second, so BG lands on top of the overlap.
    for pane in [{h: mainH, x: x0}
               , {h: bgH,   x: x0 + mw - overlap}] {
        try {
            if DllCall("user32\SetWindowPos", "Ptr", pane.h, "Ptr", 0
                     , "Int", pane.x, "Int", top
                     , "Int", 0,      "Int", 0
                     , "UInt", SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER | SWP_NOREDRAW)
                ok += 1
        }
    }
    ; INVALIDATE|ERASE|ALLCHILDREN|UPDATENOW -- one repaint each, in place,
    ; then back on screen at the position they were just given.
    _FSTileStep(mainH, bgH, "after move, still at alpha 0")
    for h in [mainH, bgH] {
        try DllCall("user32\RedrawWindow", "Ptr", h, "Ptr", 0, "Ptr", 0
                  , "UInt", 0x0001 | 0x0004 | 0x0080 | 0x0100)
        ; ── RESTORE TO VISIBLE, NOT TO WHAT IT WAS ──────────────────────────
        ; Reading the previous alpha and putting it back sounds careful and was
        ; wrong: this runs during a REVEAL, and Main is still sitting at the
        ; alpha 0 it was concealed with. Restoring "what it was" restored 0 --
        ; the window moved correctly and then stayed invisible. Main
        ; disappeared entirely after F3, which is exactly what that does.
        ;
        ; A reveal ends with the window on screen. Anything that was already
        ; opaque is put back at its own value; anything found at 0 is being
        ; revealed, so it goes to full.
        a := prevA.Has(h) ? prevA[h] : 255
        if (a < 8)
            a := 255
        try DllCall("user32\SetLayeredWindowAttributes", "Ptr", h, "UInt", 0
                  , "UChar", a, "UInt", LWA_ALPHA)
    }
    _FSTileStep(mainH, bgH, "after restoring alpha")

    ; ── FIRESTONE PUTS BATTLEGROUNDS BACK, SO PUT IT BACK AGAIN ─────────────
    ; Measured: 1.2s after a correct layout, Battlegrounds had returned to
    ; 100,100 on its own -- Firestone restores its own saved position shortly
    ; after the window is revealed. One re-apply after that has happened is
    ; enough; it is a one-shot, not a timer, so a window the user drags later
    ; stays where they put it.
    bgX := x0 + mw - overlap
    SetTimer(() => _FSTileReapply(mainH, bgH, x0, bgX, top), -1400)
    SetTimer(() => _FSTileStep(mainH, bgH, "1.8s after the layout"), -1800)

    ; ── BATTLEGROUNDS TAKES THE FOREGROUND, AND KEEPS IT ────────────────────
    ;
    ; One WinActivate was not enough. The reveal is still walking the windows
    ; when this runs, and whatever it touches last wins -- so Main ended up in
    ; front even though Battlegrounds had been activated. SetForegroundWindow
    ; also refuses outright unless the calling thread already owns the
    ; foreground, which is why it silently did nothing.
    ;
    ; Raising and focusing is NOT done here any more -- the caller does it on
    ; every F3. This function runs once per GAME, and having the z-order in it
    ; meant the second and every later F3 raised nothing at all.
    ; ── OPEN IT ON HERO SELECTION ───────────────────────────────────────────
    ; Firestone restores whatever tab it was last on, which is usually
    ; "Opponent" and is not what you want at the start of a match. The tabs are
    ; a web view, so there is nothing to call -- the only way in is a click at
    ; the tab's position. Measured against the window's own top-left, so it
    ; follows the window rather than assuming a screen position.
    SetTimer(() => _FSClickHeroSelection(bgH), -650)
    _fsTiledThisGame := true

    ; Where they ACTUALLY ended up. mainW/bgW used to be named here; they were
    ; the widths this function CHOSE, and they stopped existing when the resize
    ; was removed -- the sizes are Firestone's now and are only read. Leaving
    ; the old names behind turned a log line into a warning dialog on every
    ; layout. The real widths are mw/bw, read at the top.
    gw := 0, gh := 0, gx := 0, gy := 0
    try WinGetPos(&gx, &gy, &gw, &gh, "ahk_id " . bgH)
    _FSLog("FS-TILE laid out once for this game on the monitor they were"
         . " already on. Nothing was resized: Main " . mw . " wide + BG " . bw
         . " wide, overlapping " . overlap . "px, at y=" . top
         . "; Battlegrounds is now " . gw . "x" . gh . " at " . gx . "," . gy
         . " (" . ok . "/2 moves accepted).")
    return (ok = 2)
}

_ForegroundFSIfSafe(hwnd) {
    try {
        if WinActive("ahk_exe Hearthstone.exe")
            return
    } catch {
    }
    try WinActivate("ahk_id " . hwnd)
}

; Restored (normal) width/height of hwnd via GetWindowPlacement.
_GetRestoredSize(hwnd, &w, &h) {
    w := 0, h := 0
    wp := Buffer(44, 0)
    NumPut("UInt", 44, wp, 0)
    if !DllCall("user32\GetWindowPlacement", "Ptr", hwnd, "Ptr", wp)
        return false
    left   := NumGet(wp, 28, "Int")
    top    := NumGet(wp, 32, "Int")
    right  := NumGet(wp, 36, "Int")
    bottom := NumGet(wp, 40, "Int")
    w := right - left
    h := bottom - top
    return true
}

StartFSReveal() {
    global _fsRevealActive, _fsRevealUntil, _fsRevealedMainAt
    global _fsRevealFirstSeen, _fsRevealSettleReq, _fsRevealSettleMs
    global _fsRevealNudged, _fsRevealFg, _fsRevealDone, _fsRevealSettled
    global State, Launch, _fsBgOverMainDone, _fsMainBirthShielded
    _fsRevealActive   := true
    _fsBgOverMainDone := false        ; re-decide the pair's order on every F3

    ; ── THIS IS WHERE THE BIRTH SHIELD COMES OFF ────────────────────────────
    ; It is held from creation through every SHOW (see the note at the EV_SHOW
    ; site) precisely so there is no handover to race. F3 is the first moment
    ; the user has actually asked for the window, so it is the first moment the
    ; hide has any reason to end. Released before the reveal walks the windows,
    ; so the reveal finds them in their normal alpha-managed state.
    for h in _fsMainBirthShielded.Clone() {
        try _FSMainBirthShieldRelease(h)
    }

    ; ── LAY THEM OUT BEFORE THEY ARE SHOWN, NOT AFTER ───────────────────────
    ;
    ; The layout used to run at the END of the reveal, once both windows were
    ; already on screen at whatever position Firestone last used. However
    ; carefully that move was hidden -- cloaked, alpha 0, NOREDRAW -- the
    ; windows had already been PAINTED somewhere else first, and moving a
    ; window that has been seen is a move the user sees. That is the flicker,
    ; and it was never going to be fixed by hiding the move better.
    ;
    ; Doing it here fixes the cause instead: at this point the windows are
    ; still parked off the desktop and still concealed, so putting them in
    ; their final places costs nothing visually. The reveal that follows shows
    ; them where they belong, first frame, with nothing to correct afterwards.
    try _FSPrePositionFirestone()

    _fsRevealedMainAt := 0
    _fsRevealFirstSeen := Map()
    _fsRevealNudged    := Map()
    _fsRevealDone      := Map()   ; fresh: full reveal action once per window
    _fsRevealSettled   := Map()   ; fresh: position-settled gate
    _fsRevealFg        := Map()   ; fresh: foreground once per window per reveal

    ; Belt and braces: before the reveal touches anything, restore full opacity
    ; on every Overwolf surface left transparent -- including ones this
    ; instance never shielded itself. An F3 unlock must never be able to put an
    ; invisible window on screen, regardless of what happened before it.
    ; Alpha-concealed windows come back FIRST: they are already on screen and
    ; already visible to Windows, so the rest of the reveal has nothing to do
    ; for them but restore opacity. See _FSConcealMain.
    _FSRevealAllAlpha()
    FSRepairStuckAlpha()
    ; Same contract for the park: nothing this reveal shows may be sitting
    ; outside the virtual desktop, including windows a previous instance
    ; parked and never came back for.
    FSRepairStrandedWindows()

    launching := State.f2Active || (Launch.state != "IDLE" && Launch.state != "DONE")
    _fsRevealSettleReq := launching ? _fsRevealSettleMs : 0
    _fsRevealUntil     := A_TickCount + (launching ? 60000 : 5000)

    SetTimer(FSRevealTick, 30)
    FSRevealTick()
}

StopFSReveal() {
    global _fsRevealActive, _fsRevealFirstSeen, _fsRevealNudged
    global _fsPaintState, CFG
    ; _fsRevealDone and _fsRevealSettled ARE ON THIS LINE FOR A REASON.
    ;
    ; They were missing, and in AutoHotkey v2 an undeclared name assigned
    ; inside a function is a LOCAL -- so the two resets at the bottom of this
    ; function were creating two fresh local maps, clearing those, and throwing
    ; them away, while the globals of the same name were never touched.
    ;
    ; This is a correctness repair, not a bug fix for an observed symptom:
    ; StartFSReveal assigns both globals a fresh Map on every press, so nothing
    ; actually leaked between reveals. But a function whose last two statements
    ; silently do nothing is a trap for whoever edits it next -- add a third
    ; ledger here and it will behave differently from these two for no visible
    ; reason. Declared, so the code does what it reads as doing.
    global _fsRevealDone, _fsRevealSettled
    _fsRevealActive := false
    SetTimer(FSRevealTick, 0)

    ; ── The reveal is the paint proof ───────────────────────────────────
    ; This is the only context where the question can be answered honestly. The
    ; window has just been unparked, uncloaked, shown and nudged: it has had the
    ; full treatment on a real screen.
    ;
    ; So probe once, so the log records what happened, and mark the window warm
    ; either way. If it did not paint under these conditions, nothing the cold
    ; path does on a later press will help, and continuing to park and unpark it
    ; is strictly harmful. Warm means it takes the plain concealment path from
    ; here on.
    for h in _fsRevealFirstSeen {
        try {
            if !DllCall("user32\IsWindow", "Ptr", h)
                continue
            if _fsPaintState.Has(h)
                continue
            d := 0
            painted := _FSWindowHasPainted(h, &d)
            _fsPaintState[h] := 1
            if (painted && d >= CFG.fsPaintMinDistinct)
                _FSLog("FS-PAINT PROVEN AT REVEAL hwnd=" . h . " distinct=" . d
                     . " -- warm from now on, no further park/unpark")
            else
                _FSLog("FS-PAINT NOT proven at reveal hwnd=" . h . " distinct=" . d
                     . " -- marking warm anyway; the cold path cannot help a"
                     . " window that stayed blank with the reveal fully applied,"
                     . " and repeating it is what damages the renderer")
        }
    }

    _fsRevealFirstSeen := Map()
    _fsRevealNudged    := Map()
    _fsRevealDone      := Map()
    _fsRevealSettled   := Map()
    ; Same call the tracker makes, for the same reason -- this is a
    ; Hearthstone concern and neither overlay owns it.
    try _HSEnsureFullscreenOwnership(false)   ; revealed: Firestone keeps focus
}

FSRevealTick() {
    global _fsRevealActive, _fsRevealUntil, _fsRevealedMainAt, State, _fsEverPainted
    global _fsRevealFirstSeen, _fsRevealSettleReq, _fsRevealNudged, _fsHiddenByUs, CFG, _fsRevealFg
    global _fsRevealDone, _fsRevealSettled, _fsMainCandidate, _fsParked, _fsEverShown
    global _fsShielded, _fsBuriedForever, _fsPinnedByUs
    global _fsWasMainTitled      ; identity: a window that HAS BEEN Main, still is
    global _fsShieldHeldLogged   ; declared explicitly; reads resolve either way

    if !_fsRevealActive {
        SetTimer(FSRevealTick, 0)
        return
    }

    ; ── A REVEAL MAY NOT RUN WHILE THE LOCK IS ON. THEY ARE OPPOSITES ────────
    ;
    ; The lock means "every Firestone window should be concealed". A reveal
    ; means "show them". Both acting on the same window is not a race to be
    ; tuned, it is a contradiction -- and it runs at 30ms against a suppression
    ; sweep, which is the fastest fight in this file.
    ;
    ; IT HAPPENED. This state is in the log, plainly:
    ;
    ;   15:40:15  FS-HOLD [main] freed hwnd=4129760 after 6860ms
    ;   15:40:15  FS-REVEAL "Firestone - Main" visible=1
    ;   15:40:15  FS-VISIBLE unconcealed ... locked=1   <- reveal ran while LOCKED
    ;   15:40:20  FS-REVEAL "Firestone - Main" visible=1
    ;   15:40:25  FS-DESTROYED "Firestone - Main"
    ;
    ; and the trace for that window is the two systems taking turns:
    ;   uncloak x7 -> minimise -> uncloak x2 -> minimise -> destroyed.
    ;
    ; WHY THIS IS THE RIGHT PLACE. Nothing was RELYING on a reveal running under
    ; the lock -- both callers of StartFSReveal set fsMainLocked := false before
    ; calling it (the F3 unlock, and the tracker stand-down), so this guard can
    ; never refuse a reveal that was legitimately asked for. It only refuses one
    ; that has outlived the state that justified it. LockFirestoneMain already
    ; calls StopFSReveal for exactly this reason; this makes that a property of
    ; the tick rather than a promise every future caller has to remember.
    ;
    ; Stopping rather than skipping, because a reveal under a lock has no future
    ; state in which it becomes correct again -- the next unlock starts a fresh
    ; one.
    if State.fsMainLocked {
        _fsRevealActive := false
        SetTimer(FSRevealTick, 0)
        _FSLog("FS-REVEAL stopped -- the F3 lock is on, so a reveal has nothing"
             . " to do: the lock and the reveal are opposite states and running"
             . " both means this script shows a window and then conceals it,"
             . " over and over, thirty milliseconds apart. Whichever path left"
             . " this running, it is not wanted now. The next F3 unlock starts a"
             . " fresh reveal.")
        return
    }

    try {
        prev     := A_DetectHiddenWindows
        prevMode := A_TitleMatchMode
        DetectHiddenWindows true
        SetTitleMatchMode(2)

        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    title := WinGetTitle("ahk_id " . h)
                    ; IsFirestoneAppTitle: the lock conceals every Firestone
                    ; window, so the unlock has to be able to bring every
                    ; Firestone window back. Matching only Main and
                    ; Battlegrounds here left Settings (and any window a later
                    ; Firestone build adds) concealed with nothing that could
                    ; restore it -- see IsFirestoneAppTitle.
                    ; ── IDENTITY, NOT THE CURRENT TITLE. THIS IS WHY F3 FAILED.
                    ; The three tests below all require a title of the form
                    ; "Firestone - something":
                    ;
                    ;   IsFirestoneMainTitle           exact "Firestone - Main"
                    ;   IsFirestoneBattlegroundsTitle  exact "Firestone - Battlegrounds"
                    ;   IsFirestoneAppTitle            prefix "Firestone - " (12 chars)
                    ;
                    ; A window titled plain "Firestone" is 9 characters and
                    ; matches NONE of them -- so this `continue` skipped it and
                    ; the reveal did nothing at all.
                    ;
                    ; MAIN WEARS THAT PLAIN TITLE FOR MOST OF ITS LIFE. Measured
                    ; on a clean launch: born "Firestone", retitles to
                    ; "Firestone - Main" about 900ms later, and reverts to plain
                    ; "Firestone" whenever Overwolf rebuilds it -- which is why
                    ; every FS-DESTROYED line in the log reads title="Firestone".
                    ;
                    ; So F3 ran, found nothing it was willing to reveal, and Main
                    ; stayed hidden WHILE ALIVE -- with its taskbar button already
                    ; stripped by _FSTabOff, leaving no way to reach it by hand
                    ; either. That is exactly the reported symptom: F3 does
                    ; nothing, and unlike the version that worked, Main is not in
                    ; the taskbar to click.
                    ;
                    ; _fsWasMainTitled is the answer: it records, permanently,
                    ; that this HWND has WORN the Main title. A window that has
                    ; ever been Main is still Main whatever it is called now, and
                    ; the reveal is precisely where that has to be true.
                    if !(IsFirestoneMainTitle(title) || IsFirestoneBattlegroundsTitle(title)
                      || IsFirestoneAppTitle(title) || _fsWasMainTitled.Has(h))
                        continue
                    ; ── A LOADING WINDOW IS SKIPPED ONLY WHILE A REAL MAIN
                    ;    EXISTS. OTHERWISE IT IS THE USER'S FIRESTONE. ───────
                    ;
                    ; THIS IS "FIRESTONE DIDN'T OPEN VIA F3, SO IT WAS CLOSED
                    ; SILENTLY" -- and it was not closed at all.
                    ;
                    ; The splash is titled "Firestone - Loading" and becomes
                    ; Main in place, so skipping it here is right while Main is
                    ; still forming: a reveal should not drag a half-built
                    ; splash onto the screen.
                    ;
                    ; But when Overwolf rebuilds Main, the replacement can sit
                    ; wearing the Loading title indefinitely. Measured:
                    ;
                    ;   17:57:39  FS-DESTROYED "Firestone - Main"
                    ;   17:57:39  replacement born, titled "Firestone - Loading"
                    ;   17:58:12  FS-LOADING ... untitled=33391ms   (still Loading)
                    ;
                    ; For those thirty-three seconds that window WAS the user's
                    ; entire Firestone -- there was no Main anywhere -- and this
                    ; line made F3 walk straight past it. Pressing F3 did
                    ; nothing, repeatedly, which is indistinguishable from the
                    ; overlay having been closed.
                    ;
                    ; So the skip now asks the question it always meant: is
                    ; there a REAL Main to prefer over this one? If yes, skip
                    ; the splash. If no, this is what the user is asking for.
                    ; _FSMainWindowPresent excludes this hwnd by design.
                    if _fsBuriedForever.Has(h)
                        continue
                    if (title = "Firestone - Loading" && _FSMainWindowPresent(h))
                        continue

                    if !_fsRevealFirstSeen.Has(h)
                        _fsRevealFirstSeen[h] := A_TickCount

                    if !DllCall("IsWindow", "Ptr", h)
                        continue

                    ; The size gate rejects half-built and placeholder windows.
                    ; It must NOT reject a window this script has parked: parked
                    ; means off the virtual desktop with no taskbar button, so
                    ; skipping it here is the one way the reveal can leave a
                    ; window permanently unreachable -- and the reveal is the
                    ; janitor that park depends on. Anything in _fsParked is by
                    ; definition ours and by definition needs bringing back,
                    ; whatever GetWindowPlacement says about its size.
                    _GetRestoredSize(h, &rw, &rh)
                    if ((rw < 300 || rh < 300) && !_fsParked.Has(h))
                        continue

                    if (_fsRevealSettleReq && (A_TickCount - _fsRevealFirstSeen[h] < _fsRevealSettleReq))
                        continue

                    ; Mid-sweep re-lock guard (mirror of _SuppressFSHwnd's):
                    ; a lock can land between two windows of this sweep --
                    ; from that instant the burst owns the windows again, so
                    ; un-suppressing the rest would just add a flicker.
                    if (!_fsRevealActive || State.fsMainLocked)
                        continue

                    ; Hidden and NOT ours to show (no ledger entry): this is
                    ; Overwolf's own between-matches state -- the
                    ; Battlegrounds window's normal lifecycle. Leave it
                    ; EXACTLY as it is, CLOAK INCLUDED. The old uncloak here
                    ; showed nothing (the window stayed hidden anyway) but
                    ; stripped the pre-armed cloak, re-arming the one-frame
                    ; race at the window's next SHOW under match-start load
                    ; -- the residual BG flicker. A cloak left in place
                    ; makes the next locked-era show born invisible with
                    ; ZERO event or timer dependence; an UNLOCKED-era show
                    ; is released by the hook's unlocked-show janitor.
                    if (!DllCall("user32\IsWindowVisible", "Ptr", h)
                     && !_fsHiddenByUs.Has(h))
                        continue

                    _fsEverPainted[h] := true   ; the reveal below is this
                                                ; Once per window per reveal. This timer exists to WAIT for a window to become
                                                ; eligible, not to repeat the reveal on it; without this gate every action below
                                                ; would run once per 30 ms tick for the whole reveal window.
                    if !_fsRevealDone.Has(h) {
                        _fsRevealDone[h] := true
                        ; Drop the flicker shield first. It is a hard SW_HIDE,
                        ; and every show below is a no-op against it.
                        if _fsShielded.Has(h) {
                            _MapDrop(_fsShielded, h)
                            _MapDrop(_fsShieldHeldLogged, h)
                            _MapDrop(_fsHiddenByUs, h)
                            ; Shown while STILL PARKED off the virtual desktop.
                            ; _FSReleaseSurface below does the unpark, so the
                            ; window becomes visible somewhere nobody can see
                            ; it and then moves back -- which is the whole
                            ; reason the park is kept underneath the hold.
                            DllCall("ShowWindow", "Ptr", h, "Int", 8)  ; SW_SHOWNA
                        }
                        ; A window the user has revealed is by definition not a stray notification, so
                        ; record it in the identity ledger. The suppression funnel does not run while
                        ; the lock is off, so a revealed window would otherwise never be recorded there.
                        _fsMainCandidate[h] := true
                        _ClearFSAlphaShield(h)
                        _FSReleaseSurface(h)

                        ; ── FIRST OPEN IS CENTRED, WHATEVER CONCEALED IT ────
                        ; _FSReleaseSurface has just run, so a window that was
                        ; PARKED has already been centred by _FSUnparkWindow and
                        ; has already had this flag set -- this is a no-op for
                        ; it. What reaches here unflagged is the other half:
                        ; windows concealed by the SW_HIDE exit or by a cloak
                        ; alone, which no un-park ever touches. Both Main and
                        ; Battlegrounds can take either route depending on
                        ; whether they had proven they paint yet, which is why
                        ; centring was landing for one and not the other.
                        if !_fsEverShown.Has(h) {
                            _fsEverShown[h] := true
                            _FSCenterOnPrimary(h)
                        }

                        _FSLog("FS-REVEAL title=`"" . title . "`" painted="
                             . (_FSIsWarm(h) ? "yes" : "NOT PROVEN")
                             . " visible="
                             . (DllCall("user32\IsWindowVisible", "Ptr", h) ? 1 : 0))
                    }
                    ; Show-if-hidden, LEDGER-GATED: only windows OUR loading
                    ; suppressors took off the screen (the Loading->Main
                    ; same-HWND retitle case) are force-shown here. Windows
                    ; Overwolf itself keeps hidden are left to Overwolf.
                    if (!DllCall("user32\IsWindowVisible", "Ptr", h)
                     && _fsHiddenByUs.Has(h)) {
                        if _GuardedFSShow(h, 8)   ; SW_SHOWNA, lock-checked
                            _fsHiddenByUs.Delete(h)
                    }
                    if (WinGetMinMax("ahk_id " . h) = -1)
                        _GuardedFSShow(h, 4)      ; SW_SHOWNOACTIVATE, lock-checked

                    ; Let the move settle before any z-order work.
                    ;
                    ; _FSReleaseSurface has just moved the window back and uncloaked it. Doing the
                    ; topmost pin and the activation in the same thread turn asks the compositor to
                    ; reconcile a move, an uncloak, a z-order change and a focus change in one
                    ; frame, which reads as the window jumping into place. One tick of this timer
                    ; gives the move a frame to itself, out of a 500 ms budget.
                    if !_fsRevealSettled.Has(h) {
                        _fsRevealSettled[h] := true
                        continue
                    }

                    ; ---- Bring to FOREGROUND, above Hearthstone ----
                    ; Single-monitor users need the unlocked window ON TOP of
                    ; HS. HWND_TOPMOST (-1) beats a borderless fullscreen game;
                    ; the activate gives it input focus so it is usable. Skipped
                    ; if a re-lock landed (the guard's contract).
                    ; ONCE per window per reveal. Without this cap the block
                    ; fired on every 30ms tick for the whole reveal window --
                    ; hundreds of z-order changes and activations per F3 press,
                    ; which is what killed Main after ~12 rapid presses.
                    if (CFG.fsRevealForeground && !State.fsMainLocked
                     && !_fsRevealFg.Has(h)) {
                        _fsRevealFg[h] := true
                        try {
                            ; LEDGER THE PIN, AND ONLY WHEN WE ARE THE ONE
                            ; ADDING IT. Recording a bit Overwolf had already
                            ; set would mean clearing, on the next re-lock, a
                            ; pin this script never made -- demoting a window
                            ; Overwolf deliberately keeps on top. Same rule and
                            ; same reason as _HDTDropOurPin on the tracker side.
                            ; This is also what lets SECTION 11f re-assert the
                            ; pin when something else strips it.
                            if !_IsTopmost(h)
                                _fsPinnedByUs[h] := true
                            DllCall("user32\SetWindowPos", "Ptr", h, "Ptr", -1
                                , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                                , "UInt", 0x0001 | 0x0002 | 0x0010)  ; NOSIZE|NOMOVE|NOACTIVATE

                            ; ── NEVER TAKE THE FOREGROUND FROM HEARTHSTONE ──
                            ;
                            ; This is the "HS flashed to the other monitor"
                            ; flicker, and the rule it breaks is stated three
                            ; other times in this script: a borderless Unity
                            ; window that loses the foreground RE-RUNS ITS
                            ; DISPLAY-MODE SETUP and snaps to its remembered
                            ; monitor. _BNetPinForeground guards on GetHSPID(),
                            ; _BNetDwellMinimize guards on GetHSPID(), and
                            ; _ForegroundFSIfSafe guards on WinActive. This
                            ; site -- the one the user triggers by hand, many
                            ; times a match -- guarded on nothing and called
                            ; WinActivate straight into a running game. It
                            ; flickered twice per F3 cycle, too: once when the
                            ; reveal took the foreground, and again when the
                            ; re-lock parked the window and Windows handed the
                            ; foreground back.
                            ;
                            ; The TOPMOST pin above is kept, and it is the half
                            ; that does the real work: HWND_TOPMOST puts the
                            ; window above a borderless fullscreen game without
                            ; touching the foreground at all. What is dropped is
                            ; only the input focus, and clicking the window
                            ; still gives it that in the normal way.
                            ;
                            ; GetHSPID() rather than "is HS active": if the game
                            ; is running but the user is already on the desktop,
                            ; HS does not hold the foreground and there is
                            ; nothing to take from it -- but it is also the case
                            ; where the pin alone is plainly enough.
                            ; ── ACTIVATE UNLESS HEARTHSTONE ITSELF IS IN
                            ; FRONT ─────────────────────────────────────────
                            ; The guard was GetHSPID() -- "is Hearthstone
                            ; RUNNING" -- which is far stricter than the rule
                            ; it is implementing. The rule is "never take the
                            ; foreground FROM Hearthstone", because a
                            ; borderless Unity window that loses focus re-runs
                            ; its display setup and snaps to its remembered
                            ; monitor. A game that is running but sitting
                            ; behind Chrome is not holding the foreground and
                            ; there is nothing to take from it.
                            ;
                            ; With the strict guard, F3 during any normal
                            ; session did nothing but set a topmost bit -- so
                            ; the revealed window came up behind whatever the
                            ; user was actually looking at. Which is the
                            ; report: "Firestone doesn't come to the
                            ; foreground above other windows."
                            ;
                            ; _HSIsForeground is the same test _ForegroundFSIfSafe
                            ; has always used for exactly this decision.
                            if !_HSIsForeground()
                                WinActivate("ahk_id " . h)
                        }
                    }

                    ; ---- Gentle repaint nudge + focus-free raise ----
                    ; SKIPPED ENTIRELY FOR A WINDOW THAT IS KNOWN TO PAINT.
                    ; _FSForceRender resizes the window by a pixel and back,
                    ; twice, and _ForegroundFSIfSafe activates it -- so this
                    ; block costs a proven-good window EIGHT SetWindowPos calls
                    ; and four activations PER F3 PRESS. That is the exact
                    ; "hundreds of z-order changes and activations per press"
                    ; this script's own comments blame for killing Main after a
                    ; dozen rapid presses, and it is the single biggest reason
                    ; Main does not survive a stress test.
                    ;
                    ; The nudge exists to kick a renderer that came back idle.
                    ; A warm window did not come back idle. It needs nothing.
                    n := _fsRevealNudged.Get(h, 0)
                    if (n < 4 && !State.fsMainLocked && !_FSIsWarm(h)) {
                        _fsRevealNudged[h] := n + 1
                        ; Geometry-change kick, repeated over the first few
                        ; ticks: CEF may need a moment after the show before it
                        ; will act on a resize. Cheap, and invisible (one pixel,
                        ; put straight back).
                        _FSForceRender(h)
                        try DllCall("user32\SetWindowPos", "Ptr", h, "Ptr", 0
                            , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                            , "UInt", 0x0001 | 0x0002 | 0x0010)
                        _ForegroundFSIfSafe(h)
                    }

                    ; Any suppression title stamps (BG works like Main):
                    ; the reveal may not cut itself short before showing BG.
                    if (!_fsRevealedMainAt
                     && (IsFirestoneMainTitle(title) || IsFirestoneBattlegroundsTitle(title)))
                        _fsRevealedMainAt := A_TickCount
                } catch {
                }
            }
        }

        DetectHiddenWindows prev
        SetTitleMatchMode prevMode

        ; With both windows revealed, say which of the two is in front. Latched,
        ; so this is one enumeration per F3 rather than one per 30 ms tick.
        try _FSOrderBattlegroundsOverMain()

        if (A_TickCount >= _fsRevealUntil) {
            StopFSReveal()
            return
        }
        if (_fsRevealedMainAt && (A_TickCount - _fsRevealedMainAt) > 500)
            StopFSReveal()
    } catch {
        StopFSReveal()
    }
}

; ==============================================================================
; SECTION 11e: MONITOR LOCK — keep session windows on the launch monitor
; ------------------------------------------------------------------------------
; Locks the auxiliary session windows to the monitor the script was launched on
; (ChosenMonIdx): the Battle.net client, the Blizzard Update Agent, and
; Hearthstone itself. It is deliberately gentle and respects the 400ms settle
; margin for new windows.
; ==============================================================================

global _monLockActive := false

StartMonitorLock() {
    global _monLockActive, CFG
    if !CFG.lockWindowsToChosenMonitor
        return
    _monLockActive := true
    SetTimer(MonitorLockTick, CFG.monitorLockPollMs)
    MonitorLockTick()
}

StopMonitorLock() {
    global _monLockActive
    _monLockActive := false
    SetTimer(MonitorLockTick, 0)
}

MonitorLockTick() {
    global _monLockActive, CFG, _hsGuardActive, _bnetLauncherStaged, _bnetPostMinDone
    if !_monLockActive {
        SetTimer(MonitorLockTick, 0)
        return
    }
    ; Clean ownership: the monitor lock moves Battle.net + Agent ONLY.
    ; Hearthstone is owned exclusively by the HS placement guard
    ; (HSPlacementGuardTick), which corrects the monitor only when the game
    ; landed on the wrong one. Two systems, two disjoint window sets -- they can no longer
    ; fight over HS (the visible primary-monitor bounce). Firestone windows
    ; are not a lock concern at all; they are hidden, not placed.
    ; The launch sequence owns the launcher from reveal to minimize-complete.
    ; While it does, the lock must NOT move Battle.net -- competing placement
    ; is what ruined launch smoothness and caused the wrong-monitor minimize.
    ; _bnetLauncherStaged && !_bnetPostMinDone == "sequence in control".
    if !(_bnetLauncherStaged && !_bnetPostMinDone)
        _LockProcWindowsToChosenMonitor("Battle.net.exe", , 400)
    ; Agent.exe is NOT locked. It is a Blizzard service window and this
    ; script hides it, and a hidden window does not need placing -- the
    ; only thing the lock could do is move it, which is the jump from the
    ; primary monitor to the chosen one that the owner reported seeing.
    ; Only Hearthstone and the Battle.net LAUNCHER are placed, because
    ; those are the two windows a user actually looks at.
}

; ── HS native display preference ─────────────────────────────────────────────
; Writes Hearthstone's own Unity display selection so Unity itself targets the
; chosen monitor. Value is 0‑based (AHK monitor indices are 1‑based).
SetHSMonitorPref() {
    global CFG, ChosenMonIdx
    if (!CFG.setHSMonitorPref || !CFG.lockWindowsToChosenMonitor || !ChosenMonIdx)
        return
    try {
        v := _UnityMonitorIndexForChosen()
        if (v < 0)
            v := ChosenMonIdx - 1
        if (v < 0)
            v := 0

        ; ── ONLY WRITE WHEN IT ACTUALLY CHANGES ──────────────────────────────
        ;
        ; This is Unity's own saved display selection -- the game's setting,
        ; not ours. Rewriting it on every launch is a standing invitation for
        ; the script to override a choice the user made inside the game, and
        ; when the value changes Unity re-runs its display setup on start-up:
        ; new display, new mode negotiation, and a fullscreen game that can
        ; come up as a fullscreen WINDOW instead -- with the taskbar still
        ; drawn over it.
        ;
        ; Reading first makes the common case -- the value is already what we
        ; want -- a genuine no-op, so the only launches that touch Unity's
        ; display state are the ones that had to.
        cur := ""
        try cur := RegRead("HKCU\Software\Blizzard Entertainment\Hearthstone"
                         , "UnitySelectMonitor_h17969598")
        if (cur != "" && cur = v) {
            if CFG.f1DebugLog
                try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss")
                    . " HS-MONITOR-PREF already " . v . " -- not rewriting`n"
                    , _LogPath())
            return
        }

        RegWrite(v, "REG_DWORD"
            , "HKCU\Software\Blizzard Entertainment\Hearthstone"
            , "UnitySelectMonitor_h17969598")
        if CFG.f1DebugLog
            try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss")
                . " HS-MONITOR-PREF UnitySelectMonitor=" . v
                . " (chosen mon " . ChosenMonIdx . ")`n", _LogPath())
    }
}

; Unity's 0‑based display index for the chosen monitor, or -1 if it can't be
; resolved.
_UnityMonitorIndexForChosen() {
    global ChosenMonPt
    p := StrSplit(ChosenMonPt, ",")
    if (p.Length != 2)
        return -1
    px := p[1] + 0, py := p[2] + 0
    dd := Buffer(840, 0)
    active := 0
    i := 0
    Loop 16 {
        NumPut("UInt", 840, dd, 0)
        if !DllCall("user32\EnumDisplayDevicesW", "Ptr", 0, "UInt", i, "Ptr", dd, "UInt", 0)
            break
        i++
        state := NumGet(dd, 324, "UInt")
        if !(state & 0x1)                              ; ATTACHED_TO_DESKTOP
            continue
        if (state & 0x8)                               ; MIRRORING_DRIVER
            continue
        devName := StrGet(dd.Ptr + 4, 32, "UTF-16")
        devm := Buffer(220, 0)
        NumPut("UShort", 220, devm, 68)                ; dmSize
        ok := DllCall("user32\EnumDisplaySettingsExW", "Str", devName
            , "Int", -1, "Ptr", devm, "UInt", 0)
        if ok {
            dx := NumGet(devm, 76, "Int")
            dy := NumGet(devm, 80, "Int")
            dw := NumGet(devm, 172, "UInt")
            dh := NumGet(devm, 176, "UInt")
            if (dw > 0 && dh > 0
             && px >= dx && px < dx + dw
             && py >= dy && py < dy + dh)
                return active
        }
        active++
    }
    return -1
}

; ── Corrective‑move budget ────────────────────────────────────────────────────
; Prevents endless monitor ping‑pong by limiting corrections to 4 per window
; per rolling 120s.
global _moveBudget := Map()

_MoveBudgetAllows(h) {
    global _moveBudget
    e := _moveBudget.Get(h, 0)
    if (e && A_TickCount - e.firstAt > 120000) {
        _moveBudget.Delete(h)
        e := 0
    }
    return (!e || e.count < 4)
}

_MoveBudgetNote(h) {
    global _moveBudget, CFG
    e := _moveBudget.Get(h, 0)
    if (!e || A_TickCount - e.firstAt > 120000)
        e := {count: 0, firstAt: A_TickCount}
    e.count++
    _moveBudget[h] := e
    if (CFG.f1DebugLog && e.count = 4) {
        exe := ""
        try exe := WinGetProcessName("ahk_id " . h)
        try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss")
            . " MOVE-BUDGET exhausted " . exe . " hwnd=" . h
            . " — app keeps snapping it back; leaving it`n", _LogPath())
    }
}

_MoveBudgetReset(h) {
    global _moveBudget
    if _moveBudget.Has(h)
        _moveBudget.Delete(h)
}

; ── Core monitor‑lock function ──────────────────────────────────────────────
global _placeCreateSeen := Map()   ; hwnd -> EVENT_OBJECT_CREATE TickCount
global _placeFirstSeen  := Map()   ; hwnd -> first VISIBLE sighting TickCount

; Runs on its own schedule as well as from the monitor lock.
;
; The lock was its ONLY caller, and the lock does not run at all when
; MonitorLock=0 -- the setting single-monitor users are told to pick. With it
; off, none of the thirty-odd hwnd ledgers below were ever pruned for the whole
; session. Windows recycles window handles, so every one of them slowly fills
; with entries belonging to windows that no longer exist, and each stale entry
; is a wrong answer: a recycled handle inherits "we parked this", "we cloaked
; this", or "this popup was already seen", and the code acts on it.
_PruneLedgersTick() {
    try _PrunePlacementMaps()
}

_PrunePlacementMaps() {
    global _placeCreateSeen, _placeFirstSeen, _bnetFirstMoved, _fsAlphaApplied
    global _fsDeferredPopupCloak, _moveBudget, _fsHiddenByUs, _fsShieldDown, _fsEverPainted, _cloakState, _bnetHideDone
    ; Added: these were reachable-but-unpruned ledgers. _fsBirthHidden is the
    ; important one -- its ONLY other cleanup was the timeout sweep in
    ; SuppressFirestoneMainTick, which was dead (corrupted DllCall), so it grew
    ; without bound for the whole session and kept dead HWNDs alive as keys.
    ; HWNDs are recycled by Windows, so a stale key can also make the hook
    ; mis-handle a brand-new, unrelated window.
    global _fsBirthHidden, _fsMinLastAttempt, _fsRevealFg, _bnetPostMinCount, _qtHelperLogged
    global _fsFirstTitledAt
    ; Cold-window subsystem ledgers. _fsParked is the important one: HWNDs are
    ; recycled by Windows, and a stale _fsParked key would make _FSUnparkWindow
    ; refuse to un-park a brand-new window that genuinely is parked.
    global _fsPaintState
    global _fsParked, _fsParkedRect, _fsTabRemoved, _fsBirthReassert, _fsMainLogged
    ; _fsEverShown MUST be pruned. Windows recycles HWNDs, so a stale entry
    ; would make a brand-new Firestone window look like one the user has
    ; already positioned -- and it would then open at the dead window's birth
    ; rectangle instead of centred on the primary monitor.
    global _fsEverShown
    global _fsParkCycles, _fsMainCandidate, _fsRevealDone
    global _fsRevealSettled, _fsExemptReleased, _fsOverlayRescued, _fsTransitionsOff
    ; _fsFreshKeptHidden gates a once-per-window log line; recycled HWNDs must
    ; not inherit the gate, or a genuinely new keep-hidden goes unlogged.
    global _fsFreshKeptHidden
    ; The popup ledgers. Windows recycles HWNDs, so a stale entry here either
    ; skips a genuinely new popup (seen as already-killed) or instantly ages a
    ; brand-new window past the grace and closes a Main that is still forming.
    global _fsPopupKilled, _fsPopupFirstSeen, _fsPopupKillCount
    ; The birth-cloak ledgers (see FSBirthCloakReaper) and the tracker's own
    ; conceal ledgers. All four were unpruned. The tracker pair is the more
    ; dangerous: HDT destroys and re-creates its panels constantly, and a stale
    ; key means HDTReleaseAll would ShowWindow and force-uncloak a RECYCLED
    ; handle -- by then a window belonging to some unrelated application, which
    ; is precisely the guarantee this script prints at startup.
    global _fsBirthCloaked, _fsBirthReaped, _hdtHiddenByUs, _hdtReHideCount
    global _fsSurfaceHwndLogged, _fsDisowned, _hdtPinnedByUs
    global _hdtPreCloaked, _fsAppTitled, _fsWasMainTitled, _fsHardHidden
    global _fsShielded, _fsMainExemptLogged, _hdtPreHidden, _fsPopupLogAt
    global _fsShieldOnce, _hdtBlanketLogged, _fsMainPrewarmLogged
    global _fsMainWatchSince, _fsMainTitledAt
    global _fsShieldHeldLogged, _fsMainBirth
    for m in [_placeCreateSeen, _placeFirstSeen, _bnetFirstMoved, _fsAlphaApplied
            , _fsDeferredPopupCloak, _moveBudget, _fsHiddenByUs, _fsShieldDown, _fsEverPainted, _cloakState, _bnetHideDone
            , _fsBirthHidden, _fsMinLastAttempt, _fsRevealFg, _bnetPostMinCount, _qtHelperLogged
            , _fsFirstTitledAt
            , _fsPaintState
            , _fsParked, _fsParkedRect, _fsTabRemoved, _fsBirthReassert, _fsMainLogged
            , _fsEverShown
            , _fsParkCycles, _fsMainCandidate, _fsRevealDone
            , _fsRevealSettled, _fsExemptReleased, _fsOverlayRescued, _fsTransitionsOff
            , _fsFreshKeptHidden
            , _fsPopupKilled, _fsPopupFirstSeen, _fsPopupKillCount
            , _fsBirthCloaked, _fsBirthReaped, _hdtHiddenByUs, _hdtReHideCount
            , _fsSurfaceHwndLogged, _fsDisowned, _hdtPinnedByUs
            , _hdtPreCloaked, _fsAppTitled, _fsWasMainTitled, _fsHardHidden
            , _fsShielded, _fsMainExemptLogged, _hdtPreHidden, _fsPopupLogAt
            , _fsShieldOnce, _hdtBlanketLogged, _fsMainPrewarmLogged
            , _fsMainWatchSince, _fsMainTitledAt
            , _fsShieldHeldLogged, _fsMainBirth
] {
        dead := []
        for h in m {
            if !DllCall("user32\IsWindow", "Ptr", h)
                dead.Push(h)
        }
        for h in dead
            m.Delete(h)
    }
}

_LockProcWindowsToChosenMonitor(exe, exactTitle := "", minAgeMs := 0) {
    global ChosenMonIdx, _placeCreateSeen, _placeFirstSeen, _bnetPostMinUntil
    global _bnetHideDone, _bnetHiddenByUs
    static lastPrune := 0

    if (exe = "Battle.net.exe" && _bnetPostMinUntil > A_TickCount)
        return
    idx := ChosenMonIdx ? ChosenMonIdx : MonitorGetPrimary()

    if (A_TickCount - lastPrune > 5000) {
        lastPrune := A_TickCount
        try _PrunePlacementMaps()
    }

    waL := 0, waT := 0, waR := 0, waB := 0
    try {
        _SafeWorkArea(idx, &waL, &waT, &waR, &waB)
    } catch {
        return
    }
    monW := waR - waL
    monH := waB - waT
    if (monW <= 0 || monH <= 0)
        return

    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows false
    SetTitleMatchMode(2)

    try {
        for hwnd in WinGetList("ahk_exe " . exe) {
            try {
                ; ── NEVER PLACE A BATTLE.NET SERVICE WINDOW ─────────────────
                ; The enumeration above already skips hidden windows, but a
                ; service surface that flickers visible for a single frame
                ; before we re-hide it could still be caught here and MOVED,
                ; which is the jump the owner reported seeing. A window this
                ; script has hidden is not a window it should be positioning.
                ;
                ; Within Battle.net.exe only the real client window is placed;
                ; every other surface it owns -- login shell, helpers, popups --
                ; is a service window and is hidden, not moved. Agent.exe has
                ; no window a user ever looks at, so none of it is placed.
                if (_bnetHideDone.Has(hwnd) || _bnetHiddenByUs.Has(hwnd))
                    continue
                if (exe = "Agent.exe")
                    continue
                if (exe = "Battle.net.exe" && !_IsProtectedBNetMain(hwnd))
                    continue
                if IsIMEWindow(hwnd)
                    continue
                if IsHelperWindow(hwnd)
                    continue
                if (exactTitle != "" && WinGetTitle("ahk_id " . hwnd) != exactTitle)
                    continue
                if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
                    continue
                if (WinGetMinMax("ahk_id " . hwnd) = -1)
                    continue

                if (minAgeMs > 0) {
                    anchor := 0
                    if _placeCreateSeen.Has(hwnd)
                        anchor := _placeCreateSeen[hwnd]
                    else if _placeFirstSeen.Has(hwnd)
                        anchor := _placeFirstSeen[hwnd]
                    else {
                        _placeFirstSeen[hwnd] := A_TickCount
                        continue
                    }
                    if (A_TickCount - anchor < minAgeMs)
                        continue
                }

                WinGetPos(&x, &y, &w, &h, "ahk_id " . hwnd)
                if (w < 200 || h < 150)
                    continue

                if (GetMonitorIndexForPoint(x + w // 2, y + h // 2) = idx) {
                    _MoveBudgetReset(hwnd)
                    continue
                }
                if !_MoveBudgetAllows(hwnd)
                    continue

                newX := (w <= monW) ? waL + (monW - w) // 2 : waL
                newY := (h <= monH) ? waT + (monH - h) // 2 : waT
                _MoveBudgetNote(hwnd)
                WinMove(newX, newY, , , "ahk_id " . hwnd)
            } catch {
            }
        }
    }

    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
}

; One‑shot placement pass scheduled by the window event hook.
_HookedPlacementPass() {
    global CFG
    if !CFG.lockWindowsToChosenMonitor
        return
    _LockProcWindowsToChosenMonitor("Battle.net.exe", , 400)
    ; Agent.exe is NOT locked. It is a Blizzard service window and this
    ; script hides it, and a hidden window does not need placing -- the
    ; only thing the lock could do is move it, which is the jump from the
    ; primary monitor to the chosen one that the owner reported seeing.
    ; Only Hearthstone and the Battle.net LAUNCHER are placed, because
    ; those are the two windows a user actually looks at.
}

; ══════════════════════════════════════════════════════════════════════════════
; Battle.net FIRST‑FRAME placement (isolated subsystem)
; ══════════════════════════════════════════════════════════════════════════════
; Moves Battle.net/Agent windows once, immediately at first visibility, to the
; chosen monitor. This catches the loader/splash that would otherwise sit on
; the primary monitor for 400ms+.
global _bnetFirstMoved := Map()
global _bnetFirstShowUntil := 0

_BNetFirstShowPlace(hwnd) {
    global CFG, ChosenMonIdx, _bnetFirstMoved, _bnetCloakActive
    if (!CFG.preShowPlaceBNet || !CFG.lockWindowsToChosenMonitor || !ChosenMonIdx)
        return
    if _bnetFirstMoved.Has(hwnd)
        return
    ; ONLY place the real launcher. During the services blanket, every other
    ; Battle.net window is a SERVICE surface (splash / maintenance / Agent)
    ; that gets SW_HIDDEN -- moving it (even cloak-wrapped) was the residual
    ; primary flicker. Placing is exclusively for the window the user WILL
    ; see; services are hidden, never moved.
    if (_BNetBlanketActive() && !_IsProtectedBNetMain(hwnd))
        return
    try {
        if (DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr") != hwnd)
            return
        if !DllCall("user32\IsWindowVisible", "Ptr", hwnd)
            return
        if IsIMEWindow(hwnd)
            return
        if IsHelperWindow(hwnd)
            return
        exStyle := 0
        try exStyle := WinGetExStyle("ahk_id " . hwnd)
        if (exStyle & 0x80)                       ; WS_EX_TOOLWINDOW
            return

        rc := Buffer(16, 0)
        if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rc)
            return
        bx := NumGet(rc, 0, "Int"), by := NumGet(rc, 4, "Int")
        bw := NumGet(rc,  8, "Int") - bx
        bh := NumGet(rc, 12, "Int") - by
        if (bw < 100 || bh < 60)
            return

        if (GetMonitorIndexForPoint(bx + bw // 2, by + bh // 2) = ChosenMonIdx) {
            _bnetFirstMoved[hwnd] := true
            return
        }

        _SafeWorkArea(ChosenMonIdx, &waL, &waT, &waR, &waB)
        waW := waR - waL
        waH := waB - waT
        if (waW <= 0 || waH <= 0)
            return
        nx := (bw <= waW) ? waL + (waW - bw) // 2 : waL
        ny := (bh <= waH) ? waT + (waH - bh) // 2 : waT
        ; INVISIBLE reposition: cloak, move, uncloak. A bare move here made a
        ; wrong-monitor Battle.net window (often a transient service surface)
        ; flash on primary then jump -- the second primary flicker. Cloaking
        ; for the move composites neither the wrong-monitor frame nor the jump.
        ; Track whether WE already had it cloaked (arbitrated _cloakState),
        ; so we only uncloak if we cloaked it here -- never fight a cloak
        ; another system is intentionally holding.
        global _cloakState
        wasCloaked := _cloakState.Has(hwnd)
        if !wasCloaked
            CloakWindow(hwnd, false, "_BNetFirstShowPlace")
        DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
            , "Int", nx, "Int", ny, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0004 | 0x0010)
        if !wasCloaked {
            Sleep(15)
            UncloakWindow(hwnd, false, "_BNetFirstShowPlace")
        }
        _bnetFirstMoved[hwnd] := true
    } catch {
    }
}

StartBNetFirstShowAssist(durationMs := 90000) {
    global _bnetFirstShowUntil, _bnetFirstMoved, CFG
    if (!CFG.preShowPlaceBNet || !CFG.lockWindowsToChosenMonitor)
        return
    _bnetFirstShowUntil := A_TickCount + durationMs
    fresh := Map()
    for h in _bnetFirstMoved {
        if DllCall("user32\IsWindow", "Ptr", h)
            fresh[h] := true
    }
    _bnetFirstMoved := fresh
    SetTimer(_BNetFirstShowTick, 15)
    _BNetFirstShowTick()
}

StopBNetFirstShowAssist() {
    global _bnetFirstShowUntil
    _bnetFirstShowUntil := 0
    SetTimer(_BNetFirstShowTick, 0)
}

_BNetFirstShowTick() {
    ; ══════════════════════════════════════════════════════════════════════
    ;  THE 15ms ASSIST IS DELETED. IT POLLED FOR WHAT THE HOOK ALREADY DOES.
    ; ══════════════════════════════════════════════════════════════════════
    ; This ran every 15ms for the whole launch -- sixty-six passes a second,
    ; enumerating two Battle.net executables each time -- and called
    ; _BNetFirstShowPlace on every window it found.
    ;
    ; The window event hook ALREADY calls _BNetFirstShowPlace(hwnd) on EV_SHOW.
    ; Same function, same window, at the moment the window is actually shown.
    ; So this timer could only ever repeat work that had already been done, and
    ; it did it during the exact seconds Firestone Main is born.
    ;
    ; Placement is an event, not a state to be polled for: a window is shown
    ; once, and that is when it needs placing. Keeping a 66Hz poll alongside the
    ; event is how the two systems came to contend at all.
    ;
    ; Left as an empty function rather than deleted outright so the arm/disarm
    ; callers stay valid; StopBNetFirstShowAssist still stops the timer.
    StopBNetFirstShowAssist()
}

; ── Launch‑phase placement assist ─────────────────────────────────────────────
; During F2, Battle.net (and sometimes the Blizzard Agent) create/re‑show their
; windows on whatever monitor Windows picks. This assist (250ms) and
; MonitorLockTick (1s) are polling backstops.
global _launchPlaceActive := false

StartLaunchPlaceAssist() {
    global _launchPlaceActive
    _launchPlaceActive := true
    SetTimer(_LaunchPlaceTick, 250)
    _LaunchPlaceTick()
}

StopLaunchPlaceAssist() {
    global _launchPlaceActive
    _launchPlaceActive := false
    SetTimer(_LaunchPlaceTick, 0)
}

_LaunchPlaceTick() {
    global _launchPlaceActive, CFG
    if !_launchPlaceActive {
        SetTimer(_LaunchPlaceTick, 0)
        return
    }
    if !CFG.lockWindowsToChosenMonitor
        return
    _LockProcWindowsToChosenMonitor("Battle.net.exe", , 400)
    ; Agent.exe is NOT locked. It is a Blizzard service window and this
    ; script hides it, and a hidden window does not need placing -- the
    ; only thing the lock could do is move it, which is the jump from the
    ; primary monitor to the chosen one that the owner reported seeing.
    ; Only Hearthstone and the Battle.net LAUNCHER are placed, because
    ; those are the two windows a user actually looks at.
}

; ==============================================================================
; SECTION 11f: FRONT KEEPER — the revealed overlay stays in front
; ==============================================================================
;
; WHAT THIS FIXES: "I press F3, the window comes up, and a moment later it is
; behind the game again."
;
; Both reveal paths already pin their windows HWND_TOPMOST -- FSRevealTick for
; Firestone, HDTReleaseAll for the tracker -- and both do it EXACTLY ONCE per
; window per reveal. That cap is deliberate and it is right: without it the
; Firestone reveal fired hundreds of SetWindowPos calls per F3 press for the
; whole reveal window, which is what used to kill Main after a dozen rapid
; presses.
;
; But a one-shot pin assumes nothing ever takes it away, and several things
; routinely do:
;
;   * _FSOrderBattlegroundsOverMain calls SetWindowPos with an explicit
;     insert-after window. Windows clears WS_EX_TOPMOST on the moved window
;     whenever the window it is inserted behind is not itself topmost, so the
;     ordering pass can silently un-pin Main.
;   * The monitor lock moves these windows when they land on the wrong screen,
;     and a move is a z-order operation.
;   * Overwolf and the tracker both re-create and re-position their own
;     windows -- panel switches, a match starting, a settings change.
;   * Any other application going topmost, full-screen or exclusive.
;
; So the pin needs an owner that re-asserts it, and this is that owner. It is
; a REPAIR, not a policy: it only ever re-applies a pin this script already
; decided on and recorded, never pins anything new. A window is touched only
; when it has lost the bit, so the steady-state cost is one cheap
; GetWindowLong per interesting window per tick and no SetWindowPos at all.
;
; SCOPE, and it is deliberately narrow:
;   * Firestone Main and Battlegrounds, and only while the F3 lock is OFF.
;   * The tracker's windows, and only while they are not hidden.
;   * NEVER the in-game overlay. That belongs to OverlayTopmostTick, whose own
;     notes explain why forcing it topmost breaks Hearthstone's fullscreen
;     detection and leaves the taskbar drawn over the game.
;   * Nothing at all when neither overlay is revealed, which is the whole of a
;     normal match.
;
; The pins are recorded in _fsPinnedByUs / _hdtPinnedByUs and dropped by the
; same janitors that already existed, so this adds no new way to strand a
; window: everything it can do is undone by the re-lock, F4 and ExitCleanup.
global _fsPinnedByUs := Map()   ; hwnd -> true: WE set WS_EX_TOPMOST on this

; Give back a topmost bit this script added. The mirror of _HDTDropOurPin, and
; it exists for the same reason: a window that was ALREADY topmost when we
; found it must be left topmost, or the reveal would quietly demote something
; Overwolf deliberately pinned.
_FSDropOurPin(hwnd) {
    _FSTraceNote(hwnd, "drop topmost")
    global _fsPinnedByUs
    if !_fsPinnedByUs.Has(hwnd)
        return
    _MapDrop(_fsPinnedByUs, hwnd)
    try DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -2   ; HWND_NOTOPMOST
        , "Int", 0, "Int", 0, "Int", 0, "Int", 0
        , "UInt", 0x0001 | 0x0002 | 0x0010)                     ; NOSIZE|NOMOVE|NOACTIVATE
}

_IsTopmost(hwnd) {
    static fn := (A_PtrSize = 8) ? "user32\GetWindowLongPtrW" : "user32\GetWindowLongW"
    ex := 0
    try ex := DllCall(fn, "Ptr", hwnd, "Int", -20, "Ptr")   ; GWL_EXSTYLE
    return (ex & 0x00000008) ? true : false                 ; WS_EX_TOPMOST
}

; ── THE FRONT KEEPER IS GONE ────────────────────────────────────────────────
;
; It ran every 400ms while an overlay was revealed and re-applied
; WS_EX_TOPMOST to any overlay window that had lost it. Overwolf and DWM drop
; that bit on their own, repeatedly, so every pin was answered by a drop and
; every drop provoked another pin -- an argument with the application over a
; window neither side would let go of. The logs show 37 of those re-pins.
;
; That is the same shape as everything else in this file that has ever
; destroyed Firestone Main: not one destructive act, but sustained repetition
; against a Chromium window. This file's own conclusion, reached by
; measurement, is that repetition is what kills them.
;
; It is removed rather than throttled, because throttling a fight is still
; fighting. Concealment does not need it: F3 hides and shows the overlay
; through one path that already works, and a revealed window that ends up
; behind a fullscreen game is something the user can fix with a click. A
; destroyed overlay is not.
;
; _FSDropOurPin survives on purpose -- it REMOVES a topmost bit and is still
; called during cleanup, so a pin left behind by an older build or by another
; path is still given back.

; ==============================================================================
; SECTION 12: TIMER HELPERS
; ==============================================================================
; Tiny shared utilities for starting/stopping groups of timers cleanly.
;

CancelLaunchTimers() {
    global _lateHSUntil, _bnetLaunchFiredAt


    StopLaunchPlaceAssist()
    StopBNetFirstShowAssist()
    SetTimer(LaunchHudWatchdog,       0)
    SetTimer(LaunchStateMachine_Tick, 0)
    SetTimer(PostLoginLaunch,         0)
    SetTimer(LateHSWatch,             0)
    ; BNetMinimizeSequenceTick is deliberately NOT stopped here.
    ;
    ; CancelLaunchTimers has six call sites -- the ceiling abort, the LOGIN_WAIT
    ; abort, F2's stale-pipeline recovery, F4, and the two success paths. A timer
    ; stopped by all of them and restarted by only one is a timer that eventually
    ; stays stopped, and since this sequence is the only thing that minimises the
    ; launcher, that would mean the launcher never minimises at all.
    ;
    ; The sequence is self-governing instead: armed once, at the reveal, and it
    ; stops itself the moment it has minimised or reached its ceiling. Nothing else
    ; needs to know it exists.
    SetTimer(_BNetDwellMinimize,      0)   ; a pending dwell-minimize must
    SetTimer(MinimizeBNetAfterDwell,  0)   ; not fire into a post-abort reveal
    SetTimer(_BNetSequenceMinimizeNow, 0)  ; nor may the scheduled one -- it is
                                           ; armed as a one-shot when Play fires
                                           ; and would otherwise outlive the
                                           ; launch that armed it
    StopBNetPostLaunchMinimize()           ; -- nor may the post-Play linger
    StopBNetStallWatch()
    _lateHSUntil := 0
    _bnetLaunchFiredAt := 0
    StopLauncherHide()
}

; ==============================================================================
; SECTION 13: UPDATE CHECK — is the user running the current release?
; ==============================================================================
;
; Asks GitHub, once per run, whether a newer release exists. If one does, it
; says so quietly and offers to fetch it. It never installs anything by itself.
;
; ── THE HARD CONSTRAINT: THIS MUST NOT BLOCK ──────────────────────────────────
; AutoHotkey interrupts a thread BETWEEN lines, never inside one. A synchronous
; HTTP call is a single line, so a hanging request freezes the entire script --
; hotkeys, watchdogs, F4, all of it -- for as long as the socket takes to give
; up. On a captive-portal hotel wifi that is thirty seconds of a dead keyboard,
; and the user has no way to connect it to a version check they never asked for.
;
; So the request is issued ASYNCHRONOUSLY and polled from a timer. Each poll is
; a non-blocking WaitForResponse(0) that returns immediately either way, and the
; whole exchange is abandoned at a deadline regardless of what the socket is
; doing. The worst case for the rest of the script is one extra timer tick.
;
; ── FAIL SILENT, ALWAYS ───────────────────────────────────────────────────────
; No network, DNS poisoned by an ad-blocker, GitHub down, corporate proxy, rate
; limit, malformed JSON, a tag someone typed as "final2" -- every one of these
; ends in a log line and nothing else. A version check is a convenience. It has
; no business producing an error message for a script whose job is to launch a
; game, and a user who sees "update check failed" on a machine that is working
; perfectly has been given a problem rather than a service.
;
; ── TWO SOURCES, IN ORDER ─────────────────────────────────────────────────────
;   1. The GitHub Releases API. The correct answer when a release was published
;      properly, and it carries the download URL for the attached .ahk.
;   2. version.json in the repository. The fallback, for the two cases the API
;      cannot cover: a release that was tagged but never published as a Release,
;      and an IP that has exhausted the 60-per-hour unauthenticated rate limit.
;      A shared address behind one NAT reaches that limit; a home connection
;      never will.
;
; Whichever answers first wins, and the second is not consulted.
;
; ── WHAT IT DOES NOT DO ───────────────────────────────────────────────────────
; It does not replace the running script. An elevated process overwriting its
; own source file while AutoHotkey holds it open is how an install gets
; corrupted, and the failure lands on a user who was told the update was safe.
; The download lands BESIDE the current file, named for its version, and the
; user swaps it themselves. That also means a bad release is one deletion away
; from being undone rather than a reinstall.
;
; It sends nothing. The request is a plain GET with a User-Agent (GitHub rejects
; API calls without one). No identifier, no version, no telemetry: the machine
; asks what the newest version is and decides for itself whether it is behind.

; ── The repository this build checks against ─────────────────────────────────
; These are the FALLBACKS. HSBG Config.ini overrides all three (UpdateOwner,
; UpdateRepo, UpdateBranch), which is what makes the update path testable
; without editing the script: point a test build at a repository whose latest
; release is deliberately newer, and the whole pipeline can be exercised for
; real. See the update self-test script shipped alongside this one.
;
; The name was "HSBG-Script-Final", which is not where releases are published.
; The check still succeeded -- that repository exists and answered -- so the
; failure was silent and specific: it compared this build against a DIFFERENT
; repository's version history and cheerfully reported the wrong answer.
;
;   UPDATE this build (v5.1.0) is current; newest published is v5.0.0
;
; That line is from a real session. It is not a network error, a rate limit or
; a parse failure -- it is the update checker working perfectly against the
; wrong repository, which is the one class of fault a "fail silent" design
; cannot surface. A user on v4.0.0 would have been told they were current.
;
; The three variables are DECLARED AT THE TOP OF THIS FILE, next to HSBG_BUILD,
; not here. LoadUserConfig() can override them from HSBG Config.ini and it runs
; as a top-level statement long before this point in the source, so a
; declaration here would execute afterwards and silently overwrite whatever the
; user configured. See the note beside HSBG_BUILD.

global _updHttp        := ""        ; the in-flight request object
global _updDeadline    := 0         ; abandon the exchange at this tick
global _updStage       := ""        ; "api" | "raw" -- which source is in flight
global _updNewVersion  := ""        ; tag of the newer release, once known
global _updDownloadUrl := ""        ; direct .ahk URL, when the release has one
global _updChecked     := false     ; one check per run, whatever the outcome

_UpdReleasesPage() {
    global HSBG_REPO_OWNER, HSBG_REPO_NAME
    return "https://github.com/" . HSBG_REPO_OWNER . "/" . HSBG_REPO_NAME
         . "/releases/latest"
}

; ── Self-check: is this build pointed at a repository that can answer? ───────
; Returns "" when the configuration is usable, or a human-readable reason when
; it is not. Called once at start-up so a misconfigured fork says so in the log
; instead of silently comparing against nothing -- the failure mode that let
; "newest published is v5.0.0" be reported by a v5.1.0 build for weeks.
_UpdConfigProblem() {
    global HSBG_REPO_OWNER, HSBG_REPO_NAME, HSBG_BUILD
    if (Trim(HSBG_REPO_OWNER) = "" || Trim(HSBG_REPO_NAME) = "")
        return "no repository is configured"
    if !IsObject(_UpdParseVersion(HSBG_BUILD))
        return "this build's own version stamp (" . HSBG_BUILD
             . ") is not a version number, so nothing can be compared against it"
    return ""
}

; ------------------------------------------------------------------------------
; Version comparison
; ------------------------------------------------------------------------------
;
; Semantic, not lexical. "v4.10.0" is NEWER than "v4.9.0", and a string compare
; says the opposite -- which would tell every user on 4.10 to downgrade, and
; keep telling them, forever. Two-part versions are accepted and padded, so
; "4.1" and "v4.1.0" compare equal.
;
; A pre-release suffix ("-beta", "+build") is trimmed rather than ordered. Doing
; it properly means implementing the whole semver precedence table; trimming
; means a beta of 5.0.0 reads as 5.0.0, which for a "should I update?" question
; is the answer the user wants anyway.
_UpdParseVersion(raw) {
    v := Trim(raw)
    v := RegExReplace(v, "^[vV]", "")           ; a leading v is decoration
    v := RegExReplace(v, "[-+].*$", "")         ; drop pre-release / build
    parts := []
    for piece in StrSplit(v, ".") {
        piece := Trim(piece)
        if !IsInteger(piece)
            return ""                            ; not a version we understand
        parts.Push(Integer(piece))
    }
    if (parts.Length = 0 || parts.Length > 4)
        return ""
    while (parts.Length < 3)
        parts.Push(0)
    return parts
}

; Returns 1 if a > b, -1 if a < b, 0 if equal. Returns "" if either is
; unparseable, which every caller treats as "do not claim anything".
_UpdCompare(aRaw, bRaw) {
    a := _UpdParseVersion(aRaw)
    b := _UpdParseVersion(bRaw)
    ; IsObject, not a comparison against "": _UpdParseVersion returns either an
    ; Array or an empty string, and testing an Array with = is a type error in
    ; AutoHotkey v2 -- which would throw inside the one subsystem whose entire
    ; contract is that it fails silently.
    if (!IsObject(a) || !IsObject(b))
        return ""
    loop 3 {
        if (a[A_Index] > b[A_Index])
            return 1
        if (a[A_Index] < b[A_Index])
            return -1
    }
    return 0
}

; ------------------------------------------------------------------------------
; The check itself
; ------------------------------------------------------------------------------

; Armed from a deferred timer at start-up, never from a hotkey. Ten seconds in,
; the launch sequence a user may have started with F2 is already past its
; window-thrashing phase, and this costs it nothing.
UpdateCheckStart() {
    global CFG, _updChecked, HSBG_REPO_OWNER, HSBG_REPO_NAME, HSBG_BUILD
    if !CFG.updateCheck
        return
    if _updChecked
        return

    ; Say what is about to be asked, and of whom, BEFORE asking. When an update
    ; check misbehaves the first question is always "which repository did it
    ; actually query?", and until this line existed the log could not answer it.
    problem := _UpdConfigProblem()
    if (problem != "") {
        _FSLog("UPDATE not checking -- " . problem)
        return
    }
    _updChecked := true
    _FSLog("UPDATE checking " . HSBG_REPO_OWNER . "/" . HSBG_REPO_NAME
         . " for anything newer than " . HSBG_BUILD)
    _UpdBegin("api")
}

; Force a fresh check, from the tray. The once-per-run latch exists so a check
; is not repeated on its own; a user who asks for one by hand has overridden
; that, and an in-flight request is abandoned rather than raced.
UpdateCheckNow() {
    global _updChecked, _updHttp, CFG
    if !CFG.updateCheck {
        try BgHUD.Show("Update checks are switched off in the settings file", 3000)
        return
    }
    try SetTimer(_UpdPollTick, 0)
    _UpdCleanup()
    _updChecked := false
    try BgHUD.Show("Checking for updates…", 1500)
    UpdateCheckStart()
}

_UpdBegin(stage) {
    global _updHttp, _updDeadline, _updStage
    global HSBG_REPO_OWNER, HSBG_REPO_NAME, HSBG_REPO_BRANCH
    _updStage := stage

    ; Three sources, tried in order. The third exists because the raw URL has to
    ; name a BRANCH, and a branch name is the one part of this configuration a
    ; fork is most likely to get wrong -- this repository publishes from FINAL,
    ; most publish from main. A wrong branch is a 404, which is
    ; indistinguishable from "no version.json", so rather than make the user
    ; diagnose it the fallback simply tries the other convention.
    if (stage = "api")
        url := "https://api.github.com/repos/" . HSBG_REPO_OWNER . "/"
             . HSBG_REPO_NAME . "/releases/latest"
    else if (stage = "raw")
        url := "https://raw.githubusercontent.com/" . HSBG_REPO_OWNER . "/"
             . HSBG_REPO_NAME . "/" . HSBG_REPO_BRANCH . "/version.json"
    else
        url := "https://raw.githubusercontent.com/" . HSBG_REPO_OWNER . "/"
             . HSBG_REPO_NAME . "/main/version.json"

    try {
        _updHttp := ComObject("WinHttp.WinHttpRequest.5.1")
        ; resolve, connect, send, receive. Generous enough for a slow link,
        ; bounded enough that the deadline below is a backstop and not the
        ; mechanism.
        _updHttp.SetTimeouts(4000, 4000, 4000, 8000)
        _updHttp.Open("GET", url, true)          ; true = asynchronous
        ; GitHub refuses API requests with no User-Agent. Naming the script
        ; rather than spoofing a browser is both honest and easier to allow
        ; through a proxy.
        _updHttp.SetRequestHeader("User-Agent", "HSBG-UpdateCheck")
        if (stage = "api")
            _updHttp.SetRequestHeader("Accept", "application/vnd.github+json")
        _updHttp.Send()
    } catch as e {
        _FSLog("UPDATE could not start the " . stage . " request ("
             . e.Message . ") -- skipping the version check for this run")
        _UpdCleanup()
        return
    }

    _updDeadline := A_TickCount + 15000
    SetTimer(_UpdPollTick, 250)
}

; Non-blocking poll. WaitForResponse(0) returns at once whether or not the
; response has landed, which is the entire reason this is a timer rather than a
; straight-line call.
_UpdPollTick() {
    global _updHttp, _updDeadline, _updStage

    if !_updHttp {
        SetTimer(_UpdPollTick, 0)
        return
    }

    if (A_TickCount > _updDeadline) {
        _FSLog("UPDATE the " . _updStage . " request did not answer within"
             . " 15s -- abandoned. Nothing is wrong with this script; the"
             . " version check simply did not complete.")
        _UpdAdvanceOrStop()
        return
    }

    ready  := false
    failed := false
    try {
        ready := _updHttp.WaitForResponse(0)
    } catch {
        ; The request failed outright -- no route, TLS refused, DNS miss. That
        ; is an answer, and the answer is "not this source".
        failed := true
    }
    if failed {
        _UpdAdvanceOrStop()
        return
    }
    if !ready
        return

    status := 0
    body   := ""
    try {
        status := _updHttp.Status
        body   := _updHttp.ResponseText
    } catch {
        _UpdAdvanceOrStop()
        return
    }

    if (status != 200) {
        _FSLog("UPDATE " . _updStage . " returned HTTP " . status
             . (status = 403 ? " (rate limit -- this is per-IP and clears"
                             . " within the hour)" : ""))
        _UpdAdvanceOrStop()
        return
    }

    stage := _updStage
    SetTimer(_UpdPollTick, 0)
    _UpdHandleBody(stage, body)
}

; The API failed, so try the repository file; the repository file failed, so
; stop. One place decides that, so neither path can loop.
_UpdAdvanceOrStop() {
    global _updStage, HSBG_REPO_BRANCH
    stage := _updStage
    SetTimer(_UpdPollTick, 0)
    _UpdCleanup()
    if (stage = "api") {
        _FSLog("UPDATE falling back to version.json on branch "
             . HSBG_REPO_BRANCH)
        _UpdBegin("raw")
        return
    }
    if (stage = "raw" && HSBG_REPO_BRANCH != "main") {
        _FSLog("UPDATE branch " . HSBG_REPO_BRANCH . " did not answer"
             . " -- trying main")
        _UpdBegin("raw-main")
        return
    }
    _FSLog("UPDATE no version information could be retrieved this run."
         . " This is not a fault in the script -- it launches and plays"
         . " exactly the same either way.")
}

_UpdCleanup() {
    global _updHttp
    try _updHttp := ""
}

; ------------------------------------------------------------------------------
; Reading the answer
; ------------------------------------------------------------------------------
;
; Both sources are JSON, and both are read with a regex rather than a parser.
; That is a deliberate limit, not a shortcut: exactly three string fields are
; wanted, all of them flat, and importing a JSON library to reach them would add
; several hundred lines to a single-file script for no gain in correctness.
;
; The release page URL is NOT taken from the response. GitHub's release JSON
; contains several html_url fields -- the release, the author, each asset -- and
; picking the wrong one sends the user to somebody's profile. It is built from
; the two repository constants instead, where it cannot be wrong.
_UpdHandleBody(stage, body) {
    global HSBG_BUILD, _updNewVersion, _updDownloadUrl

    _UpdCleanup()

    tag := ""
    if RegExMatch(body, '"tag_name"\s*:\s*"([^"]+)"', &m)
        tag := m[1]
    else if RegExMatch(body, '"version"\s*:\s*"([^"]+)"', &m)
        tag := m[1]

    if (tag = "") {
        _FSLog("UPDATE " . stage . " answered, but carried no version field"
             . " -- ignoring it")
        return
    }

    cmp := _UpdCompare(tag, HSBG_BUILD)
    if (cmp = "") {
        _FSLog("UPDATE cannot compare " . tag . " against this build ("
             . HSBG_BUILD . ") -- one of them is not a version number, so"
             . " nothing is claimed either way")
        return
    }
    if (cmp <= 0) {
        _FSLog("UPDATE this build (" . HSBG_BUILD . ") is current; newest"
             . " published is " . tag)
        return
    }

    _updNewVersion := tag

    ; The attached .ahk, if the release has one. A release published without an
    ; asset is still worth announcing -- the user is simply sent to the page.
    if RegExMatch(body, '"browser_download_url"\s*:\s*"([^"]*\.ahk)"', &m)
        _updDownloadUrl := m[1]
    else if RegExMatch(body, '"download"\s*:\s*"([^"]+)"', &m)
        _updDownloadUrl := m[1]

    notes := ""
    if RegExMatch(body, '"notes"\s*:\s*"([^"]*)"', &m)
        notes := m[1]

    _FSLog("UPDATE " . tag . " is available (this build is " . HSBG_BUILD
         . ")" . (notes != "" ? " -- " . notes : "")
         . (_updDownloadUrl != "" ? " -- asset: " . _updDownloadUrl
                                  : " -- no .ahk asset on the release"))

    _UpdAnnounce(tag, notes)
}

; ------------------------------------------------------------------------------
; Telling the user
; ------------------------------------------------------------------------------
;
; Once, quietly, and then it waits to be asked. A version check that interrupts
; a match has made the script worse at the thing it exists to do, and a modal
; dialog over a Battlegrounds board is exactly that. So: one toast, a changed
; tooltip that persists, and a tray item that is there whenever the user goes
; looking. No dialog, no repeat, no second toast later in the session.
_UpdAnnounce(tag, notes) {
    global HSBG_BUILD

    try A_IconTip := "Battle Grounds " . HSBG_BUILD . " - running - "
                   . tag . " available"

    try {
        A_TrayMenu.Insert("1&", "Get " . tag . " …", (*) => UpdateFetchNow())
    }

    try BgHUD.Show(tag . " is available — tray icon → Get " . tag, 6000)
}

; Fetch the new file. User-initiated, from the tray menu, and deliberately the
; only part of this subsystem that touches the disk.
;
; IT DOES NOT TOUCH THE RUNNING SCRIPT. The file lands beside it under the new
; version's name, so both exist and the user chooses when to switch. Overwriting
; A_ScriptFullPath while AutoHotkey has it open risks a half-written script that
; will not start, on a machine whose owner has just been told it was safe.
UpdateFetchNow() {
    global _updNewVersion, _updDownloadUrl

    if (_updNewVersion = "")
        return

    ; No asset on the release: the page is the honest answer.
    if (_updDownloadUrl = "") {
        _FSLog("UPDATE no downloadable .ahk on " . _updNewVersion
             . " -- opening the releases page instead")
        try Run(_UpdReleasesPage())
        return
    }

    ; The script's own folder is not always writable -- the same problem the
    ; settings file has, for the same reason. Resolved BEFORE the file is looked
    ; for, so the "already downloaded?" test and the download itself cannot
    ; disagree about where the file lives.
    dir  := _DirIsWritable(A_ScriptDir) ? A_ScriptDir : A_Temp
    dest := dir . "\HSBG Script Final " . _updNewVersion . ".ahk"

    ; Already fetched on an earlier click. Show it rather than downloading it
    ; twice, which is also what a user who clicked again is actually asking for.
    if FileExist(dest) {
        _FSLog("UPDATE " . _updNewVersion . " was already downloaded to "
             . dest . " -- opening the folder")
        try Run('explorer.exe /select,"' . dest . '"')
        try BgHUD.Show("Already downloaded — " . _updNewVersion . ".ahk", 4000)
        return
    }

    try BgHUD.Show("Downloading " . _updNewVersion . "…", 0)
    ok := false
    try {
        Download(_updDownloadUrl, dest)
        ok := FileExist(dest) ? true : false
    }

    if !ok {
        _FSLog("UPDATE the download of " . _updNewVersion . " failed"
             . " -- opening the releases page so it can be fetched by hand")
        try BgHUD.Show("Download failed — opening the releases page", 3000)
        try Run(_UpdReleasesPage())
        return
    }

    _FSLog("UPDATE downloaded " . _updNewVersion . " to " . dest
         . " -- the running script was NOT modified")
    try BgHUD.Show("Saved beside this script — exit HSBG, then run "
                 . _updNewVersion, 7000)
    try Run('explorer.exe /select,"' . dest . '"')
}

; ==============================================================================
; SECTION 14: LAUNCH PIPELINE — F2 state machine
; ==============================================================================
; States:  IDLE → HAMMERING → LOGIN_WAIT → DONE
;
;   (OW_WAIT is gone. It existed to hold the pipeline while Overwolf started,
;    back when Firestone was launched first and Hearthstone waited on it. That
;    ordering is reversed -- Firestone now starts alongside everything else on
;    F2 and nothing waits for it -- so the state was unreachable.)
;                stability before transitioning to HAMMERING.
;   HAMMERING  — Repeatedly steps TryLaunchWTCG until HS's window appears.
;                The gate walks Battle.net through client-start -> reveal ->
;                render dwell before the real launch fires; the moment HS's
;                PROCESS exists the launcher is minimized. Detects the BNet
;                login screen and transitions to LOGIN_WAIT.
;   LOGIN_WAIT — Waits for user to authenticate in Battle.net before resuming.
;   DONE       — HS window detected; cleanup, focus, lock Firestone, arm F1.
; ==============================================================================


; ── HAMMERING entry ───────────────────────────────────────────────────────────
StartHSLaunch() {
    global Cache, State, Launch, CFG, _smLastTick
    _smLastTick := A_TickCount        ; baseline the liveness stamp: see the

                                      ; stale-pipeline guard in Hotkey_F2
    SetHSMonitorPref()
    StartLaunchPlaceAssist()
    StartBNetFirstShowAssist()
    Cache.hsPath             := ""
    Launch.state             := "HAMMERING"
    Launch.retries           := 0
    Launch.lastAttempt       := 0        ; gate stepped every tick until the
                                         ; first real launch fires
    Launch.sessionStart      := A_TickCount
    Launch.loginFallbackDone := false
    Launch.loginTitleCount   := 0
    Launch.loginEnteredAt    := 0
    TryLaunchWTCG()
    SetTimer(LaunchStateMachine_Tick, CFG.hammerFastMs)
    SetTimer(LaunchHudWatchdog,       CFG.launchHudWatchMs)
}

; ── Watchdog ──────────────────────────────────────────────────────────────────
LaunchHudWatchdog() {
    global Launch
    if (Launch.state != "HAMMERING" && Launch.state != "LOGIN_WAIT")
        return
    if (!GetHSPID())
        return
    if HSWindowExists()
        CompleteHSLaunchSuccess()
}

; ── State machine tick ────────────────────────────────────────────────────────
LaunchStateMachine_Tick() {
    global Launch, Cache, State, CFG, _lateHSUntil, _bnetRevealedAt, _bnetPostMinDone, _bnetLoginAllowed, _bnetLaunchFiredAt, _smLastTick
    _smLastTick := A_TickCount

    ; ── LOGIN_WAIT GETS ITS OWN CEILING ──────────────────────────────────────
    ;
    ; It is exempt from the launch ceiling below, and correctly so -- a human
    ; typing a password should not be raced. But exempt from EVERY limit meant
    ; the pipeline could sit in LOGIN_WAIT forever, and that state is not inert:
    ; the tick keeps stamping _smLastTick, so _LaunchPipelineAlive() stays true,
    ; so F1 answers "launch in progress" and F2 answers "already launching" on
    ; every press for the rest of the session. Two of the four hotkeys dead,
    ; with nothing able to recover them.
    ;
    ; It does not take a real login screen to get stuck there. The detector
    ; matches the substrings "log in" / "sign in" in ANY Battle.net window title
    ; including hidden ones, so a background CEF window that keeps such a title
    ; after a successful login satisfies the exit test's negation forever.
    ;
    ; Thirty minutes is longer than any genuine sign-in and is the same budget
    ; the README already promises for a large patch. Falling out of it aborts
    ; the pipeline the same way the launch ceiling does, which frees both keys.
    if (Launch.state = "LOGIN_WAIT" && Launch.loginEnteredAt
     && A_TickCount - Launch.loginEnteredAt > CFG.loginWaitCeilingMs) {
        _FSLog("LAUNCH LOGIN_WAIT ceiling reached after "
             . ((A_TickCount - Launch.loginEnteredAt) // 1000) . "s -- aborting the"
             . " pipeline so F1 and F2 are usable again")
        Launch.state := "HAMMERING"      ; fall into the ceiling abort below
        Launch.sessionStart := 0
    }

    ; Hard ceiling (CFG.launchCeilingMs, default 5 min).
    if (Launch.state != "LOGIN_WAIT"
     && A_TickCount - Launch.sessionStart > CFG.launchCeilingMs) {
        Launch.state   := "IDLE"
        State.f2Active := false
        CancelLaunchTimers()
        StopHSCloaker()
        BgHUD.Hide()
        try {
            prev := A_DetectHiddenWindows
            DetectHiddenWindows true
            for hwnd in WinGetList("ahk_exe Hearthstone.exe") {
                try UncloakWindow(hwnd, false, "LaunchStateMachine_Tick")
            }
            DetectHiddenWindows prev
        }
        RevealBNetWindows()            ; foreground the launcher if never done
        RestoreHiddenBNetServices()    ; and un-hide any service surface --
                                       ; the stall may BE a maintenance screen
        ; COLD‑LAUNCH RECOVERY: watcher for late HS appearance.
        _lateHSUntil := A_TickCount + 600000
        SetTimer(LateHSWatch, 5000)
        BgHUD.Show("Launch slow — watching for HS in background", 2500)
        return
    }

    ; ── LOGIN_WAIT ────────────────────────────────────────────────────────────
    if (Launch.state = "LOGIN_WAIT") {
        if HSWindowExists() {
            CompleteHSLaunchSuccess()
            return
        }
        if !ProcessExist("Battle.net.exe") {
            Launch.state   := "IDLE"
            State.f2Active := false
            CancelLaunchTimers()
            StopHSCloaker()
            BgHUD.Hide()
            try {
                prev := A_DetectHiddenWindows
                DetectHiddenWindows true
                for hwnd in WinGetList("ahk_exe Hearthstone.exe") {
                    try UncloakWindow(hwnd, false, "LaunchStateMachine_Tick")
                }
                DetectHiddenWindows prev
            }
            RevealBNetWindows()
            RestoreHiddenBNetServices()   ; Agent may outlive Battle.net
            return
        }
        if !BNetLoginOrAuthScreen() {
            if Launch.loginEnteredAt {
                Launch.sessionStart  += A_TickCount - Launch.loginEnteredAt
                Launch.loginEnteredAt := 0
            }
            _bnetLoginAllowed      := false   ; login done: the blanket owns
                                              ; Battle.net.exe again
            Launch.state           := "HAMMERING"
            Launch.retries         := 0
            Launch.lastAttempt     := 0
            Launch.loginTitleCount := 0
            SetTimer(LaunchStateMachine_Tick, 0)
            SetTimer(PostLoginLaunch, -1500)
        }
        return
    }

    ; ── HAMMERING ─────────────────────────────────────────────────────────────
    if (Launch.state = "HAMMERING") {
        ; Keep the tick FAST through the entire BNet pre-nav/reveal/dwell
        ; sequence. These stages fire on wall-clock deltas, so a slowed tick
        ; would only ADD latency between them -- the main source of the
        ; "sometimes fast, sometimes slow" launch. Fast cadence until HS's
        ; window actually exists makes the pacing consistent.
        if (_bnetRevealedAt != 0 && !HSWindowExists())
            SetTimer(LaunchStateMachine_Tick, CFG.hammerFastMs)
        if HSWindowExists() {
            CompleteHSLaunchSuccess()
            return
        }

        ; Hearthstone's PROCESS exists — Battle.net launched it. Minimize the
        ; launcher (once), but ONLY after it has been visible long enough to
        ; render: the reveal dwell plus the post-play linger, measured from
        ; the reveal. Without this wait, HS's process (which appears at
        ; Stage 4) could trigger this minimize DURING Stage 5's linger,
        ; before the launcher painted the game page -- the "pops up then
        ; minimizes faster than it can render". Stage 5 and this share the
        ; timing and the _bnetPostMinDone flag, so exactly one minimize fires.
        ; (The HS-PID minimize backstop that lived here is gone.) It was
        ; trigger 2 of 5, and it duplicated -- with a slightly different
        ; anchor, hence a slightly different answer -- exactly what
        ; BNetMinimizeSequenceTick now does properly: wait for Hearthstone's
        ; process, then linger, then minimize. Two things computing the same
        ; deadline from different starting points is how the sequence became
        ; unpredictable in the first place.

        Launch.retries++

        loginDetected := false
        if (!Launch.skipLoginDetect && ProcessExist("Battle.net.exe")
         && Launch.retries >= CFG.loginDetectMinRetries) {
            if BNetLoginOrAuthScreen() {
                Launch.loginTitleCount++
                ; ── A LOGIN SCREEN THAT LASTS, NOT ONE THAT FLASHES ─────
                ; This was 3 ticks. At hammerFastMs (100ms) that is THREE
                ; HUNDRED MILLISECONDS, which a transient window clears
                ; trivially -- and clearing it sets _bnetLoginAllowed, which
                ; tells _HideBlizzWindow to stop hiding EVERY Battle.net
                ; window for the rest of the launch.
                ;
                ; Measured 2026-09-07: a "Battle.net Login" window, 362x719,
                ; visible on the primary monitor for ~2 seconds and gone --
                ; Battle.net startup UI, not a prompt; the launcher went
                ; straight on to Play. It also took the foreground, which is
                ; the likeliest reason the shell dropped Hearthstone's
                ; fullscreen state and redrew the taskbar over the game.
                ;
                ; A real login prompt waits for a human, so it is still there
                ; seconds later. The only cost of the higher bar is that a
                ; genuine prompt is revealed a few seconds later.
                if (Launch.loginTitleCount >= CFG.bnetLoginPersistTicks) {
                    Launch.loginTitleCount := 0
                    ; A human has to see (and type into) the login screen:
                    ; stand the Battle.net blanket down and un-hide it.
                    _bnetLoginAllowed := true
                    UnhideBNetLoginWindows()
                    RevealBNetWindows()
                    Launch.state           := "LOGIN_WAIT"
                    Launch.loginEnteredAt  := A_TickCount
                    SetTimer(LaunchStateMachine_Tick, CFG.hammerSlowMs)
                    return
                }
                loginDetected := true
            } else {
                Launch.loginTitleCount := 0
            }
        }

        ; Same rule as OW_WAIT: once Hearthstone's process exists the launcher has done
        ; its job, and re-firing the launch command only re-surfaces it while the
        ; game's window is still forming.
        if (!loginDetected && !GetHSPID()) {
            elapsed := A_TickCount - Launch.sessionStart
            if (elapsed < 10000)
                refire := 700
            else if (ProcessExist("Battle.net.exe"))
                refire := 5000
            else
                refire := 2500

            if (Launch.lastAttempt = 0 || (A_TickCount - Launch.lastAttempt) > refire) {
                if TryLaunchWTCG()
                    Launch.lastAttempt := A_TickCount
            }
        }

        if (!GetHSPID() && !Launch.skipLoginDetect && !Launch.loginFallbackDone
         && Launch.retries >= CFG.loginFallbackMinRetries
         && (A_TickCount - Launch.sessionStart) > CFG.loginFallbackAfterMs) {
            Launch.loginFallbackDone := true
            if BNetLoginOrAuthScreen() {
                _bnetLoginAllowed := true     ; login fallback: humans must see it
                UnhideBNetLoginWindows()
                RevealBNetWindows()
                Launch.state          := "LOGIN_WAIT"
                Launch.loginEnteredAt := A_TickCount
                SetTimer(LaunchStateMachine_Tick, CFG.hammerSlowMs)
            } else {
                TryLaunchWTCG()
            }
            return
        }

        ; Back off a hammer that is getting nowhere. Counted in TICKS, so these
        ; two numbers moved with hammerFastMs when it was halved -- 100 ticks at
        ; 100ms is the same ten seconds 50 ticks at 200ms was. Getting this
        ; wrong does not break anything, it just gives up on the fast phase
        ; twice as early as intended.
        if (Launch.retries = 100)
            SetTimer(LaunchStateMachine_Tick, 500)
        else if (Launch.retries = 200)
            SetTimer(LaunchStateMachine_Tick, 1000)
        return
    }
}

; ── Post‑login deferred launch ────────────────────────────────────────────────
PostLoginLaunch() {
    global Launch, CFG
    Launch.lastAttempt := TryLaunchWTCG() ? A_TickCount : 0
    SetTimer(LaunchStateMachine_Tick, CFG.hammerFastMs)
}

; ── Launch complete ───────────────────────────────────────────────────────────
; Called as soon as the HS window is confirmed present.
CompleteHSLaunchSuccess() {
    global State, Launch, _fsBurstUntil, _fsBgWatchUntil, CFG, _fsBgEverSeen
    if (Launch.state = "DONE" || Launch.state = "IDLE")
        return
    Launch.state   := "DONE"
    State.f2Active := false

    ; Start the clock on the Battlegrounds window's lazy birth. It is created
    ; at the first Battlegrounds match, which is a couple of minutes away at
    ; most -- and until then the suppression sweep holds the faster cadence
    ; that Main was born under, instead of dropping to the settled rate this
    ; window would otherwise be the only Firestone surface born beneath. See
    ; the old coast rate. Bounded here rather than left open-ended: a session played
    ; with F3 unlocked never latches _fsBgEverSeen, so "until it appears" is
    ; not on its own a bound.
    if (CFG.fsBgBirthWatch && !_fsBgEverSeen)
        _fsBgWatchUntil := A_TickCount + CFG.fsBgBirthWatchMs

    CancelLaunchTimers()

    HideHSOnLaunch(10000)

    BgHUD.Hide()

    ; Hearthstone's window is confirmed. The reveal below is an idempotent janitor:
    ; it guarantees the launcher has been placed on every path that reaches
    ; "Hearthstone is up", including the late-recovery and watchdog completions.
    ;
    ; It deliberately does not minimise. That decision belongs to
    ; BNetMinimizeSequenceTick, which anchors it to the game having launched; a
    ; second caller forcing it here would discard the configured pause.
    RevealBNetWindows()

    StartOverlayTopmostEnforcer()

    ; The launch is over, so the suppression burst has no more newborn windows
    ; to beat. Let it decay to the coast rate shortly after HS settles instead
    ; of riding the full fsBurstMaxMs window.
    ;
    ; _fsBurstUntil MOVES WITH THE TIMER. It is what _FSEventNudge consults to
    ; decide whether an existing burst already covers a new window; leaving it
    ; at the original twenty-second horizon while the decay is pulled in to five
    ; seconds means a window created in between is refused a nudge on the
    ; grounds of a burst that is about to end. Those are exactly the seconds
    ; Firestone spends finishing Main and Battlegrounds.
    _fsBurstUntil := A_TickCount + 5000
    SetTimer(_FSBurstDecay, -5000)

    ; Post-F2 transparency repair. The symptom is reported after F2 on both the
    ; cold and restart paths, so the launch tail is exactly where it needs to
    ; be caught -- not only at startup and at F3. Cheap, and a no-op when
    ; nothing is stranded.
    SetTimer(FSRepairStuckAlpha, -1500)
    SetTimer(FSRepairStrandedWindows, -1500)

    ; NOTE: The persistent early Overwolf cloak remains active until its own
    ; conditions are met (see StartEarlyOverwolfCloak).
}

; ══════════════════════════════════════════════════════════════════════════════
; DEFERRED FIRESTONE LAUNCH (the deleted fsLaunchAfterHS)
; ══════════════════════════════════════════════════════════════════════════════
; The structural half of the Firestone-Main fix.
;
; The old order launched Firestone FIRST, at the very top of F2, so
; Firestone - Main was born into the single noisiest moment this script has:
; the 3 ms early-cloak blanket, the 10 ms loading suppressors, the 10 ms
; launcher-splash hider, the 1 ms suppression burst, the Battle.net services
; blanket at 10 ms and a five-event window hook, all live at once, all
; mutating window state, while Chromium tried to stand up a compositor for the
; first time. Even with every individual hide made paint-safe, that is a lot of
; contention to survive by design rather than by luck.
;
; This defers the Firestone launch until Hearthstone's PROCESS exists. By then
; the launch storm is over: the Battle.net sequence has fired, the launcher has
; been minimized, and the burst is decaying. Main is born into a quiet system.
;
; Overwolf detects an already-running game (it polls, it does not only watch
; for launches) and EnsureFirestoneSettings already enables
; launchFirestoneWhenGameStarts, so the overlay still attaches. Hearthstone
; needs 30-60 seconds from process start to a playable menu, so Firestone is up
; long before a Battlegrounds match can begin.




; ── FIRESTONE STARTS WHEN F2 IS PRESSED. NOT LATER, NOT ON A TIMER ──────────
;
; There is no scheduling here any more, and that is the point. What used to be
; _FSScheduleLaunch and _FSDelayedLaunch offered three different launch
; moments -- immediately, after a fixed delay, or once Hearthstone was up --
; behind two config values, and every one of them had already been argued
; against in its own comments:
;
;   * A FIXED DELAY was measured to break Firestone outright. It moved the
;     launch into Hearthstone's initialisation, Firestone attached to a process
;     that was not ready, and the session got "CRITICAL ERROR: Could not read
;     the game's memory" and no overlay. It was left in at 0 -- a value whose
;     only job was to not be used.
;   * WAITING FOR THE GAME shipped switched off, described in its own comment
;     as reordering a sequence that already worked.
;   * IMMEDIATE is what actually ran, every time.
;
; So two of the three paths were dead, and the live one went through a
; scheduler, a global flag, a timer target and a second entry point in
; RevealHSAfterLaunch to arrive at "call the launch". Every one of those was a
; place the launch could happen at an unexpected moment, or twice, and this
; script's whole difficulty with Overwolf is windows appearing when something
; else is mid-flight.
;
; Now: F2 launches Battle.net and Firestone together, and the only thing
; between the keypress and Overwolf is the guard below.
;
; THE GUARD STAYS, AND IT IS THE IMPORTANT PART. Launching a second copy of
; Overwolf is worse than not launching one at all, and the check has to happen
; HERE rather than at the call site -- LaunchFirestoneNow asks whether the MAIN
; WINDOW is open, not whether some Overwolf process exists, because Firestone
; closes to tray and routinely runs with no Main at all. The older
; FirestoneAppRunning() test read that state as "already up" and launched
; nothing, leaving the user with no overlay.
; ── FIRESTONE MUST NOT BE STARTED WHILE HEARTHSTONE IS STILL ALIVE ───────────
;
; THIS IS THE WHOLE OF "FIRESTONE MAIN CLOSES WHEN HS IS RUNNING", AND IT IS
; A HALF-SECOND OF ASSUMED SHUTDOWN.
;
; MEASURED, repeatedly, with this script not running and nothing touching any
; window. The condition that decides Firestone Main's fate is not concealment,
; not the game launching, and not how much head start Main gets. It is whether
; HEARTHSTONE WAS ALREADY RUNNING AT THE MOMENT FIRESTONE STARTED:
;
;   Firestone started while Hearthstone was ALREADY running:
;       DIED at +7797ms  -- untouched
;       DIED at +8032ms  -- untouched
;       DIED at +8031ms  -- untouched
;
;   Firestone started with Hearthstone NOT running, then the game launched
;   afterwards -- Main fully concealed the whole time:
;       0s head start  -> survived 60s
;       3s head start  -> survived 60s
;       6s head start  -> survived 60s
;       10s head start -> survived 60s
;       (and 150s in the longest run)
;
; Firestone rebuilds its own Main a few seconds after creating it if it finds
; the game already up. Nothing here causes it and nothing here can prevent it
; -- every operation in this file was cleared by experiment, including a sweep
; of 118,336 window operations. The only thing this script controls is whether
; Firestone is started INTO that condition.
;
; And the restart path was doing exactly that. ProcessClose is asynchronous: it
; asks the process to exit, and a Unity game takes seconds to finish. The
; fixed Sleep(300) + Sleep(200) above assumed it was gone after half a second,
; so Firestone was launched while Hearthstone.exe was still very much alive,
; and its Main was born into the losing state every time.
;
; BOUNDED, on the same principle as every other gate here: if the game somehow
; refuses to exit, the launch proceeds anyway and says so. A late overlay is a
; nuisance; a launch that never happens is a broken script.
_WaitForGameGone(timeoutMs := 15000) {
    if !ProcessExist("Hearthstone.exe")
        return true
    t0 := A_TickCount
    while (A_TickCount - t0 < timeoutMs) {
        if !ProcessExist("Hearthstone.exe") {
            _FSLog("RESTART Hearthstone exited after " . (A_TickCount - t0)
                 . "ms -- Firestone can start now. Starting it while the game is"
                 . " still alive makes Firestone rebuild its own Main window a"
                 . " few seconds later, which is what 'Firestone Main keeps"
                 . " closing' has always been.")
            return true
        }
        Sleep 100
    }
    _FSLog("RESTART Hearthstone was still running after " . timeoutMs . "ms --"
         . " starting Firestone anyway. Its Main window may be rebuilt shortly"
         . " after it appears; that is Firestone's own behaviour and it"
         . " recovers on its own.")
    return false
}

; ══════════════════════════════════════════════════════════════════════════════
;  START FIRESTONE -- WITH BATTLE.NET, BEFORE HEARTHSTONE
; ══════════════════════════════════════════════════════════════════════════════
;
; ORDER IS THE WHOLE THING. See CFG, above fsMainReHoldMax, for the measured
; reason: a Main created while Hearthstone is already running dies in ~8s no
; matter what is or is not done to it, and a Main that already exists when the
; game starts survives.
;
; A menu-gated variant lived here -- it read Hearthstone's own LoadingScreen.log
; for "currMode=HUB" and started Firestone at that point. It worked exactly as
; designed and was removed anyway, because starting Firestone once the game has
; reached its menu IS the fatal order. It is not coming back; the alternative
; has no switch for the same reason.
; ══════════════════════════════════════════════════════════════════════════════
;  STOP OVERWOLF CLOSING FIRESTONE'S WINDOWS IN-GAME
; ══════════════════════════════════════════════════════════════════════════════
;
; THE CAUSE, FROM FIRESTONE'S OWN MANIFEST. Two of the windows this script
; manages are declared desktop_only:
;
;   CollectionWindow      desktop_only: true   <- "Firestone - Main"
;   BattlegroundsWindow   desktop_only: true   <- "Firestone - Battlegrounds"
;
; Overwolf closes desktop-only windows while a game is running. That is the
; whole reason Firestone Main disappears a few seconds into Hearthstone, and no
; amount of holding, cloaking, parking or re-asking changes it -- it was
; measured six ways and at four deferrals, all ~7.8s, before the cause was
; found. It is a DECLARATION, not a behaviour, and declarations can be edited.
;
; WHAT THIS DOES. Sets desktop_only to false for those two windows and only
; those two. SettingsWindow, LotteryWindow and OutOfCardsAuthWindow are left
; exactly as Firestone shipped them: this script does not manage them, so it has
; no business changing them.
;
; REVERSIBLE. The untouched file is copied to manifest.json.hsbg-original beside
; the original, once, and never overwritten after that.
;
; RE-CHECKED EVERY RUN, because a Firestone update installs into a NEW version
; folder with a fresh manifest and the patch has to follow it there. The check is
; one 8KB file read.
;
; WHAT COULD GO WRONG, STATED PLAINLY. Overwolf ships _metadata/verified_
; contents.json, which holds a hash for manifest.json and a signature. If
; Overwolf enforces that at load time, a patched manifest may be rejected or
; re-downloaded and Firestone would fail to start rather than start with its
; windows freed. That is why the stock file is preserved and why this can be
; switched off with fsUnlockDesktopOnly. UNVERIFIED until it is run.
; ══════════════════════════════════════════════════════════════════════════════
;  SILENT LAUNCH, USING OVERWOLF'S OWN SWITCH
; ══════════════════════════════════════════════════════════════════════════════
;
; Firestone's manifest declares:
;
;   "launch_events": { "event": "GameLaunch",
;                      "event_data": { "game_ids": [9898] },
;                      "start_minimized": false }
;
; start_minimized is Overwolf's OWN documented setting for starting an app
; without putting its window on screen. Turning it on is the only approach here
; that does not race anything: there is no first frame to catch, because the
; window is never shown in the first place.
;
; WHY THIS IS NOT THE start_position PATCH THAT FAILED. That one wrote
; "left": 30000 into CollectionWindow, so Main was born off the side of the
; desktop, never presented, never got a taskbar button, and Firestone never
; dismissed its Loading popup. This changes one boolean that Overwolf itself
; defines, and a minimised window is an ordinary Windows state that F3 restores.
;
; It is still an edit to ANOTHER APPLICATION'S FILE, so: the stock manifest is
; preserved as manifest.json.hsbg-original before the first write, the change is
; idempotent, and REVERT FIRESTONE.bat puts it back. Firestone updates ship a
; fresh manifest, so this is re-applied per version rather than once forever.
; ══════════════════════════════════════════════════════════════════════════════
;  ENFORCE FIRESTONE'S SETTINGS AT SCRIPT START
; ══════════════════════════════════════════════════════════════════════════════
;
; Scans Firestone's manifest once, at start-up, and writes the settings this
; script needs. One read, one write, backed up, idempotent, and it says exactly
; what it changed. This runs BEFORE anything is launched, which is the only
; point where a manifest edit can still affect how Firestone starts.
;
; It runs at start-up rather than at launch time on purpose: Overwolf reads the
; manifest when it loads the app, so a write issued while the app is already
; starting is too late for that run and only takes effect the next time.
;
; WHAT IT WRITES, AND WHAT EACH ONE ACTUALLY DOES:
;
;   launch_events.start_minimized = true
;       Overwolf's own switch. It governs the AUTO-LAUNCH path only -- the one
;       where Overwolf starts Firestone itself because launch_events declares
;       GameLaunch for Hearthstone. On that path the window is never shown at
;       all. It does NOT affect a manual start through
;       OverwolfLauncher.exe -launchapp, which is how this script launches
;       Firestone, so setting it is necessary but on its own not sufficient.
;
; The stock manifest is copied to manifest.json.hsbg-original before the first
; write, so REVERT FIRESTONE.bat and a manual restore both work. A Firestone
; update ships a fresh manifest, so this is re-applied per version.
global _fsSettingsEnforced := false   ; F2 will not launch until this is true
_FSEnforceFirestoneSettings() {
    global CFG, _fsSettingsEnforced
    _fsSettingsEnforced := true
    if !CFG.fsSilentLaunch
        return false

    path := _FSFirestoneManifestPath()
    if (path = "" || !FileExist(path)) {
        _FSLog("FS-SETTINGS no Firestone manifest found -- nothing to enforce")
        return false
    }
    try {
        txt := FileRead(path, "UTF-8")
    } catch as e {
        _FSLog("FS-SETTINGS could not read manifest: " . e.Message)
        return false
    }
    if (txt = "")
        return false

    out := txt
    changed := []

    ; desktop_only is a WINDOW property. Change only the two windows HSBG owns.
    for name in ["CollectionWindow", "BattlegroundsWindow"] {
        r := _FSJsonBlockRange(out, name)
        if !IsObject(r)
            continue
        block := SubStr(out, r.start, r.len)
        newBlock := block
        if RegExMatch(block, 'i)"desktop_only"\s*:\s*(true|false)', &d) {
            if (StrLower(d[1]) != "false") {
                newBlock := RegExReplace(newBlock, 'i)("desktop_only"\s*:\s*)(true|false)', '$1false', &cnt, 1)
                if cnt
                    changed.Push(name . ".desktop_only=false")
            }
        } else {
            newBlock := RegExReplace(newBlock, 'i)\{\s*', '{"desktop_only": false,', , 1)
            changed.Push(name . ".desktop_only=false")
        }
        if (newBlock != block)
            out := SubStr(out, 1, r.start - 1) . newBlock . SubStr(out, r.start + r.len)
    }

    ; start_minimized is NOT a window property. Overwolf documents it on the
    ; GameLaunch launch-event object. Patch that event only.
    if RegExMatch(out, 'is)"launch_events"\s*:\s*\[\s*\{[^\}]*?"event"\s*:\s*"GameLaunch"[^\}]*?\}', &lm) {
        block := lm[0]
        newBlock := block
        if RegExMatch(block, 'i)"start_minimized"\s*:\s*(true|false)', &sm) {
            if (StrLower(sm[1]) != "true") {
                newBlock := RegExReplace(newBlock, 'i)("start_minimized"\s*:\s*)(true|false)', '$1true', &cnt3, 1)
                if cnt3
                    changed.Push("launch_events.GameLaunch.start_minimized=true")
            }
        } else {
            newBlock := RegExReplace(newBlock, 'i)\{\s*', '{"start_minimized": true,', , 1)
            changed.Push("launch_events.GameLaunch.start_minimized=true")
        }
        if (newBlock != block)
            out := SubStr(out, 1, lm.Pos - 1) . newBlock . SubStr(out, lm.Pos + lm.Len)
    } else {
        _FSLog("FS-SETTINGS no GameLaunch launch event found -- silent-launch setting not applied")
    }

    if (changed.Length = 0) {
        _FSLog("FS-SETTINGS Firestone manifest already has required settings")
        return true
    }

    bak := path . ".hsbg-original"
    if !FileExist(bak)
        try FileCopy(path, bak, false)
    tmp := path . ".hsbg-tmp"
    try {
        FileDelete(tmp)
        FileAppend(out, tmp, "UTF-8-RAW")
        FileMove(tmp, path, true)
        check := FileRead(path, "UTF-8")
        if (check = "")
            throw Error("manifest read-back was empty")
    } catch as e {
        try FileDelete(tmp)
        _FSLog("FS-SETTINGS could not write/read back Firestone manifest: " . e.Message)
        return false
    }
    joined := ""
    for item in changed
        joined .= (joined = "" ? "" : ", ") . item
    _FSLog("FS-SETTINGS rewrote Firestone manifest: " . joined)
    _FSLog("FS-SETTINGS Original preserved as manifest.json.hsbg-original")
    return true
}
_FSFirestoneManifestPath() {
    static known := ""
    if (known != "" && FileExist(known))
        return known
    root := EnvGet("LOCALAPPDATA") . "\Overwolf\Extensions"
    if !DirExist(root)
        return ""
    best := "", bestVer := ""
    loop files root . "\*", "D" {
        loop files A_LoopFileFullPath . "\*", "D" {
            mf := A_LoopFileFullPath . "\manifest.json"
            if !FileExist(mf)
                continue
            txt := ""
            try txt := FileRead(mf, "UTF-8")
            if !InStr(txt, '"Firestone"')
                continue
            ; Newest version folder wins. Zero-pad each dotted part first --
            ; a plain text compare puts "18.9.9" above "18.17.2".
            v := _FSPadVersion(A_LoopFileName)
            if (bestVer = "" || StrCompare(v, bestVer) > 0)
                bestVer := v, best := mf
        }
    }
    known := best
    return best
}

_FSPadVersion(v) {
    out := ""
    for part in StrSplit(v, ".") {
        p := ""
        for ch in StrSplit(part)
            if (ch >= "0" && ch <= "9")
                p .= ch
        if (p = "")
            p := "0"
        out .= Format("{:08d}", Integer(p)) . "."
    }
    return out
}

; The {...} block belonging to a named key, so an edit cannot leak into a
; neighbouring window. Quoted spans are skipped, so a brace inside a string
; cannot unbalance the count.
_FSJsonBlockRange(txt, keyName) {
    k := InStr(txt, '"' . keyName . '"')
    if !k
        return 0
    open := InStr(txt, "{", false, k)
    if !open
        return 0
    ; NOT NAMED inStr. AutoHotkey identifiers are CASE-INSENSITIVE, so a local
    ; called inStr IS the built-in InStr function -- declaring it breaks every
    ; InStr call in this scope. The same trap is recorded above _FSTraceNote,
    ; and it cost an hour there too.
    depth := 0, inString := false, esc := false
    i := open
    while (i <= StrLen(txt)) {
        c := SubStr(txt, i, 1)
        if esc
            esc := false
        else if (c = "\")            ; JSON escape. Backslash is NOT an AHK
            esc := true              ; escape character, so this is literal.
        else if (c = '"')
            inString := !inString
        else if !inString {
            if (c = "{")
                depth++
            else if (c = "}") {
                depth--
                if (depth = 0)
                    return { start: open, len: i - open + 1 }
            }
        }
        i++
    }
    return 0
}

; true when either window still needs an edit.
_FSManifestNeedsUnlock(txt) {
    global CFG
    for name in ["CollectionWindow", "BattlegroundsWindow"] {
        r := _FSJsonBlockRange(txt, name)
        if !IsObject(r)
            continue
        blk := SubStr(txt, r.start, r.len)
        if RegExMatch(blk, 'i)"desktop_only"\s*:\s*true')
            return true
        if (CFG.fsEnableHwAccel
         && RegExMatch(blk, 'i)"disable_hardware_acceleration"\s*:\s*true'))
            return true
    }
    return false
}

; Idempotent. A manifest already patched is read and left alone.
_FSUnlockFirestoneWindows() {
    global CFG, _fsManifestUnlocked
    if _fsManifestUnlocked
        return true
    if !CFG.fsUnlockDesktopOnly {
        _fsManifestUnlocked := true
        return false
    }
    mf := _FSFirestoneManifestPath()
    if (mf = "") {
        _fsManifestUnlocked := true          ; nothing installed: nothing to do
        return false
    }
    txt := ""
    try txt := FileRead(mf, "UTF-8")
    if (txt = "") {
        _FSLog("FS-UNLOCK could not read Firestone's manifest at " . mf
             . " -- leaving it alone. Firestone Main will still be closed by"
             . " Overwolf a few seconds into a game; that is the untreated"
             . " behaviour, not a new fault.")
        _fsManifestUnlocked := true
        return false
    }
    if !_FSManifestNeedsUnlock(txt) {
        _fsManifestUnlocked := true
        _FSLog("FS-UNLOCK Firestone's manifest already has desktop_only off for"
             . " Main and Battlegrounds -- nothing to change this run.")
        return true
    }

    ; Keep the stock file once, and only once: a second run must not overwrite
    ; the pristine copy with an already-patched one.
    bak := mf . ".hsbg-original"
    if !FileExist(bak)
        try FileCopy(mf, bak, false)

    ; NOT named `out`, and NOT named `new`. Identifiers are case-insensitive
    ; here, so `out` collides with any global called OUT, and `new` is reserved.
    ; The first of those silently redirected a whole diagnostic to a filename
    ; made of the file's own contents while this was being written.
    patchedTxt := txt, changed := 0
    for name in ["CollectionWindow", "BattlegroundsWindow"] {
        r := _FSJsonBlockRange(patchedTxt, name)
        if !IsObject(r)
            continue
        blk := SubStr(patchedTxt, r.start, r.len)
        swapped := RegExReplace(blk, 'i)"desktop_only"\s*:\s*true'
                                   , '"desktop_only": false')
        if CFG.fsEnableHwAccel
            swapped := RegExReplace(swapped
                                  , 'i)"disable_hardware_acceleration"\s*:\s*true'
                                  , '"disable_hardware_acceleration": false')
        if (swapped != blk) {
            patchedTxt := SubStr(patchedTxt, 1, r.start - 1) . swapped
                        . SubStr(patchedTxt, r.start + r.len)
            changed++
        }
    }
    if !changed {
        _fsManifestUnlocked := true
        return false
    }

    ; Written whole, then read back. A truncated manifest is worse than an
    ; untouched one, so a failed verify restores the original.
    ; "UTF-8-RAW", NOT "UTF-8". AutoHotkey writes a byte-order mark with plain
    ; "UTF-8", the stock manifest has none, and a BOM in front of "{" makes the
    ; file invalid JSON to a strict parser -- Node refuses it outright, and
    ; Overwolf may well do the same. That would have handed the user a Firestone
    ; that no longer starts, in the name of fixing a window that closes.
    ok := false
    try {
        if FileExist(mf)
            FileDelete(mf)
        FileAppend(patchedTxt, mf, "UTF-8-RAW")
        check := FileRead(mf, "UTF-8")
        ok := (check != "" && !_FSManifestNeedsUnlock(check))
    }
    if !ok {
        if FileExist(bak) {
            try {
                if FileExist(mf)
                    FileDelete(mf)
                FileCopy(bak, mf, true)
            }
        }
        _FSLog("FS-UNLOCK writing Firestone's manifest failed, so the original"
             . " has been put back. Nothing is broken; Firestone Main will"
             . " simply keep being closed in-game as before.")
        _fsManifestUnlocked := true
        return false
    }

    _fsManifestUnlocked := true
    _FSLog("FS-UNLOCK set desktop_only=false on Firestone's CollectionWindow and"
         . " BattlegroundsWindow in " . mf . ". Overwolf closes desktop-only"
         . " windows while a game runs, which is the whole reason Firestone Main"
         . " vanished a few seconds into Hearthstone. The stock file is kept"
         . " beside it as manifest.json.hsbg-original. Firestone must be"
         . " restarted for this to take effect.")
    return true
}

_FSStartFirestone() {
    ; BEFORE Firestone starts, always: Overwolf reads the manifest as the
    ; extension loads, so a patch applied afterwards only takes effect next run.
    ; Idempotent and free once done.
    try _FSUnlockFirestoneWindows()
    if FirestoneAppRunning() {
        _FSLog("FS-LAUNCH Firestone is already running -- nothing to launch."
             . " A second copy of Overwolf is worse than none.")
        return
    }
    _FSLog("FS-LAUNCH starting Firestone now, with Battle.net -- there is no"
         . " deferral and no timer between the F2 press and this.")
    LaunchFirestoneNow()
}

LaunchFirestoneNow() {
    global State, CFG, _fsFastBlanketUntil, _fsOutcomeRearmed

    ; Hold the blanket at 10ms from here until Firestone's first window is
    ; taken. See _FSBlanketWantsFast -- without this the cadence drops to 100ms
    ; when BATTLE.NET finishes, which is always about two seconds before
    ; Firestone opens, and the loading window is born into the slow poll.
    _fsFastBlanketUntil := A_TickCount + CFG.fsFastBlanketMs
    _fsOutcomeRearmed   := false        ; each launch gets its own grace period

    ; And say how it went, once, well after it has had time to open. A launch
    ; that produced nothing is indistinguishable from a launch that produced a
    ; window we concealed, unless something says which happened.
    try SetTimer(_FSLaunchOutcome, -Abs(CFG.fsOutcomeAfterMs))
    ; ══════════════════════════════════════════════════════════════════════
    ;  "FIRESTONE IS RUNNING" IS NOT "FIRESTONE MAIN IS OPEN"
    ; ══════════════════════════════════════════════════════════════════════
    ; This returned early whenever FirestoneAppRunning() was true -- and that
    ; function answers a much weaker question than the name suggests: it is
    ; true if ANY Overwolf window's title starts with "Firestone". The in-game
    ; overlay counts. So does a hidden 0x0 helper, and so does a notification
    ; popup.
    ;
    ; Firestone can legitimately be "running" with no Main window: it closes to
    ; tray if the user has that switched on in Firestone itself, and its overlay
    ; and helper windows keep the process alive regardless. Every subsequent F2
    ; then took this early return, launched nothing, and left the user with a
    ; session and no Firestone Main -- the "Firestone Main is not opening"
    ; report, which had nothing to do with concealment.
    ;
    ; (HSBG used to force close-to-tray ON in Firestone's own settings, which
    ; made this far more likely. It no longer edits those settings at all --
    ; see SECTION 7 -- but the case still has to be handled, because the user
    ; may have chosen it themselves.)
    ; do with concealment.
    ;
    ; So the question asked is the one that matters. If Main is genuinely open,
    ; nothing to do. If Firestone is running WITHOUT it, the launch command is
    ; re-issued: Overwolf's -launchapp against an app that is already running
    ; opens its main window rather than starting a second copy, which is
    ; precisely the behaviour wanted here.
    if (FirestoneAppRunning() && _FSMainWindowPresent()) {
        _FSLog("FS-LAUNCH Firestone Main is already open -- nothing to launch")
        return false
    }
    if FirestoneAppRunning()
        _FSLog("FS-LAUNCH Firestone is running but has NO Main window (it"
             . " closes to tray). Re-issuing the launch so Main opens ahead of"
             . " Hearthstone, which is the order Firestone needs to attach"
             . " cleanly.")

    ; ---- RESOLVE FIRST, ARM SECOND ----
    ; This used to arm the whole suppressor bundle -- a 1 ms sweep, a 3 ms
    ; cloak, a 10 ms loading watch, a 750 ms popup sweeper -- and only then ask
    ; whether there was anything to launch. On a machine with no Overwolf or no
    ; Firestone that meant every F2 press started a full choreography against
    ; windows that could never exist, at up to a thousand enumerations a second
    ; on a script running at high process priority, for up to two minutes. The
    ; user paid the entire cost of a feature they do not have.
    cmd := _ResolveFirestoneLaunch()
    if (cmd = "") {
        _FSLog("FS-LAUNCH no Overwolf/Firestone install found -- skipping the"
             . " Firestone stage entirely (this is not an error; the rest of"
             . " the session is unaffected)")
        StandDownFirestoneSubsystems()
        return false
    }

    ; Re-arm the suppressors at the moment of launch.
    ;
    ; All of them are armed by F2 and torn down by CancelLaunchTimers when
    ; Hearthstone's window appears. With fsLaunchAfterHS that ordering inverts --
    ; Hearthstone appearing is the trigger for launching Firestone -- so without
    ; this they would be switched off shortly before the windows they exist to
    ; suppress are created. Suppressors belong where the windows are born.
    ; With immediate launch, this is the right place to arm them.
    if State.fsMainLocked {
        StartLauncherHide()   ; carries its own 60s ceiling
        StartEarlyOverwolfCloak()
        StartKillFirestoneLoading()
        StartFSNotifSweeper()
        StartFSBurst()

        ; Let the suppressors tick before the process exists.
        ;
        ; Arming a timer does not run it: the first tick is one interval away, and hook
        ; delivery lags the event by a few milliseconds. Firing the launch in the same
        ; thread turn would allow the first windows to be created before any suppressor
        ; had run once. This delay is far longer than every cadence involved and
        ; imperceptible next to Firestone's own start-up.
        Sleep(CFG.fsLaunchArmSettleMs)
    }

    try Run(cmd)
    ; INVALIDATE THE "IS OVERWOLF RUNNING" CACHE, NOW.
    ;
    ; The suppression sweeps skip their enumeration when no Overwolf process
    ; exists. That answer was last computed moments ago -- before this line --
    ; and it was "no". Left alone it would stay "no" for up to a second, which
    ; is precisely the second in which Overwolf creates its first windows, and
    ; the sweeps armed forty lines above would sit out the whole of it.
    try _OverwolfRunningCached(true)
    ; Run() returning without throwing means a process was STARTED, not that
    ; Firestone works. A crash a second later -- the "critical error, no
    ; overlay" a user reported -- is indistinguishable from success at this
    ; point, and nothing downstream ever asked again, so the suppressors ran
    ; for the rest of the session waiting for windows that were never coming.
    ; This asks, once, well after any healthy start-up would have finished.
    SetTimer(FirestoneHealthCheck, -CFG.fsHealthCheckMs)
    return true
}

; Is there anything to manage? Cheap, cached, and never throws.
;
; The whole Firestone half of this script is optional. Every path that arms a
; Firestone timer asks this first, so a user who has never installed Overwolf
; runs a script that launches Hearthstone and does nothing else -- rather than
; one that polls an empty window list at 50 ms for the rest of the session.
FirestoneInstalled() {
    try return (_ResolveFirestoneLaunch() != "")
    return false
}

; Build the command that starts Firestone, or "" if there is nothing to start.
; Pure lookup: no side effects, safe to call before deciding anything.
_ResolveFirestoneLaunch() {
    fsCmd := GetFirestoneCmd()
    if (fsCmd != "")
        return fsCmd
    owPath := GetOverwolfPath()
    if (owPath = "")
        return ""
    appId := GetFirestoneAppId()
    return (appId != "")
        ? ('"' . owPath . '" -overwolfsilent -launchapp ' . appId)
        : ('"' . owPath . '"')
}

; Did Firestone actually come up? If not, stop waiting for it.
; RETRIED, NOT ONE-SHOT.
;
; A single check meant "not running yet" and "never coming" were the same
; answer, and standing everything down on the first was the worse mistake: the
; suppressors would be switched off moments before a slow Overwolf finally
; produced its windows, so Firestone - Main would flash on screen -- the exact
; bug this subsystem exists to prevent, reintroduced by its own safety net.
; Three checks put the verdict past three minutes, which is beyond any healthy
; start-up, so "absent" really does mean absent.
FirestoneHealthCheck() {
    global CFG
    static tries := 0
    if FirestoneAppRunning() {
        tries := 0
        _FSLog("FS-HEALTH Firestone is running")
        return
    }
    tries += 1
    if (tries < 3) {
        _FSLog("FS-HEALTH Firestone not up yet (check " . tries . " of 3)"
             . " -- giving it another " . CFG.fsHealthCheckMs . "ms")
        SetTimer(FirestoneHealthCheck, -CFG.fsHealthCheckMs)
        return
    }
    tries := 0
    _FSLog("FS-HEALTH Firestone was launched but never appeared -- it most"
         . " likely failed to start. Standing down the Firestone subsystems;"
         . " Hearthstone and the hotkeys are unaffected")
    try BgHUD.Show("Firestone did not start — continuing without it", 3000)
    StandDownFirestoneSubsystems()
}

; Switch off everything that exists only to manage Firestone windows.
;
; Called when Firestone is not installed, and when it was launched but died.
; Deliberately does NOT touch State.fsMainLocked: F3 stays meaningful, so if
; the user starts Firestone by hand later the lock is still in the state they
; expect. It only stops the timers that would otherwise poll forever -- the
; 50 ms coast sweep, the 100 ms loading guard, the 750 ms popup sweeper -- for
; windows that do not exist.
StandDownFirestoneSubsystems() {
    try StopFSBurst()
    try SetTimer(FSMainMonitor,                 0)
    ; See _TrackerStandDownFirestone: the pending 60-second one-shot must be
    ; cancelled, or it re-arms the loading sweep long after this ran.
    try SetTimer(StopKillFirestoneLoading,      0)
    try StopKillFirestoneLoading()
    try SetTimer(SuppressFirestoneLoadingTick,  0)
    try StopFSNotifSweeper()
    try StopEarlyOverwolfCloak()
    try StopLauncherHide()
    try StopFSReveal()
}

; ── Late‑HS recovery (post‑ceiling cold launches) ─────────────────────────────
; Armed ONLY by the launch‑ceiling timeout. Watches for HS to appear after the
; pipeline gave up, and runs the reduced success path.
global _lateHSUntil := 0

LateHSWatch() {
    global _lateHSUntil
    if (!_lateHSUntil || A_TickCount >= _lateHSUntil) {
        _lateHSUntil := 0
        SetTimer(LateHSWatch, 0)
        return
    }
    if (!GetHSPID() || !HSWindowExists())
        return
    _lateHSUntil := 0
    SetTimer(LateHSWatch, 0)
    CompleteHSLaunchLate()
}

; Reduced success tail for an HS that appeared after the pipeline ceiling.
CompleteHSLaunchLate() {
    StopHSCloaker()
    RevealBNetWindows(true)   ; late path: Hearthstone is already up and has
                              ; been for a while, so "minimize now" is exactly
                              ; right here and there is no linger to respect
    StartOverlayTopmostEnforcer()
    SetHSGpuPreferenceHigh()
    PauseWSearch()
}

; ==============================================================================
; SECTION 15: HOTKEYS
; ==============================================================================
;
; The four handlers users actually touch. Each is a thin conductor: it
; sets state, starts the right subsystems, and gets out of the way.

; ── System-modifier passthrough ──────────────────────────────────────────────
; The four hotkeys are declared with the `*` wildcard so they fire no matter
; which modifiers are held. That is right for Shift (sticky keys, stray shift
; during a match) and catastrophically wrong for the OS combinations:
;
;   Alt+F4  — the universal "close window" chord. With `*F4` the script ATE it
;             everywhere in Windows and ran a FULL SHUTDOWN instead: it killed
;             Hearthstone, Battle.net, Overwolf and then exited. Closing any
;             unrelated window with Alt+F4 nuked the whole session.
;   Ctrl+F4 — "close tab / close document" in browsers, Office, IDEs.
;   Win+F#  — reserved by the shell.
;
; Gating the wildcard hotkeys on this makes the modified chords INACTIVE rather
; than swallowed, so Windows receives them normally. Unmodified F1-F4 are
; unaffected: they still match here, and the SC03B..SC03E aliases below (which
; require no modifiers anyway) are a second path to the same handlers.
;
; ── FAIL-OPEN, AND SELF-HEALING ──────────────────────────────────────────────
; This one function decides whether ANY of the four hotkeys are live. That
; makes it the single most dangerous piece of code in the script: if it ever
; returns false and stays there, all four keys go silently inert -- no handler
; runs, no HUD toast, no log line, nothing to see. A user reported exactly that
; after a launch in which Firestone threw a critical error.
;
; The mechanism is a keyboard-state desync. GetKeyState(key, "P") reads the
; OS's PHYSICAL key state, which goes stale when a low-level keyboard hook
; chain is disrupted -- and Overwolf installs a global keyboard hook to deliver
; its own overlay hotkeys, so an Overwolf/Firestone crash is precisely the
; event that can drop a modifier's key-up. The modifier is then reported held
; forever, and this gate reports "a system chord is in progress" forever.
;
; Three defences, in order of when they act:
;
;   1. BOTH STATES MUST AGREE. A modifier counts as held only when the logical
;      AND physical states say so. A one-sided desync -- the common kind --
;      no longer blocks anything.
;   2. FAIL OPEN. Any exception reading key state returns TRUE (hotkeys live).
;      A gate that cannot read the keyboard must not be the reason the user
;      cannot press F4 to shut down.
;   3. SELF-HEAL. The moment this gate STARTS refusing is stamped below, and
;      HK_ReachabilityWatchdog treats a gate that has been refusing
;      continuously as proof the modifier state is wrong -- which is the only
;      test that catches the user pressing dead F-keys, because their presses
;      keep the system idle timer at zero.
;
; What this does NOT change: a real Alt+F4 / Ctrl+F4 / Win+F4 still passes
; through to Windows untouched, because a genuinely held modifier sets both
; states and is released within milliseconds of the chord ending.
global _hkGateBlockedSince := 0
HK_NoSysMods() {
    global _hkGateBlockedSince
    try {
        clear := !_HKModHeld("Alt")  && !_HKModHeld("Ctrl")
              && !_HKModHeld("LWin") && !_HKModHeld("RWin")
    } catch {
        _hkGateBlockedSince := 0
        return true                  ; unreadable: fail OPEN, never inert
    }
    if clear {
        _hkGateBlockedSince := 0
        return true
    }
    if !_hkGateBlockedSince
        _hkGateBlockedSince := A_TickCount
    return false
}

; A modifier is "held" only when the logical and physical states agree.
_HKModHeld(key) {
    return GetKeyState(key) && GetKeyState(key, "P")
}

; Releases a modifier the OS is reporting as held when nothing is being typed.
;
; The test is deliberately conservative: a modifier must report held AND there
; must have been no physical input at all for CFG.hkStuckModifierMs. Holding a
; modifier generates no input events, but no real chord lasts ten seconds --
; Alt-tabbing sends Tab presses, which reset the idle timer. So this fires only
; on a state that cannot be produced by a human hand.
;
; The repair is to send the key-up the OS never received. If the modifier
; really was held, the only consequence is that it is released, which is also
; what the user would have done next.
HK_ReachabilityWatchdog() {
    global _hkGateBlockedSince, CFG, State, Launch

    ; ---- 1. Reconcile the launch flag with the launch state ----
    ; State.f2Active gates F1 and F2. Launch.state is what the pipeline
    ; actually thinks it is doing. When the flag says "launching" and the state
    ; machine says IDLE or DONE, the flag is a leftover -- and a leftover here
    ; costs the user two of their four keys. Clearing it is always safe: a real
    ; launch keeps Launch.state on one of the working states for its whole life.
    try {
        if (State.f2Active && !_LaunchPipelineAlive()
         && (Launch.state = "IDLE" || Launch.state = "DONE")) {
            State.f2Active := false
            _FSLog("HOTKEY reconciled: f2Active was set with Launch.state="
                 . Launch.state . " -- cleared so F1/F2 are usable")
        }
    }

    ; ---- 2. Release a stuck system modifier ----
    if !CFG.hkStuckModifierRepair
        return
    stuck := ""
    try {
        ; TWO WAYS TO QUALIFY, and the second is the one that matters.
        ;
        ; (a) IDLE. A modifier reports held while nothing at all is being
        ;     typed for hkStuckModifierMs. Conservative: holding a modifier
        ;     generates no input events, but no real chord lasts ten seconds --
        ;     Alt-tabbing sends Tab presses, which reset the idle timer.
        ;
        ; (b) THE GATE HAS BEEN BLOCKING. A_TimeIdlePhysical is reset by every
        ;     keypress -- INCLUDING the F-key presses that are being swallowed.
        ;     So the exact user who most needs this repair, the one pressing F2
        ;     over and over because nothing is happening, keeps the idle timer
        ;     near zero and would never have qualified under (a) alone. That is
        ;     precisely the reported failure. HK_NoSysMods stamps the moment it
        ;     began refusing; if it has been refusing continuously for this
        ;     long, the modifier state is wrong no matter how busy the keyboard
        ;     looks.
        idleStuck  := (A_TimeIdlePhysical >= CFG.hkStuckModifierMs)
        gateStuck  := (_hkGateBlockedSince
                    && (A_TickCount - _hkGateBlockedSince) >= CFG.hkGateBlockedMs)
        if !(idleStuck || gateStuck)
            return
        for key in ["Alt", "Ctrl", "LWin", "RWin"] {
            if _HKModHeld(key)
                stuck .= (stuck = "" ? "" : ",") . key
        }
    } catch {
        return
    }
    if (stuck = "")
        return
    _FSLog("HOTKEY stuck modifier(s) " . stuck . " held with "
         . A_TimeIdlePhysical . "ms of no physical input -- releasing so the"
         . " F-keys come back")
    for key in StrSplit(stuck, ",") {
        try Send("{" . key . " up}")
    }
    _hkGateBlockedSince := 0
    try BgHUD.Show("Hotkeys restored", 1200)
}

; ── F1 — Disconnect / Reconnect ──────────────────────────────────────────────
#MaxThreadsPerHotkey 1
#HotIf HK_NoSysMods()
$*F1::Hotkey_F1()
SC03B::Hotkey_F1()
#HotIf

; Is the launch pipeline genuinely running, or just flagged as running?
;
; The single answer both F1 and F2 use. "Running" means the state machine has
; ticked recently; anything else is a corpse holding a flag. A stamp of 0 means
; it never ticked at all, which is the cold-launch failure and is also dead.
; Kept deliberately small and total -- it must never throw, because both
; hotkeys' availability depends on it returning.
_LaunchPipelineAlive() {
    global _smLastTick
    try {
        if (_smLastTick = 0)
            return false
        return (A_TickCount - _smLastTick) <= 4000
    }
    return false
}

; F1 FAILSAFE: removes the firewall block AND the input shield unconditionally.
; Armed as a one-shot the moment a block is applied, so even if the F1 thread
; dies (exception, script reload, external kill) the game is never left
; permanently disconnected or input-shielded -- the "stuck frozen, had to
; restart" failure. Harmless if the normal path already cleaned up.
_F1FailsafeRelease() {
    ; FORCED, and it now runs on EVERY press rather than only when the F1 thread
    ; died. Both cases share the same problem: the _ipBlockOn flag records that
    ; a delete was attempted, not that it succeeded, so it cannot be trusted to
    ; decide whether a rule is still on the machine. Two netsh calls, a couple
    ; of seconds after the skip is over and off the critical path, is what makes
    ; "a block is always released" a guarantee instead of an expectation.
    try RemoveIPBlock(true)
    try StopHSInputShield()
    ; The Battle.net guard is deliberately NOT stopped here. It is bounded and
    ; self-expiring, and this failsafe only runs when the F1 thread died -- the
    ; case where a disconnect-driven restore is MOST likely. Cancelling it here
    ; would switch the protection off exactly when it is most needed.
}

_HKFired(which) {
    ; One line the instant a hotkey handler actually runs. It exists to settle a
    ; question the log could not answer on 2026-09-06: every F-key appeared
    ; dead while the script was demonstrably alive -- timers ticking, log being
    ; written, Responding=True, no stuck modifier, and the #HotIf gate open.
    ;
    ; With this line, the watchdog records the PHYSICAL key press and this
    ; records the HANDLER. If the watchdog shows a press and there is no
    ; HK-FIRED beside it, the keystroke never reached this script and the fault
    ; is outside it -- another app owning the key, or an integrity boundary.
    ; If both appear, the key arrived and the handler did nothing useful, which
    ; is a bug in here. Two witnesses, and the disagreement is the finding.
    ; ── IS THE PHYSICAL KEY ACTUALLY DOWN RIGHT NOW? ────────────────────────
    ;
    ; The two-witness scheme above needs an external watchdog for the first
    ; witness, and that witness is not always available -- a watchdog launched
    ; detached from the interactive desktop reads no key state at all and
    ; reports zero presses for every key, which is indistinguishable from "the
    ; keystroke never arrived". That happened, and it left a real question
    ; unanswerable: F3 entered this handler 24 times in one session, toggling
    ; Firestone's lock 24 times, with no way to tell whether a human pressed
    ; it 24 times.
    ;
    ; This settles it from inside, with no second process to go wrong. A
    ; handler entered because of a keypress runs while that key is still
    ; physically down -- the hook fires on key-down. So:
    ;
    ;   phys=1   a real press. Rapid pairs mean the KEYBOARD is repeating or
    ;            the user is double-tapping.
    ;   phys=0   nothing was pressed. Something in this script called the
    ;            handler directly, which is a bug to find, not a key to
    ;            debounce.
    phys := ""
    try phys := GetKeyState(which, "P") ? 1 : 0
    try _FSLog("HK-FIRED " . which . " handler entered"
             . "  fg=" . _HKForegroundDesc()
             . "  gateOpen=" . (HK_NoSysMods() ? 1 : 0)
             . "  phys=" . phys)
}
_HKForegroundDesc() {
    try {
        fg := DllCall("user32\GetForegroundWindow", "Ptr")
        if !fg
            return "none"
        t := "", e := ""
        try t := WinGetTitle("ahk_id " . fg)
        try e := WinGetProcessName("ahk_id " . fg)
        return e . " `"" . SubStr(t, 1, 40) . "`""
    }
    return "unreadable"
}

Hotkey_F1(targetOverride := "", fromAuto := false) {
    _HKFired("F1")
    global State, CFG, InputShield
    _HotkeyTone("F1")

    hsPID := GetHSPID()
    if (!hsPID) {
        BgHUD.Show("HS not running", 900)
        return
    }

    ; ── A DROPPED PRESS NOW SAYS SO ──────────────────────────────────────────
    ; This used to return in silence. Combined with a press that took three
    ; seconds to complete, the user experience was: press F1, see nothing
    ; happen, press it again -- and the second press landed inside the cooldown
    ; and was also discarded, silently. "I have to press it twice" is that loop
    ; seen from outside. The toast costs nothing and turns an invisible refusal
    ; into an answer.
    if (State.lastF1End && (A_TickCount - State.lastF1End) < CFG.cooldownTime) {
        BgHUD.Show("F1 cooling down…", 700)
        return
    }

    ; F1 stands aside during a launch -- but only for a launch that is actually
    ; running. State.f2Active is a plain flag; if the pipeline dies without
    ; clearing it, this early return disables F1 for the rest of the session
    ; with nothing but a toast to say why. The same staleness test Hotkey_F2
    ; uses decides it here, so the two agree on what "in progress" means and
    ; neither can be wedged by a flag nobody cleared.
    if State.f2Active {
        if _LaunchPipelineAlive() {
            BgHUD.Show("F1 ignored — launch in progress", 1200)
            return
        }
        _FSLog("F1 proceeding: f2Active was set but the launch pipeline is"
             . " stale -- clearing the flag")
        State.f2Active := false
    }

    BgHUD.Show("Skip…")

    ; Auto-skip may hand us a prewarmed target list. It is accepted only if it
    ; is very fresh; otherwise the normal lookup below remains the safety net.
    target := ""
    usePrewarmed := false
    if (fromAuto && targetOverride != "") {
        global State
        age := State.autoSkipTargetAt ? (A_TickCount - State.autoSkipTargetAt) : 999999
        if (age <= 900) {
            target := targetOverride
            usePrewarmed := true
            _FSLog("F1 auto-skip using prewarmed target age=" . age . "ms")
        }
    }

    ; ── Adapter mode: no socket bookkeeping, just drop the NIC briefly ───────
    if (CFG.f1Method = "adapter") {
        try {
            StartHSInputShield("F1", CFG.f1AdapterHoldMs + 2500)
            BgHUD.Show("Skip (adapter reset)…")
            _F1AdapterReset(CFG.f1AdapterHoldMs)
            Sleep(CFG.f1AdapterHoldMs + 400)
            BgHUD.Show("Reconnecting…", 1000)
        } catch {
            BgHUD.Show("F1 adapter reset failed", 1500)
        } finally {
            Sleep(300)
            try StopHSInputShield()
            State.lastF1End := A_TickCount
        }
        return
    }

    ; ── Default: IP block ────────────────────────────────────────────────────
    ; ── FAST PATH FIRST ──────────────────────────────────────────────────────
    ; The TCP table answers the common question in under a millisecond. Only
    ; when it finds nothing does this fall through to the PowerShell
    ; enumeration, which costs most of a second but also covers IPv6 and the
    ; services-port ordering the table cannot express. See _FastGameServerIPs.
    ;
    ; NOTE: the exclusion described below applies only to the OLD partial fast
    ; path (_FastGameServerIPs), which genuinely cannot report services
    ; addresses. _FastConnScan above enumerates them, so "all" mode is answered
    ; by it like everything else and never reaches this.
    ;
    ; f1Target="all" is excluded from the PARTIAL fast path on purpose. That
    ; mode blocks the services addresses too, and the partial path cannot
    ; report them -- taking it would quietly turn the documented sledgehammer
    ; back into the smart one at the exact moment someone reached for it
    ; because smart was picking wrong.
    ; ── THE COMPLETE FAST READ COMES FIRST ───────────────────────────────────
    ; _FastConnScan answers the WHOLE question -- game candidates, services
    ; connections, their ages, IPv6 -- from the IP Helper API in well under a
    ; millisecond. When it succeeds there is nothing left for PowerShell to
    ; contribute, including in "all" mode, because it enumerates the services
    ; addresses too. See _FastConnScan for why this matters mid-combat.
    ;
    ; It sets complete := false on ANY doubt, and that is the only thing this
    ; branch trusts. A false there means the old two-step below runs exactly as
    ; it always has.
    if !usePrewarmed {
        fastFull := _FastConnScan(hsPID)
        lookupKind := ""
        if fastFull.complete {
            r := fastFull
            lookupKind := "fast-full"
        }

        fast := (CFG.f1Target = "all") ? {ips: "", cnt: 0, svcCnt: 0, v6Cnt: 0, detail: ""}
                                       : (fastFull.complete
                                            ? {ips: fastFull.nonSvcIps, cnt: fastFull.cnt
                                             , svcCnt: fastFull.svcCnt, v6Cnt: 0
                                             , detail: fastFull.detail}
                                            : _FastGameServerIPs(hsPID))

        if (lookupKind = "fast-full") {
        } else if (fast.ips != "" && fast.svcCnt < 2 && fast.v6Cnt = 0) {
            r := {nonSvcIps: fast.ips, svcNewestIp: "", svcIps: "", svcCnt: fast.svcCnt
                , cnt: fast.cnt, detail: fast.detail}
            lookupKind := "fast"
        } else {
            r := FindGameServerIPs(hsPID)
            lookupKind := "powershell"
        }
        target := r.nonSvcIps
        if (CFG.f1Target = "all") {
            Loop Parse, r.svcIps, "," {
                ip := Trim(A_LoopField)
                if (ip != "" && !InStr("," . target . ",", "," . ip . ","))
                    target .= (target = "" ? "" : ",") . ip
            }
        } else if (r.svcCnt >= 2 && r.svcNewestIp != "" && PortsToCsv(CFG.gamePorts) = ""
                && !InStr("," . target . ",", "," . r.svcNewestIp . ",")) {
            target .= (target = "" ? "" : ",") . r.svcNewestIp
        }
    } else {
        lookupKind := "prewarm"
        ; Keep a minimal result-shaped object so the existing debug log stays useful.
        r := {nonSvcIps: target, svcNewestIp: "", svcIps: "", svcCnt: 0, cnt: 0, detail: ""}
    }

    if CFG.f1DebugLog {
        ; Report what the path that ACTUALLY ANSWERED found. On the fast-full
        ; path in "all" mode `fast` is the dummy object, so logging it would
        ; print "fastIps=(none) fastSvcCnt=0" for a press the fast read
        ; answered completely -- which reads as a failure of the very thing
        ; being measured.
        logIps := (lookupKind = "fast-full") ? r.nonSvcIps : fast.ips
        logSvc := (lookupKind = "fast-full") ? r.svcCnt    : fast.svcCnt
        try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") . " F1 lookup="
            . lookupKind
            . " fastIps=" . (logIps = "" ? "(none)" : logIps)
            . " fastSvcCnt=" . logSvc
            . " game=" . ((r.HasOwnProp("gameNewestIp") && r.gameNewestIp != "")
                            ? r.gameNewestIp : "(unknown)")
            . " svcNewest=" . (r.svcNewestIp = "" ? "(none)" : r.svcNewestIp) . "`n"
            , _LogPath())
        try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") . " F1 method=" . CFG.f1Method
            . " target=" . CFG.f1Target . " pid=" . hsPID . " cnt=" . r.cnt
            . " svcCnt=" . r.svcCnt . " block=" . target
            . " hold=" . CFG.forcefulHoldMs . "`n"
            . r.detail, _LogPath())
    }

    ; ── SMART FOUND NOTHING: FALL BACK TO THE MATCH CONNECTION ──────────────
    ;
    ; This is why auto-skip did nothing. f1Target="smart" blocks only the
    ; NON-services connections, and a Battlegrounds match frequently runs over
    ; the services channel (port 1119) instead -- so nonSvcIps came back empty,
    ; target was "", and F1 returned without blocking anything. It fired at
    ; exactly the right instant and then did nothing, every time.
    ;
    ; The reference tool does not have this problem because it blocks every
    ; remote address Hearthstone owns. That is also precisely why it eventually
    ; strands people: it takes out the auth channel with no bound, the client
    ; cannot re-establish, and the game is gone.
    ;
    ; So the fallback is the NEWEST services connection only -- the one the
    ; match is on -- not the whole list. And the hold is already bounded
    ; separately for exactly this case: f1SvcSafeMaxMs (4s) applies whenever
    ; the block list touches a services address, which is the shorter ceiling
    ; that has never produced the disconnect screen.
    if (target = "" && r.svcNewestIp != "") {
        target := r.svcNewestIp
        _FSLog("F1 smart found no game connection, falling back to the newest"
             . " services connection " . target . " -- that is where a"
             . " Battlegrounds match usually lives. The 4s services ceiling"
             . " applies to this hold, not the 5s one.")
    }

    if (target = "") {
        ; ── THIS RETURN USED TO BE SILENT ───────────────────────────────────
        ; A HUD toast and nothing in the log. For a press you made yourself
        ; that is survivable -- you saw the toast. For an AUTO press it is not:
        ; auto-skip fired, F1 bailed here, and the only trace in the log was
        ; the line saying it had started. The report that comes back is
        ; "auto-skip isn't working at all", with no way to tell a skip that
        ; never fired from one that fired and found nothing to block.
        _FSLog("F1 STOPPED: no game connection to block (lookup=" . lookupKind
             . (usePrewarmed ? ", from auto-skip's prewarmed list" : "")
             . "). Nothing was blocked and no skip happened. If this is an auto"
             . " press, the prewarmed target was empty or had gone stale by the"
             . " time F1 ran.")
        ; "Skip..." was shown with NO timeout, because the normal path replaces
        ; it when the hold ends. This exit did not, so the word sat on screen
        ; for the rest of the session. Every early exit has to replace it.
        BgHUD.Show("No game connection found", 1400)
        return
    }
    _FSLog("F1 proceeding to block " . target . " (lookup=" . lookupKind
         . (fromAuto ? ", auto-skip" : ", manual") . ")")

    BgHUD.Show("Skip (" . target . ")…")
    ; Assigned BEFORE the try, because the finally reads it. In AutoHotkey v2 an
    ; unset local throws when read, and a throw inside finally would replace a
    ; real error with a meaningless one -- and skip the cleanup after it.
    shieldHandedOver := false

    ; Everything that has to outlive the hold is armed off the CEILING, not off
    ; the nominal duration: in adaptive mode the hold may legitimately run to
    ; f1HoldMaxMs, and a shield or failsafe that expired before the block was
    ; lifted would be worse than no adaptive mode at all. They are bounds, not
    ; predictions, so over-arming them costs nothing -- the normal path stands
    ; them down explicitly as soon as the block is released.
    holdCeil := (CFG.f1HoldMode = "adaptive") ? CFG.f1HoldMaxMs : CFG.forcefulHoldMs
    ; Clamped by the SAME rule the hold loop uses. These arm the shield, the
    ; failsafe and the Battle.net guard, and a failsafe that fires later than
    ; the hold it is backstopping is a second of Blizzard's auth address
    ; blocked that nothing accounted for -- which is the territory that
    ; produced "disconnected from the Blizzard game service".
    if (CFG.f1HoldMode = "adaptive" && r.svcNewestIp != ""
     && InStr("," . target . ",", "," . r.svcNewestIp . ","))
        holdCeil := Min(holdCeil, CFG.f1SvcSafeMaxMs)
    try {
        StartHSInputShield("F1", holdCeil + 2500)

        if !ApplyIPBlock(target) {
            BgHUD.Show("F1: firewall rule creation failed", 1800)
            try StopHSInputShield()
            return
        }
        ; Arm the failsafe: guarantees unblock + un-shield even if this thread
        ; never reaches its own cleanup below.
        SetTimer(_F1FailsafeRelease, -(holdCeil + 3000))

        ; Keep the Battle.net launcher down for the hold and a few seconds
        ; after -- the window in which a disconnect-driven restore would land.
        StartF1BNetGuard(holdCeil + 6000)

        ; ---- THE HOLD ----
        ; See _F1CountEstablished for why this is a condition rather
        ; than a duration, and for the four safety rails below.
        holdStart := A_TickCount
        holdWhy   := "fixed"

        ; ── CONFIRM ON THE GAME CONNECTION. NEVER ON THE SERVICES ONE. ──────
        ; THIS COST A GAME. READ IT BEFORE CHANGING THE SET.
        ;
        ; In smart mode the block list can contain TWO kinds of address: the
        ; match's own server, and -- as a fallback for setups where the match
        ; runs over port 1119 -- Blizzard's newest services address. Building
        ; the confirmation set from the whole list made the hold wait for BOTH
        ; to drop.
        ;
        ; They do not drop alike. The game connection gives up in a second or
        ; two; the services channel is long-lived, patient, and hangs on. So
        ; the hold ran to its ceiling on essentially every press -- and spent
        ; all of it with Blizzard's AUTH ADDRESS blocked. Nine seconds of that
        ; is exactly what the client is designed to react to:
        ;
        ;     "Your game has been disconnected from the Blizzard game service."
        ;
        ; The old four-second fixed hold never reached that threshold, which is
        ; why this appeared only once the hold became adaptive. It is the one
        ; failure in this script that can lose a match outright.
        ;
        ; So the set is the NON-SERVICES candidates only. The services address
        ; is still blocked when smart mode wants it -- that part is unchanged
        ; and is what makes 1119 setups work -- but it gets no vote on when the
        ; block ends.
        ; ── CONFIRM ON ONE ADDRESS: THE MATCH'S OWN ────────────────────────
        ; Not "every non-services address". Hearthstone holds idle public
        ; sockets throughout a session -- a CDN keep-alive on 443 is the usual
        ; one -- and an idle socket has nothing in flight, so a blocked path is
        ; invisible to it and it never leaves ESTABLISHED. Waiting for ALL of
        ; them meant waiting for one that never drops: every press ran to the
        ; ceiling, which is both the "not as snappy" report and the reason a
        ; press could sit there long enough to matter.
        ;
        ; _FastConnScan now names the newest non-services connection, which is
        ; the one created when the match began. If it could not (the PowerShell
        ; path, which has no timestamps for these) there is nothing safe to
        ; watch and the hold falls back to the fixed duration rather than
        ; guessing.
        ; Watch EVERY address we blocked, and release when the count of them
        ; still ESTABLISHED goes DOWN. See _F1CountEstablished for why counting
        ; beats both "wait for all of them" and "guess which one is the game".
        gameOnly := target
        if (CFG.f1HoldMode = "adaptive" && gameOnly = "") {
            ; Defensive only -- the press already returned above if `target`
            ; was empty, so nothing should reach here. Kept because the cost is
            ; one comparison and the alternative, if it ever DID reach here,
            ; would be a confirmation loop with an empty set that could only
            ; ever run to the ceiling.
            holdWhy := "fixed (nothing was blocked)"
            Sleep(CFG.forcefulHoldMs)
        } else if (CFG.f1HoldMode = "adaptive") {
            tset   := _F1TargetSet(gameOnly)
            streak := 0
            holdWhy := "ceiling"

            ; The baseline the drop is measured against. Taken AFTER the block
            ; is applied, so it is what the client is holding at the moment the
            ; path went dark; anything that closes from here is the client
            ; reacting. Zero means nothing was established to begin with, which
            ; is not a state a confirmation can be built on -- fall back.
            baseline := _F1CountEstablished(hsPID, tset)
            if (baseline <= 0) {
                holdWhy := "fixed (nothing established to watch)"
                Sleep(CFG.forcefulHoldMs)
                baseline := -2          ; marks the loop below as skipped
            }

            ; ── AND THE CEILING IS CLAMPED WHILE AUTH IS IN THE BLOCK LIST ──
            ; Even confirming on the right connection, a press that never
            ; confirms would sit at the ceiling with the services address
            ; blocked. The safe bound for that is the duration this script ran
            ; at for its whole life before adaptive mode existed.
            ceilMs := CFG.f1HoldMaxMs
            if (r.svcNewestIp != "" && InStr("," . target . ",", "," . r.svcNewestIp . ","))
                ceilMs := Min(ceilMs, CFG.f1SvcSafeMaxMs)
            while (baseline > 0) {
                Sleep(CFG.f1ConfirmPollMs)
                elapsed := A_TickCount - holdStart

                ; CEILING. Ends the hold whatever the table says.
                if (elapsed >= ceilMs)
                    break

                ; FLOOR. Read nothing, decide nothing, until the skip has had
                ; its minimum. This is what stops a lucky early read turning a
                ; real skip into a flicker.
                if (elapsed < CFG.f1HoldMinMs)
                    continue

                st := _F1CountEstablished(hsPID, tset)

                ; FALLBACK. The table could not be read at all -- no answer is
                ; not the same as "it dropped", and it is not a reason to hold
                ; four times as long either. Stand the whole mechanism down to
                ; the duration this press would have had anyway.
                if (st = -1) {
                    holdWhy := "fixed (table unreadable)"
                    if (elapsed < CFG.forcefulHoldMs)
                        Sleep(CFG.forcefulHoldMs - elapsed)
                    break
                }

                ; STREAK. One poll catching the socket mid-teardown is not
                ; evidence; consecutive agreeing polls are.
                if (st >= baseline) {
                    streak := 0
                    continue
                }
                if (++streak >= CFG.f1ConfirmStreak) {
                    holdWhy := "confirmed"
                    break
                }
            }
        } else {
            Sleep(CFG.forcefulHoldMs)
        }

        if CFG.f1DebugLog {
            ; Log the MEASURED elapsed time, not the configured value. Sleep can
            ; overshoot under load, and a hold that ran long is the first thing
            ; to check when a skip felt wrong.
            ;
            ; And log WHY it ended, which is the part a fixed hold could never
            ; tell you. "confirmed" means the client's connection really did
            ; leave ESTABLISHED and the skip will land. "ceiling" means it never
            ; did -- either the client stayed quiet for nine seconds, or the
            ; block was aimed at an address the match is not running on. Those
            ; two look identical from the chair and need opposite fixes.
            try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") . " F1 hold "
                . (A_TickCount - holdStart) . "ms (" . holdWhy . ")"
                . (holdWhy = "ceiling"
                    ? " -- the connection never left ESTABLISHED. If this"
                    . " repeats, the block is probably on the wrong address:"
                    . " check the block= line above against the GAME line."
                    : "") . "`n"
                , _LogPath())
        }

        RemoveIPBlock()
        ; ── THE SHIELD OUTLIVES THE BLOCK, DELIBERATELY ──────────────────────
        ; Deleting the firewall rule is the START of the reconnect, not the end
        ; of the skip. The client still has to notice the drop, re-establish and
        ; replay to the result; a click landing in that window goes into a board
        ; the user cannot see yet. This used to call StopHSInputShield here, so
        ; clicks went live the instant the rule was gone.
        ;
        ; It is not simply left on its original ceiling either -- that was the
        ; opposite complaint, a game that stayed dead for seconds after the
        ; network was back. The shield is re-aimed at a short, explicit window
        ; measured from the release.
        _ExtendHSInputShield(CFG.f1PostReleaseShieldMs)
        shieldHandedOver := (CFG.f1PostReleaseShieldMs > 0)

        ; ── THE FAILSAFE IS DEFERRED, NOT DISARMED ───────────────────────────
        ; This used to cancel it outright on the strength of RemoveIPBlock
        ; having been CALLED. But that function judges nothing: the OUT delete
        ; is fired asynchronously and neither exit code is read, so a delete
        ; that did not take still clears the flag -- after which the finally's
        ; RemoveIPBlock is a no-op and the failsafe is gone. Hearthstone stays
        ; firewalled off its own game server until the script exits.
        ;
        ; Re-arming it just past the shield instead costs two netsh calls a
        ; couple of seconds after the skip is already over, off the critical
        ; path, and makes "a rule can never survive a press" true rather than
        ; probable. It is idempotent and forced, so it is a no-op on the ledger
        ; and a real sweep on the machine.
        _f1FailsafeAt := CFG.f1PostReleaseShieldMs + 1000
        if (_f1FailsafeAt < 2500)
            _f1FailsafeAt := 2500
        SetTimer(_F1FailsafeRelease, -_f1FailsafeAt)

        BgHUD.Show("Reconnecting…", 1000)
    } catch {
        BgHUD.Show("F1 failed — unblocking", 1500)
    } finally {
        try RemoveIPBlock()
        ; DO NOT KILL A SHIELD THAT WAS DELIBERATELY HANDED OVER.
        ;
        ; On the normal path the block above re-aimed the shield at the
        ; post-release window and expects the 50 ms tick to expire it on
        ; schedule. Stopping it here would undo that in the same breath, and the
        ; clicks-land-too-early bug would be exactly as it was.
        ;
        ; The settle sleep therefore belongs to the FAILURE path only: an
        ; exception, or a press that never reached the release. There the shield
        ; is still on its original ceiling and has to be brought down by hand.
        if (!shieldHandedOver && InputShield.active) {
            Sleep(300)
            try StopHSInputShield()
        }
        State.lastF1End := A_TickCount
    }
}

; Four threads. The restart path sleeps for roughly 600 ms, and presses landing
; inside that window would otherwise be dropped with no indication. Extra
; threads bounce off the pipeline guard below instead.
#MaxThreadsPerHotkey 4
#HotIf HK_NoSysMods()
$*F2::Hotkey_F2()
SC03C::Hotkey_F2()
#HotIf

Hotkey_F2() {
    _HKFired("F2")
    global State, Cache, Launch, CFG, _smLastTick, _hdtGateSince, _fsSettingsEnforced
    ; ── F2 DOES NOT LAUNCH UNTIL THE SETTINGS WRITE HAS HAPPENED ────────────
    ; Overwolf reads Firestone's manifest when it loads the app, so a settings
    ; write that lands after the launch command has fired does nothing for that
    ; run. Start-up normally does this long before any F2, but if the key is
    ; pressed before that ran -- or the enforcement threw -- it is done here,
    ; synchronously, before anything is launched. It is one file read and at
    ; most one write, so the delay is not perceivable.
    if !_fsSettingsEnforced {
        _FSLog("F2 settings enforcement had not run yet -- doing it now, before"
             . " launching anything, because Overwolf reads the manifest when it"
             . " loads the app and a later write would miss this run.")
        try _FSEnforceFirestoneSettings()
    }
    _HotkeyTone("F2")

    ; ── WHICH OVERLAY IS THIS SESSION'S? ────────────────────────────────────
    ; Answered once, here, before anything is started -- because the answer
    ; decides what gets started. If both overlays are installed this opens the
    ; picker and waits for it; every other case resolves silently.
    ;
    ; DELIBERATELY BEFORE THE PIPELINE GUARD. The guard's job is to stop a
    ; second F2 from re-entering a live launch, and the picker's own
    ; _trackerPickerOpen flag already handles a second press landing while the
    ; prompt is up. Asking first also means the prompt cannot appear halfway
    ; through a launch that has already begun placing windows.
    ResolveTrackerMode()

    ; Clear the tracker Play-gate clock. See _hdtGateSince: a launch abandoned
    ; while the gate was waiting would otherwise hand this launch an expired
    ; ceiling, and the wait would be skipped at exactly the moment it mattered.
    _hdtGateSince := 0

    ; A live pipeline blocks re-entry even if State.f2Active was cleared
    ; mid-launch (the F3 unlock does that by long-standing design). BUT: if
    ; the pipeline is DEAD rather than busy (state stuck non-IDLE yet the
    ; state-machine heartbeat is stale -- an abort that didn't reset, an
    ; exception, an external timer kill), do NOT block forever. Detect the
    ; stale state and force a clean reset so this F2 proceeds. A live launch
    ; ticks every few hundred ms at most, so a >4s gap means dead.
    launchingNow := (State.f2Active || (Launch.state != "IDLE" && Launch.state != "DONE"))
    if launchingNow {
        ; A pipeline that has never ticked is DEAD, not busy.
        ;
        ; This read `_smLastTick != 0 && ...`, which meant a stamp of 0 could
        ; never be judged stale no matter how much time passed. _smLastTick is
        ; written by LaunchStateMachine_Tick, so a launch that died before its
        ; first tick -- the cold-start case, where Launch.state leaves IDLE
        ; several calls before the timer is armed -- left the stamp at 0 and
        ; this guard returned early on EVERY subsequent press. F2 was inert for
        ; the rest of the session, and F1 with it (it refuses to run while
        ; f2Active). Both entry points now baseline the stamp, and a 0 here is
        ; treated as dead so an older build's state cannot wedge this one.
        pipelineDead := !_LaunchPipelineAlive()
        if !pipelineDead
            return                      ; genuinely busy: block re-entry
        ; Stale/dead pipeline -- reset and fall through to a fresh launch.
        CancelLaunchTimers()
        Launch.state   := "IDLE"
        BgHUD.Show("Recovering stalled launch…", 1500)
    }
    State.f2Active := true


    isRestart              := GetHSPID()
    Launch.skipLoginDetect := false
    Launch.bnetWasRunning  := ProcessExist("Battle.net.exe") != 0

    if isRestart {
        ; ── RESTART PATH ─────────────────────────────────────────────────────
        ; Every Firestone-specific call below is gated on Firestone being this
        ; session's overlay. Under HSReplay -- or under no overlay at all --
        ; none of the suppression machinery arms, so nothing spends the session
        ; watching for windows that are never going to exist, and an Overwolf
        ; the user happens to be running for something else is not interfered
        ; with. StartHSCloaker is NOT gated: it belongs to Hearthstone.
        if TrackerIsFirestone() {
            KillFirestoneLoadingExisting()

            if State.fsMainLocked {
                LockFirestoneMain()
            }
        }

        StartHSCloaker()

        if TrackerIsFirestone()
            StartLauncherHide()

        ; StartFSNotifSweeper()   ; removed – already running from startup

        BgHUD.Show("Restarting Hearthstone…", 0)

        RemoveIPBlock()

        Sleep(100)

        try ProcessClose(isRestart)

        Sleep(300)

        try ProcessClose("Agent.exe")
        try ProcessClose("Battle.net Helper.exe")
        try ProcessClose("Battle.net.exe")

        Sleep(200)

        Cache.hsPath           := ""
        ; Login detection stays ENABLED on the restart path. Battle.net is not still
        ; authenticated here -- this branch closed it a few lines above -- so a restart
        ; that lands on a credential prompt must be able to reach LOGIN_WAIT. Detection
        ; costs a title match after a short delay and is a no-op whenever auto-login
        ; works.
        Launch.skipLoginDetect := false

        if TrackerIsFirestone() {

            StartEarlyOverwolfCloak()

            StartKillFirestoneLoading()

            ; The restart path deliberately does NOT kill Overwolf, so Firestone is
            ; normally still running and this is a no-op. It is armed anyway for
            ; the case where Overwolf died or was closed between sessions: without
            ; it, a restart would leave you with no overlay and nothing watching
            ; for that. LaunchFirestoneNow() self-checks FirestoneAppRunning().
            ; The deferred launch is no longer used; we launch Firestone immediately
            ; if it isn't running.
            ; ── FIRESTONE STARTS BEFORE HEARTHSTONE, AND THAT ORDER MATTERS ─────
            ; Firestone reads the game's memory to drive its overlay. Starting it
            ; BEFORE Hearthstone exists lets it be in place and waiting as the game
            ; comes up; starting it midway through Hearthstone's initialisation
            ; makes it attach to a process that is not ready, which fails with
            ; "CRITICAL ERROR: Could not read the game's memory" and leaves the user
            ; with no overlay for the session.
            ;
            ; A delay was briefly introduced here to move Firestone's windows out of
            ; the busiest part of the launch, so a birth-time concealment race had
            ; less to compete with. It fixed a cosmetic flash and broke the product,
            ; and both it and the scheduler it needed are now gone -- Firestone
            ; starts here, with Battle.net. See _FSStartFirestone.
            ; ASK FOR MAIN, NOT FOR "SOMETHING FIRESTONE-SHAPED IS RUNNING".
            ; The gate moved inside LaunchFirestoneNow, which checks whether the
            ; MAIN window is open rather than whether any Overwolf window is --
            ; Firestone closes to tray, so it is routinely running with no Main
            ; at all, and the old test read that as "already up" and launched
            ; nothing. This call is a no-op when Main is genuinely open.
            ; The game was asked to exit above, but ProcessClose only ASKS.
            ; Firestone must not be started until it has actually gone -- see
            ; _WaitForGameGone for the measurements. This is the restart path,
            ; the one case where Hearthstone is running when F2 is pressed.
            _WaitForGameGone()

            _FSStartFirestone()
        } else if TrackerIsHDT() {
            ; ── THE TRACKER STARTS BEFORE HEARTHSTONE TOO, FOR ITS OWN REASON ──
            ; Firestone goes first because it reads the game's memory and has to
            ; be attached before the game is ready. The tracker goes first
            ; because it writes log.config, which Hearthstone reads once at
            ; start-up and never again. Different mechanism, same ordering, and
            ; the Play press is gated on it in TryLaunchWTCG so a slow tracker
            ; start cannot lose the race.
            ; ARMED BEFORE THE LAUNCH, NOT AFTER IT. State.hdtHidden is what
            ; makes the window hook conceal a tracker window at birth, and
            ; LaunchHDTNow does real work (path resolution, then Run) before it
            ; returns -- so arming afterwards leaves a gap in which the launch
            ; is already issued and the hook is still inert.
            HDT_StartHidden()
            LaunchHDTNow()
        }

        StartHSLaunch()

    } else {
        ; ── FRESH LAUNCH PATH ────────────────────────────────────────────────
        ; As on the restart path, the Firestone machinery arms only when
        ; Firestone is this session's overlay. StartHSCloaker is Hearthstone's
        ; and runs either way.

        if TrackerIsFirestone() {
            LockFirestoneMain()

            StartEarlyOverwolfCloak()
        }

        StartHSCloaker()

        if TrackerIsFirestone() {
            StartKillFirestoneLoading()

            StartLauncherHide()

            ; StartFSNotifSweeper()   ; removed – already running from startup

        }

        if Launch.bnetWasRunning
            Launch.skipLoginDetect := true

        if TrackerIsFirestone() {
            ; ── LAUNCH ORDER ──────────────────────────────────────────────
            ; Firestone is launched immediately, at the same time as
            ; Battle.net. The old deferred launch (waiting for
            ; Hearthstone.exe) is removed.
            ;
            ; UNCONDITIONAL, because the gate moved inside
            ; LaunchFirestoneNow: it asks whether the MAIN window is open
            ; rather than whether any Overwolf window is. Firestone closes to
            ; tray, so it is routinely running with no Main at all, and the
            ; old FirestoneAppRunning() test read that as "already up" and
            ; launched nothing. This is a no-op when Main is genuinely open.
            _FSStartFirestone()
        } else if TrackerIsHDT() {
            ; Same position in the sequence, same reason for being early: the
            ; tracker writes log.config and Hearthstone reads it once, at
            ; start-up. See _TrackerPlayGateClear, which holds the Play press
            ; until this has actually come up.
            ; As on the other path: armed BEFORE the launch so the hook is
            ; live for the tracker's very first window. See CFG.hdtStartHidden.
            HDT_StartHidden()
            LaunchHDTNow()
        }
        ; ── HOLD THE GAME UNTIL FIRESTONE MAIN ACTUALLY EXISTS ──────────────
        ;
        ; Firestone is started before this line, but STARTING it is not the same
        ; as its window existing, and nothing here ever waited for the window.
        ; Measured on this machine:
        ;
        ;   F2 +0s   Firestone launch issued
        ;   F2 +5s   Battle.net launcher window
        ;   F2 +8s   Firestone Main is actually born
        ;   F2 +11s  Hearthstone
        ;
        ; So Main preceded the game by three seconds -- by luck of timing, not
        ; because anything enforced it. On a slower machine, a cold Overwolf or
        ; a Battle.net that is already open, that ordering inverts and Main is
        ; created INTO a running game, which is the case that reliably kills it.
        ;
        ; This makes the order deliberate. Bounded, and non-blocking: it is a
        ; one-shot timer rather than a wait loop, because blocking here would
        ; freeze every hotkey including F4.
        ; Firestone and Hearthstone start together. There used to be a gate here
        ; that held the game until Firestone Main existed, on the theory that
        ; Main only survives if it is created before the game. That ordering was
        ; disproved by the owner in testing, and the gate never actually held
        ; anyway -- _fsGateUntil was assigned inside Hotkey_F2 without being
        ; declared global there, so the write went to a discarded local and the
        ; deadline stayed 0. Making it work simply added up to 25 seconds of
        ; waiting before the launcher appeared, for no benefit. Deleted rather
        ; than switched off.
        StartHSLaunch()
    }
}


; ── Shutdown — triggered by the F4 key ──────────────────────────────────────
;
; MaxThreadsPerHotkey 10 belongs to F4 and to F4 alone. Shutdown is allowed to
; re-enter, because a user who thinks nothing happened presses it again and
; every one of those presses must reach a handler rather than be discarded --
; a swallowed F4 leaves windows parked off the virtual desktop.
;
; SC03E is F4's scancode: the fallback for the case the whole watchdog exists
; for, a fullscreen DirectInput game that eats the named-key hotkey. F1, F2
; and F3 each carry the same pair for the same reason.
#MaxThreadsPerHotkey 10
#HotIf HK_NoSysMods()
$*F4::Hotkey_F4()
SC03E::Hotkey_F4()
#HotIf

; ── Animation speed — F5 ────────────────────────────────────────────────────
;
; SPLIT OUT OF THE F4 BLOCK, AND BOTH HALVES OF THAT MATTER.
;
; F5 was declared inside the shutdown block, which handed it two settings
; written for F4 and wrong for it.
;
; It inherited MaxThreadsPerHotkey 10, so a held or repeated F5 could stack
; ten cycle-and-write threads over one bridge file. The only possible
; outcomes of that race are a speed the user did not select and log lines
; that disagree with the HUD. Cycling a setting is the opposite case from
; shutdown: the LAST press must win and the ones in flight are noise, which
; is exactly what a limit of 1 means.
;
; It also inherited no scancode fallback, while every other hotkey here has
; one -- leaving it the only key in the script unreachable from a fullscreen
; game, which is the one place a speed key is ever pressed. SC03F is F5.
; Each key carries its scancode twin for the same reason F1-F4 do: a
; fullscreen DirectInput game can consume the named-key hotkey, and the speed
; keys are pressed in exactly that situation. SC03F..SC042 are F5..F8.
;
; MaxThreadsPerHotkey 1 across all four. Cycling is the opposite case from
; shutdown: the LAST press must win and the ones in flight are noise. Ten
; queued threads over one bridge file is a race whose only outcomes are a
; speed nobody chose and a HUD that disagrees with the log.
#MaxThreadsPerHotkey 1
#HotIf HK_NoSysMods()
; F5 FASTER, F6 SLOWER -- the pair walks the cycle in both directions, which
; is the interaction the key names imply and the one the HUD describes.
;
; F5 IS CONTESTED, AND THAT IS NOT FIXABLE FROM HERE. Overwolf, NVIDIA's
; overlay, Discord and Steam all run alongside Hearthstone and all bind
; F-keys by default; whichever registered first owns the key, and the press
; then never reaches this script at all -- no HUD, no log line, nothing,
; which is indistinguishable from a broken script. The scancode twin does not
; help, because SC03F is the same physical key.
;
; So F5 is bound because it is the natural key and it works on most machines,
; and there is no second key: SpeedHotkey was removed, because one speed key
; is what this script offers and a hidden second one nobody asked for is worse
; than none. A key another program has taken is fixed in that program.
; F5 IS BOUND ONE WAY ONLY. THE REASONING IS A THEORY, NOT A MEASUREMENT.
;
; Every other key here carries a scancode twin as a fallback for a fullscreen
; DirectInput game eating the named-key hotkey. F5 had one and it was removed,
; on this argument:
;
;   $*F5   the $ forces AutoHotkey's keyboard HOOK. A hook sees the key no
;          matter who else wants it, and cannot be refused by another program.
;   SC03F  a plain hotkey, which AutoHotkey MAY implement with RegisterHotKey.
;          RegisterHotKey is exclusive and first-come, so if another program
;          already holds F5 -- the one key in this range that routinely IS
;          claimed -- ours could fail to register at all.
;
; STATED HONESTLY, BECAUSE IT HAS NEVER BEEN TESTED. Nobody has demonstrated
; the twin failing on F5, and the evidence in this very file points the other
; way: F1, F2, F3, F4, F6, F7 and F8 all carry both forms and all work. If the
; twin were the liability described above, those seven would be at risk too.
;
; It is left alone anyway, for a reason that has nothing to do with the theory:
; the one time F5 was dead on this machine, the cause was a physically broken
; key, and the twin was added and then removed again while chasing it. Changing
; a working binding on an untested argument is not an improvement. If F5 ever
; genuinely fails somewhere, test the twin before reasoning about it -- and
; measure which form fires, because both call the same handler and the log
; cannot tell them apart.
;
; This does not conjure the key back if another program's own hook swallows it
; upstream -- nothing here can. A key another program takes first is gone
; before this script exists, and the only fixes are in that program. Rule out
; the keyboard itself too: a dead key is indistinguishable from a stolen one,
; and here it was exactly that.
$*F5::Hotkey_F5()
$*F6::Hotkey_F6()
SC040::Hotkey_F6()
$*F7::Hotkey_F7()
SC041::Hotkey_F7()
$*F8::Hotkey_F8()
SC042::Hotkey_F8()
; F9 toggles automatic combat skipping. Bound in the same two forms and inside
; the same #HotIf as the speed keys, because it is the same kind of key: it
; only means anything while the game is in front, and it must not be taken
; from other applications the rest of the time. SC043 is F9.
$*F9::Hotkey_F9()
SC043::Hotkey_F9()
#HotIf


Hotkey_F4() {
    _HKFired("F4")
    Critical(false)
    global State, Launch, _f4Shutdown
    _HotkeyTone("F4")


    try {
        ; ── Shutdown: do not restore what is about to be killed ─────────────
        ; F4 kills Overwolf. Those windows are about to stop existing, so restoring
        ; them first achieves nothing except showing them briefly on the way out.
        ;
        ; The restore janitors exist for the other exit paths -- tray exit, reload,
        ; crash -- where this script goes away but Overwolf keeps running and a parked
        ; window would be left genuinely unreachable. That reasoning does not apply
        ; when we are killing the process that owns the window.
        ;
        ; Flag it, keep the lock on so nothing releases, kill, and only then decide.
        ; If the kill succeeded there is nothing left to restore; if it did not, the
        ; flag is cleared below and ExitCleanup restores normally -- an unreachable
        ; window is worse than a brief flash.
        _f4Shutdown := true

        ; ── KILL OVERWOLF FIRST, WHILE THE SUPPRESSION IS STILL HOLDING ─────
        ;
        ; THIS IS "THE HIDDEN FIRESTONE WINDOWS FLASH ON THEIR WAY OUT".
        ;
        ; These three lines used to sit forty lines further down, after every
        ; suppressor had been switched off. That order has a gap in it: the
        ; janitors that keep Firestone's windows hidden stop first, Overwolf
        ; carries on re-showing those windows -- which it does, that is why the
        ; re-assert path exists -- and nothing is left to take them back. They
        ; become visible for as long as it takes the kill to land, and the last
        ; thing the user sees on the way out is the windows they had hidden.
        ;
        ; Killing first closes the gap: the process owning the windows is gone
        ; before anything stops watching them, so there is nothing left to
        ; re-show and nothing to see. The stops below then tear down timers that
        ; have no work left rather than abandoning windows that still do.
        ;
        ; Only the Overwolf kills move. Battle.net and Hearthstone are killed
        ; further down as before -- neither has windows this script conceals, so
        ; neither can flash, and reordering them would be a change with no
        ; reason behind it.
        try Run('taskkill /F /IM OverwolfLauncher.exe /T', , "Hide")
        try Run('taskkill /F /IM OverwolfBrowser.exe /T',  , "Hide")
        try Run('taskkill /F /IM Overwolf.exe /T',         , "Hide")

        Launch.state       := "IDLE"
        State.f2Active     := false
        CancelLaunchTimers()
        StopLauncherHide()
        StopEarlyOverwolfCloak()
        StopHSCloaker()
        StopHSInputShield()
        StopHSHiddenLaunchWatch()
        StopHSPlacementGuard()
        StopOverlayTopmostEnforcer()
        StopMonitorLock()
        StopFSReveal()
        StopBNetPostLaunchMinimize()

; (_FSUnparkAll deliberately NOT called here -- see the note above.)

        _ForceReleaseHighResTimer()

        SetTimer(FSMainMonitor,                 0)
        SetTimer(RevealHSAfterLaunch,           0)
        SetTimer(HSHiddenLaunchWatch,           0)
        SetTimer(SuppressFirestoneLoadingTick,  0)
        SetTimer(KillFirestoneLoading,          0)
        SetTimer(StopKillFirestoneLoading,      0)
        SetTimer(F4Watchdog,                    0)

        try BgHUD.Hide()

        try UnmuteHearthstone()

        try ResumeWSearch()


        try Run('taskkill /F /IM Agent.exe /T',               , "Hide")
        try Run('taskkill /F /IM "Battle.net Helper.exe" /T', , "Hide")
        try Run('taskkill /F /IM Battle.net.exe /T',          , "Hide")

        try Run('taskkill /F /IM Hearthstone.exe /T',         , "Hide")

        ; ── THE TRACKER IS CLOSED, LIKE EVERYTHING ELSE IN THE SESSION ──────
        ; _TrackerShutdown closes it unconditionally -- no config option, no
        ; "who started it" check -- because F4 means "end this Battlegrounds
        ; session" and the tracker is part of the session. It is asked to close
        ; first (it writes match statistics as it plays, and a forced kill
        ; mid-write truncates a stats file) and forced only if it has not gone
        ; within two seconds.
        ;
        ; IT DOES NOT SHOW THE TRACKER FIRST. A tracker F3 left hidden is
        ; closed while still hidden and its windows are destroyed with the
        ; process -- flashing them onto the screen a moment before killing them
        ; is the opposite of what F4 was asked to do. The guarantee that a
        ; concealment never outlives this script is kept where it actually
        ; applies: if the close and the force BOTH fail, the surviving windows
        ; are revealed. See _TrackerShutdown.
        try _TrackerShutdown()

        ; Verify the kill before trusting it. taskkill is issued asynchronously, so
        ; "we asked" is not "it is gone". Only if Overwolf is genuinely dead is the
        ; restore skipped; otherwise a failed kill would leave its windows parked
        ; off-screen with no taskbar button and nothing running to bring them back.
        _f4Deadline := A_TickCount + 1500
        while (A_TickCount < _f4Deadline) {
            if !(ProcessExist("Overwolf.exe") || ProcessExist("OverwolfBrowser.exe"))
                break
            Sleep(50)
        }
        if (ProcessExist("Overwolf.exe") || ProcessExist("OverwolfBrowser.exe")) {
            _f4Shutdown := false     ; kill failed: let ExitCleanup restore
            _FSLog("F4 shutdown: Overwolf survived the taskkill"
                 . " -- restoring its windows rather than leaving them parked")
        }
    } catch {
    } finally {
        ExitApp()
    }
}



; ── FS lock toggle — triggered by the F3 key ────────────────────────────────
#MaxThreadsPerHotkey 1
#HotIf HK_NoSysMods()
$*F3::Hotkey_F3()
SC03D::Hotkey_F3()
#HotIf

; Has a window titled exactly "Firestone - Main" ever existed this session?
;
; Latched, not polled: once true it stays true, so the scan below runs only
; while the answer is still no. Enumerating hidden windows is required -- Main
; is concealed the moment it appears, and a concealed window is still a window
; that has opened.
global _fsMainEverOpened := false
FSMainHasOpened() {
    global _fsMainEverOpened, _fsParked, _fsHiddenByUs
    if _fsMainEverOpened
        return true

    ; A SECOND WAY TO QUALIFY, so this gate cannot wedge shut.
    ;
    ; The primary test is an exact "Firestone - Main" title. If a Firestone
    ; build ever names that window differently, that test would fail on every
    ; press forever and F3 would be dead with nothing to tell the user why. So
    ; anything the script is ALREADY concealing counts too: if there is a
    ; Firestone window parked or hidden, there is by definition something for
    ; F3 to reveal, whatever it happens to call itself.
    if (_fsParked.Count || _fsHiddenByUs.Count) {
        _fsMainEverOpened := true
        return true
    }
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true          ; Main is hidden on purpose; still counts
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if IsFirestoneMainTitle(WinGetTitle("ahk_id " . h)) {
                        _fsMainEverOpened := true
                        break
                    }
                }
            }
            if _fsMainEverOpened
                break
        }
    }
    DetectHiddenWindows prev
    return _fsMainEverOpened
}

; ── F3 under HSReplay — hide / un-hide the tracker ──────────────────────────
;
; The Firestone version of F3 hides DESKTOP windows and never touches the
; in-game overlay, because under Firestone the overlay is the thing you are
; playing with and the desktop windows are the clutter. Under HSReplay the
; relationship is the other way round: the overlay is what is on your board, so
; that is what F3 is for.
;
; Everything about how the concealment works -- cloaking rather than hiding, the
; ledger of what we concealed, the watcher for panels created while hidden -- is
; in section 7B. This is only the key handler.
Hotkey_F3_HDT() {
    global State

    ; INERT UNTIL THERE IS SOMETHING TO TOGGLE, exactly as the Firestone branch
    ; is inert until Main exists. A tone that says "that did something" when
    ; nothing happened is worse than silence.
    if !HDTRunning()
        return

    ; ── TRUST THE SCREEN, NOT ONLY THE FLAG ─────────────────────────────────
    ; State.hdtHidden is what this SCRIPT last intended. The window list is
    ; what the USER is actually looking at. They can disagree -- a conceal
    ; that ran from the birth path before the flag was armed, a reveal that
    ; released a window the ledger had lost, a tracker that restarted itself
    ; -- and the disagreement used to be unrecoverable in one specific
    ; direction: flag says "not hidden" while every window is hidden.
    ;
    ; In that state the guard below saw no visible surfaces and returned in
    ; silence, and even past it the toggle would have called HDT_Hide, found
    ; nothing to conceal and reported "Nothing to hide". The tracker was
    ; running, invisible, with no key left that could bring it back.
    ;
    ; So the direction is decided by what is on screen. Nothing visible and
    ; something hidden means the only useful thing F3 can do is show.
    hidden := State.hdtHidden

    ; ── A MINIMISED WINDOW IS HIDDEN, WHATEVER WINDOWS SAYS ─────────────────
    ; IsWindowVisible stays TRUE for a minimised window -- WS_VISIBLE is not
    ; cleared by minimising -- so counting "visible" surfaces counted windows
    ; sitting in the taskbar as if they were on screen. Now that the tracker
    ; starts minimised that is the normal state, and F3 would have read it as
    ; "something is showing, so hide it" on every single press.
    vis := 0
    for h in GetHDTSurfaces() {
        try {
            if !DllCall("user32\IsIconic", "Ptr", h)
                vis++
        }
    }

    if (!hidden && !vis && GetHDTSurfaces(true).Length) {
        _FSLog("HDT-F3 no tracker window is visible but the hidden flag was"
             . " not set -- showing rather than hiding, so the tracker cannot"
             . " be left running with no way to bring it back")
        hidden := true
    }
    if (!hidden && !vis)
        return

    _HotkeyTone("F3")

    ; Debounce, for the same reason the Firestone branch debounces: a held or
    ; spammed key should not turn into a burst of DWM attribute changes on a
    ; window somebody else's process is actively drawing into.
    static lastPress := 0
    if (A_TickCount - lastPress < 250)
        return
    lastPress := A_TickCount

    ; ── THE HUD SPEAKS THE SAME LANGUAGE ON BOTH SIDES OF F3 ────────────────
    ; Under Firestone the key reports "FS Unlocked" / "FS Locked". Under
    ; HSReplay it said "Tracker shown" / "Tracker hidden", which describes the
    ; same one key in a different vocabulary -- so the message told you nothing
    ; about which overlay F3 currently belongs to, which is the one thing a
    ; user with both installed actually needs from it. Same shape, same tense,
    ; different prefix: HSR for the tracker, FS for Firestone.
    try {
        if hidden {          ; the reconciled view, not State.hdtHidden alone
            HDT_Show()
            BgHUD.Show("HSR Unlocked", 800)
        } else {
            n := HDT_Hide()
            ; "Nothing to hide" is kept for the one case where the state did
            ; NOT change -- HDT_Hide found no surfaces and deliberately did not
            ; arm the hidden state, so claiming "HSR Locked" would be a lie the
            ; next press would then contradict.
            BgHUD.Show(n ? "HSR Locked" : "Nothing to hide", 800)
        }
    } catch {
        ; FAIL TOWARDS VISIBLE. Whatever went wrong, an overlay the user cannot
        ; get back is the worse outcome of the two.
        try HDT_Show()
        BgHUD.Show("F3 error – tracker restored", 1200)
    }
}

; What does Firestone's manifest say about desktop_only RIGHT NOW?
;
; READ, NEVER ASSERTED. The destroy verdict used to state as fact that
; "Firestone declares desktop_only" -- text written when that was true, left
; unchanged after this script started patching the flag out. It then told me,
; in this very log, that a death was "EXPECTED ... declares desktop_only"
; minutes after the flag had been set to false. A hardcoded claim about a file
; that this script edits is a lie waiting to happen.
;
; Cached briefly: this is called from a destroy handler.
_FSDesktopOnlyStateNow() {
    static cached := "", at := 0
    if (cached != "" && A_TickCount - at < 30000)
        return cached
    val := "unknown (manifest not found)"
    try {
        mf := _FSFirestoneManifestPath()
        if (mf != "") {
            txt := FileRead(mf, "UTF-8")
            r := _FSJsonBlockRange(txt, "CollectionWindow")
            if IsObject(r) {
                blk := SubStr(txt, r.start, r.len)
                if RegExMatch(blk, 'i)"desktop_only"\s*:\s*true')
                    val := "true"
                else if RegExMatch(blk, 'i)"desktop_only"\s*:\s*false')
                    val := "false"
                else
                    val := "not declared"
            }
        }
    }
    cached := val, at := A_TickCount
    return val
}

; Is Firestone set to use its in-game (integrated) window?
;
; WHY THIS GATE EXISTS. Asking Firestone for a window while a game runs gets the
; OVERLAY counterpart -- CollectionOverlayWindow, which is drawn in the game's
; overlay space rather than as an OS window. With integrated mode switched OFF
; that is not what the user wants: it arrives on the wrong monitor, and its
; settings cannot be reached. Measured on this machine, and reported as "pulled
; up Firestone Main but in integrated mode, not on primary, couldn't access
; settings".
;
; WHERE THE ANSWER LIVES. Firestone keeps its preferences in Overwolf's CEF
; local storage, and the switch is "bgsUseOverlay". That store is a LevelDB, and
; there is no LevelDB reader here -- but the value is plain text inside the
; append-only .log, so it can be read without one. LevelDB appends, so the LAST
; occurrence is the current value.
;
; DEFAULTS TO OFF. If the store cannot be read, or the key has never been
; written, the honest answer is "do not use the overlay window": a user who
; never enabled it should not be handed one, and the cost of being wrong that
; way is a reveal that finds nothing rather than a window in the wrong place.
_FSIntegratedModeOn() {
    static cached := "", cachedAt := 0
    if (cached != "" && A_TickCount - cachedAt < 10000)
        return cached = "1"
    val := ""
    try {
        dir := EnvGet("LOCALAPPDATA")
             . "\Overwolf\CefBrowserCache\Default\Local Storage\leveldb"
        if DirExist(dir) {
            loop files dir . "\*.log" {
                txt := ""
                try txt := FileRead(A_LoopFileFullPath, "RAW")
                if (txt = "")
                    continue
                ; Last occurrence wins: the store is append-only.
                pos := 1
                while (p := InStr(txt, "bgsUseOverlay", false, pos)) {
                    seg := SubStr(txt, p, 40)
                    if InStr(seg, "true")
                        val := "1"
                    else if InStr(seg, "false")
                        val := "0"
                    pos := p + 13
                }
            }
        }
    }
    if (val = "")
        val := "0"
    cached := val, cachedAt := A_TickCount
    return val = "1"
}

; Ask Firestone to open one of its own windows, and CHECK THAT IT DID.
;
; WHY THIS IS NOT ONE Send(). Two reasons, both measured as "eventually works
; but takes very long".
;
; 1. SENDINPUT IS THE WRONG MECHANISM HERE. AutoHotkey v2 defaults to
;    SendInput, which delivers the whole key sequence as one atomic block with
;    no gaps. Overwolf registers its app hotkeys through a low-level keyboard
;    hook, and hooks of that kind routinely miss a burst delivered that fast --
;    which is why pressing Alt+C by hand works first time and one Send() often
;    does nothing. SendEvent with a real key delay produces the same shape of
;    input a human does.
;
; 2. A KEYSTROKE HAS NO RETURN VALUE. Sending once and hoping was the whole
;    design; there was no way to tell "Firestone ignored it" from "Firestone is
;    still building the window". So this watches for a Firestone window that did
;    not exist before the ask, and only then reports success.
;
; BOUNDED, and it stops the instant the window appears -- this is a request
; that is repeated only while it is going unanswered, not a poll. The latency
; is logged either way, because "how long does Firestone actually take" is a
; number nobody has ever had.
_FSAskFirestoneFor(which) {
    global _fsAppHotkeys, CFG
    spec := ""
    try {
        if !IsObject(_fsAppHotkeys)
            _fsAppHotkeys := _FSReadAppHotkeys()
        spec := _FSHotkeyToSend(which = "bg" ? _fsAppHotkeys.bg : _fsAppHotkeys.main)
    }
    if (spec = "")
        return false

    before := Map()
    for h in _FSFirestoneWindowHandles()
        before[h] := true

    t0 := A_TickCount
    loop CFG.fsAskTries {
        attempt := A_Index
        try {
            prevMode  := A_SendMode
            prevDelay := A_KeyDelay
            SendMode("Event")            ; individual events, hook-visible
            SetKeyDelay(10, 10)          ; paced enough for a hook, no more
            Send(spec)
            SendMode(prevMode)
            SetKeyDelay(prevDelay)
        }
        waited := 0
        while (waited < CFG.fsAskWaitMs) {
            Sleep 100
            waited += 100
            for h in _FSFirestoneWindowHandles() {
                if before.Has(h)
                    continue
                _FSLog("FS-INGAME Firestone opened a window " . (A_TickCount - t0)
                     . "ms after being asked, on attempt " . attempt . " of "
                     . CFG.fsAskTries . " (key " . spec . "). Sent with SendEvent"
                     . " rather than SendInput: Overwolf reads its hotkeys through"
                     . " a low-level hook, and an atomic SendInput burst is the"
                     . " thing it misses.")
                return true
            }
        }
    }
    _FSLog("FS-INGAME asked Firestone for its " . which . " window " . CFG.fsAskTries
         . " times over " . (A_TickCount - t0) . "ms and no new window appeared."
         . " Either the hotkey (" . spec . ") is not the one Firestone has, or it"
         . " is refusing. Nothing else this script can do opens that window.")
    return false
}

; Fired once, shortly after Overwolf takes Firestone Main during a game.
; See _FSNoteDestroyed for why this does not wait for F3.
_FSPreemptInGameWindow() {
    global State
    try {
        if !ProcessExist("Hearthstone.exe")
            return
        if !State.fsMainLocked
            return                    ; user has F3 unlocked: not our moment
        if _FSMainWindowPresent()
            return                    ; Firestone already rebuilt it by itself
        if !_FSIntegratedModeOn()
            return                    ; overlay window is not wanted: see F3
        _FSLog("FS-INGAME Firestone Main was taken by Overwolf mid-game."
             . " Asking Firestone for its in-game window straight away rather"
             . " than waiting for F3, so the window is already built and"
             . " concealed when it is wanted.")
        _FSAskFirestoneFor("main")
    }
}

; Every top-level Firestone-family window, by handle.
_FSFirestoneWindowHandles() {
    out := []
    prev := A_DetectHiddenWindows
    DetectHiddenWindows true
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if (DllCall("user32\GetAncestor", "Ptr", h, "UInt", 2, "Ptr") != h)
                        continue
                    t := WinGetTitle("ahk_id " . h)
                    if (t != "" && InStr(t, "Firestone") = 1)
                        out.Push(h)
                }
            }
        }
    }
    DetectHiddenWindows prev
    return out
}

Hotkey_F3() {
    _HKFired("F3")
    global State, _fsUserUnlocked, _fsAppHotkeys

    ; ── F3 BELONGS TO WHICHEVER OVERLAY THIS SESSION CHOSE ──────────────────
    ; The choice is normally made at F2. F3 can arrive before that -- and can
    ; arrive at any moment, including mid-match -- so it resolves the mode
    ; NON-INTERACTIVELY: if the answer is unambiguous (one overlay installed, or
    ; a pinned setting) it is used, and if it is genuinely ambiguous F3 does
    ; nothing rather than opening a dialog over a live game.
    mode := State.trackerMode
    if (mode = "")
        mode := ResolveTrackerMode(false)
    if (mode = "hsreplay") {
        Hotkey_F3_HDT()
        return
    }
    if (mode != "firestone")
        return          ; "none", or undecided: nothing for F3 to own

    ; ── F3 IS COMPLETELY INERT UNTIL FIRESTONE MAIN EXISTS ──────────────────
    ; Before that point there is nothing for it to toggle, and every part of
    ; pressing it is a liability rather than a no-op:
    ;
    ;   * It flips State.fsMainLocked, which is what tells the suppression
    ;     subsystems to conceal Firestone's windows AS THEY ARE BORN. Unlocking
    ;     before Main exists disarms the concealment for the exact window it
    ;     was armed for, so the window arrives visible.
    ;   * It clears State.f2Active, standing the launch pipeline's Firestone
    ;     stage down mid-flight.
    ;   * It plays a note, which says "that did something" when it did not.
    ;
    ; This returns BEFORE the tone and before the debounce stamp, so an early
    ; press is silent and costs nothing -- it is not consumed, not queued, and
    ; not remembered. The first press after Main opens behaves as the first
    ; press.
    if !FSMainHasOpened()
        return

    _HotkeyTone("F3")

    ; Debounce: rapid re-toggling style-flaps the CEF window (layered alpha
    ; on/off + a FRAMECHANGED SetWindowPos per cycle) -- the documented wedge
    ; hazard for a forming Firestone - Main. Presses landing inside the
    ; window are acknowledged on the HUD and dropped; state never flaps.
    static lastF3 := 0
    if (A_TickCount - lastF3 < 250) {
        ; (no HUD toast here: the debounce still protects the window, but a
        ;  spammed F3 should not paint a message about being spammed.)
        return
    }
    lastF3 := A_TickCount

    ; ATOMIC TOGGLE. Without this the suppression sweep, the 30 ms reveal tick
    ; and the window event hook can all interrupt this handler PART-WAY
    ; THROUGH -- between clearing the lock flag and starting the reveal, or
    ; between starting the reveal and the first sweep. Each interleaving leaves
    ; the two halves briefly disagreeing about who owns the window, and every
    ; disagreement costs a show or a hide on a live CEF surface. Under a stress
    ; test they stack up. Critical makes the whole state change one indivisible
    ; step; the body contains no Sleep, so nothing is starved, and it clears
    ; automatically when the thread ends.
    ; CRITICAL COVERS THE STATE CHANGE ONLY -- NOT THE WINDOW WORK.
    ;
    ; Critical(true) forbids every other thread from running: no timer, no
    ; other hotkey, nothing. That is exactly right for flipping the flag and
    ; stopping the timers, which is a handful of assignments and cannot block.
    ; It was catastrophically wrong for the window work that used to sit inside
    ; it -- StartFSReveal and LockFirestoneMain both enumerate every Overwolf
    ; window and touch each one, and a single call that stalls on a crashed
    ; Firestone window then freezes the ENTIRE script, hotkeys included, with
    ; no watchdog able to run either (they are timers, and timers are exactly
    ; what Critical is suppressing). One slow window call became "nothing
    ; responds".
    ;
    ; The atomicity that mattered is still here: the flag and the timers change
    ; together, so no sweep can observe a half-applied toggle. The subsequent
    ; window work is idempotent and re-entrancy is already handled by the 250 ms
    ; debounce above and by each function's own guards.
    unlocking := false
    Critical(true)
    try {
        if State.fsMainLocked {
            ; ── THE EARLY CLOAK STOPS INSIDE THE CRITICAL, BEFORE THE UNLOCK ─
            ; The early cloak is a blanket that conceals untitled Overwolf
            ; windows during the launch. Stopping it AFTER the unlock leaves
            ; it live for a few milliseconds while the reveal is already
            ; trying to show windows -- a tug-of-war whose outcomes are a
            ; flicker or a Main that stays hidden.
            ;
            ; Stopping it here makes the whole state change atomic: the
            ; blanket is down before the lock is released, so no sweep can
            ; ever observe one without the other. It also removes the reason
            ; the deferred-stop flag existed -- there is nothing left to defer.
            try StopEarlyOverwolfCloak()

            ; ----- Then unlock the state -----
            _FSSetLock(false, "F3 pressed -- unlock")
            _fsUserUnlocked    := true
            SetTimer(FSMainMonitor, 0)
            StopFSBurst()
            State.f2Active := false
            unlocking := true
        }
    } catch {
        Critical(false)
        BgHUD.Show("F3 error – reset", 1200)
        return
    }
    Critical(false)

    ; Window work belongs OUT here, where a stalled cross-process call costs
    ; time instead of costing the whole script.
    try {
        if unlocking {
            ; ── F3 IS THE REVEAL AGAIN, AND ONLY THE REVEAL ─────────────────
            ; Sending Firestone's own show/hide hotkey from here was tried and
            ; is gone. It is clunkier than the reveal in every way that shows:
            ; it needs the game focused before the key will even be delivered,
            ; it has to be verified afterwards because a keystroke has no
            ; return value, and it fails silently on a machine where the user
            ; rebound the key. The reveal answers immediately and needs none of
            ; that.
            ;
            ; What it CANNOT do is bring back a window Overwolf has closed --
            ; and nothing here can, because CollectionWindow is declared
            ; desktop_only and Overwolf enforces that while a game runs. That
            ; is a property of the window, not a gap in this code, and pretending
            ; otherwise is what produced the clunk.
            ; ── IN-GAME, THE WINDOW WE WANT IS NOT THE ONE WE HAVE ──────────
            ;
            ; Firestone declares TWO collection windows in its manifest:
            ;
            ;   CollectionWindow         desktop_only, native_window,
            ;                            use_os_windowing   <- "Firestone - Main"
            ;   CollectionOverlayWindow  transparent, NOT desktop_only
            ;
            ; Overwolf closing Main when a game starts is the HANDOFF between
            ; those two, not a failure. In-game the user is meant to be looking
            ; at the overlay counterpart -- and this script cannot create it,
            ; because it is Firestone's window and only Firestone makes it.
            ;
            ; A reveal cannot show a window that does not exist. That is the
            ; whole of "F3 works once and then does nothing": Main is handed
            ; off, and F3 goes on toggling a lock over a destroyed handle.
            ;
            ; So when Main is gone and a game is running, F3 ASKS FIRESTONE for
            ; its window using Firestone's own hotkey, read from its manifest
            ; (Alt+C by default, and whatever the user rebound it to if they
            ; did). That is not a fallback -- it is the only route that exists,
            ; and it is what the user was doing by hand.
            ; ── ONLY WHEN THE USER HAS INTEGRATED MODE ON ───────────────────
            ; Asking Firestone in-game produces its OVERLAY window, not the
            ; desktop one. With integrated mode off that window is unwanted --
            ; wrong monitor, settings unreachable -- so F3 does not ask for it.
            ; See _FSIntegratedModeOn.
            asked := false
            if (!_FSMainWindowPresent() && ProcessExist("Hearthstone.exe")
             && _FSIntegratedModeOn()) {
                BgHUD.Show("Asking Firestone…", 900)
                asked := _FSAskFirestoneFor("main")
                if !asked
                    BgHUD.Show("Firestone did not answer", 1200)
            }
            if !asked {
                StartFSReveal()
                BgHUD.Show("FS Unlocked", 800)
            }
        } else {
            _fsUserUnlocked := false      ; and re-locked it by hand too
            LockFirestoneMain()
            BgHUD.Show("FS Locked", 800)
        }
    } catch {
        try {
            _FSSetLock(true, "F3 handler error path -- re-locking to a safe state")
            ; One synchronous pass, the same as the normal lock path. The
            ; comment that used to sit here explained how to re-arm
            ; FSMainMonitor without confusing its cached period; that timer is
            ; gone, and the explanation went with it.
            SuppressFirestoneMainTick()
        }
        BgHUD.Show("F3 error – reset", 1200)
    }
}

; ==============================================================================
; SECTION 16: STARTUP / BACKGROUND TASKS
; ==============================================================================
;
; Everything that runs once when the script boots: pick the launch monitor,
; elevate to admin, repair anything a crashed previous run left hidden,
; arm the permanent window hook, and start the steady‑state watchers.
;

; Resolve the launch monitor BEFORE elevation.
ResolveChosenMonitor()

; ── Require elevation — relaunch as admin, handing off the launch monitor ────
;
; TWO FAILURES THIS HANDLES THAT THE ONE-LINE VERSION DID NOT.
;
; 1. THE USER CLICKS "NO" ON THE UAC PROMPT. Run() throws, the try swallows
;    it, and ExitApp() runs anyway -- so the script vanishes with no window,
;    no tray icon, no message and no log line. From the user's side they
;    double-clicked something and nothing happened, twice, and nothing
;    anywhere explains why. That is a support ticket every time, and it is
;    the single most likely first-run experience for anyone cautious about
;    UAC prompts. Elevation is genuinely required here -- the script drives
;    an elevated game's windows and edits firewall rules -- so the answer is
;    not to carry on unelevated. It is to say so, once, in a box that cannot
;    be missed, because there is no tray icon left to put it on.
;
; 2. RUNNING AS A COMPILED .EXE. A_AhkPath points at the AutoHotkey
;    interpreter, which on a machine with no AutoHotkey installed does not
;    exist, and /restart is an interpreter switch. A compiled build has to
;    re-launch ITSELF; A_IsCompiled is the only thing that tells them apart.
if !A_IsAdmin {
    relaunched := false
    try {
        if A_IsCompiled
            Run('*RunAs "' . A_ScriptFullPath . '" /mon:' . ChosenMonPt)
        else
            Run('*RunAs "' . A_AhkPath . '" /restart "' . A_ScriptFullPath
              . '" /mon:' . ChosenMonPt)
        relaunched := true
    } catch as e {
        try _FSLog("STARTUP elevation was refused or failed (" . e.Message
                 . ") -- HSBG cannot run without it and is exiting")
    }
    if !relaunched {
        try MsgBox("HSBG needs to run as administrator, and that request was"
                 . " declined.`n`nIt manages Hearthstone's windows and edits a"
                 . " firewall rule. Windows does not allow either from a"
                 . " normal-privilege program, so there is nothing useful it"
                 . " can do without elevation.`n`nStart HSBG again and choose"
                 . " Yes on the Windows prompt."
                 , "HSBG " . HSBG_BUILD, 0x40010)
    }
    ExitApp()
}

A_IconTip := "Battle Grounds " . HSBG_BUILD . " — running"

; ── Tray menu: reach the settings file without hunting for it ────────────────
; The settings file can end up in one of two folders depending on whether the
; script's own folder turned out to be writable, and a user should never have
; to work out which. These two items remove the question entirely.
;
; There is a second, less obvious reason "Open settings" earns its place: this
; script runs ELEVATED, so an editor launched from here is elevated too. If the
; .ini did land somewhere only an administrator can write, opening it this way
; is the one route that can actually save the file. That is precisely the
; failure this menu exists to answer.
try {
    A_TrayMenu.Insert("1&")                       ; separator above the defaults
    ; ── SEPARATES "THE KEY IS NOT ARRIVING" FROM "THE HANDLER IS BROKEN" ────
    ; Those two produce identical evidence -- nothing happens, nothing is
    ; logged -- and they need completely different fixes. This calls the F5
    ; handler directly, so it exercises everything except the key binding:
    ;
    ;   works from the tray, dead on the keyboard  -> the hotkey is being
    ;       swallowed before HSBG sees it. Something else on the machine owns
    ;       F5 (Overwolf and NVIDIA both bind F-keys by default), or the key
    ;       is not reaching the hook at all.
    ;   dead both ways -> the handler or the speed subsystem is at fault, and
    ;       the log line it writes on entry will say which.
    A_TrayMenu.Insert("1&", "Test speed cycle (next speed now)", (*) => Hotkey_F5())
    A_TrayMenu.Insert("1&", "Copy diagnostics to clipboard", (*) => CopyDiagnostics())
    A_TrayMenu.Insert("1&", "Log Firestone's windows", (*) => LogFirestoneWindows())
    A_TrayMenu.Insert("1&", "Log Firestone's setting keys", (*) => LogFirestoneSettingKeys())
    A_TrayMenu.Insert("1&", "What is under my cursor?", (*) => WhatIsUnderCursor())
    A_TrayMenu.Insert("1&", "Test hotkey sound", (*) => TestHotkeySound())
    A_TrayMenu.Insert("1&", "Check for updates now", (*) => UpdateCheckNow())
    A_TrayMenu.Insert("1&", "Reload settings", (*) => ReloadUserConfig())
    ; The same window the overlay's gear opens. It is reachable from the tray
    ; as well because the overlay only exists while Hearthstone is running,
    ; and the settings are most often changed when it is not.
    A_TrayMenu.Insert("1&", "HSBG settings…", (*) => BgSettings.Open())
    A_TrayMenu.Insert("1&", "Overlay for this session…", (*) => ChangeSessionTracker())
    A_TrayMenu.Insert("1&", "Open settings (HSBG Config.ini)", (*) => OpenConfigFile())
}

; ── "Log Firestone's windows" — the answer to "are my pins safe?" ────────────
;
; THE PROBLEM THIS EXISTS TO SOLVE. This script decides what may be seen from a
; single title: CFG.fsVisibleTitles, whose only member is "Firestone -
; Overlays". Anything else Overwolf puts on screen while the F3 lock is on is
; treated as a desktop surface and concealed. That is the right default -- it is
; what stops stray CEF frames and nag popups appearing -- but it means the
; script's safety for a PINNED overlay panel depends entirely on a fact the
; script cannot discover for itself: whether that panel is part of the
; "Firestone - Overlays" window, or a separate OS window with its own title.
;
; If it is part of the overlay, everything here is safe. If it is a separate
; window, three things can happen to it, and they need different fixes:
;   * it is cloaked at birth and never released (helper-shaped, so the sweep
;     skips it -- and skipping it also skips the release),
;   * it is cloaked and re-cloaked on every sweep (not helper-shaped),
;   * it is CLOSED, if it happens to be titled exactly "Firestone" and measures
;     between 300 and 800 pixels on both sides, because that is the shape test
;     for Firestone's notification popup.
;
; Rather than guess between them and risk breaking the popup suppression, this
; records the evidence. Pin a comp, click this, and the log gets one line per
; Overwolf window with everything needed to tell those cases apart: the title,
; the class, the size, whether it is owned, and the extended styles -- 0x80 is
; WS_EX_TOOLWINDOW (helper-shaped), 0x20 is WS_EX_TRANSPARENT (click-through,
; which exempts it from the popup test), 0x8 is WS_EX_TOPMOST.
;
; Reads only. It cannot move, hide, show or close anything.
LogFirestoneWindows() {
    global State, _fsParked, _fsHiddenByUs
    count := 0
    hsHwnd := 0
    try {
        for h in GetHSRealWindows() {
            hsHwnd := h
            break
        }
    }
    _FSLog("FS-INVENTORY ---- begin (locked=" . (State.fsMainLocked ? 1 : 0)
         . " hsRunning=" . (GetHSPID() ? 1 : 0) . ") ----")
    prev     := A_DetectHiddenWindows
    prevMode := A_TitleMatchMode
    DetectHiddenWindows true
    SetTitleMatchMode(2)
    try {
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe", "OverwolfHelper.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    ttl := "", cls := "", ex := 0, st := 0
                    try ttl := WinGetTitle("ahk_id " . h)
                    try cls := WinGetClass("ahk_id " . h)
                    try ex  := WinGetExStyle("ahk_id " . h)
                    try st  := WinGetStyle("ahk_id " . h)
                    WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . h)
                    owner := DllCall("user32\GetWindow", "Ptr", h, "UInt", 4, "Ptr")   ; GW_OWNER

                    ; Would the popup test close this window right now? This is
                    ; the single most important field: a "1" here on a pinned
                    ; panel is the whole answer.
                    popupShaped := 0
                    try popupShaped := IsFirestoneNotificationPopup(h, ttl) ? 1 : 0

                    count++
                    _FSLog("FS-INVENTORY " . exe . " hwnd=" . h
                         . " title=`"" . ttl . "`""
                         . " class=" . cls
                         . " size=" . ww . "x" . wh . " at " . wx . "," . wy
                         . " visible=" . (DllCall("user32\IsWindowVisible", "Ptr", h) ? 1 : 0)
                         . " cloaked=" . (IsWindowCloakedDWM(h) ? 1 : 0)
                         . " parked=" . (_fsParked.Has(h) ? 1 : 0)
                         . " ourLedger=" . (_fsHiddenByUs.Has(h) ? 1 : 0)
                         . " owned=" . (owner ? 1 : 0)
                         . " ex=0x" . Format("{:X}", ex)
                         . " style=0x" . Format("{:X}", st)
                         . " popupShaped=" . popupShaped
                         . " overHS=" . (hsHwnd ? (_RectsOverlapHwnd(h, hsHwnd) ? 1 : 0) : "?"))
                }
            }
        }
    }
    DetectHiddenWindows prev
    SetTitleMatchMode prevMode
    _FSLog("FS-INVENTORY ---- end, " . count . " window(s) ----")
    BgHUD.Show(count . " Firestone/Overwolf window(s) written to HSBG.log", 4000)
}

; Do two windows' rectangles overlap at all? Read-only helper for the inventory.
_RectsOverlapHwnd(a, b) {
    try {
        WinGetPos(&ax, &ay, &aw, &ah, "ahk_id " . a)
        WinGetPos(&bx, &by, &bw, &bh, "ahk_id " . b)
        if (aw <= 0 || ah <= 0 || bw <= 0 || bh <= 0)
            return false
        return !(ax >= bx + bw || bx >= ax + aw || ay >= by + bh || by >= ay + ah)
    }
    return false
}

OpenConfigFile() {
    path := _ConfigPath()
    try {
        if !FileExist(path)
            _WriteDefaultConfig(path)
        _MakeConfigEditable(path)
        Run('notepad.exe "' . path . '"')       ; explicit: no file association
    } catch {                                   ; needed, and it can always save
        try Run(path)
    }
}

; Re-read HSBG Config.ini and apply what can be applied without a restart.
;
; Honest about its limits: the monitor lock starts and stops cleanly, and the
; hotkey tones only need their files built. Anything else in CFG was consumed
; during start-up and is not revisited, which is why the file itself tells the
; user to restart rather than promising this covers everything.
ReloadUserConfig() {
    global CFG
    LoadUserConfig()
    try {
        if CFG.lockWindowsToChosenMonitor
            StartMonitorLock()
        else
            StopMonitorLock()
    }
    if CFG.hotkeyAudio
        try EnsureHotkeyTones()
    _FSLog("CONFIG reloaded from " . _ConfigPath()
         . " -- MonitorLock=" . (CFG.lockWindowsToChosenMonitor ? 1 : 0)
         . " HotkeyAudio="    . (CFG.hotkeyAudio ? 1 : 0))
    BgHUD.Show("Settings reloaded", 1500)
}

; ── "Copy diagnostics to clipboard" ─────────────────────────────────────────
;
; THE SUPPORT PROBLEM THIS EXISTS TO SOLVE.
;
; Nearly every report this script can generate reduces to one of a dozen
; environment facts: which overlay the session chose, whether the game is
; running, whether Overwolf is installed at all, whether the settings file
; being read is the one the user believes they edited, whether the build
; running is the build they downloaded. Establishing those over a forum
; thread takes a day and several round trips, and the first three answers are
; usually wrong, because the user is describing what they believe rather than
; what is on disk.
;
; This asks the machine instead and puts the answer on the clipboard in a
; form that can be pasted into a message. It is READ-ONLY -- it launches
; nothing, moves nothing, changes no setting -- so it is always safe to offer
; as the first thing to try.
;
; Deliberately manual and never transmitted anywhere: it contains file paths
; and a Windows account name, and where that goes is the user's decision.
CopyDiagnostics() {
    global CFG, State, Launch, HSBG_BUILD

    lines := []
    rule(n) => StrReplace(Format("{:" . n . "}", ""), " ", "-")
    add(k, v) => lines.Push(Format("{:-24}", k) . v)
    ; No single probe may abort the report. Every one of these calls reaches
    ; into another process or the filesystem, and the report is most valuable
    ; on exactly the broken machine where some of them will fail.
    ask(fn) {
        try
            return fn()
        catch as e
            return "<failed: " . e.Message . ">"
    }

    lines.Push("HSBG diagnostics — " . FormatTime(, "yyyy-MM-dd HH:mm:ss"))
    lines.Push(rule(78))

    add("Build",          HSBG_BUILD)
    add("Script",         A_ScriptFullPath)
    add("Host",           A_IsCompiled ? "compiled exe"
                                       : "AutoHotkey " . A_AhkVersion)
    add("Elevated",       A_IsAdmin ? "yes"
                                    : "NO — window control and F1 cannot work")
    add("OS",             A_OSVersion . (A_Is64bitOS ? " x64" : " x86"))
    add("Running for",    Round(A_TickCount / 60000, 1) . " min")
    cfgPath := ask(() => _ConfigPath())
    add("Settings file",  cfgPath . (FileExist(cfgPath) ? "" : "   (MISSING)"))
    add("Log file",       ask(() => _LogPath()))

    lines.Push("")
    lines.Push("-- settings in force " . rule(56))
    add("MonitorLock",    CFG.lockWindowsToChosenMonitor ? "1" : "0")
    add("Tracker (config)", CFG.tracker)
    add("Tracker (session)", State.trackerMode = "" ? "<not resolved yet>"
                                                    : State.trackerMode)
    add("HotkeyAudio",    (CFG.hotkeyAudio ? "1" : "0")
                        . "  vol=" . CFG.hotkeyAudioVolume
                        . "  mode=" . CFG.hotkeyFreqMode)
    add("UpdateCheck",    CFG.updateCheck ? "1" : "0")

    lines.Push("")
    lines.Push("-- overlays " . rule(65))
    ow := ask(() => GetOverwolfPath())
    add("Overwolf",       (ow = "" ? "<not found>" : ow))
    add("Firestone",      ask(() => FirestoneInstalled()) ? "installed"
                                                          : "not installed")
    add("  running",      ask(() => FirestoneAppRunning()) ? "yes" : "no")
    add("HSReplay / HDT", ask(() => HDTInstalled()) ? "installed"
                                                    : "not installed")
    add("  running",      ask(() => GetHDTPID()) ? "yes" : "no")

    lines.Push("")
    lines.Push("-- game " . rule(69))
    hsPid := ask(() => GetHSPID())
    add("Hearthstone",    hsPid ? "running, PID " . hsPid : "not running")
    if hsPid
        add("  path",     ask(() => GetHSPath(hsPid)))
    bn := ask(() => GetBattleNetPath())
    add("Battle.net",     (bn = "" ? "<not found>" : bn))
    add("Launch state",   Launch.state)

    lines.Push("")
    lines.Push("-- animation speed " . rule(58))
    if !CFG.animationSpeedEnabled {
        add("Enabled",    "0  (off — this is the default)")
    } else {
        blocker := ask(() => _HSSpeedBlocker())
        bridge  := ask(() => _HSSpeedBridgePath())
        add("Enabled",    "1")
        add("Status",     blocker = "" ? "working"
                                       : "NOT WORKING — " . blocker)
        add("Bridge file", bridge = "" ? "<unresolved>" : bridge)
        add("Current",    Format("{:.2f}x", State.animationSpeedCurrent))
    }

    lines.Push("")
    lines.Push("-- monitors " . rule(65))
    add("Chosen monitor",  ask(() => ResolveChosenMonitor()))
    try {
        loop MonitorGetCount() {
            MonitorGet(A_Index, &ml, &mt, &mr, &mb)
            add("  monitor " . A_Index
              , (mr - ml) . "x" . (mb - mt) . " at " . ml . "," . mt
              . (A_Index = MonitorGetPrimary() ? "   (primary)" : ""))
        }
    }

    report := ""
    for line in lines
        report .= line . "`r`n"

    ; Written to the log as well. A user who cannot work the clipboard, or
    ; whose clipboard is held by the game, still leaves a copy behind.
    try _FSLog("DIAGNOSTICS requested from the tray:`r`n" . report)

    ok := false
    try {
        A_Clipboard := report
        ok := ClipWait(2)
    }
    try BgHUD.Show(ok ? "Diagnostics copied — paste them into your report"
                      : "Diagnostics written to HSBG.log (clipboard unavailable)"
                 , 3500)
}

; Apply configured script process priority.
if CFG.scriptAboveNormalPriority
    ; High (was AboveNormal): the 1ms burst and the event hook must hold
    ; their cadence through a Battlegrounds MATCH-START load spike -- the
    ; exact moment fresh Firestone windows are born. The script's per-tick
    ; work is microseconds, so this costs the game nothing.
    try ProcessSetPriority("High")

; Defensive startup pass: uncloak any window that may have been left cloaked.
try {
    _startupPrevDHW := A_DetectHiddenWindows
    DetectHiddenWindows true
    for _startupExe in ["Overwolf.exe", "OverwolfBrowser.exe", "OverwolfLauncher.exe", "Hearthstone.exe"] {
        for _startupHwnd in WinGetList("ahk_exe " . _startupExe) {
            try UncloakWindow(_startupHwnd, false, "CopyDiagnostics")
        }
    }
    ; This loop only ever UNCLOAKED. Transparency left behind by a previous run
    ; (the launcher fade, or the alpha shield) was never cleared here -- only
    ; the Battle.net loop below did that -- so an invisible Overwolf window
    ; survived a restart of the script untouched. FSRepairStuckAlpha covers the
    ; whole Overwolf family and skips per-pixel windows.
    try FSRepairStuckAlpha()
    ; Battle.net/Agent repair: uncloak + unfade everything. Force-SHOW only a
    ; window carrying this script's own crash fingerprint — hidden AND still
    ; DWM-cloaked (only a mid-launch crash leaves that combination) — and only
    ; for the Battle.net client itself. A launcher the user closed to the tray
    ; is hidden but NOT cloaked, and Agent's shell window is MEANT to be
    ; invisible; neither is ever popped onto the screen here.
    for _startupExe in ["Battle.net.exe", "Battle.net Launcher.exe", "Battle.net Helper.exe", "Agent.exe"] {
        for _startupHwnd in WinGetList("ahk_exe " . _startupExe) {
            try {
                _startupWasCloaked := IsWindowCloakedDWM(_startupHwnd)
                UncloakWindow(_startupHwnd, false, "CopyDiagnostics")
                try WinSetTransparent("Off", "ahk_id " . _startupHwnd)
                if (_startupExe = "Battle.net.exe" && _startupWasCloaked
                 && !DllCall("user32\IsWindowVisible", "Ptr", _startupHwnd)
                 && WinGetTitle("ahk_id " . _startupHwnd) != "") {
                    WinGetPos(, , &_sw, &_sh, "ahk_id " . _startupHwnd)
                    if (_sw > 200 && _sh > 150)
                        DllCall("ShowWindow", "Ptr", _startupHwnd, "Int", 8)  ; SW_SHOWNA
                }
            }
        }
    }
    DetectHiddenWindows _startupPrevDHW
}

; Recover from previous failed launch state.
try StopFSBurst()

; Repair anything a PREVIOUS instance of this script left transparent. The
; shield keeps WS_EX_LAYERED across unlocks by design, so a reload or restart
; while Firestone is running used to inherit stranded alpha-0 windows that no
; code path would ever restore -- the "F3 unlocks them and they are invisible"
; failure. Must run before the lock arms.
try FSRepairStuckAlpha()

; Same, for the cold-window park: bring back anything a previous instance left
; sitting outside the virtual desktop. Must also run before the lock arms.
try FSRepairStrandedWindows()


; Start Firestone‑Main monitor in locked mode.
;
; GATED ON THERE BEING A FIRESTONE. This call arms FSMainMonitor at 50 ms,
; and it ran unconditionally -- so on a machine with no Overwolf install the
; sweep was already running by the time the check further down logged
; "Firestone subsystems stay dormant" and declined to start it. Dormant has
; to mean not running.
; ── GATED ON THIS SESSION'S OVERLAY, THOUGH NOT YET DECIDED HERE ────────────
; NOTE ON ORDERING, because it is not what it looks like: ResolveTrackerMode
; runs LATER in start-up than this line, so State.trackerMode is always "" at
; this point and this gate always passes when Firestone is installed. The gate
; that does the real work is the matching one further down, after the resolve.
; This one is kept deliberately -- it costs nothing, it is correct if the mode
; is ever latched earlier, and having the two read identically is what stops a
; future edit fixing one and missing the other.
;
; The problem both are for: a user with Tracker=hsreplay pinned, and Firestone
; also installed, had the entire Firestone stack armed anyway. The resolve
; picks hsreplay and _TrackerStandDownFirestone clears fsMainLocked -- and the
; later unconditional lock then set it straight back to true. F2 could not undo
; it either, because ResolveTrackerMode short-circuits once the mode is
; latched. So for the whole session the script cloaked and parked
; Firestone's windows and closed its popups, in a session whose stated promise
; is that the overlay you did not choose is "not launched, not suppressed, not
; closed, not moved".
;
; "" means undecided, which is the normal case -- both overlays installed and
; the question deferred to F2 -- and that must still arm, because Firestone
; windows have to be concealed from start-up if that is where the session ends
; up. Only an explicit hsreplay/none pin skips it.
if (FirestoneInstalled()
 && (State.trackerMode = "" || State.trackerMode = "firestone"))
    LockFirestoneMain()

; Ledger pruning, on a schedule that does not depend on the monitor lock.
; Ten seconds is far more often than handle reuse can matter and the pass is
; a handful of IsWindow calls over maps that are normally near-empty.
SetTimer(_PruneLedgersTick, 10000)

; Register deterministic cleanup for all exit paths.
OnExit(ExitCleanup)
ExitCleanup(*) {
    ; _fsAlphaApplied, _fsHiddenByUs and _bnetHiddenByUs must be declared global
    ; here. In AutoHotkey v2 an undeclared name inside a function is a LOCAL, and
    ; reading an unset local throws -- inside the try that wraps the restore
    ; block, which would swallow it and abandon the entire cleanup.
    global _fsAlphaApplied, _fsHiddenByUs, _bnetHiddenByUs, _f4Shutdown
    global _fsPinnedByUs, _hdtPinnedByUs
    global _fsShielded
    ; State is only READ here (the writes below are to its properties, not to
    ; the name itself), so this line is not strictly required. It is here
    ; because the release of the Power.log handle sits inside a try, and a
    ; scoping mistake there would be swallowed exactly as the note above
    ; describes -- leaving the game unable to roll its log over, with nothing
    ; logged to say why.
    global State
    ; Listed for the reader alongside the other ledgers this unwinds; the read
    ; below resolved to the global with or without this line.
    global _hdtAlphaConcealed
    try ResumeWSearch()
    try UnmuteHearthstone()

    ; FIRST, BEFORE ANYTHING ELSE HERE CAN THROW.
    ;
    ; A DWM cloak lives in the window manager, not in this process, so it
    ; outlives the script that applied it. Exiting with the tracker hidden by F3
    ; leaves a running tracker that is invisible on every monitor, has no
    ; taskbar route back, and gives its user no reason to connect any of it to a
    ; script they just closed. This is the only line that prevents that, and it
    ; runs on every exit path -- F4, tray exit, reload, a crash on the way out.
    try HDTReleaseAll()

    ; The overlay is one of ours and it is always-on-top: leaving it on screen
    ; after the script exits would strand a strip the user cannot close and
    ; cannot trace back to anything. The phase tail holds an open handle on
    ; Power.log, which must be released or the game cannot roll its log over.
    try SetTimer(BgOverlayTick, 0)
    try SetTimer(_BGPhaseTick, 0)
    try BgOverlay.Destroy()
    try BgSettings._Close()
    try {
        if State.bgLogFile {
            State.bgLogFile.Close()
            State.bgLogFile := 0
        }
    }

    try StopOWCreateHook()
    try StopEarlyOverwolfCloak()
    try SetTimer(LateHSWatch, 0)
    try {
        prevT := A_DetectHiddenWindows
        DetectHiddenWindows true
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe"] {
            for hwnd in WinGetList("ahk_exe " . exe)
                try _EnableDWMTransitions(hwnd)
        }
        DetectHiddenWindows prevT
    }

    try {
        prev     := A_DetectHiddenWindows
        prevMode := A_TitleMatchMode
        DetectHiddenWindows true
        SetTitleMatchMode(2)
        for exe in ["Overwolf.exe", "OverwolfBrowser.exe", "Battle.net.exe", "Agent.exe", "Battle.net Helper.exe"] {
            for h in WinGetList("ahk_exe " . exe) {
                try {
                    if (_fsAlphaApplied.Has(h)
                     && IsFirestoneSuppressionTitle(WinGetTitle("ahk_id " . h)))
                        _RemoveFSAlphaShield(h)
                }
                try UncloakWindow(h, false, "ExitCleanup")
            }
        }
        ; ── Selective restore ───────────────────────────────────────────────
        ; The purpose of an exit janitor is to leave nothing UNREACHABLE. It is not to
        ; put transient surfaces back on screen.
        ;
        ; A boot splash, a loading popup or a notification left hidden is not
        ; unreachable: the owning application knows about it and will show it again
        ; whenever it likes. A window this script PARKED outside the virtual desktop
        ; with its taskbar button removed IS unreachable, and so is one left cloaked.
        ;
        ; So: always undo what was done to a window's reachability; only ever show a
        ; window the user actually needs.
        ;
        ; Battle.net: the real client only. Service surfaces stay concealed.
        for h in _bnetHiddenByUs.Clone() {
            try {
                if !DllCall("user32\IsWindow", "Ptr", h)
                    continue
                if DllCall("user32\IsWindowVisible", "Ptr", h)
                    continue
                if _IsProtectedBNetMain(h)
                    WinShow("ahk_id " . h)
            }
        }
        ; Firestone: the same rule. Show back the windows the user reaches with F3 and
        ; the overlay that must render -- Main, Battlegrounds, Overlays. The Loading
        ; splash and the bare-"Firestone" notification are not restored: they are
        ; transient surfaces Overwolf owns and re-creates at will.
        ;
        ; The unpark and the taskbar-button restore below are NOT conditional. They run
        ; for every window this script touched, because those are the two things that
        ; would genuinely leave a window unreachable.
        if !_f4Shutdown {
            ; ── THE HELD BIRTH HIDES COME BACK FIRST, BY LEDGER NOT BY NAME ─
            ; _fsShielded means "this script cleared WS_VISIBLE on this window
            ; and is still holding it" (CFG.fsBgHardHideHold), and that is a
            ; debt regardless of what the window ended up being called. The
            ; title-filtered pass below deliberately restores only the three
            ; surfaces the user reaches with F3 -- correct for its own purpose,
            ; and not a release mechanism: a shielded window with any other
            ; title would fall straight through it and be left hidden with
            ; this script gone. Ledger first, names second.
            for h in _fsShielded.Clone() {
                try {
                    if !DllCall("user32\IsWindow", "Ptr", h)
                        continue
                    UncloakWindow(h, true, "ExitCleanup")
                    if !DllCall("user32\IsWindowVisible", "Ptr", h)
                        DllCall("ShowWindow", "Ptr", h, "Int", 8)  ; SW_SHOWNA
                }
            }
            for h in _fsHiddenByUs.Clone() {
                try {
                    if !DllCall("user32\IsWindow", "Ptr", h)
                        continue
                    if DllCall("user32\IsWindowVisible", "Ptr", h)
                        continue
                    ht := ""
                    try ht := WinGetTitle("ahk_id " . h)
                    if (ht = "Firestone - Main" || ht = "Firestone - Battlegrounds"
                     || ht = "Firestone - Overlays")
                        WinShow("ahk_id " . h)
                }
            }
        }
        DetectHiddenWindows prev
        SetTitleMatchMode prevMode
    }

    try ForceEnableHSWindow()
    try StopHSInputShield()
    try StopLauncherHide()
    try StopHSHiddenLaunchWatch()
    try StopHSCloaker()
    try StopHSPlacementGuard()
    try StopOverlayTopmostEnforcer()
    try StopMonitorLock()

    ; ── GIVE BACK EVERY TOPMOST BIT THIS SCRIPT ADDED ───────────────────────
    ; The front keeper only ever pins windows it recorded, and this is the
    ; janitor that contract requires. A Firestone or tracker window left
    ; WS_EX_TOPMOST by an exited HSBG floats over everything the user does
    ; afterwards, with nothing running that could explain it or take it off --
    ; the same class of stranded state as a parked window, and just as
    ; baffling to the person holding it.
    try {
        for h in _fsPinnedByUs.Clone()
            _FSDropOurPin(h)
    }
    try {
        for h in _hdtPinnedByUs.Clone()
            _HDTDropOurPin(h)
    }
    try StopFSReveal()
    ; LEAVE NO TRACE, park edition. A window left parked outside the virtual
    ; desktop by an exiting instance has no taskbar button and no Alt-Tab
    ; entry, so nothing could ever bring it back. Unpark our ledger, then
    ; sweep for anything stranded that is not in it.
    if !_f4Shutdown {
        try _FSRevealAllAlpha()   ; nothing may be left transparent (SECTION note)
        try _FSHoldReleaseAll()       ; nor hidden by a hold that outlived us
        try _FSUnparkAll()
        try {
            for h in _hdtAlphaConcealed.Clone()
                _AlphaReveal(h, _hdtAlphaConcealed)
        }
        try _HDTUnparkAll()      ; the tracker's half of the same rule (SECTION 7C)
        try _HDTShieldRestoreAll()   ; and nothing may be left with an empty region
        try FSRepairStrandedWindows()
    }
    try _ForceReleaseHighResTimer()
    try SetTimer(FSMainMonitor,               0)
    try SetTimer(SuppressFirestoneLoadingTick, 0)
    try SetTimer(KillFirestoneLoading,        0)
    try SetTimer(StopKillFirestoneLoading,    0)
    try SetTimer(HSHiddenLaunchWatch,         0)
    try SetTimer(RevealHSAfterLaunch,         0)
    try SetTimer(BNetStallWatchTick,          0)
    try SetTimer(F1BNetGuardTick,             0)
    try SetTimer(BNetMinimizeSequenceTick,    0)
    try SetTimer(HK_ReachabilityWatchdog,     0)
    try SetTimer(_UpdPollTick,                0)

    try {
        prev := A_DetectHiddenWindows
        DetectHiddenWindows true
        for hwnd in WinGetList("ahk_exe Hearthstone.exe") {
            if IsIMEWindow(hwnd)
                continue
            if IsHelperWindow(hwnd)
                continue
            try UncloakWindow(hwnd, false, "ExitCleanup")
            WinShow("ahk_id " . hwnd)
            WinSetTransparent("Off", "ahk_id " . hwnd)
        }
        DetectHiddenWindows prev
    }

    try DeleteRules()
    try DeleteGameRule()

    ; ── HAND THE GAME CLOCK BACK ────────────────────────────────────────────
    ; THE SAME RULE AS EVERY OTHER JANITOR HERE, APPLIED TO THE ONE PIECE OF
    ; STATE THAT OUTLIVES THE PROCESS MOST DURABLY.
    ;
    ; The speed bridge is a FILE, and nothing about it is undone by this
    ; script exiting: the plugin re-reads it on the game's next Awake, so a
    ; session that ended at 8x hands the next one 8x -- with HSBG closed, no
    ; HUD to say so and no F5 running to change it back. The user is left with
    ; a permanently fast Hearthstone and nothing on screen connecting it to a
    ; script they shut down yesterday. That is exactly the stranded state
    ; _FSUnparkAll and DeleteRules exist to prevent, and the bridge was the
    ; one instance of it with no janitor at all.
    ;
    ; Unconditional, and it deliberately does not consult
    ; CFG.animationSpeedEnabled: the file may have been written by an earlier
    ; run under a since-changed setting, and 1.0 is the correct value in every
    ; case. It writes nothing if no bridge file exists.
    try _ResetHSSpeedBridge()
}

; One‑shot startup cleanup: run synchronously so first F2 cannot race it.
StartupCleanup() {
    global State, CFG, HSBG_BUILD
    try DeleteRules()
    try DeleteGameRule()
    State.startupDone := true

    ; ── PHASE AWARENESS AND THE OVERLAY COME UP HERE ────────────────────────
    ; Both are started after the rule cleanup above, and neither can block it:
    ; the log.config write is a small local file edit, and the two timers do
    ; nothing at all until Hearthstone is running. If the write fails, phase
    ; detection stays off and everything else in the script is unaffected --
    ; which is the whole reason it is safe to do this unconditionally.
    ; The log.config edit is the only part gated on the setting, because it is
    ; the only part that writes to disk. The TIMER is started unconditionally
    ; and _BGPhaseTick returns immediately while CFG.phaseDetect is false.
    ;
    ; Gating the timer here instead was a bug: switching phase detection on in
    ; the settings window sets CFG.phaseDetect, but nothing would have started
    ; the timer, so the setting appeared to do nothing until the script was
    ; restarted -- and there would have been no error to explain it. The
    ; overlay directly below already had this right; this now matches it.
    ; Turning it on later also runs the log.config edit, from _Save.
    if CFG.phaseDetect
        try _HSEnsurePowerLogging()
    try SetTimer(_BGPhaseTick, 250)

    ; The overlay's own timer decides whether the strip should exist, so it
    ; runs even when the overlay is switched off -- that is how enabling it in
    ; the settings window takes effect without a restart.
    try SetTimer(BgOverlayTick, 500)

    ; The settings actually in force go to the LOG ONLY.
    ;
    ; This briefly showed them on the HUD at every launch as well. That was
    ; added to make a config problem diagnosable at a glance, and it did -- but
    ; nobody asked for a start-up banner, and a message that appears every
    ; single launch to tell you nothing has gone wrong is noise. The
    ; information is still recorded, and the tray menu can report it on demand;
    ; it just no longer interrupts a launch that is working.
    try {
        _FSLog("STARTUP " . HSBG_BUILD . " settings in force: MonitorLock="
             . (CFG.lockWindowsToChosenMonitor ? 1 : 0) . " HotkeyAudio="
             . (CFG.hotkeyAudio ? 1 : 0) . " vol=" . CFG.hotkeyAudioVolume
             . " freqMode=" . CFG.hotkeyFreqMode . " Tracker=" . CFG.tracker
             . " from " . _ConfigPath())
    }

    ; ── WHAT IS INSTALLED, AND WHAT THIS SCRIPT WILL TOUCH ──────────────────
    ; Recorded at start-up so that the first question anyone asks about an
    ; overlay -- "did HSBG find it?", "is HSBG the thing interfering with it?"
    ; -- is already answered in the log before it is asked.
    try {
        _FSLog("STARTUP overlays detected: Firestone="
             . (FirestoneInstalled() ? "yes" : "no")
             . " HSReplay=" . (HDTInstalled() ? "yes" : "no")
             . " -- Tracker=" . CFG.tracker)
        ; ── SAY WHETHER WE ARE ELEVATED. THIS DECIDES WHETHER HOTKEYS WORK. ─
        ; Windows will not deliver a keystroke to a lower-integrity process
        ; while a higher-integrity window has focus. If this script is NOT
        ; elevated and Hearthstone is -- which it will be, because Battle.net
        ; launches it and Battle.net runs elevated -- then every F-key works on
        ; the desktop and silently does nothing once the game has focus.
        ;
        ; That is exactly the reported symptom, and the HK-FIRED lines matched
        ; it on 2026-09-06: F2 and F4 fired with explorer, claude and a driver
        ; in front, and NEVER ONCE with Hearthstone or Overwolf in front. The
        ; script was not broken and no hotkey was stolen; the keystrokes never
        ; arrived. Nothing inside this file can fix that -- only running it
        ; elevated can -- so it has to be visible in the log rather than
        ; guessed at, which is what cost an evening.
        ; Enforce Firestone's settings BEFORE anything can be launched.
        ; Overwolf reads the manifest when it loads the app, so this is
        ; the only point at which a write still affects how it starts.
        try _FSEnforceFirestoneSettings()
        _FSLog("STARTUP elevated=" . (A_IsAdmin ? "YES" : "NO")
             . " -- if this says NO, the F-keys will work on the desktop and do"
             . " NOTHING while Hearthstone or Overwolf has focus, because"
             . " Windows does not deliver input across an integrity boundary."
             . " Every other symptom of that looks like a dead script.")
        _FSLog("STARTUP this script only ever moves, hides, cloaks or closes"
             . " windows belonging to: Hearthstone, Battle.net, the Blizzard"
             . " Agent and Overwolf. Every other process on this machine is"
             . " ignored by the window hook. The HSReplay tracker is touched"
             . " only by F3, and only to cloak and un-cloak.")
    }
}

; One‑shot startup warmup: resolve and cache Overwolf/Firestone paths.
PreCachePaths() {
    global CFG, State
    GetOverwolfPath()
    GetFirestoneCmd()

    ; The tracker lookup goes here for the same reason the Firestone one does:
    ; it walks the disk and the registry, and the place for that is a warmup,
    ; not the middle of an F2 press. Cached after this whether it found
    ; anything or not.
    ;
    ; It also has to happen BEFORE the first ResolveTrackerMode, because
    ; "is the tracker installed?" is half of the question that decides whether
    ; the picker appears at all.
    try GetHDTCmd()

    ; Give back any tracker window a previous run was killed before releasing.
    ; See HDTRepairOrphans -- a cloaked, hidden window outlives the process that
    ; concealed it and there is no other way to reach it.
    try HDTRepairOrphans()

}

; Run the first‑use‑sensitive startup work immediately.
StartupCleanup()
PreCachePaths()

; ── Initialize animation speed control ──────────────────────────────────────
;
; AND SAY, ON SCREEN, WHETHER IT CAN POSSIBLY WORK.
;
; "I am still not sure the animation speed control is working" is a fair
; complaint about a feature whose only evidence of failure was one line in a
; log file. There is nothing subtle to diagnose here: the plugin cannot load
; unless BepInEx is installed, HSBG does not install it, and on this machine
; it has never been present -- BepInEx\core\BepInEx.dll does not exist, so
; every F5 press has been writing a number into a file that nothing reads.
;
; A HUD line at start-up turns that from a silent no-op into a statement.
; Shown only when the feature is switched ON and cannot work, which is exactly
; the case where the user is entitled to wonder.
_InitHSSpeedControl()
if CFG.animationSpeedEnabled {
    EnsureHSSpeedPlugin()
    ; ── START AT THE IDLE SPEED, NOT AT AnimationSpeedDefault ───────────────
    ; With the two-speed system on, the speed in force outside a combat IS the
    ; idle speed -- so starting at AnimationSpeedDefault (1.0, the game's own)
    ; meant the game opened at normal speed and only reached the configured 3x
    ; after the first combat had come and gone. Measured: "SPEED selected
    ; 1.000x" at start-up with IdleSpeed=3.0 sitting in the config.
    ;
    ; AnimationSpeedDefault still applies when phase-following is off, because
    ; then there is no idle speed to mean anything.
    SetHSSpeed(CFG.phaseSpeedEnabled ? CFG.idleSpeed : CFG.animationSpeedDefault
             , false)
    speedBlocker := ""
    try speedBlocker := _HSSpeedBlocker()
    if (speedBlocker != "" && !InStr(speedBlocker, "not running")) {
        _FSLog("SPEED NOT WORKING: " . speedBlocker
             . " -- the speed keys will change nothing until this is resolved")
        ; A dialog rather than a toast: this needs an action, not a glance.
        ; Deferred so it cannot sit in front of the launch it would interrupt.
        SetTimer((*) => _ShowSpeedBlockedDialog(speedBlocker), -2500)
    }
}

; Free Firestone's windows before anything else touches Firestone.
;
; HERE, at start-up, because this rewrites a file Overwolf reads ONCE as the
; extension loads. Applied later, the change would only take effect on the run
; after the one that made it. The script is already elevated by this point --
; elevation is settled far above -- so the write cannot fail for permissions.
;
; If it has not run by the time F2 is pressed, _FSStartFirestone runs it before
; launching, so the launch never races the patch.
try _FSUnlockFirestoneWindows()

; Work out where Hearthstone is installed, now, before the first F2.
;
; RESOLVED AT START-UP SO THE FIRST PRESS ALREADY HAS IT. The menu watch reads
; the game's own log folder to know when it has finished loading, and it is
; armed at the F2 press -- before the game exists. If the install path were
; worked out then, the first press of the session would be the one press that
; had to discover it.
;
; It is also written back to HearthstonePath in the settings file the first
; time it is found, so this is a one-off for the life of the install rather
; than something every run repeats. A machine with the game somewhere unusual
; and no configured path still gets one search, once, and never again.
_bootHSRoot := ""
try _bootHSRoot := _FindHearthstoneInstallRoot()
if (_bootHSRoot != "")
    _FSLog("HS-PATH Hearthstone is at " . _bootHSRoot . " -- remembered in the settings file, so no later run has to go looking for it.")
else
    _FSLog("HS-PATH could not work out where Hearthstone is installed. The launch still works; what is lost is the menu signal, so Firestone will start immediately on F2 instead of waiting for the game to finish loading. Setting HearthstonePath in the settings file fixes it.")

; Create the ITaskbarList object ONCE, here, before anything can reach it from
; a window-event callback. See _FSTaskbarInit.
try _FSTaskbarInit()

; Arm the window event hook at startup.
StartOWCreateHook()

; Background loading-popup guard: a low-rate (100ms) always-on instance of the
; Firestone loading suppression, so a loading window appearing BEFORE the first
; F2 (or right after a too-quick F2) is caught instead of flashing on primary.
; No-op when no loading popup exists. F2 still arms the fast 10ms instance.
;
; FIRESTONE IS OPTIONAL. Nothing below is armed on a machine with no Overwolf
; and no Firestone install: these timers exist solely to manage Firestone's
; windows, and on such a machine they would poll an empty window list forever.
; The check is a cached path lookup, so it costs one filesystem probe.
;
; It is also not armed when this session has already settled on something other
; than Firestone. An installed-but-unchosen Firestone is somebody else's
; program: if the user has Overwolf open for a different game entirely, a guard
; that closes Firestone loading popups has no business running.
if (FirestoneInstalled() && State.trackerMode != "hsreplay" && State.trackerMode != "none")
    SetTimer(SuppressFirestoneLoadingTick, CFG.fsLoadingIdleMs)

; Deferred 3s: warm PowerShell once after startup settles.
SetTimer(PrewarmRules, -3000)
PrewarmRules() {
    global State
    if !State.startupDone {
        SetTimer(PrewarmRules, -500)
        return
    }
    try Run(A_ComSpec . ' /c powershell -NoProfile -Command exit', , "Hide")
}

; Shutdown watchdog: polls physical F4 key state every 500ms so shutdown still
; fires even when DirectInput/fullscreen mode swallows the window message.
SetTimer(F4Watchdog, 500)

; Build the hotkey notes if HSBG Config.ini turned them on. Deferred off the start-up
; path: generating four waveforms takes about a second, and a hotkey pressed in
; that second must not wait for it -- a press before they exist builds them on
; the spot and falls back to a plain beep, so it is never silent.
;
; Logged either way. If the sound was switched on and nothing was heard, this
; line is the first thing to check: it says whether the script saw the setting
; at all, which separates "the audio failed" from "the file you edited is not
; the file the script read".
if CFG.hotkeyAudio {
    _FSLog("AUDIO enabled in config -- building notes shortly")
    SetTimer(EnsureHotkeyTones, -1200)
} else {
    _FSLog("AUDIO disabled (HotkeyAudio=0 in " . _ConfigPath() . ")")
}

; Update check: deferred, once, and non-blocking. Ten seconds puts it clear of
; an F2 pressed the instant the tray icon appears, and SECTION 13 polls the
; request from a timer so a dead network cannot stall a single hotkey.
if CFG.updateCheck
    SetTimer(UpdateCheckStart, -10000)
else
    _FSLog("UPDATE disabled (UpdateCheck=0 in " . _ConfigPath() . ")")

; Hotkey watchdog: releases a system modifier the OS is reporting as held while
; nothing is being typed. That state makes all four F-keys inert with no
; visible symptom, so this is the one timer whose job is to keep the script
; reachable at all. See HK_NoSysMods.
SetTimer(HK_ReachabilityWatchdog, CFG.hkWatchdogPollMs)

; Qt‑helper janitor: keeps Battle.net's hidden helper windows hidden.
SetTimer(QtHelperJanitor, 2000)

; Birth-cloak reaper: releases the cloak on any newborn Overwolf window that
; never turned out to be Firestone's. A cloaked window is invisible but still
; hit-tested, so one left over the game silently eats clicks -- see
; FSBirthCloakReaper. Permanent, cheap (it returns immediately with an empty
; ledger) and deliberately not tied to a launch: birth cloaks are applied
; whenever Overwolf creates a window, which is not only during F2.
SetTimer(FSBirthCloakReaper, CFG.fsBirthCloakReapMs)

; Flicker shield release. Deliberately faster than the reaper: this one is
; holding a window HIDDEN, and the sooner that comes off the shorter the
; window in which a cold CEF surface is being denied a compositor. See
; FSFlickerShieldTick.
SetTimer(FSFlickerShieldTick, CFG.fsShieldTickMs)

; Point Hearthstone's own display preference at the chosen monitor.
SetHSMonitorPref()

; Monitor lock: keep the HUD / Battle.net / Agent / Hearthstone on the launch monitor.
StartMonitorLock()



; F3 STARTS IN THE LOCKED STATE. State.fsMainLocked already defaults to true,
; but nothing ever ARMED it at startup: LockFirestoneMain() is what starts the
; 1ms suppression burst and runs the first sweep. Without this call a Firestone
; that was already running when the script started stayed visible until the
; first F2/F3. Now FS-Main and FS-Battlegrounds are hidden from startup.
;
; Skipped entirely when Firestone is not installed -- LockFirestoneMain arms
; the 50ms coast sweep, and there is nothing for it to sweep.
; Also skipped when this session has already been pinned to the OTHER overlay:
; suppressing Firestone's windows and closing its popups in an HSReplay session
; is exactly what "the overlay that was not chosen is left completely alone"
; forbids. See the matching gate above.
if (FirestoneInstalled()
 && (State.trackerMode = "" || State.trackerMode = "firestone")) {
    LockFirestoneMain()
    StartFSNotifSweeper()   ; starts the popup closer immediately
} else if !FirestoneInstalled() {
    _FSLog("STARTUP no Overwolf/Firestone install detected -- Firestone"
         . " subsystems stay dormant. F1, F2 and F4 work normally; F3 has"
         . " nothing to toggle")
} else {
    _FSLog("STARTUP Firestone is installed but this session is pinned to "
         . State.trackerMode . " -- its windows are left completely alone:"
         . " not suppressed, not moved, not closed")
}

; ── LOAD STAMP ────────────────────────────────────────────────────────────────
; A distinct rising 3-note chord the instant THIS build finishes loading.
; Purpose: AutoHotkey does NOT hot-reload an edited script -- the previously
; launched instance keeps running until it is exited and relaunched. If you
; save a new build but do not relaunch (or a stale second instance is live),
; you are testing OLD code, which presents exactly as "fixes didn't take" and
; can eat hotkey beeps. Hear this chord = the new build is the running one.
; Ctrl+Alt+R force-reloads from disk at any time (see below).

; Reload from the tray icon if a build needs to be re-read from disk. A global
; Ctrl+Alt+R chord is deliberately not registered: other applications want it.

F4Watchdog() {
    if !GetHSPID()
        return
    ; Same modifier rule as the hotkeys themselves. Without it this poll was a
    ; back door around the passthrough above: Alt+F4 in any application left F4
    ; physically down, the poll saw it 500 ms later and ran the full shutdown
    ; anyway. Only a BARE F4 hold is a shutdown request.
    if !HK_NoSysMods()
        return
    if GetKeyState("F4", "P")
        Hotkey_F4()
}

; ════════════════════════════════════════════════════════════════════════════
;  BATTLEGROUNDS PHASE AWARENESS · PHASE-DRIVEN SPEED · THE HSBG OVERLAY
; ════════════════════════════════════════════════════════════════════════════
;
; WHAT THIS ADDS, AND WHY IT IS SHAPED THIS WAY
;
; Until this block existed, every action in this script was driven by a
; keypress and nothing else. The script had no idea what the game was doing --
; no notion of a shop, a combat, or even whether the game in progress was
; Battlegrounds at all. That one gap is the reason animation speed had to be a
; single global number, and the reason a combat skip had to be aimed by hand.
;
; Hearthstone states the board phase outright in Power.log, so the phase here
; is READ, never inferred from timing or from pixels:
;
;     tag=BOARD_VISUAL_STATE value=2     combat has begun
;     tag=BOARD_VISUAL_STATE value=1     back in the shop
;     GameType=GT_BATTLEGROUNDS          this game is Battlegrounds
;     CREATE_GAME / STATE value=COMPLETE a game began / a game ended
;
; Reading beats every alternative available to us: no polling of game memory,
; no screen scraping, nothing that breaks on a balance patch. The log format
; has outlived years of patches, which is why this is the stable route and the
; in-process plugin -- which could report the phase with lower latency -- is
; not used for it.
;
; ── THE TWO FAULTS THIS DELIBERATELY DOES NOT REPRODUCE ─────────────────────
;
; 1. AUTO-SKIP THAT STRANDS YOU. A skip works by cutting the game's connection
;    for a moment. Fire that on a fixed timer, every combat, and eventually the
;    client fails to re-establish: the player is dropped, cannot rejoin, and
;    loses a game they were winning. That is not a rare edge case -- it is the
;    predictable end state of blocking on a stopwatch and hoping.
;
;    F1 here does not hold for a fixed duration. It watches the actual socket
;    and releases when the connection is confirmed back, with a floor, a
;    confirmation streak, a ceiling, and a stand-down when the connection table
;    cannot be read at all (the safety rails documented above _NormIP).
;    Auto-skip below therefore does not implement skipping. It presses F1, so
;    every one of those rails applies to an automatic press exactly as it
;    applies to a manual one, and there is no second, weaker skip anywhere in
;    this script to drift out of step with the first.
;
;    It is still OFF by default. A safer automatic skip is still automatic.
;
; 2. SKIPPING OUTSIDE BATTLEGROUNDS. A phase marker looks identical in every
;    game mode. Acting on one without first confirming GT_BATTLEGROUNDS means
;    cutting the connection during a ranked constructed game. Every automatic
;    action below is gated on State.bgInBG, which only GT_BATTLEGROUNDS sets,
;    and which both CREATE_GAME and game-over clear.

; ── WHERE HEARTHSTONE KEEPS ITS LOGGING SWITCHES ────────────────────────────
_HSLogConfigPath() {
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return ""
    return lad . "\Blizzard\Hearthstone\log.config"
}

; ── TURN POWER LOGGING ON, WITHOUT DISTURBING ANYTHING ELSE ─────────────────
;
; Power.log is not written unless log.config asks for it. A machine with a
; tracker installed already has the section, because every tracker writes it;
; a machine without one does not, and on that machine phase detection would
; silently do nothing, forever, with no visible reason. So we write it
; ourselves -- the same thing we already do to Firestone's and Overwolf's
; settings at start-up.
;
; THE CARE THIS TAKES, AND WHY. Other applications own the other sections of
; this file. Rewriting it wholesale -- the obvious implementation -- would
; delete [Net], [Decks], [Arena] and the rest, and the first symptom would be
; somebody's tracker quietly losing features with no visible cause and no
; reason at all to suspect us. So this is a surgical edit: it walks the file,
; changes at most the two keys inside [Power] that have to be true, appends the
; section only when it is genuinely absent, and preserves every other byte
; where it stands -- comments, ordering and unknown keys included. When nothing
; needs changing it writes nothing at all.
_HSEnsurePowerLogging() {
    path := _HSLogConfigPath()
    if (path = "")
        return false

    txt     := ""
    existed := FileExist(path) ? true : false
    if existed {
        try {
            txt := FileRead(path, "UTF-8")
        } catch {
            _FSLog("PHASE log.config could not be read: " . path
                 . " -- phase detection stays off")
            return false
        }
    }

    out      := []
    inPower  := false
    sawPower := false
    setLevel := false
    setPrint := false
    changed  := false

    for cfgLine in StrSplit(txt, "`n", "`r") {
        t := Trim(cfgLine)
        if (SubStr(t, 1, 1) = "[") {
            ; A section header ends the previous section. If we were inside
            ; [Power] and it lacked a key we require, it has to be added HERE,
            ; before the next header, or the key would land in the wrong
            ; section and do nothing.
            if inPower {
                if !setLevel {
                    out.Push("LogLevel=1")
                    changed := true
                }
                if !setPrint {
                    out.Push("FilePrinting=true")
                    changed := true
                }
            }
            inPower := (StrLower(t) = "[power]")
            if inPower
                sawPower := true
            out.Push(cfgLine)
            continue
        }
        if (inPower && RegExMatch(t, "i)^LogLevel\s*=")) {
            setLevel := true
            if (t != "LogLevel=1") {
                out.Push("LogLevel=1")
                changed := true
                continue
            }
        } else if (inPower && RegExMatch(t, "i)^FilePrinting\s*=")) {
            setPrint := true
            if !RegExMatch(t, "i)^FilePrinting\s*=\s*true\s*$") {
                out.Push("FilePrinting=true")
                changed := true
                continue
            }
        }
        out.Push(cfgLine)
    }

    ; The file ended while still inside [Power].
    if inPower {
        if !setLevel {
            out.Push("LogLevel=1")
            changed := true
        }
        if !setPrint {
            out.Push("FilePrinting=true")
            changed := true
        }
    }

    if !sawPower {
        if (out.Length && Trim(out[out.Length]) != "")
            out.Push("")
        out.Push("[Power]")
        out.Push("LogLevel=1")
        out.Push("FilePrinting=true")
        out.Push("ConsolePrinting=false")
        out.Push("ScreenPrinting=false")
        changed := true
    }

    if !changed {
        _FSLog("PHASE log.config already enables Power logging -- not touched")
        return true
    }

    ; One backup, once, keyed on the backup's ABSENCE: this must never
    ; overwrite the user's own original with our already-edited copy on a
    ; later run.
    bak := path . ".hsbg-original"
    if (existed && !FileExist(bak))
        try FileCopy(path, bak, false)

    body := ""
    for i, cfgLine in out
        body .= cfgLine . "`r`n"
    tmp := path . ".hsbg-tmp"
    try {
        try FileDelete(tmp)
        SplitPath(path, , &dir)
        if (dir != "" && !DirExist(dir))
            DirCreate(dir)
        FileAppend(body, tmp, "UTF-8-RAW")
        FileMove(tmp, path, true)
        _FSLog("PHASE log.config: Power logging enabled by HSBG ("
             . (sawPower ? "section repaired" : "section added") . ") at " . path
             . (existed ? " -- original kept as " . bak : " (file created)"))
        return true
    } catch as e {
        try FileDelete(tmp)
        _FSLog("PHASE log.config could not be written (" . e.Message . ") at "
             . path . " -- phase detection stays off")
        return false
    }
}

; ── FIND THE LOG THIS RUN OF HEARTHSTONE IS WRITING ─────────────────────────
;
; Every launch creates Logs\Hearthstone_<timestamp>\. The folder name sorts
; chronologically as plain text, which is why a string comparison finds the
; newest one correctly and no date parsing is needed here.
_BGNewestPowerLog() {
    root := ""
    try root := _FindHearthstoneInstallRoot()
    if (root = "" || !DirExist(root))
        return ""
    logsDir := root . "\Logs"
    if !DirExist(logsDir)
        return ""
    newest := ""
    try {
        Loop Files logsDir . "\Hearthstone_*", "D" {
            if (StrCompare(A_LoopFileName, newest) > 0)
                newest := A_LoopFileName
        }
    }
    cand := (newest != "") ? logsDir . "\" . newest . "\Power.log"
                           : logsDir . "\Power.log"
    return FileExist(cand) ? cand : ""
}

; ── OPEN (OR RE-OPEN) THE TAIL ──────────────────────────────────────────────
;
; Opens at the END of the file. Replaying history on attach would re-fire every
; phase change of every game played this session, which at best sets a wrong
; speed and at worst -- with auto-skip on -- fires a skip for a combat that
; finished an hour ago.
_BGPhaseAttach() {
    global State
    try {
        if State.bgLogFile
            State.bgLogFile.Close()
    }
    State.bgLogFile    := 0
    State.bgLogPath    := ""
    State.bgLogPos     := 0
    State.bgLogPartial := ""

    cand := _BGNewestPowerLog()
    if (cand = "")
        return false
    try {
        f := FileOpen(cand, "r", "UTF-8")
        f.Seek(0, 2)                          ; 2 = seek from the end
        State.bgLogFile := f
        State.bgLogPath := cand
        State.bgLogPos  := f.Pos
        _FSLog("PHASE attached to " . cand . " at offset " . State.bgLogPos)
        return true
    } catch as e {
        _FSLog("PHASE could not open " . cand . ": " . e.Message)
        return false
    }
}

; ── THE TAIL ITSELF ─────────────────────────────────────────────────────────
;
; Reads only what has been appended since the last pass. Three details matter:
;
;   TRUNCATION  A file shorter than our offset means the game restarted into a
;               new log; re-attach rather than seek past the end.
;   PARTIAL     A read can land mid-line. The remainder is carried to the next
;               pass so a marker split across two reads is still matched.
;   CAP         A long pause could leave megabytes pending. The read is capped
;               so that one pass can never stall the timer.
_BGPhaseTick() {
    global State, CFG
    static lastLook := 0

    ; Switched off at runtime: let go of the log before standing down. Simply
    ; returning would leave our read handle open on Power.log for the rest of
    ; the session, which stops Hearthstone rolling its own log over -- a fault
    ; in the game that nothing on the machine would connect to a setting the
    ; user had just turned OFF in HSBG.
    if !CFG.phaseDetect {
        if State.bgLogFile {
            was := State.bgLogPath
            try State.bgLogFile.Close()
            State.bgLogFile := 0
            State.bgLogPath := ""
            State.bgInBG    := false
            _BGEnterPhase("")
            _FSLog("PHASE detection switched off -- released " . was)
        }
        return
    }
    if !GetHSPID() {
        if State.bgLogFile {
            try State.bgLogFile.Close()
            State.bgLogFile := 0
            State.bgLogPath := ""
            State.bgInBG    := false
            _BGEnterPhase("")
        }
        return
    }

    ; Look for a newer log folder occasionally -- the game may have been
    ; restarted underneath us -- and keep retrying an attach that has not
    ; succeeded yet, because Power.log does not exist until a game is entered.
    if (A_TickCount - lastLook > (State.bgLogFile ? 5000 : 1500)) {
        lastLook := A_TickCount
        newest := _BGNewestPowerLog()
        if (newest != "" && newest != State.bgLogPath)
            _BGPhaseAttach()
        else if !State.bgLogFile
            _BGPhaseAttach()
    }
    if !State.bgLogFile
        return

    ; Keep the F1 target warm while auto-skip is enabled. This stays on the
    ; existing 250ms phase timer and uses the already-fast IP Helper path, so
    ; MAIN_END does not have to pay for discovery before applying the block.
    static lastPrewarm := 0
    if (CFG.autoSkip && State.bgInBG && (A_TickCount - lastPrewarm >= 250)) {
        lastPrewarm := A_TickCount
        try _BGAutoSkipPrewarm()
    }

    f := State.bgLogFile
    try {
        len := f.Length
        if (len < State.bgLogPos) {
            _BGPhaseAttach()
            return
        }
        if (len = State.bgLogPos)
            return
        f.Seek(State.bgLogPos)
        n := len - State.bgLogPos
        if (n > 1048576)
            n := 1048576
        buf := Buffer(n)
        got := f.RawRead(buf, n)
        State.bgLogPos += got
        chunk  := State.bgLogPartial . StrGet(buf, got, "UTF-8")
        lastNl := InStr(chunk, "`n", , -1)
        if !lastNl {
            State.bgLogPartial := chunk
            return
        }
        State.bgLogPartial := SubStr(chunk, lastNl + 1)
        Loop Parse SubStr(chunk, 1, lastNl - 1), "`n", "`r"
            _BGPhaseScan(A_LoopField)
    } catch as e {
        _FSLog("PHASE read error (" . e.Message . ") -- re-attaching")
        _BGPhaseAttach()
    }
}

; ── ONE LINE OF Power.log ───────────────────────────────────────────────────
;
; Hot path: called for every appended line. Nothing here writes to HSBG.log --
; only the transition handlers do, and only when something actually changed.
; That rule is why this can run against a file the game appends to constantly.
_BGPhaseScan(line) {
    global State
    ; ── THE BOARD PHASE COMES FROM PowerTaskList, NOT GameState ─────────────
    ;
    ; Power.log carries two streams and they disagree about how long a combat
    ; lasts, because they are answering different questions.
    ;
    ;   GameState      the logical state. The server has already resolved the
    ;                  whole fight, so this flips back to value=1 about a
    ;                  SECOND after it flipped to 2.
    ;   PowerTaskList  the animation queue -- what the client is actually
    ;                  playing out on screen. This is the combat a player sees.
    ;
    ; Measured over seven consecutive fights in one game: GameState reported
    ; combats of 0.9s, 1.1s, 1.6s, 1.7s, 1.5s, 2.0s and 1.8s. PowerTaskList
    ; reported the same fights as 7.1s, 11.3s, 6.5s, 5.8s, 9.2s, 13.1s and
    ; 22.3s. The second set is the truth; the first is the server's paperwork.
    ;
    ; Reading GameState broke three features at once and none of them looked
    ; like a phase bug: combat speed applied for a second and dropped back to
    ; the idle speed while the fight was still playing, so combats were never
    ; actually sped up; auto-skip's delay had usually not elapsed before the
    ; phase went back to shop, so it rarely fired; and the overlay flicked to
    ; COMBAT and back before it could be read.
    ;
    ; Only the board phase moves. The game-lifecycle markers below stay on
    ; GameState, where they belong -- those are logical facts about the match,
    ; not about what is being rendered.
    if InStr(line, "PowerTaskList.") {
        if InStr(line, "tag=BOARD_VISUAL_STATE value=2")
            _BGEnterPhase("combat")
        else if InStr(line, "tag=BOARD_VISUAL_STATE value=1")
            _BGEnterPhase("shop")
        return
    }
    if !InStr(line, "GameState.")
        return

    ; This is the exact logical end-of-turn boundary. Do not use the visual
    ; combat-start marker for auto-skip: that is when the opponent's combat
    ; starts, not when our turn timer expires.
    ; ── AUTO-SKIP FIRES ON THE LOGICAL COMBAT START, NOT ON MAIN_END ────────
    ;
    ; Both are in GameState and BOTH ARE THE SAME INSTANT -- measured over one
    ; game, every combat turn logged MAIN_END and BOARD_VISUAL_STATE=2 with an
    ; identical timestamp (17:17:04.904, 17:17:51.482, 17:18:54.120,
    ; 17:20:11.263). MAIN_END bought no lead time whatsoever.
    ;
    ; What it did buy was a turn that has no combat in it. MAIN_END fires at
    ; the end of EVERY turn, including the hero-selection turn: 17:16:17.414
    ; logged a MAIN_END with no combat after it at all. Auto-skip keyed to
    ; MAIN_END would cut the connection there for nothing -- an outage with no
    ; combat to skip, which is exactly the kind of pointless disconnect that
    ; gets a client dropped and unable to rejoin.
    ;
    ; BOARD_VISUAL_STATE=2 only exists when a combat actually exists. Same
    ; instant, strictly fewer firings. It is also the trigger point the
    ; reference tool uses, so the end-of-turn timing matches what that feels
    ; like -- without inheriting its fixed-timer hold.
    ;
    ; MAIN_END also arrives TWICE per turn, about 0.4s apart (17:17:04.904 and
    ; 17:17:05.309), at two nesting depths in the same power block. The
    ; bgCombatSeen gate in _BGAutoSkip absorbed the duplicate, but it was
    ; absorbing a duplicate that never needed to be sent.
    ;
    ; This stays on GameState deliberately. The VISUAL phase above reads
    ; PowerTaskList because that is what is being rendered; the SKIP has to
    ; fire when the turn ends, not when the animation of it begins. The two
    ; questions have two answers and each reads its own stream.
    if InStr(line, "tag=BOARD_VISUAL_STATE value=2") {
        if State.bgInBG
            _BGAutoSkip()
    }
    ; Disarm in the SAME stream that armed. bgCombatSeen was cleared only by
    ; the visual phase reaching "shop", which comes from PowerTaskList and lags
    ; the logical end of a combat by five to twenty seconds. That worked, but
    ; it made one stream's gate depend on another stream arriving -- and if the
    ; animation queue never reported shop (a game that ends mid-combat, a
    ; tailer that reattached to a new log part-way), auto-skip stayed armed-
    ; and-spent for the rest of the match with nothing to say so. Arming and
    ; disarming on the same marker cannot come apart like that.
    else if InStr(line, "tag=BOARD_VISUAL_STATE value=1")
        State.bgCombatSeen := false
    if InStr(line, "GameType=GT_BATTLEGROUNDS") {
        if !State.bgInBG {
            State.bgInBG := true
            _FSLog("PHASE Battlegrounds game detected")
            try BgOverlay.Refresh()
        }
    } else if InStr(line, "CREATE_GAME") {
        State.bgInBG       := false
        State.bgCombatSeen := false
        ; A new game gets one fresh arrangement. Without this the pair would be
        ; tidied once ever, and never again for the rest of the session.
        global _fsTiledThisGame
        _fsTiledThisGame := false
        _BGEnterPhase("")
    } else if InStr(line, "Entity=GameEntity tag=STATE value=COMPLETE") {
        State.bgInBG       := false
        State.bgCombatSeen := false
        ; A new game gets one fresh arrangement. Without this the pair would be
        ; tidied once ever, and never again for the rest of the session.
        global _fsTiledThisGame
        _fsTiledThisGame := false
        _BGEnterPhase("")
        _FSLog("PHASE game over")
    }
}

; ── A PHASE CHANGE ──────────────────────────────────────────────────────────
_BGEnterPhase(phase) {
    global State, CFG
    if (State.bgPhase = phase)
        return
    prev := State.bgPhase
    State.bgPhase      := phase
    State.bgPhaseSince := A_TickCount

    ; A shop marker ends the previous combat, so the next combat is allowed to
    ; arm auto-skip again. Without this, one skip per game would be the limit.
    if (phase = "shop")
        State.bgCombatSeen := false

    if (phase != "" && State.bgInBG)
        _FSLog("PHASE " . (prev = "" ? "-" : prev) . " -> " . phase)

    ; Speed follows the phase. When the game leaves Battlegrounds entirely
    ; (phase = ""), we MUST still hand the game back to the configured idle
    ; speed. The old guard required State.bgInBG to still be true, but the
    ; caller clears that flag before it asks us to enter the empty phase. On
    ; the final combat that left Time.timeScale at CombatSpeed (10x), so the
    ; main menu inherited 10x instead of the player's IdleSpeed (3x).
    if (phase = "" || (State.bgInBG && phase != ""))
        _BGApplyPhaseSpeed(phase)

    ; Auto-skip is keyed to GameEntity STEP=MAIN_END, not combat-start.

    try BgOverlay.Refresh()
}

; ── THE SPEED THAT BELONGS TO A PHASE ───────────────────────────────────────
;
; There are exactly two speeds and they live in the settings file. Combat has
; one; everything else -- shop, menus, the collection, a constructed game --
; shares the other. There is no third, session-only store shadowing them,
; which is what makes the settings window, the ini file and the speed keys all
; describe the same two numbers.
_BGPhaseSpeedFor(phase) {
    global CFG
    return (phase = "combat") ? CFG.combatSpeed : CFG.idleSpeed
}

_BGApplyPhaseSpeed(phase) {
    global State, CFG
    if (!CFG.phaseSpeedEnabled || !CFG.animationSpeedEnabled)
        return false
    want := _BGPhaseSpeedFor(phase)
    if (Abs(State.animationSpeedCurrent - want) < 0.001)
        return true
    ; quiet: the overlay already shows the phase and the speed, so a HUD toast
    ; on every shop-to-combat transition would be pure noise.
    return _SpeedApply(want, "phase:" . phase, true)
}

; ── A SPEED KEY RETUNES WHICHEVER SPEED YOU ARE CURRENTLY LIVING IN ─────────
;
; F5-F8 do not set "the speed" any more, because there is no longer one speed
; to set. In combat they change the combat speed; anywhere else -- shop, menu,
; between games -- they change the other one. So the keys keep doing exactly
; what they always did from the player's side ("faster", "slower", "jump to
; 8x"), and the number they move is the one that will still be in force the
; next time the game is in the same situation.
;
; That is the whole reason this is written to the settings file rather than
; held in memory: a speed you tuned during a combat is worthless if it is
; forgotten when the script restarts. Tuning by feel, in-game, IS configuring
; the script -- so the keys and the settings window write the same two keys.
;
; The write is deferred a moment because F5 and F6 are step keys: walking four
; notches up the cycle is four presses in under a second, and only the value
; you stop on is worth recording.
_BGRememberManualSpeed(value) {
    global State, CFG
    if !CFG.phaseSpeedEnabled
        return
    inCombat := (State.bgInBG && State.bgPhase = "combat")
    if inCombat
        CFG.combatSpeed := value
    else
        CFG.idleSpeed := value
    State.bgSpeedPendingKey := inCombat ? "CombatSpeed" : "IdleSpeed"
    State.bgSpeedPendingVal := value
    SetTimer(_BGSpeedPersist, -400)
    try BgOverlay.Refresh()
}

; Writes the pending speed to the settings file. Separate from the handler
; above so that a burst of presses costs one write, not one per press.
_BGSpeedPersist() {
    global State
    key := State.bgSpeedPendingKey
    val := State.bgSpeedPendingVal
    if (key = "")
        return
    State.bgSpeedPendingKey := ""
    try {
        IniWrite(Format("{:.1f}", val), _ConfigPath(), "Settings", key)
        _FSLog("PHASE " . key . " set to " . Format("{:.1f}", val)
             . "x by a speed key and saved to " . _ConfigPath())
    } catch as e {
        _FSLog("PHASE could not save " . key . " (" . e.Message . ")")
    }
}

; ── AUTOMATIC SKIP ──────────────────────────────────────────────────────────
;
; Presses F1. That is the entire implementation, and it is the point: the
; adaptive hold, the confirmation streak, the floor, the ceiling, the cooldown
; and the input shield all live in that path already, so an automatic press is
; exactly as safe as a manual one. A skip implemented separately here would be
; a second, weaker one with none of those rails -- which is the design that
; strands people mid-game.
_BGAutoSkipPrewarm() {
    global State, CFG
    if !CFG.autoSkip || !State.bgInBG || !GetHSPID()
        return
    try {
        fast := _FastConnScan(GetHSPID())
        if !fast.complete
            return
        target := fast.nonSvcIps
        if (CFG.f1Target = "all") {
            Loop Parse, fast.svcIps, "," {
                ip := Trim(A_LoopField)
                if (ip != "" && !InStr("," . target . ",", "," . ip . ","))
                    target .= (target = "" ? "" : ",") . ip
            }
        } else if (fast.svcCnt >= 2 && fast.svcNewestIp != ""
                && PortsToCsv(CFG.gamePorts) = ""
                && !InStr("," . target . ",", "," . fast.svcNewestIp . ",")) {
            target .= (target = "" ? "" : ",") . fast.svcNewestIp
        }
        if (target != "") {
            State.autoSkipTarget   := target
            State.autoSkipTargetAt := A_TickCount
        }
    }
}

; Auto-skip is fired on Hearthstone's own logical end-of-turn boundary:
; `GameEntity tag=STEP value=MAIN_END`. There is intentionally no extra 50ms
; grace timer here. The target lookup is normally already warm from the short
; prewarm timer, so the firewall block can start at the event itself.
_BGAutoSkip() {
    global State, CFG
    if (!CFG.autoSkip || !State.bgInBG)
        return
    if State.bgCombatSeen
        return
    State.bgCombatSeen := true
    if !GetHSPID()
        return
    if (State.lastF1End && (A_TickCount - State.lastF1End) < CFG.cooldownTime) {
        _FSLog("PHASE auto-skip declined: F1 is still cooling down")
        return
    }
    _FSLog("PHASE auto-skip firing at GameEntity STEP=MAIN_END")
    ; Execute on the same dispatch that observed MAIN_END. There is no extra
    ; timer tick here: the prewarmed target is already available, and F1 still
    ; supplies the normal connection/hold safety rails.
    _BGAutoSkipFire()
}

; ── AUTO-SKIP PRESSES F1. NOTHING ELSE. ─────────────────────────────────────
;
; It used to hand F1 a "prewarmed" connection list and a fromAuto flag, which
; sent it down a different path to the one a keypress takes -- and that path
; was the broken one. A manual F1 has always worked instantly; the automatic
; one fired at exactly the right moment and then blocked nothing, because the
; prewarmed list it was given was empty or stale by the time F1 read it.
;
; Two code paths for one action, where only one of them is ever exercised by
; hand, is how a feature stays broken while its trigger looks perfect in the
; log. So this now does literally what pressing the key does: no target, no
; flag, no prewarm. F1 does its own lookup, the same one that works when you
; press it, and every guard it carries -- the cooldown, the adaptive hold, the
; services ceiling -- applies identically because it is the same call.
_BGAutoSkipFire() {
    global State
    try Hotkey_F1()
    State.autoSkipTarget := ""
    State.autoSkipTargetAt := 0
}

; ════════════════════════════════════════════════════════════════════════════
;  THE HSBG OVERLAY  --  a compact status strip that sits over the game
; ════════════════════════════════════════════════════════════════════════════
;
;      ⣿  ● SHOP        3.0x   ⚙
;      │  │              │      └─ settings
;      │  │              └──────── click: next speed  (as F5)
;      │  └─────────────────────── click: skip combat (as F1)
;      └────────────────────────── drag: move it, position is remembered
;
; ── WHY THIS IS NOT DRAWN WITH GDI+ ─────────────────────────────────────────
;
; The obvious way to build an overlay button is a layered window with a GDI+
; back-buffer, which costs a ~3000-line imaging library, a bitmap per repaint
; and a paint loop to keep it alive. That buys gradients, rounded corners and
; anti-aliased arcs.
;
; This script's visual language is a flat dark panel with bold text -- exactly
; what native controls already render, pixel for pixel, with no library, no
; buffers and no paint loop. So the whole overlay is a Gui with five Text
; controls. It is not a compromise for the sake of being small; it is the same
; picture by a shorter route, and it is one fewer dependency to break.
;
; ── THE ONE FLAG THAT MATTERS: WS_EX_NOACTIVATE ─────────────────────────────
;
; This window sits on top of a fullscreen game and is clicked. That is exactly
; the shape of thing that breaks fullscreen, and the reason is documented above
; _HSEnsureFullscreenOwnership: the shell only hides the taskbar for a covering
; window that is ALSO the foreground window. Anything that takes focus from
; Hearthstone leaves the taskbar drawn over the game.
;
; A normal clickable window takes focus on every single click. This one carries
; WS_EX_NOACTIVATE (0x08000000), so it receives clicks and never becomes
; foreground -- the game keeps focus through every press, and the taskbar stays
; where it belongs. Every Show below is also NoActivate, for the same reason.
; If this overlay ever starts stealing focus, that flag is the first suspect.
class BgOverlay {
    static _gui    := 0
    static _grip   := 0
    static _dot    := 0
    static _phase  := 0
    static _auto   := 0
    static _speed  := 0
    static _menu   := 0
    static _keys   := []
    static _fs     := 0
    static _msgOn  := false
    static _lastSig := ""
    static _dragging := false
    static _dragDX   := 0
    static _dragDY   := 0

    ; ── THE KEY LEGEND ──────────────────────────────────────────────────────
    ; What each key does, on the overlay, so it does not have to be memorised
    ; from a README nobody has open mid-game.
    ;
    ; "act" is false for F4 on purpose. Every other row is a click away from
    ; something recoverable -- a skip, a speed step, a toggle. F4 closes the
    ; game, Battle.net, the tracker and HSBG, and a stray click on a strip that
    ; sits over a live board should not be able to end the session. It is
    ; listed because knowing the key exists is the point of a legend; it is not
    ; wired up because a legend is not a launch button.
    static KEYS := [ {k: "F1", t: "SKIP",  act: true }
                   , {k: "F2", t: "PLAY",  act: true }
                   , {k: "F3", t: "SHOW",  act: true }
                   , {k: "F5", t: "FAST",  act: true }
                   , {k: "F6", t: "SLOW",  act: true }
                   , {k: "F9", t: "AUTO",  act: true }
                   , {k: "F4", t: "QUIT",  act: false} ]

    ; ── COLOURS ────────────────────────────────────────────────────────────
    ; The palette is the art style, and it is BgHUD's: near-black panel, bold
    ; white text. The accents exist only to make the dot readable at a glance
    ; from across a game board.
    static BG      := "111111"
    static FG      := "FFFFFF"
    static DIM     := "888888"
    static GREEN   := "2ECC71"     ; shop -- free to act
    static AMBER   := "E67E22"     ; combat -- in progress
    static RED     := "E74C3C"     ; skipping right now
    static GREY    := "555555"     ; not in a Battlegrounds game
    static BLUE    := "3498DB"     ; auto-skip armed
    static RULE    := "2A2A2A"     ; the hairline under the mark
    static GOLD    := "F0B429"     ; the mark, matching the project's own art

    static Enabled() {
        global CFG
        return CFG.overlayEnabled ? true : false
    }

    ; ── THE PERIODIC PULSE ─────────────────────────────────────────────────
    ; One timer drives the whole overlay: it decides whether the strip should
    ; exist at all, and repaints it when something it shows has changed. It
    ; deliberately does NOT poll the game -- the phase arrives from the tail --
    ; so this stays a cheap comparison of a handful of values.
    static Tick() {
        try {
            if (!BgOverlay.Enabled() || !GetHSPID()) {
                BgOverlay.Destroy()
                return
            }
            BgOverlay.Refresh()
        }
    }

    static Refresh() {
        global State, CFG, InputShield
        if (!BgOverlay.Enabled() || !GetHSPID())
            return

        ; Auto-skip always has an explicit On/Off state. Once the F1 target
        ; has been prewarmed, show READY as the live sub-state without replacing
        ; the clear enabled/disabled wording. The wider strip prevents either
        ; label from being clipped.
        autoLabel := CFG.autoSkip ? "Auto Skip On" : "Auto Skip Off"
        if (CFG.autoSkip && State.autoSkipTarget != ""
         && State.autoSkipTargetAt
         && (A_TickCount - State.autoSkipTargetAt) <= 900)
            autoLabel := "Auto Skip Ready"
        autoCol := CFG.autoSkip ? BgOverlay.GREEN : BgOverlay.DIM
        if (State.bgPhase = "combat" && CFG.autoSkip)
            autoCol := BgOverlay.BLUE

        if !State.bgInBG {
            phaseLabel := "MENU"
            phaseCol := BgOverlay.GREY
        } else if (State.bgPhase = "combat") {
            phaseLabel := "COMBAT"
            phaseCol := BgOverlay.AMBER
        } else if (State.bgPhase = "shop") {
            phaseLabel := "SHOP"
            phaseCol := BgOverlay.GREEN
        } else {
            phaseLabel := "BG"
            phaseCol := BgOverlay.GREEN
        }

        spd := Format("{:.1f}x", State.animationSpeedCurrent)

        ; Repaint only on an actual change. Rewriting identical text every
        ; pulse is a repaint the user cannot see and the compositor still pays
        ; for -- over a fullscreen game that is the wrong trade.
        sig := phaseLabel . "|" . phaseCol . "|" . autoLabel . "|" . autoCol . "|" . spd
        if (sig = BgOverlay._lastSig && IsObject(BgOverlay._gui))
            return
        BgOverlay._lastSig := sig

        if !IsObject(BgOverlay._gui)
            BgOverlay._Create()
        if !IsObject(BgOverlay._gui)
            return

        try {
            BgOverlay._dot.Opt("c" . phaseCol)
            BgOverlay._phase.Opt("c" . phaseCol)
            BgOverlay._auto.Opt("c" . autoCol)
            if (BgOverlay._phase.Text != phaseLabel)
                BgOverlay._phase.Text := phaseLabel
            if (BgOverlay._auto.Text != autoLabel)
                BgOverlay._auto.Text := autoLabel
            if (BgOverlay._speed.Text != spd)
                BgOverlay._speed.Text := spd
            BgOverlay._dot.Redraw()
            BgOverlay._phase.Redraw()
            BgOverlay._auto.Redraw()
        }
    }

    static _Create() {
        global CFG
        BgOverlay.Destroy()

        if CFG.lockWindowsToChosenMonitor
            GetChosenMonitorBounds(&l, &t, &monW, &monH)
        else
            GetHSMonitorBounds(&l, &t, &monW, &monH)

        ; Sized from real monitor pixels, exactly as BgHUD is, and for the
        ; same reason: -DPIScale below means every number here is already a
        ; physical pixel and must not be scaled a second time.
        fs := Max(10, (monH // 80) * CFG.overlayScale // 100)
        BgOverlay._fs := fs

        ; ── A COLUMN ON THE LEFT EDGE, NOT A BAR ACROSS THE BOTTOM ──────────
        ;
        ; The bar was the lazy shape. It was as wide as its longest label, it
        ; sat across the bottom centre, and that is exactly where the game puts
        ; the player's own hand and hero power -- so it either covered them or
        ; had to be dragged somewhere arbitrary on every new machine.
        ;
        ; A narrow column on the LEFT edge solves both. It is the one strip of
        ; a Battlegrounds screen with nothing in it: the board is centred, and
        ; both trackers put their overlays on the RIGHT by default -- Firestone
        ; its panels, HSReplay its deck list -- so anything of ours on the left
        ; is clear of both without asking the user to arrange anything.
        ;
        ; Vertically it sits a little above centre, away from the shop row at
        ; the bottom and the tavern tier controls at the top.
        ; A quarter narrower than it was (14.5 -> 10.9, floor 240 -> 180). The
        ; longest string it has to hold is "Auto Skip Ready", which measures
        ; well inside this at the font the strip uses.
        colW := Max(Round(fs * 10.9), 180)
        pad  := Round(fs * 0.55)
        rowH := Round(fs * 1.45)
        gap  := Round(fs * 0.42)
        keyH := Round(rowH * 0.92)               ; the legend rows are tighter
        btnH := Round(rowH * 1.30)               ; the MENU chip

        ; mark, rule, dot, phase, auto, speed, rule, MENU, rule, legend
        totalH := pad + Round(rowH * 2.25) + gap + 2 + gap
                + rowH + rowH + rowH + gap + rowH + gap
                + 2 + gap + btnH + gap + 2 + gap
                + (keyH * BgOverlay.KEYS.Length) + pad
        totalW := colW

        ; +E0x08000000 is WS_EX_NOACTIVATE -- see the note above the class.
        g := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x08000000", "HSBG Overlay")
        g.Opt("-DPIScale")
        g.BackColor := BgOverlay.BG
        g.MarginX   := 0
        g.MarginY   := 0

        y := pad

        ; ── THE MARK, WHICH IS ALSO THE HANDLE ──────────────────────────────
        ; HS over BG, the same lockup as the community icon. It doubles as the
        ; drag grip: the piece of a window you grab should be the piece that
        ; identifies it, not a separate row of dots bolted on beside it.
        g.SetFont("s" . Round(fs * 0.82) . " c" . BgOverlay.GOLD . " Bold", "Segoe UI")
        BgOverlay._grip := g.Add("Text", "x0 y" . y . " w" . colW
                                       . " h" . Round(rowH * 2.25)
                                       . " Center +0x100", "HS`nBG")
        y += Round(rowH * 2.25) + gap

        g.Add("Text", "x" . Round(colW * 0.22) . " y" . y
                    . " w" . Round(colW * 0.56) . " h1 Background" . BgOverlay.RULE)
        y += 2 + gap

        ; The glyph needs about 1.4x its point size in line height. At 1.15x fs
        ; in a row 1.45x fs tall it was drawn clipped -- only the bottom half of
        ; the dot appeared, which read as a rendering fault rather than a dot.
        g.SetFont("s" . Round(fs * 0.85) . " c" . BgOverlay.GREY . " Bold", "Segoe UI")
        BgOverlay._dot := g.Add("Text", "x0 y" . y . " w" . colW
                                      . " h" . rowH . " Center +0x100", Chr(0x25CF))
        y += rowH

        g.SetFont("s" . Round(fs * 0.72) . " c" . BgOverlay.GREY . " Bold", "Arial")
        BgOverlay._phase := g.Add("Text", "x0 y" . y . " w" . colW
                                        . " h" . rowH . " Center +0x100", "MENU")
        y += rowH

        g.SetFont("s" . Round(fs * 0.66) . " c" . BgOverlay.DIM . " Bold", "Arial")
        BgOverlay._auto := g.Add("Text", "x0 y" . y . " w" . colW
                                      . " h" . rowH . " Center +0x100", "Auto Skip Off")
        y += rowH + gap

        g.SetFont("s" . Round(fs * 0.95) . " c" . BgOverlay.FG . " Bold", "Arial")
        BgOverlay._speed := g.Add("Text", "x0 y" . y . " w" . colW
                                        . " h" . rowH . " Center +0x100", "1.0x")
        y += rowH + gap

        g.Add("Text", "x" . Round(colW * 0.22) . " y" . y
                    . " w" . Round(colW * 0.56) . " h1 Background" . BgOverlay.RULE)
        y += 2 + gap

        ; ── MENU ────────────────────────────────────────────────────────────
        ; The gear is gone. A cog is an icon you have to recognise; a word you
        ; can read is not worse for being obvious, and this is the only control
        ; on the strip that opens anything, so it says what it opens.
        ;
        ; It goes straight to the settings window. It used to raise a popup
        ; menu whose main item was "Settings…", which is a menu whose purpose
        ; was to offer one more click before the thing you wanted.
        ; ── THE BOX AND THE WORD ARE TWO CONTROLS ───────────────────────────
        ; One bordered Text with SS_CENTERIMAGE looked centred in a mock-up and
        ; did not read as centred on a real monitor: WS_BORDER shrinks the
        ; client rectangle the text is centred within, and SS_CENTERIMAGE then
        ; rounds the remaining half-pixel the same way every time, so the word
        ; sits consistently high and left inside its own frame.
        ;
        ; Drawing the frame and the word separately removes both effects -- the
        ; word is placed at a position computed from the box, so it is centred
        ; by construction rather than by a style flag. The box is added first
        ; so the word sits above it in z-order.
        boxX := Round(colW * 0.10)
        boxW := colW - (boxX * 2)              ; equal margins, whatever colW is
        g.Add("Text", "x" . boxX . " y" . y . " w" . boxW . " h" . btnH . " +Border")
        g.SetFont("s" . Round(fs * 0.80) . " c" . BgOverlay.GOLD . " Bold", "Arial")
        txtH := Round(fs * 0.80 * 1.5)
        BgOverlay._menu := g.Add("Text"
            , "x" . boxX . " y" . (y + ((btnH - txtH) // 2))
            . " w" . boxW . " h" . txtH . " Center BackgroundTrans", "MENU")
        y += btnH + gap

        g.Add("Text", "x" . Round(colW * 0.22) . " y" . y
                    . " w" . Round(colW * 0.56) . " h1 Background" . BgOverlay.RULE)
        y += 2 + gap

        ; ── THE KEY LEGEND ──────────────────────────────────────────────────
        ; Key on the left in the project's gold, what it does on the right in
        ; grey. Same lockup as the header art, small enough to read past.
        BgOverlay._keys := []
        kw := Round(colW * 0.40)
        for entry in BgOverlay.KEYS {
            g.SetFont("s" . Round(fs * 0.62) . " c"
                    . (entry.act ? BgOverlay.GOLD : BgOverlay.GREY) . " Bold", "Arial")
            kc := g.Add("Text", "x" . Round(colW * 0.10) . " y" . y
                              . " w" . kw . " h" . keyH . " +0x100", entry.k)
            g.SetFont("s" . Round(fs * 0.58) . " c"
                    . (entry.act ? BgOverlay.DIM : BgOverlay.GREY) . " Norm", "Arial")
            tc := g.Add("Text", "x" . (Round(colW * 0.10) + kw) . " y" . y
                              . " w" . (colW - Round(colW * 0.20) - kw)
                              . " h" . keyH . " +0x100", entry.t)
            if entry.act {
                ; Bound at creation, one per row. A single shared handler
                ; would have to work out which row was hit from the mouse
                ; position, which is a second source of truth for something
                ; the loop already knows.
                kc.OnEvent("Click", BgOverlay._KeyHandler(entry.k))
                tc.OnEvent("Click", BgOverlay._KeyHandler(entry.k))
            }
            BgOverlay._keys.Push(kc)
            BgOverlay._keys.Push(tc)
            y += keyH
        }

        ; ── THE READOUTS ARE READOUTS, NOT BUTTONS ──────────────────────────
        ; The dot, the phase and the speed do nothing when clicked, and the
        ; strip no longer carries a skip button at all. A control that CHANGES
        ; the game does not belong on the surface most likely to be clicked by
        ; accident, right where the eye goes to read the current state -- and a
        ; misclick during a combat silently retuned the speed for every future
        ; combat, because a manual change is remembered. The legend below is
        ; where a click does something, and it says which key it is pressing.
        BgOverlay._grip.OnEvent("Click", (*) => 0)          ; drag, not click
        BgOverlay._menu.OnEvent("Click", (*) => BgOverlay._OpenSettings())

        BgOverlay._gui := g

        ; Remembered position, clamped back onto a real monitor. A saved
        ; position from a monitor that is no longer attached would otherwise
        ; put the strip somewhere unreachable, with no way to get it back.
        px := CFG.overlayX
        py := CFG.overlayY
        if (px = "" || py = "" || !BgOverlay._OnAnyMonitor(px, py, totalW, totalH)) {
            px := l                                 ; flush to the left edge
            ; Measured from the strip's OWN height rather than a fixed
            ; fraction of the screen, so the column growing (it did, when the
            ; key legend was added) cannot push its bottom into the shop row on
            ; a short monitor. 0.72 sits it well below centre -- 0.55 was still
            ; landing high enough to need moving by hand every time.
            py := t + Round((monH - totalH) * 0.87)
        }

        g.Show("x" . px . " y" . py . " w" . totalW . " h" . totalH . " NoActivate")
        try WinSetTransColor("000000 " . CFG.overlayOpacity, g)

        ; ── ROUNDED CORNERS ─────────────────────────────────────────────────
        ; A hard rectangle reads as a debug window sitting on the game. The
        ; region is applied to OUR OWN window, which matters: SetWindowRgn
        ; sends synchronous messages to the thread that owns the window, so
        ; doing this to another process's window blocks on that process. On a
        ; window we created, in our own thread, it costs nothing.
        try {
            r := Round(Min(colW, totalH) * 0.22)
            rgn := DllCall("gdi32\CreateRoundRectRgn", "Int", 0, "Int", 0
                         , "Int", totalW + 1, "Int", totalH + 1
                         , "Int", r, "Int", r, "Ptr")
            if rgn
                DllCall("user32\SetWindowRgn", "Ptr", g.Hwnd, "Ptr", rgn
                      , "Int", true)
        }
        ; one. Registering them once and leaving them installed for the life of
        ; the script means they keep running against windows the overlay knows
        ; nothing about -- the settings window, the tracker picker -- long after
        ; the overlay itself has been destroyed.
        ;
        ; That is not theoretical. With these left installed, opening the
        ; settings window while the overlay existed tore it down on its own a
        ; second or two later: its controls vanished, and Save then wrote an
        ; empty value over every setting in the file. Nothing in the settings
        ; window was wrong -- it was being acted on from outside.
        ;
        ; So they are installed with the window and removed with it, and each
        ; one still checks the hwnd it was given. Both halves matter: the
        ; check stops the wrong window being acted on while we are up, and the
        ; teardown stops us acting at all once we are gone.
        if !BgOverlay._msgOn {
            ; WM_MOUSEACTIVATE is the one that actually keeps focus on the
            ; game -- see the note on _BGOverlayMouseActivate. WM_LBUTTONDOWN
            ; starts a drag from the grip; WM_EXITSIZEMOVE is where the moved
            ; position gets written back to the settings file.
            OnMessage(0x0021, _BGOverlayMouseActivate)
            OnMessage(0x0201, _BGOverlayLDown)
            OnMessage(0x0232, _BGOverlayMoved)
            BgOverlay._msgOn := true
        }
    }

    static _OnAnyMonitor(x, y, w, h) {
        try {
            loop MonitorGetCount() {
                MonitorGet(A_Index, &ml, &mt, &mr, &mb)
                ; the strip's own centre has to land on a monitor, so a window
                ; hanging off an edge is still recoverable but a window on a
                ; detached monitor is not accepted.
                cx := x + w // 2
                cy := y + h // 2
                if (cx >= ml && cx <= mr && cy >= mt && cy <= mb)
                    return true
            }
        }
        return false
    }

    ; Clicking a legend row must behave EXACTLY as pressing that key does, so
    ; it calls the same handler. Nothing here re-implements a skip or a speed
    ; step -- every guard those keys carry (the cooldown, the in-a-game check,
    ; the adaptive hold) applies to a click because it is the same code.
    static _KeyHandler(k) {
        switch k {
            case "F1": return (*) => BgOverlay._Fire(Hotkey_F1, "F1")
            case "F2": return (*) => BgOverlay._Fire(Hotkey_F2, "F2")
            case "F3": return (*) => BgOverlay._Fire(Hotkey_F3, "F3")
            case "F5": return (*) => BgOverlay._Fire(Hotkey_F5, "F5")
            case "F6": return (*) => BgOverlay._Fire(Hotkey_F6, "F6")
            case "F9": return (*) => BgOverlay._Fire(Hotkey_F9, "F9")
        }
        return (*) => 0
    }

    ; One place that swallows a throw. A hotkey that fails is a hotkey that
    ; fails; it must not also take the overlay down with it, because the
    ; overlay is how the user finds out what state they are in.
    ;
    ; The log line is not noise. HK-FIRED says a hotkey ran; it does not say
    ; who ran it, and a legend that presses real keys makes that ambiguous for
    ; the first time. A session showed 24 F3 fires and there was no way to tell
    ; how many were the keyboard and how many were clicks on this strip -- the
    ; two are indistinguishable downstream. An HK-FIRED with no OVERLAY-CLICK
    ; immediately before it came from the keyboard, or from nothing at all,
    ; which is the case worth being able to see.
    static _Fire(fn, key := "") {
        if (key != "")
            try _FSLog("OVERLAY-CLICK " . key . " pressed from the overlay legend")
        try fn()
    }

    ; MENU is a toggle. Pressing it a second time to put the window away is the
    ; obvious thing to try, and it used to do nothing at all -- Open() saw a
    ; window already built and just re-showed it.
    static _OpenSettings() {
        try {
            if IsObject(BgSettings._gui) {
                BgSettings._Close()
                return
            }
            BgSettings.Open()
        }
    }

    static _BeginDrag() {
        if BgOverlay._dragging
            return
        if !IsObject(BgOverlay._gui)
            return
        prev := A_CoordModeMouse
        CoordMode("Mouse", "Screen")
        MouseGetPos(&mx, &my)
        WinGetPos(&wx, &wy, , , BgOverlay._gui)
        CoordMode("Mouse", prev)
        if (wx = "" || wy = "")
            return
        BgOverlay._dragDX   := mx - wx
        BgOverlay._dragDY   := my - wy
        BgOverlay._dragging := true
        SetTimer(_BGOverlayDragTick, 15)
    }

    static _DragTick() {
        static SWP_NOSIZE     := 0x0001
             , SWP_NOZORDER   := 0x0004
             , SWP_NOACTIVATE := 0x0010
        if (!BgOverlay._dragging || !IsObject(BgOverlay._gui)) {
            BgOverlay._EndDrag()
            return
        }
        ; The button is read physically. A logical read can miss the release
        ; when the pointer is over another process's window, which would leave
        ; the strip glued to the cursor.
        if !GetKeyState("LButton", "P") {
            BgOverlay._EndDrag()
            return
        }
        prev := A_CoordModeMouse
        CoordMode("Mouse", "Screen")
        MouseGetPos(&mx, &my)
        CoordMode("Mouse", prev)
        try DllCall("user32\SetWindowPos"
                  , "Ptr",  BgOverlay._gui.Hwnd, "Ptr", 0
                  , "Int",  mx - BgOverlay._dragDX
                  , "Int",  my - BgOverlay._dragDY
                  , "Int",  0, "Int", 0
                  , "UInt", SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE)
    }

    static _EndDrag() {
        if !BgOverlay._dragging
            return
        BgOverlay._dragging := false
        SetTimer(_BGOverlayDragTick, 0)
        ; Once per drag, not once per frame -- the same reason the old
        ; WM_EXITSIZEMOVE handler saved here and nowhere else.
        try BgOverlay.SavePosition()
    }

    static SavePosition() {
        global CFG
        if !IsObject(BgOverlay._gui)
            return
        try {
            WinGetPos(&x, &y, , , BgOverlay._gui)
            if (x = "" || y = "")
                return
            CFG.overlayX := x
            CFG.overlayY := y
            IniWrite(x, _ConfigPath(), "Settings", "OverlayX")
            IniWrite(y, _ConfigPath(), "Settings", "OverlayY")
            _FSLog("OVERLAY moved to " . x . "," . y . " (remembered)")
        }
    }

    static Destroy() {
        ; A drag in progress owns a timer that would otherwise keep firing at
        ; a window that no longer exists.
        BgOverlay._EndDrag()
        ; Remove the process-wide message hooks before anything else. See the
        ; note where they are installed: left registered, they act on windows
        ; that are not ours and are not even the overlay.
        if BgOverlay._msgOn {
            try {
                OnMessage(0x0021, _BGOverlayMouseActivate, 0)
                OnMessage(0x0201, _BGOverlayLDown, 0)
                OnMessage(0x0232, _BGOverlayMoved, 0)
            }
            BgOverlay._msgOn := false
        }
        BgOverlay._lastSig := ""
        BgOverlay._grip  := 0
        BgOverlay._dot   := 0
        BgOverlay._phase := 0
        BgOverlay._auto  := 0
        BgOverlay._speed := 0
        BgOverlay._menu  := 0
        BgOverlay._keys  := []
        if IsObject(BgOverlay._gui) {
            try BgOverlay._gui.Destroy()
            BgOverlay._gui := 0
        }
    }

    ; Rebuild from scratch -- used after a settings change that alters size,
    ; opacity or position, where editing the live window in place would be
    ; more code than simply drawing it again.
    static Rebuild() {
        BgOverlay.Destroy()
        try BgOverlay.Refresh()
    }
}

; ── THE MESSAGE THAT ACTUALLY KEEPS THE GAME IN FRONT ───────────────────────
;
; WS_EX_NOACTIVATE ALONE IS NOT ENOUGH, AND THIS WAS MEASURED, NOT ASSUMED.
; With the style bit confirmed present on the window, clicking the strip still
; moved the foreground to it -- a decoy window held focus, the overlay was
; clicked, and the foreground afterwards was the overlay. The style stops a
; window being activated in several ways, but a click that lands on a CHILD
; control still reaches the parent as WM_MOUSEACTIVATE, and the default answer
; to that message activates the window.
;
; Returning MA_NOACTIVATE (3) is the documented way to refuse. It is what makes
; the difference between an overlay that is safe over a fullscreen game and one
; that puts the taskbar back on screen every time it is used, because the shell
; only hides the taskbar for a covering window that is ALSO foreground.
;
; If the taskbar ever starts reappearing when the overlay is clicked, this
; handler -- not the style bit -- is the thing that has stopped working.
_BGOverlayMouseActivate(wParam, lParam, msg, hwnd) {
    try {
        if (IsObject(BgOverlay._gui) && hwnd = BgOverlay._gui.Hwnd)
            return 3                      ; MA_NOACTIVATE
    }
}

; ── DRAGGING, WITHOUT A TITLE BAR AND WITHOUT TAKING FOCUS ──────────────────
;
; A caption-less window is moved by telling Windows the pointer is on its
; caption: posting WM_NCLBUTTONDOWN with HTCAPTION hands the drag to the window
; manager, which then does the whole move for us. It costs nothing while idle,
; unlike tracking mouse movement ourselves, and it keeps working while the
; window is NOACTIVATE.
;
; The filter is the important part. This is a process-wide message hook, so it
; sees every left click in every window this script owns -- the settings
; window, the tracker picker, everything. It must act ONLY on the grip.
_BGOverlayLDown(wParam, lParam, msg, hwnd) {
    try {
        if !IsObject(BgOverlay._gui)
            return
        if !IsObject(BgOverlay._grip)
            return
        if (hwnd != BgOverlay._grip.Hwnd)
            return
        BgOverlay._BeginDrag()
        return 0
    }
}

; ── WHY THE DRAG IS HAND-ROLLED ─────────────────────────────────────────────
;
; This used to be one line: PostMessage WM_NCLBUTTONDOWN with HTCAPTION, which
; hands the move to Windows and costs nothing. It also ACTIVATES the window,
; and that is not negotiable -- a caption drag is a non-client message, so it
; never reaches the WM_MOUSEACTIVATE handler that keeps the game in front.
;
; The symptom was reported as "pulling it up makes the taskbar show", which
; sounds positional and is not: the taskbar is hidden only for a window that is
; fullscreen AND foreground, so the instant the overlay took the foreground,
; Hearthstone stopped qualifying and the shell put the taskbar back. It
; happened at any position; dragging was the trigger.
;
; So the move is done here instead, with SWP_NOACTIVATE. The cursor offset is
; captured once at the start rather than tracked per frame, so the window
; cannot drift away from the pointer over a long drag.
_BGOverlayDragTick(*) => BgOverlay._DragTick()

; WM_EXITSIZEMOVE: the drag has finished. Saving here rather than on every
; mouse move means one line in the settings file per move, not hundreds.
_BGOverlayMoved(wParam, lParam, msg, hwnd) {
    try {
        if (IsObject(BgOverlay._gui) && hwnd = BgOverlay._gui.Hwnd)
            BgOverlay.SavePosition()
    }
}

BgOverlayTick(*) => BgOverlay.Tick()

; ════════════════════════════════════════════════════════════════════════════
;  THE SETTINGS WINDOW  --  what the gear on the overlay opens
; ════════════════════════════════════════════════════════════════════════════
;
; Every control here writes the SAME settings file that has always been the
; source of truth, through the same IniWrite path, and then asks the script to
; re-read it. There is no parallel settings store and no in-memory-only knob:
; a change made here is identical to one typed into HSBG Config.ini by hand,
; which is what keeps "Open settings (HSBG Config.ini)" in the tray menu
; honest, and what stops this window and the file drifting apart.
;
; This window is allowed to take focus, unlike the overlay. It is opened
; deliberately, between games, and a settings dialog you cannot type into
; would be useless. It is also NOT always-on-top, so it cannot end up
; stranded over a fullscreen game with no way past it.
class BgSettings {
    static _gui := 0
    static _c   := Map()

    ; Layout state. Every control's design-time rectangle is captured once,
    ; after the window has been laid out, and every later resize is computed
    ; from those rather than from the control's current position -- repeated
    ; relative moves accumulate rounding error, absolute ones cannot.
    static _rects    := []
    static _baseW    := 0
    static _baseH    := 0
    static _scrollY  := 0
    static _contentH := 0
    static _footerH  := 62          ; the button band, measured up from the bottom
    static _splitX   := 0           ; x of the second column, set by _Build
    static _msgOn    := false
    static _sync     := false       ; see _SpeedSync

    ; ── THE PALETTE IS THE PROJECT'S: BLACK AND ORANGE ──────────────────────
    ; Near-black ground, one accent. Headings and the values you can change are
    ; in the accent; explanatory text is grey so it reads as explanation. The
    ; window used to be flat grey-on-black with no accent at all, which is why
    ; it did not look like the rest of HSBG.
    static BG    := "121212"
    static PANEL := "1C1C1C"
    static FG    := "FFFFFF"
    static DIM   := "9A9A9A"
    static GOLD  := "F0B429"
    static WARN  := "E67E22"
    static RULE  := "2E2E2E"

    ; The presets the slider snaps through. The Edit beside it is NOT limited
    ; to these -- see _SpeedRow.
    static SPEEDS := ["1.0","1.5","2.0","2.5","3.0","3.5","4.0","4.5","5.0"
                    , "5.5","6.0","6.5","7.0","7.5","8.0","8.5","9.0","9.5","10.0"]
    static MINSPD := 0.1
    static MAXSPD := 20.0

    static Open(*) {
        if IsObject(BgSettings._gui) {
            try {
                BgSettings._gui.Show()
                WinActivate("ahk_id " . BgSettings._gui.Hwnd)
                return
            }
        }
        BgSettings._Build()
    }

    static _Idx(list, want) {
        for i, v in list {
            if (Float(v) = Float(want))
                return i
        }
        return 1
    }

    ; ── A SPEED ROW: SLIDER *AND* A BOX YOU CAN TYPE IN ─────────────────────
    ;
    ; It used to be a dropdown of the presets in the config file, so the only
    ; reachable speeds were the ones already written down. Now the slider walks
    ; the presets for the common case and the box beside it takes any number at
    ; all -- 3.7, 12 -- whether or not it appears in the config.
    ;
    ; The two are one value shown twice, so each writes to the other. _sync is
    ; what stops that being a loop: setting a control's value raises its own
    ; Change event, which would set the first control again, and so on until
    ; the stack gives out. The guard is on the class rather than on the row
    ; because the handlers are separate closures over the same value.
    static _SpeedRow(g, key, label, x, y, val) {
        g.SetFont("s10 c" . BgSettings.FG . " Norm", "Segoe UI")
        g.Add("Text", "x" . x . " y" . (y + 4) . " w150", label)

        sl := g.Add("Slider", "x" . (x + 152) . " y" . y . " w200 h26 "
                            . "Range10-100 TickInterval5 Page5 NoTicks"
                  , Round(BgSettings._Clamp(val) * 10))
        ed := g.Add("Edit", "x" . (x + 360) . " y" . (y + 1) . " w62 h24 "
                          . "Background" . BgSettings.PANEL . " c" . BgSettings.GOLD
                          . " Center", Format("{:.1f}", BgSettings._Clamp(val)))

        sl.OnEvent("Change", (*) => BgSettings._SpeedSync(key, "slider"))
        ed.OnEvent("Change", (*) => BgSettings._SpeedSync(key, "edit"))

        BgSettings._c[key]           := ed        ; the Edit is the value _Save reads
        BgSettings._c[key . "Slider"] := sl
        return y + 30
    }

    static _Clamp(v) {
        n := 0.0
        try n := Float(v)
        if (n < BgSettings.MINSPD)
            n := BgSettings.MINSPD
        if (n > BgSettings.MAXSPD)
            n := BgSettings.MAXSPD
        return n
    }

    static _SpeedSync(key, from) {
        if BgSettings._sync
            return
        if (!BgSettings._c.Has(key) || !BgSettings._c.Has(key . "Slider"))
            return
        BgSettings._sync := true
        try {
            ed := BgSettings._c[key]
            sl := BgSettings._c[key . "Slider"]
            if (from = "slider") {
                ed.Value := Format("{:.1f}", sl.Value / 10)
            } else {
                ; Typed. Do NOT clamp the text while it is being typed -- a
                ; half-finished "1" on the way to "12" would be rewritten to
                ; the minimum under the cursor. Only the slider is moved here;
                ; the value is clamped on save.
                n := 0.0
                try n := Float(ed.Text)
                if (n >= 1.0 && n <= 10.0)
                    sl.Value := Round(n * 10)
            }
        }
        BgSettings._sync := false
    }

    static _Head(g, txt, x, y) {
        g.SetFont("s11 c" . BgSettings.GOLD . " Bold", "Segoe UI")
        g.Add("Text", "x" . x . " y" . y . " w400", txt)
        ; A Text with an explicit Background, not SS_ETCHEDHORZ. The etched
        ; style draws with the system's 3D edge colours and ignores the colour
        ; it is given, so on a near-black panel it came out a bright white bar.
        g.Add("Text", "x" . x . " y" . (y + 22) . " w400 h1 Background" . BgSettings.GOLD)
        return y + 32
    }

    static _Note(g, txt, x, y, w) {
        g.SetFont("s9 c" . BgSettings.DIM . " Norm", "Segoe UI")
        t := g.Add("Text", "x" . x . " y" . y . " w" . w, txt)
        t.GetPos(, , , &th)
        return y + th + 6
    }

    static _Warn(g, txt, x, y, w) {
        g.SetFont("s9 c" . BgSettings.WARN . " Norm", "Segoe UI")
        t := g.Add("Text", "x" . x . " y" . y . " w" . w, txt)
        t.GetPos(, , , &th)
        return y + th + 6
    }

    ; Same rule as _Num, and the same reason. The fixed "h22" here CLIPPED a
    ; long label instead of wrapping it -- a checkbox given a height does not
    ; grow to fit its text, it just cuts it off. Height is left to the control
    ; and the row advances by what it became.
    static _Chk(g, key, txt, x, y, on) {
        g.SetFont("s10 c" . BgSettings.FG . " Norm", "Segoe UI")
        c := g.Add("Checkbox"
            , "x" . x . " y" . y . " w400 " . (on ? "Checked" : ""), txt)
        BgSettings._c[key] := c
        h := 0
        try c.GetPos(, , , &h)
        return y + Max(26, h + 4)
    }

    ; ── THE ROW ADVANCES BY WHAT IT ACTUALLY DREW ───────────────────────────
    ; This returned a flat y+30 regardless of the label. A Text with a width
    ; and no height auto-sizes, so a label too long for the column wraps onto a
    ; second line and the control becomes ~34px tall -- and the next row was
    ; then drawn 30px down, on top of that second line. On screen it reads as
    ; the words being cut off, which is the symptom that was reported:
    ; "Compatibility delay setting (unused in event mode)" sat underneath the
    ; note that followed it.
    ;
    ; Measuring is the fix rather than widening the column, because the next
    ; long label would put it straight back.
    static _Num(g, key, label, x, y, val) {
        g.SetFont("s10 c" . BgSettings.FG . " Norm", "Segoe UI")
        lab := g.Add("Text", "x" . x . " y" . (y + 4) . " w220", label)
        BgSettings._c[key] := g.Add("Edit"
            , "x" . (x + 224) . " y" . y . " w80 h24 Number Background"
            . BgSettings.PANEL . " c" . BgSettings.GOLD . " Center", val)
        labH := 0
        try lab.GetPos(, , , &labH)
        ; The edit box is 24 tall and sits 4px above the label's top, so the
        ; row is never shorter than 30 however short the label is.
        return y + Max(30, labH + 10)
    }

    ; ── ONE PAGE, NOT FIVE TABS ─────────────────────────────────────────────
    ;
    ; The tabs hid four fifths of the settings behind a click each and made the
    ; window feel small because only one page was ever on screen. Everything is
    ; on one page now, in two columns, in a window big enough to hold it --
    ; which is also what makes the thing scannable: you can see that a setting
    ; exists without hunting for the tab it lives on.
    static _Build() {
        global CFG
        BgSettings._c := Map()

        winW := 980
        winH := 760
        m    := 22                       ; page margin
        colW := 440
        c1   := m
        c2   := m + colW + 34
        BgSettings._splitX := c2

        g := Gui("+Resize -MaximizeBox", "HSBG settings")
        g.BackColor := BgSettings.BG
        g.MarginX := 0
        g.MarginY := 0
        g.SetFont("s10 c" . BgSettings.FG, "Segoe UI")

        ; ── COLUMN ONE: SPEED, THEN SKIP ────────────────────────────────────
        y := m
        y := BgSettings._Head(g, "ANIMATION SPEED", c1, y)
        y := BgSettings._Chk(g, "AnimationSpeedEnabled"
           , "Enable speed control (F5-F8)", c1, y, CFG.animationSpeedEnabled)
        y := BgSettings._Note(g, "Speed is written to the game through the HSBG "
           . "plugin. If the plugin is not installed these settings have no "
           . "effect, and HSBG.log says why.", c1 + 24, y, colW - 24)

        y := BgSettings._Chk(g, "PhaseSpeedEnabled"
           , "Speed follows the game phase automatically", c1, y + 4
           , CFG.phaseSpeedEnabled)
        y := BgSettings._Note(g, "Combat gets one speed; everything else shares "
           . "the other. F5-F8 retune whichever is in force at the time and the "
           . "new value is saved here.", c1 + 24, y, colW - 24)

        y += 4
        y := BgSettings._SpeedRow(g, "CombatSpeed",  "In combat",       c1, y, CFG.combatSpeed)
        y := BgSettings._SpeedRow(g, "IdleSpeed",    "Everything else", c1, y, CFG.idleSpeed)
        y := BgSettings._SpeedRow(g, "SpeedKeyF7",   "F7 preset",       c1, y
           , CFG.HasOwnProp("speedKeyF7") ? CFG.speedKeyF7 : 4.0)
        y := BgSettings._SpeedRow(g, "SpeedKeyF8",   "F8 preset",       c1, y
           , CFG.HasOwnProp("speedKeyF8") ? CFG.speedKeyF8 : 8.0)
        y := BgSettings._Note(g, "Drag the slider through the presets, or type "
           . "any number into the box - it does not have to be one of them."
           , c1, y + 2, colW)

        y += 12
        y := BgSettings._Head(g, "COMBAT SKIP", c1, y)
        y := BgSettings._Chk(g, "PhaseDetect"
           , "Detect the game phase (needed by everything below)", c1, y
           , CFG.phaseDetect)
        y := BgSettings._Note(g, "Reads Hearthstone's own Power.log. HSBG turns "
           . "Power logging on at start-up if it is off, without touching any "
           . "other setting in that file.", c1 + 24, y, colW - 24)

        y := BgSettings._Chk(g, "AutoSkip", "Skip every combat automatically"
           , c1, y + 4, CFG.autoSkip)
        y := BgSettings._Warn(g, "Off by default, and worth understanding first. "
           . "An automatic skip presses F1, so it inherits the connection check, "
           . "the cooldown and the hold ceiling a manual press has - it is not a "
           . "second, weaker skip. It only fires inside a Battlegrounds game."
           , c1 + 24, y, colW - 24)
        y := BgSettings._Num(g, "AutoSkipDelayMs", "Compatibility delay setting (unused in event mode)"
           , c1, y + 2, CFG.autoSkipDelayMs)
        y := BgSettings._Note(g, "Auto-skip is event-driven: the F1 block fires on "
           . "Hearthstone's GameEntity STEP=MAIN_END, so this legacy setting is "
           . "kept only for existing configuration files and does not delay the "
           . "end-of-turn action.", c1, y, colW)

        ; ── THE HOLD LENGTH, AND WHY IT IS NOT A NUMBER BY DEFAULT ──────────
        ; The label above was read as "the skip timer", which is a fair reading
        ; of "Wait before skipping" and is wrong -- so both are now spelled out
        ; here, next to each other, rather than left to be inferred.
        ; HasOwnProp, not a bare read -- the same guard the effect toggles
        ; carry, for the same reason. An unguarded read of a key this build
        ; does not know about throws inside _Build, the throw is swallowed
        ; upstream, and the symptom is a settings window that never opens with
        ; no error anywhere. Measured again here the moment these two keys were
        ; added.
        y := BgSettings._Chk(g, "SkipFixedHold"
           , "Use a fixed skip length (not recommended)", c1, y + 4
           , CFG.HasOwnProp("f1HoldMode") && CFG.f1HoldMode = "fixed")
        y := BgSettings._Warn(g, "Leave this off. F1 normally watches the "
           . "connection and releases the moment it is confirmed back, so the "
           . "hold is as long as that combat needs and no longer. A fixed "
           . "length cannot know whether the client has noticed yet: too short "
           . "and the skip does nothing, too long and you are dropped and "
           . "cannot rejoin - which is how a fixed-timer skip strands you in a "
           . "game you were winning.", c1 + 24, y, colW - 24)
        y := BgSettings._Num(g, "SkipFixedHoldMs", "Fixed skip length (ms)"
           , c1, y, CFG.HasOwnProp("forcefulHoldMs") ? CFG.forcefulHoldMs : 4000)

        ; OVERLAY lives in this column to balance the two. Effects alone is
        ; twelve rows tall; with overlay and general stacked under it as well,
        ; the right column ran to the bottom of the screen while the left one
        ; stopped half way and left a hole.
        y += 12
        y := BgSettings._Head(g, "OVERLAY", c1, y)
        y := BgSettings._Chk(g, "OverlayEnabled", "Show the overlay", c1, y
           , CFG.overlayEnabled)
        y := BgSettings._Note(g, "Drag it by the HS/BG mark; the position is "
           . "remembered. MENU on the strip opens this window.", c1 + 24, y, colW - 24)
        y := BgSettings._Num(g, "OverlayScale",   "Size (%)",        c1, y + 2, CFG.overlayScale)
        y := BgSettings._Num(g, "OverlayOpacity", "Opacity (0-255)", c1, y, CFG.overlayOpacity)
        g.SetFont("s10 c" . BgSettings.FG, "Segoe UI")
        g.Add("Button", "x" . c1 . " y" . (y + 4) . " w200 h30"
            , "Reset overlay position").OnEvent("Click", (*) => BgSettings._ResetPos())
        y += 40
        col1Bottom := y

        ; ── COLUMN TWO: EFFECTS, OVERLAY, GENERAL ───────────────────────────
        y := m
        y := BgSettings._Head(g, "VISUAL EFFECTS", c2, y)
        y := BgSettings._Note(g, "All off by default. The first one is the one "
           . "worth having: card borders and glows run off the game's scaled "
           . "clock, so at 10x they stop reading as a pulse and start reading "
           . "as a strobe - that toggle feeds them real time instead. The rest "
           . "trade spectacle for a quieter board. A toggle only does something "
           . "if the plugin found a method in Hearthstone to attach it to; "
           . "BepInEx\\LogOutput.log lists each one and how many it patched, so "
           . "a zero there means Blizzard renamed something and that box is "
           . "inert until it is followed."
           , c2, y, colW)
        ; ── LABELS SAY WHAT THE TOGGLE DOES TO THE SCREEN ───────────────────
        ; The old ones named the mechanism ("No material flicker") rather than
        ; the effect, which is only useful to someone who already knows what
        ; the mechanism is. These say what changes when you tick it.
        ;
        ; Three of these are marked "(may not apply)". That is not hedging --
        ; it is measured. The plugin binds each effect to a method in the
        ; running game and logs how many it patched; on the current build:
        ;
        ;   CameraShakeMgr        2 patched     MaterialSoftFlicker   1
        ;   FullScreenFXMgr       1 patched     LegendarySkin         2
        ;   ShaderTime            1 patched
        ;   BoardEventListener    0 patched  <- nothing to hook
        ;   SpellStateType        0 patched  <- nothing to hook
        ;   Actor.IsUsingFast...  0 patched  <- nothing to hook
        ;
        ; A zero means Blizzard renamed or restructured that type, so the box
        ; ticks and nothing changes. Saying so is better than a box that lies,
        ; and better than deleting a toggle that will start working again the
        ; next time the name comes back. BepInEx\LogOutput.log carries the
        ; current counts if this needs re-checking after a patch.
        for spec in [ ["FxShaderTime",   "Card glows and borders pulse at normal speed"]
                    , ["FxLoopAnim",     "Stop idle animations looping on the board"]
                    , ["FxFastTriggers", "Use the game's fast trigger path"]
                    , ["FxShake",        "No screen shake when something hits"]
                    , ["FxScreen",       "No full-screen flashes or washes"]
                    , ["FxFlicker",      "No shimmer on card and minion art"]
                    , ["FxBoard",        "No hero-damage or spawn reactions"]
                    , ["FxHeroSkins",    "Freeze animated hero portraits"]
                    , ["FxParticles",    "Hide sparks, dust and trails on the board"]
                    , ["FxLowQuality",   "Drop render quality to the lowest tier"]] {
            ; HasOwnProp, not a bare read. A settings key this build does not
            ; know about must cost one unchecked box, not the whole column: an
            ; unguarded read throws, the throw is swallowed upstream, and the
            ; symptom is a settings window that silently comes up with the
            ; effects missing and no error anywhere. Measured -- they vanished
            ; exactly that way while these twelve keys were being added.
            prop := "fx" . SubStr(spec[1], 3)
            on   := CFG.HasOwnProp(prop) && CFG.%prop%
            y := BgSettings._Chk(g, spec[1], spec[2], c2, y, on)
        }
        y := BgSettings._Warn(g, "These two hide things you may need to read - "
           . "numbers, markers and counters - not just spectacle:"
           , c2, y + 2, colW)
        y := BgSettings._Chk(g, "FxHideSpells", "Hide spell effects entirely"
           , c2, y, CFG.HasOwnProp("fxHideSpells") && CFG.fxHideSpells)
        y := BgSettings._Chk(g, "FxAllParticles"
           , "Hide every particle, interface included", c2, y
           , CFG.HasOwnProp("fxAllParticles") && CFG.fxAllParticles)

        y += 12
        y := BgSettings._Head(g, "GENERAL", c2, y)
        y := BgSettings._Chk(g, "MonitorLock"
           , "Keep windows on the monitor the session started on", c2, y
           , CFG.lockWindowsToChosenMonitor)
        y := BgSettings._Chk(g, "HotkeyAudio", "Play a tone when a hotkey fires"
           , c2, y, CFG.hotkeyAudio)
        y := BgSettings._Num(g, "HotkeyAudioVolume", "Tone volume (1-100)"
           , c2, y + 2, CFG.hotkeyAudioVolume)
        y := BgSettings._Chk(g, "UpdateCheck", "Check for updates on start-up"
           , c2, y, CFG.updateCheck)
        y := BgSettings._Note(g, "Everything here lives in HSBG Config.ini, which "
           . "has a comment for every setting including several not shown here."
           , c2, y + 4, colW)
        col2Bottom := y

        ; ── FOOTER ──────────────────────────────────────────────────────────
        ; Positioned from the WINDOW's bottom, not from the last control. With
        ; "y+12" the previous control is whichever column happened to end last,
        ; so the buttons landed in the middle of the page.
        content := Max(col1Bottom, col2Bottom)
        if (winH < content + BgSettings._footerH + m)
            winH := content + BgSettings._footerH + m
        fy := winH - BgSettings._footerH + 14

        g.SetFont("s10 c" . BgSettings.FG, "Segoe UI")
        g.Add("Button", "x" . c1 . " y" . fy . " w120 h34 Default", "Save")
             .OnEvent("Click", (*) => BgSettings._Save())
        g.Add("Button", "x+10 yp w120 h34", "Cancel")
             .OnEvent("Click", (*) => BgSettings._Close())
        g.Add("Button", "x+10 yp w200 h34", "Open HSBG Config.ini")
             .OnEvent("Click", (*) => OpenConfigFile())

        g.OnEvent("Close",  (*) => BgSettings._Close())
        g.OnEvent("Escape", (*) => BgSettings._Close())
        g.OnEvent("Size",   (o, mm, w, h) => BgSettings._Relayout(w, h))
        BgSettings._gui := g
        BgSettings._DarkControls(g)
        ; Before Show(), so the ownership is in place the first time it appears
        ; rather than being applied to a window already on screen.
        BgSettings._OwnToHearthstone(g)

        ; ── IT OPENS ON THE MONITOR THE SESSION IS LOCKED TO ────────────────
        ; Not wherever Windows feels like putting it. Someone playing on a
        ; second monitor was getting the settings window on the first one,
        ; behind the game, which reads as the MENU button doing nothing.
        BgSettings._ShowOnChosenMonitor(winW, winH)

        BgSettings._Capture()
        if !BgSettings._msgOn {
            OnMessage(0x020A, _BgSettingsWheel)      ; WM_MOUSEWHEEL
            BgSettings._msgOn := true
        }
    }

    ; ── MAKE THE NATIVE CONTROLS DARK ───────────────────────────────────────
    ;
    ; A checkbox and a button are drawn by the common controls library, not by
    ; us. Setting the Gui's background black left a page of bright white
    ; checkbox squares and three light-grey buttons sitting on it -- the window
    ; was black, and nothing in it was.
    ;
    ; These two uxtheme entry points are exported BY ORDINAL and are not
    ; documented, which is why the whole thing sits in a try and why the result
    ; is never checked: if a future Windows drops them, the controls come back
    ; light and every one of them still works. Nothing here is load-bearing.
    ;   #135  SetPreferredAppMode(2)      -- 2 is force-dark
    ;   #133  AllowDarkModeForWindow(hwnd, true)
    ; SetWindowTheme then asks each control to use the dark variant.
    static _DarkControls(g) {
        try {
            ux := DllCall("kernel32\GetModuleHandleW", "Str", "uxtheme", "Ptr")
            if !ux
                ux := DllCall("kernel32\LoadLibraryW", "Str", "uxtheme.dll", "Ptr")
            if !ux
                return
            if (p := DllCall("kernel32\GetProcAddress", "Ptr", ux, "Ptr", 135, "Ptr"))
                DllCall(p, "Int", 2)
            if (p := DllCall("kernel32\GetProcAddress", "Ptr", ux, "Ptr", 133, "Ptr"))
                DllCall(p, "Ptr", g.Hwnd, "Int", true)
            for hwnd, ctrl in g
                try DllCall("uxtheme\SetWindowTheme", "Ptr", ctrl.Hwnd
                          , "Str", "DarkMode_Explorer", "Ptr", 0)
        }
    }

    ; ── OWNED BY HEARTHSTONE, SO THE TASKBAR STAYS DOWN ─────────────────────
    ;
    ; Opening this window made the taskbar slide up over the game and drop back
    ; when it closed. That is the shell doing exactly what it is supposed to:
    ; it hides the taskbar for a fullscreen window only while that window is
    ; the foreground one, and a settings window has to take the foreground --
    ; you type into it.
    ;
    ; Making Hearthstone the OWNER of this window is the way out. An owned
    ; window is treated as part of its owner's group: the owner keeps its
    ; active appearance while the owned dialog has focus, and the shell does
    ; not treat the switch as leaving the fullscreen app. It also means this
    ; window can never be lost behind the game, which is the other half of the
    ; same behaviour.
    ;
    ; Only when Hearthstone is actually running. Owning to a window that is
    ; about to close would take this one with it.
    static _OwnToHearthstone(g) {
        try {
            hs := 0
            prev := A_DetectHiddenWindows
            DetectHiddenWindows false
            for h in WinGetList("ahk_exe Hearthstone.exe") {
                try {
                    if (WinGetTitle("ahk_id " . h) != "Hearthstone")
                        continue
                    WinGetPos(, , &fw, &fh, "ahk_id " . h)
                    if (fw >= 600 && fh >= 400) {
                        hs := h
                        break
                    }
                }
            }
            DetectHiddenWindows prev
            if !hs
                return false
            ; GWLP_HWNDPARENT (-8) sets the OWNER, not the parent. Setting a
            ; real parent would clip this window inside the game's client area
            ; and is not what is wanted.
            fn := (A_PtrSize = 8) ? "user32\SetWindowLongPtrW" : "user32\SetWindowLongW"
            DllCall(fn, "Ptr", g.Hwnd, "Int", -8, "Ptr", hs)
            _FSLog("SETTINGS owned by the Hearthstone window (" . hs . ") so the"
                 . " shell does not treat opening it as leaving the fullscreen"
                 . " game -- that is what made the taskbar appear.")
            return true
        }
        return false
    }

    static _ShowOnChosenMonitor(w, h) {
        global CFG
        g := BgSettings._gui
        if !IsObject(g)
            return
        l := 0, t := 0, mw := 0, mh := 0
        try {
            if CFG.lockWindowsToChosenMonitor
                GetChosenMonitorBounds(&l, &t, &mw, &mh)
            else
                GetHSMonitorBounds(&l, &t, &mw, &mh)
        }
        if (mw <= 0 || mh <= 0) {
            g.Show("w" . w . " h" . h)
            return
        }
        ; Centred, and never taller than the monitor it is going onto -- a
        ; window whose Save button is below the bottom of the screen cannot be
        ; saved, and this one is deliberately large.
        if (h > mh - 60)
            h := mh - 60
        x := l + (mw - w) // 2
        y := t + (mh - h) // 2
        g.Show("x" . x . " y" . y . " w" . w . " h" . h)
    }

    ; ── RESIZING ────────────────────────────────────────────────────────────
    ;
    ; AutoHotkey does not reflow a Gui on its own, so the rule is written down:
    ;
    ;   page content   moves with the scroll offset, and wrapped text widens
    ;                  with the window so it uses the space it is given
    ;   footer buttons keep their size and stay pinned to the bottom
    ;
    ; Heights are left alone deliberately. Stretching a checkbox vertically
    ; makes it no easier to read; giving its label room to stop wrapping does.
    static _Capture() {
        BgSettings._rects := []
        g := BgSettings._gui
        if !IsObject(g)
            return
        ; ── CLIENT COORDINATES, NOT WINDOW COORDINATES ──────────────────────
        ; Controls report their position inside the CLIENT area, and the Size
        ; event hands out client dimensions too. GetPos returns the OUTER
        ; rectangle -- bigger by the title bar and the borders. Mixing the two
        ; put the footer boundary about forty pixels below where the buttons
        ; actually were, so every footer control was classified as page content
        ; and the footer stopped following the bottom edge. Everything captured
        ; here is client space so that it agrees with what Size reports later.
        g.GetClientPos(, , &gw, &gh)
        BgSettings._baseW := gw
        BgSettings._baseH := gh
        BgSettings._scrollY := 0
        footerTop := gh - BgSettings._footerH
        maxB := 0
        for hwnd, ctrl in g {
            try {
                ctrl.GetPos(&cx, &cy, &cw, &ch)
                inPage := (cy < footerTop)
                ; Which column it belongs to decides how it answers a resize:
                ; the left one only widens, the right one widens AND slides
                ; right so the gap between them grows with the window.
                col2   := (cx >= BgSettings._splitX - 4)
                BgSettings._rects.Push({ c: ctrl, x: cx, y: cy, w: cw, h: ch
                                       , page: inPage, col2: col2 })
                if (inPage && cy + ch > maxB)
                    maxB := cy + ch
            }
        }
        BgSettings._contentH := maxB
    }

    static _Relayout(w, h) {
        if (!IsObject(BgSettings._gui) || !BgSettings._rects.Length)
            return
        if (BgSettings._baseW = 0 || w = 0)
            return
        dh := h - BgSettings._baseH
        ; ── EXTRA WIDTH IS SHARED BETWEEN THE TWO COLUMNS ───────────────────
        ; Not given to both in full, which would overlap them, and not ignored,
        ; which is the old complaint: the window grew and only the black
        ; background grew with it. Half each, and the right column starts half
        ; a window-width further over.
        dw  := w - BgSettings._baseW
        dw2 := dw // 2

        ; ── WHY THE REDRAW IS SWITCHED OFF AROUND THE LOOP ──────────────────
        ; Each Move() repaints immediately, so a window with this many controls
        ; repainted a hundred-odd times per drag step and the resize crawled and
        ; flickered. WM_SETREDRAW off, move everything, back on, then invalidate
        ; once -- the whole window redraws a single time per resize, which is
        ; what makes the gesture feel smooth instead of torn.
        hwnd := BgSettings._gui.Hwnd
        try DllCall("user32\SendMessageW", "Ptr", hwnd, "UInt", 0x000B
                  , "Ptr", 0, "Ptr", 0)                       ; WM_SETREDRAW off
        for r in BgSettings._rects {
            try {
                if r.page
                    r.c.Move(r.col2 ? r.x + dw2 : r.x
                           , r.y - BgSettings._scrollY
                           , r.w + dw2)
                else
                    r.c.Move(, r.y + dh)          ; footer follows the bottom
            }
        }
        try {
            DllCall("user32\SendMessageW", "Ptr", hwnd, "UInt", 0x000B
                  , "Ptr", 1, "Ptr", 0)                       ; WM_SETREDRAW on
            DllCall("user32\RedrawWindow", "Ptr", hwnd, "Ptr", 0, "Ptr", 0
                  , "UInt", 0x0085)   ; INVALIDATE|ERASE|ALLCHILDREN
        }
    }

    ; ── SCROLLING ───────────────────────────────────────────────────────────
    ; On a short screen the page does not fit. Rather than a scrollbar control
    ; (which AutoHotkey has no native support for on a Gui) the contents are
    ; simply moved, which is all a scrollbar would do anyway.
    ;
    ; Clamped to the content, so it cannot be scrolled into blank space, and a
    ; no-op when everything already fits -- a wheel over a window with nothing
    ; to scroll should do nothing, not drift.
    static _Scroll(delta) {
        if !IsObject(BgSettings._gui)
            return
        ; Client, to agree with _Capture and with what Size reports.
        gw := 0, gh := 0
        try BgSettings._gui.GetClientPos(, , &gw, &gh)
        if !gh
            return
        ; The visible page is everything above the footer band. The overflow is
        ; what the content exceeds it by, recomputed per scroll because it
        ; shrinks to nothing as the window is made taller.
        room := BgSettings._contentH - (gh - BgSettings._footerH) + 16
        if (room < 0)
            room := 0
        want := BgSettings._scrollY - delta
        want := Max(0, Min(want, room))
        if (want = BgSettings._scrollY)
            return
        BgSettings._scrollY := want
        BgSettings._Relayout(gw, gh)
    }

    static _ResetPos() {
        global CFG
        CFG.overlayX := ""
        CFG.overlayY := ""
        try {
            IniWrite("", _ConfigPath(), "Settings", "OverlayX")
            IniWrite("", _ConfigPath(), "Settings", "OverlayY")
        }
        try BgOverlay.Rebuild()
        _FSLog("OVERLAY position reset to the default")
    }

    static _Get(key) {
        if BgSettings._c.Has(key)
            return BgSettings._c[key].Value
        return ""
    }

    static _Text(key) {
        if BgSettings._c.Has(key)
            return BgSettings._c[key].Text
        return ""
    }

    static _Save() {
        ; State is read below when the effect flags are pushed to the plugin.
        ; Declared rather than relied on: that read sits inside a try, where a
        ; scoping mistake would be swallowed and the toggles would silently
        ; never reach the game.
        global State, CFG
        path := _ConfigPath()
        try {
            IniWrite(BgSettings._Get("AnimationSpeedEnabled") ? 1 : 0, path, "Settings", "AnimationSpeedEnabled")
            IniWrite(BgSettings._Get("PhaseSpeedEnabled")     ? 1 : 0, path, "Settings", "PhaseSpeedEnabled")
            IniWrite(BgSettings._Get("PhaseDetect")           ? 1 : 0, path, "Settings", "PhaseDetect")
            IniWrite(BgSettings._Get("AutoSkip")              ? 1 : 0, path, "Settings", "AutoSkip")
            IniWrite(BgSettings._Get("OverlayEnabled")        ? 1 : 0, path, "Settings", "OverlayEnabled")
            IniWrite(BgSettings._Get("MonitorLock")           ? 1 : 0, path, "Settings", "MonitorLock")
            IniWrite(BgSettings._Get("HotkeyAudio")           ? 1 : 0, path, "Settings", "HotkeyAudio")
            IniWrite(BgSettings._Get("UpdateCheck")           ? 1 : 0, path, "Settings", "UpdateCheck")

            ; Clamped HERE rather than while it is being typed. Rewriting the
            ; box on every keystroke would turn a half-finished "1" on the way
            ; to "12" into the minimum, under the cursor. A typed value can be
            ; anything at all up to this point; this is where it has to become
            ; a number the game can be given.
            for k in ["CombatSpeed", "IdleSpeed", "SpeedKeyF7", "SpeedKeyF8"]
                IniWrite(Format("{:.1f}", BgSettings._Clamp(BgSettings._Text(k)))
                       , path, "Settings", k)

            for k in ["FxShaderTime", "FxLoopAnim", "FxFastTriggers", "FxBoard"
                    , "FxShake", "FxParticles", "FxScreen", "FxFlicker"
                    , "FxHeroSkins", "FxLowQuality", "FxHideSpells"
                    , "FxAllParticles"]
                IniWrite(BgSettings._Get(k) ? 1 : 0, path, "Settings", k)

            IniWrite(BgSettings._Get("AutoSkipDelayMs"),   path, "Settings", "AutoSkipDelayMs")
            IniWrite(BgSettings._Get("SkipFixedHold") ? "fixed" : "adaptive"
                   , path, "Settings", "SkipHoldMode")
            IniWrite(BgSettings._Get("SkipFixedHoldMs"),   path, "Settings", "SkipFixedHoldMs")
            IniWrite(BgSettings._Get("OverlayScale"),      path, "Settings", "OverlayScale")
            IniWrite(BgSettings._Get("OverlayOpacity"),    path, "Settings", "OverlayOpacity")
            IniWrite(BgSettings._Get("HotkeyAudioVolume"), path, "Settings", "HotkeyAudioVolume")
        } catch as e {
            _HudSay("Could not save settings: " . e.Message, 3600)
            return
        }

        _FSLog("SETTINGS saved from the settings window to " . path)
        try ReloadUserConfig()
        ; Switching phase detection on has to switch Power logging on too, or
        ; the setting is accepted and then silently does nothing because the
        ; game is not writing the log it reads. Safe to call every save: it
        ; writes nothing when the file is already correct.
        if CFG.phaseDetect
            try _HSEnsurePowerLogging()
        ; Push the effect toggles to the plugin straight away. Without this the
        ; new flags would sit in CFG until the next speed change, so ticking a
        ; box would appear to do nothing until a hotkey was pressed.
        try _WriteHSSpeedBridge(State.animationSpeedCurrent)
        try BgOverlay.Rebuild()
        BgSettings._Close()
        _HudSay("Settings saved", 1600)
    }

    static _Close(*) {
        ; The wheel hook is process-wide, so it comes off with the window --
        ; the same lesson the overlay's message hooks taught: a handler left
        ; installed for a window that no longer exists acts on windows that
        ; were never its business.
        if BgSettings._msgOn {
            try OnMessage(0x020A, _BgSettingsWheel, 0)
            BgSettings._msgOn := false
        }
        if IsObject(BgSettings._gui) {
            try BgSettings._gui.Destroy()
            BgSettings._gui := 0
        }
        BgSettings._c     := Map()
        BgSettings._rects := []
        BgSettings._scrollY := 0
    }
}

; ── THE SETTINGS WINDOW'S WHEEL HANDLER ─────────────────────────────────────
; Process-wide, like every OnMessage, so it checks that the wheel actually
; happened over the settings window before doing anything. Without that test it
; would scroll the settings page while the pointer was over the game.
;
; wParam's high word is the wheel delta: 120 per notch, negative downward. It
; is divided down and multiplied by a line height so one notch moves a sensible
; distance rather than one pixel or a whole page.
_BgSettingsWheel(wParam, lParam, msg, hwnd) {
    try {
        if !IsObject(BgSettings._gui)
            return
        ; The message goes to whichever control is under the pointer, so walk
        ; up to the top-level window before comparing.
        root := DllCall("user32\GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr")
        if (root != BgSettings._gui.Hwnd)
            return
        delta := (wParam >> 16) & 0xFFFF
        if (delta > 32767)
            delta -= 65536
        BgSettings._Scroll(Round(delta / 120) * 48)
        return 0
    }
}
